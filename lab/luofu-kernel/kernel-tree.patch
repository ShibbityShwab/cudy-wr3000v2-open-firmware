 	help
 	  Support for Hisilicon HIX5HD2 SoC family
 
+config ARCH_LUOFU
+	bool "Hisilicon luofu (Hi5671Y) family"
+	depends on ARCH_MULTI_V7
+	select CACHE_L2X0
+	select HAVE_ARM_SCU if SMP
+	select HAVE_ARM_TWD if SMP
+	help
+	  Support for the Hisilicon Hi5671Y "luofu" SoC (board R116, the Cudy
+	  WR3000 v2.0). The machine code is arch/arm/mach-luofu/luofu.c: it only
