--- a/arch/arm/mach-hisi/Kconfig
+++ b/arch/arm/mach-hisi/Kconfig
@@ -55,6 +55,20 @@
 	help
 	  Support for Hisilicon HIX5HD2 SoC family
 
+config ARCH_LUOFU
+	bool "Hisilicon luofu (Hi5671Y) family"
+	depends on ARCH_MULTI_V7
+	select CACHE_L2X0
+	select HAVE_ARM_SCU if SMP
+	select HAVE_ARM_TWD if SMP
+	help
+	  Support for the Hisilicon Hi5671Y "luofu" SoC (board R116, the Cudy
+	  WR3000 v2.0). The machine code is arch/arm/mach-luofu/luofu.c: it only
+	  matches the luofu devicetree and programs no hardware itself, so what
+	  comes up is exactly what the DT plus the drivers binding to it can do.
+	  A UP boot is the expected first posture - the DT enable-method is the
+	  vendor's "hisilicon,hsan_smp", which has no mainline smp_ops yet.
+
 config ARCH_SD5203
 	bool "Hisilicon SD5203 family"
 	depends on ARCH_MULTI_V5

