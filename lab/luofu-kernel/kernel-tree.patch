# ---------------------------------------------------------------------------
# Decompressor breadcrumbs: 0xC0DE000A on entry (physical write while the MMU
# is still off; r3/r4 are free at that point - r7/r8 hold the saved r1/r2),
# 0xC0DE000B after cache_off, just before entering the kernel proper.
# A stale value of either proves the decompressor stage was reached.

# ---------------------------------------------------------------------------
# Decompressor breadcrumbs, graded: 0xC0DE0008 at the absolute entry (the
# first instructions after the legacy header branch), 0xC0DE0009 once the
# hyp-stub call returned, 0xC0DE000A after r7/r8 hold the saved boot
# registers, 0xC0DE000B after cache_off just before entering the kernel.
# Physical writes while the MMU is off; r3/r4 are free at every point and
# the boot ABI registers (r0-r2, later r7/r8) are never touched.
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -211,13 +211,31 @@
 
 		__EFI_HEADER
 1:
+		/* lab breadcrumb: decompressor entry (very first instructions) */
+		movw	r3, #:lower16:0x10100C18
+		movt	r3, #:upper16:0x10100C18
+		movw	r4, #0x0008
+		movt	r4, #0xC0DE
+		str	r4, [r3]
  ARM_BE8(	setend	be		)	@ go BE8 if compiled for BE8
  AR_CLASS(	mrs	r9, cpsr	)
 #ifdef CONFIG_ARM_VIRT_EXT
 		bl	__hyp_stub_install	@ get into SVC mode, reversibly
 #endif
+		/* lab breadcrumb: hyp-stub install returned */
+		movw	r3, #:lower16:0x10100C18
+		movt	r3, #:upper16:0x10100C18
+		movw	r4, #0x0009
+		movt	r4, #0xC0DE
+		str	r4, [r3]
 		mov	r7, r1			@ save architecture ID
 		mov	r8, r2			@ save atags pointer
+		/* lab breadcrumb: r7/r8 saved (arg save path) */
+		movw	r3, #:lower16:0x10100C18
+		movt	r3, #:upper16:0x10100C18
+		movw	r4, #0x000A
+		movt	r4, #0xC0DE
+		str	r4, [r3]
 
 #ifndef CONFIG_CPU_V7M
 		/*
@@ -620,6 +638,12 @@
 		add	r1, r1, r0		@ end of inflated image
 		bl	cache_clean_flush
 		bl	cache_off
+		/* lab breadcrumb: decompression done, about to enter the kernel */
+		movw	r3, #:lower16:0x10100C18
+		movt	r3, #:upper16:0x10100C18
+		movw	r4, #0x000B
+		movt	r4, #0xC0DE
+		str	r4, [r3]
 
 #ifdef CONFIG_ARM_VIRT_EXT
 		mrs	r0, spsr		@ Get saved CPU boot mode

-----------------------------------------------------------
# Kernel-proper breadcrumb: 0xC0DE0004 at stext, the first instruction of the
# decompressed kernel (physical write, MMU off, r3/r4 free, boot ABI untouched).
# This extends the ladder across the decompressor->kernel handoff, the last
# unobserved stage.
--- a/arch/arm/kernel/head.S
+++ b/arch/arm/kernel/head.S
@@ -74,7 +74,13 @@
 	.arm
 
 	__HEAD
 ENTRY(stext)
+		/* lab breadcrumb: kernel stext entry (0xC0DE0004) - first instruction of the kernel proper */
+		movw	r3, #:lower16:0x10100C18
+		movt	r3, #:upper16:0x10100C18
+		movw	r4, #0x0004
+		movt	r4, #0xC0DE
+		str	r4, [r3]
  ARM_BE8(setend	be )			@ ensure we are in BE8 mode
 
  THUMB(	badr	r9, 1f		)	@ Kernel is always entered in ARM.
