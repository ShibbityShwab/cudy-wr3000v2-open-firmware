+	luofu-r116.dtb
 dtb-$(CONFIG_ARCH_INTEGRATOR) += \
 	integratorap.dtb \
 	integratorap-im-pd1.dtb \

# ---------------------------------------------------------------------------
# Decompressor breadcrumbs: 0xC0DE000A on entry (physical write while the MMU
# is still off; r3/r4 are free at that point - r7/r8 hold the saved r1/r2),
# 0xC0DE000B after cache_off, just before entering the kernel proper.
# A stale value of either proves the decompressor stage was reached.

# ---------------------------------------------------------------------------
# Decompressor breadcrumbs, graded: 0xC0DE0008 at the absolute entry (the
# first instructions after the legacy header branch), 0xC0DE0009 once the
# hyp-stub call returned, 0xC0DE000A after r7/r8 hold the saved boot
# registers, 0xC0DE000B after cache_off just before entering the kernel.
# Physical writes while the MMU is off; r3/r4 are free at every point and
# the boot ABI registers (r0-r2, later r7/r8) are never touched.

