+	LUOFU_SWITCH_ABSENT,	/* probe has not run yet */
+	LUOFU_SWITCH_REFUSED,	/* probe ran and failed closed */
+	LUOFU_SWITCH_READY,	/* W2 qid map programmed and verified */
