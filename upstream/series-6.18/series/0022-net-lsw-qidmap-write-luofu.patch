+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Internal wired-data-path interface of the Hi5671Y "luofu" internal LSW
+ * switch driver (luofu-switch.c).
+ *
+ * The switch driver owns the egress qid map; the GEMAC front end owns the port
+ * net_devices and may only register them after the switch has programmed and
+ * verified that map.  This is the minimal readiness contract between the two
+ * drivers - the switch itself stays a hidden engine, exactly like the PIE
+ * packet engine (luofu-pie.h).
+ *
+ * This interface is a draft and not a stable ABI.  It has never been executed
+ * on hardware; the map is only programmed in an explicit attended boot.
+ */
+#ifndef _LUOFU_SWITCH_H
+#define _LUOFU_SWITCH_H
+
+#include <linux/types.h>
+
+bool luofu_switch_probed(void);
+bool luofu_switch_ready(void);
+
+#endif /* _LUOFU_SWITCH_H */
