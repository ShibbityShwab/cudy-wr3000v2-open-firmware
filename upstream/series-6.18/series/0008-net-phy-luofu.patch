From 5dcb27b074cf3447b0a2ffae3862ccfa629e137d Mon Sep 17 00:00:00 2001
From: ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:20:00 +0700
Subject: [PATCH 08/26] net: phy: add driver for HiSilicon Luofu "Genius" PHYs

Add a PHYLIB driver for the HiSilicon "Genius" clause 22 PHYs (PHY ID
0x20669a00, mask 0xffffff00) behind the internal switch of the Hi5671Y
"luofu" SoC.  Their clause 22 register set is standard, so the driver
uses the generic helpers and exists to bind the device to a named
SoC-owned driver instead of the generic PHY.

Not implemented, on purpose: the vendor per-PHY firmware patch
(hi_ephy_*.bin) is not loaded.  Its format and effect are not decoded,
and it is the first suspect if link training differs from the vendor
stack.  The PHY is matched by PHY ID, not by a devicetree compatible, so
the PHY child nodes stay standard ethernet-phy-ieee802.3-c22 and no
binding is added.

Host-compiled against linux-6.18.60; never run on hardware.

Signed-off-by: ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>

---
 drivers/net/phy/Kconfig     |    7 ++++++
 drivers/net/phy/Makefile    |    1 +
 drivers/net/phy/luofu-phy.c |   52 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 60 insertions(+)

diff --git a/drivers/net/phy/Kconfig b/drivers/net/phy/Kconfig
--- a/drivers/net/phy/Kconfig
+++ b/drivers/net/phy/Kconfig
@@ -328,6 +328,13 @@ config LSI_ET1011C_PHY
 	help
 	  Supports the LSI ET1011C PHY.
 
+config LUOFU_PHY
+	tristate "HiSilicon Luofu Genius PHYs"
+	help
+	  Currently supports the HiSilicon "Genius" clause 22 PHYs found
+	  behind the internal switch of the Hi5671Y "luofu" SoC (PHY ID
+	  0x20669a00, mask 0xffffff00).
+
 config MARVELL_PHY
 	tristate "Marvell Alaska PHYs"
 	help
diff --git a/drivers/net/phy/Makefile b/drivers/net/phy/Makefile
--- a/drivers/net/phy/Makefile
+++ b/drivers/net/phy/Makefile
@@ -75,6 +75,7 @@ obj-$(CONFIG_FIXED_PHY)		+= fixed_phy.o
 obj-$(CONFIG_ICPLUS_PHY)	+= icplus.o
 obj-$(CONFIG_INTEL_XWAY_PHY)	+= intel-xway.o
 obj-$(CONFIG_LSI_ET1011C_PHY)	+= et1011c.o
+obj-$(CONFIG_LUOFU_PHY)		+= luofu-phy.o
 obj-$(CONFIG_LXT_PHY)		+= lxt.o
 obj-$(CONFIG_MARVELL_10G_PHY)	+= marvell10g.o
 obj-$(CONFIG_MARVELL_PHY)	+= marvell.o
diff --git a/drivers/net/phy/luofu-phy.c b/drivers/net/phy/luofu-phy.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/phy/luofu-phy.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for the HiSilicon "Genius" ethernet PHYs of the Hi5671Y "luofu" SoC.
+ *
+ * The wired ports' PHYs are IEEE 802.3 clause 22 devices with the HiSilicon
+ * PHY ID 0x20669a00 (mask 0xffffff00; the low byte reports the revision).
+ * Their clause 22 register set (BMCR/BMSR/ANAR/ANLPAR/MII_CTRL1000/
+ * MII_STAT1000) is standard, so the generic clause 22 helpers provide
+ * autonegotiation, link status and the 10/100/1000BASE-T abilities; this
+ * driver exists to bind the device to a named SoC-owned driver instead of the
+ * generic PHY.
+ *
+ * Not implemented, on purpose: the vendor driver downloads a per-PHY firmware
+ * patch (a file named hi_ephy_%xv%x.bin from the vendor rootfs) before the
+ * link trains.  The patch format and its effect are not decoded, so this
+ * driver loads nothing.  If link training behaves differently from the vendor
+ * stack, or this driver and the vendor driver disagree about link state, that
+ * patch is the first suspect.
+ *
+ * The PHY is matched by PHY ID, not by a devicetree compatible: the
+ * devicetree nodes stay standard ethernet-phy-ieee802.3-c22 nodes, so this
+ * driver adds no binding.
+ */
+
+#include <linux/module.h>
+#include <linux/phy.h>
+
+#define LUOFU_GENIUS_PHY_ID	0x20669a00
+#define LUOFU_GENIUS_PHY_MASK	0xffffff00
+
+static struct phy_driver luofu_genius_phy_drivers[] = {
+	{
+		.phy_id		= LUOFU_GENIUS_PHY_ID,
+		.phy_id_mask	= LUOFU_GENIUS_PHY_MASK,
+		.name		= "HiSilicon Luofu Genius PHY",
+		.config_aneg	= genphy_config_aneg,
+		.read_status	= genphy_read_status,
+		.suspend	= genphy_suspend,
+		.resume		= genphy_resume,
+	},
+};
+
+module_phy_driver(luofu_genius_phy_drivers);
+
+static const struct mdio_device_id __maybe_unused luofu_genius_phy_tbl[] = {
+	{ LUOFU_GENIUS_PHY_ID, LUOFU_GENIUS_PHY_MASK },
+	{ }
+};
+MODULE_DEVICE_TABLE(mdio, luofu_genius_phy_tbl);
+
+MODULE_DESCRIPTION("HiSilicon Luofu Genius PHY driver");
+MODULE_LICENSE("GPL");
