+/*
+ * PLL rate derivation, decoded from the vendor hi_clk.ko
+ * (hi_pll_recalc_rate) and cross-checked against the field layout in
+ * MISC-SOC-BLOCKS.md section 5.3.  In exact arithmetic:
+ *
+ *   rate = parent_rate * (int + frac / 2^24) / fbdiv
+ *
+ * followed by the two decoded divider-select fields (each is "skip when
+ * zero", and the vendor adds its absent-on-this-board div-factor term):
+ *
+ *   div1 = word0[10:8] + div_factor
+ *   div2 = word0[6:4]  + div_factor
+ *
+ * Bit 3 of word0 byte 0 selects the integer-only path: when set the
+ * fractional word is not added.  The vendor module performs the divisions in
+ * the written order with truncation, so this keeps the same operation order
+ * rather than re-arranging the fraction (the difference is at most one LSB of
+ * the final rate and matters if a consumer compares rates exactly).
+ *
+ * The field positions and the operation order are [V] (vendor DT plus the
+ * module disassembly of hi_pll_recalc_rate).  What is [U] is the on-board
+ * value: the boot-programmed words have never been read back on this board,
+ * so the derived rates are read-only and must be confirmed by a
+ * clock-summary readback before being trusted by anything that computes a
+ * divider (e.g. UART or cpufreq).  No write path
+ * exists on purpose: the writer's busy/re-lock protocol is decoded but its
+ * feedback-word encoding is not verified, and a wrong PLL store can hang the
+ * core.
+ */
+static unsigned long luofu_crg_pll_recalc_rate(struct clk_hw *hw,
+					       unsigned long parent_rate)
+{
+	struct luofu_crg_pll *pll = container_of(hw, struct luofu_crg_pll, hw);
+	const struct luofu_crg_pll_data *data = pll->data;
+	u64 rate;
+	u32 word0, word1, fbdiv, frac, div;
+
+	if (regmap_read(pll->regmap, data->ctrl_offset, &word0))
+		return 0;
+	if (regmap_read(pll->regmap, data->ctrl_offset + 4, &word1))
+		return 0;
+
+	fbdiv = FIELD_GET(LUOFU_PLL_FBDIV_MASK, word0);
+	if (!fbdiv) {
+		/*
+		 * The write protocol's call path was observed to compose a zero
+		 * feedback-divider field.  The bootloader's words are expected
+		 * to divide by a non-zero value; a zero here means the words are
+		 * not in the decoded layout, so report "unknown rate" rather
+		 * than faulting on a divide.
+		 */
+		return 0;
+	}
+
+	rate = div_u64((u64)parent_rate * FIELD_GET(LUOFU_PLL_INT_MASK, word0),
+		       fbdiv);
+
+	if (!(word0 & LUOFU_PLL_INT_MODE)) {
+		frac = FIELD_GET(LUOFU_PLL_FRAC_MASK, word1);
+		rate += div_u64((u64)parent_rate * frac, fbdiv) >> 24;
+	}
+
+	div = FIELD_GET(LUOFU_PLL_DIV1_MASK, word0) + data->div_factor;
+	if (div)
+		rate = div_u64(rate, div);
+
+	div = FIELD_GET(LUOFU_PLL_DIV2_MASK, word0) + data->div_factor;
+	if (div)
+		rate = div_u64(rate, div);
+
+	/* A rate above ULONG_MAX cannot be represented on 32-bit ARM. */
+	if (rate > ULONG_MAX) {
+		pr_warn_once("luofu-crg: %s decoded rate overflow\n", data->name);
+		return 0;
+	}
+
+	return (unsigned long)rate;
