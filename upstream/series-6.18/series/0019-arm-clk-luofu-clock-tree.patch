+/*
+ * PLL control words (two consecutive 32-bit words at ctrl_offset) and the
+ * shared status word.  The field layout is the decoded vendor hi_clk.ko
+ * model: word0[23:12] integer feedback field, word0[29:24] feedback divider,
+ * word1[23:0] fractional feedback, word0 byte 0 bit 3 is the integer-mode
+ * select and word0 bits 4..6 / 8..10 are divider-select fields.
+ */
+#define LUOFU_CRG_PLL_STATUS_OFFSET	0x90
+
+#define LUOFU_PLL_INT_MASK		GENMASK(23, 12)
+#define LUOFU_PLL_FBDIV_MASK		GENMASK(29, 24)
