From e09ef404a4202adb94512f19204cf96dc5ed1d4f Mon Sep 17 00:00:00 2001
From: ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>
Date: Wed, 18 Nov 2026 08:20:00 +0700
Subject: [PATCH 12/17] thermal: add Luofu thermal sensor driver

Add a read-only thermal sensor driver for the HiSilicon Hi5671Y "luofu"
SoC.  The die temperature is the low 16 bits of the word at offset
0x24, converted with the vendor v4 formula

    ((165 * raw - 32835) / 100) * 1000 - 40000   millidegrees

reproduced operation for operation, including the truncating division,
so the reported values match the vendor kernel.  The sensor is
registered as an of-thermal sensor with
devm_thermal_of_zone_register().

The thermal zone, its trips (115 C passive, 125 C critical, 3 C
hysteresis) and the 1 s polling delay are board devicetree data.  The
threshold, interrupt, enable and trim registers are not decoded and are
not written; the node claims no interrupt and the driver has no write
path at all.

Host-compiled against linux-6.18.60, binding checked with
dt_binding_check; never run on hardware.

Signed-off-by: ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>

---
 drivers/thermal/Kconfig                            |   15 ++
 drivers/thermal/Makefile                           |    1 
 drivers/thermal/luofu_tvsensor.c                   |  133 ++++++++++++++++++++
 .../bindings/thermal/hisilicon,luofu-tvsensor.yaml |   56 ++++++++
 4 files changed, 205 insertions(+)

diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -263,6 +263,21 @@
 	  thermal framework. cpufreq is used as the cooling device to throttle
 	  CPUs when the passive trip is crossed.
 
+config LUOFU_TVSENSOR
+	tristate "HiSilicon Luofu thermal sensor"
+	depends on ARCH_LUOFU || COMPILE_TEST
+	depends on HAS_IOMEM
+	depends on OF
+	help
+	  The Hi5671Y "luofu" SoC has a temperature sensor whose die
+	  temperature is read from a single register. Enable this to register
+	  it with the thermal framework; the board devicetree describes the
+	  thermal zone and its trip points. The driver is polled and performs
+	  no register writes.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called luofu_tvsensor.
+
 config IMX_THERMAL
 	tristate "Temperature sensor driver for Freescale i.MX SoCs"
 	depends on ARCH_MXC || COMPILE_TEST
diff --git a/drivers/thermal/Makefile b/drivers/thermal/Makefile
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -60,6 +60,7 @@
 obj-y				+= qcom/
 obj-y				+= tegra/
 obj-$(CONFIG_HISI_THERMAL)     += hisi_thermal.o
+obj-$(CONFIG_LUOFU_TVSENSOR)	+= luofu_tvsensor.o
 obj-y				+= mediatek/
 obj-$(CONFIG_GENERIC_ADC_THERMAL)	+= thermal-generic-adc.o
 obj-$(CONFIG_UNIPHIER_THERMAL)	+= uniphier_thermal.o
diff --git a/drivers/thermal/luofu_tvsensor.c b/drivers/thermal/luofu_tvsensor.c
new file mode 100644
--- /dev/null
+++ b/drivers/thermal/luofu_tvsensor.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HiSilicon Hi5671Y "luofu" temperature sensor
+ *
+ * The sensor is a single register block: the die temperature is the low 16
+ * bits of the word at offset 0x24, converted with the linear formula of the
+ * vendor driver's v4 path (the only path this board's hwver 3 uses):
+ *
+ *     raw = readl(base + 0x24) & 0xffff
+ *     millidegrees = ((165 * raw - 32835) / 100) * 1000 - 40000
+ *
+ * The formula was decoded from the vendor module and verified numerically
+ * (raw 240 -> 27.0 C, nominal slope 1.65 C/LSB); the integer division
+ * truncates toward zero exactly like the vendor's ARM sdiv.  The result is
+ * reported as-is: the conversion extrapolates outside the calibrated range
+ * (raw 0 yields a value below THERMAL_TEMP_INVALID, which the thermal core
+ * treats as "no valid temperature"), and this driver does not clamp or
+ * invent a validity window.
+ *
+ * This driver deliberately implements only the documented minimum:
+ *
+ *   - the temperature read path.  It is store-free: the only MMIO access in
+ *     the whole driver is the read in ->get_temp;
+ *   - registration as an of-thermal sensor.  The thermal zone, its trip
+ *     points and its polling delay are board devicetree data; the zone polls
+ *     this sensor at its polling-delay.
+ *
+ * Deliberately not implemented, because the register model is not
+ * established (no offset/encoding has been decoded and no store to this
+ * block has been measured):
+ *
+ *   - threshold programming ("set_th") and the interrupt path ("set_int_mask",
+ *     "clr_int", the vendor threshold/critical event IRQ).  The node claims
+ *     no interrupt and the zone is polled;
+ *   - enable/mode and trim ("set_trim", and the vendor "trim",
+ *     "int-base-offset", "addition-en", "efuse-trim-en" properties).  No
+ *     vendor enable sequence is needed for the read path: the vendor kernel
+ *     reads the sensor without re-enabling it, so the bootloader leaves it
+ *     running;
+ *   - any register write at all.  There is no write path in this driver.
+ *
+ * The block is not part of the CRG system-controller page and the vendor
+ * devicetree gives it no clock or reset; none are modelled.  Whether the
+ * block has a gate or a reset that Linux must manage is unknown (see the
+ * binding).
+ */
+
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+/* Register layout: only the temperature word is decoded. */
+#define LUOFU_TVSENSOR_TEMP_REG	0x24
+#define LUOFU_TVSENSOR_RAW_MASK	0xffff
+
+struct luofu_tvsensor {
+	void __iomem *base;
+};
+
+static int luofu_tvsensor_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct luofu_tvsensor *sensor = thermal_zone_device_priv(tz);
+	u32 raw;
+	int deg;
+
+	raw = readl(sensor->base + LUOFU_TVSENSOR_TEMP_REG) &
+	      LUOFU_TVSENSOR_RAW_MASK;
+
+	/*
+	 * Keep the vendor formula operation for operation so the reported
+	 * value matches the vendor driver bit for bit, including the
+	 * truncation of the division.  No overflow: 165 * 0xffff fits in int.
+	 */
+	deg = (165 * (int)raw - 32835) / 100;
+	*temp = deg * 1000 - 40000;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops luofu_tvsensor_ops = {
+	.get_temp = luofu_tvsensor_get_temp,
+};
+
+static int luofu_tvsensor_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tz;
+	struct luofu_tvsensor *sensor;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(sensor->base))
+		return dev_err_probe(dev, PTR_ERR(sensor->base),
+				     "failed to map the sensor registers\n");
+
+	/*
+	 * Probe performs no register access: the first read happens in
+	 * ->get_temp once the thermal core starts the zone's monitor, and the
+	 * zone, trips and polling delay come from the board devicetree.
+	 */
+	tz = devm_thermal_of_zone_register(dev, 0, sensor, &luofu_tvsensor_ops);
+	if (IS_ERR(tz))
+		return dev_err_probe(dev, PTR_ERR(tz),
+				     "failed to register thermal sensor\n");
+
+	dev_info(dev, "thermal sensor registered\n");
+
+	return 0;
+}
+
+static const struct of_device_id luofu_tvsensor_of_match[] = {
+	{ .compatible = "hisilicon,luofu-tvsensor" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, luofu_tvsensor_of_match);
+
+static struct platform_driver luofu_tvsensor_driver = {
+	.probe = luofu_tvsensor_probe,
+	.driver = {
+		.name = "luofu-tvsensor",
+		.of_match_table = luofu_tvsensor_of_match,
+	},
+};
+module_platform_driver(luofu_tvsensor_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi5671Y luofu temperature sensor");
+MODULE_LICENSE("GPL");
diff --git a/Documentation/devicetree/bindings/thermal/hisilicon,luofu-tvsensor.yaml b/Documentation/devicetree/bindings/thermal/hisilicon,luofu-tvsensor.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/hisilicon,luofu-tvsensor.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/hisilicon,luofu-tvsensor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Luofu temperature sensor
+
+maintainers:
+  - ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>
+
+description: |
+  The Hi5671Y "luofu" SoC has a temperature sensor with a single on-die
+  sensor. The die temperature is the low 16 bits of the register at offset
+  0x24 of the node's reg window.
+
+  The reg window must therefore cover offset 0x24, i.e. be at least 0x28
+  bytes long. The vendor devicetree declares only 0x14 bytes, which is
+  shorter than the register its own driver reads, so do not copy that size.
+
+  The vendor devicetree also describes an interrupt (the threshold/critical
+  event output) and threshold/trim properties. Their register model is not
+  established, so this binding does not describe them and the driver polls
+  the sensor through the thermal zone instead of claiming an interrupt.
+
+  The block has no clock or reset input in the vendor devicetree, so neither
+  is modelled here; whether Linux must manage a gate or a reset for it is
+  unverified.
+
+$ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: hisilicon,luofu-tvsensor
+
+  reg:
+    maxItems: 1
+
+  '#thermal-sensor-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#thermal-sensor-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    temperature-sensor@14900500 {
+        compatible = "hisilicon,luofu-tvsensor";
+        reg = <0x14900500 0x100>;
+        #thermal-sensor-cells = <0>;
+    };
+...
