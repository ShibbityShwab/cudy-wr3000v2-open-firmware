 drivers/pci/controller/dwc/Makefile                |    1 
 drivers/pci/controller/dwc/pcie-luofu.c            |  467 ++++++++++++++++++++
 .../bindings/pci/hisilicon,luofu-pcie.yaml         |  126 +++++
 4 files changed, 609 insertions(+)

