+++ b/drivers/net/ethernet/hisilicon/Kconfig
@@ -153,6 +153,18 @@
 
 endif #HNS3
 
+config LUOFU_PIE
+	tristate "HiSilicon Luofu PIE packet engine (draft, data path disabled)"
+	depends on OF
+	help
+	  Platform driver for the Hi5671Y "luofu" PIE packet engine, the
+	  DMA/ring half of the wired Ethernet data path.  This is a draft
