+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HiSilicon Hi5671Y "luofu" peripheral pin controller
+ *
+ * The peripheral IOMUX block has two register windows:
+ *
+ *   0x14900100, 0x3c bytes	mux: one bit per pin function
+ *   0x14940000, 0x100 bytes	cfg: one 32-bit pin configuration word per pin
+ *
+ * There are 37 pins (pin0..pin36), 24 pin groups and 24 functions.  Every
+ * function owns exactly one group and every group is owned by exactly one
+ * function; the tables are transcribed from the vendor pin controller for
+ * this SoC, which is the only register-level description of the block.
+ *
+ * Muxing model: a pin has up to five (register offset, bit number, function)
+ * hits.  Selecting function F on a group walks the group's pins and, for
+ * every hit of every pin, clears the hit's bit and sets it again only when
+ * the hit names F.  The "null" hits are bits that therefore stay clear.
+ * Some pins share a hit (for example pin10 and pin11 are both mdio1 on mux
+ * word 16 bit 21); a "null" hit at mux word 12 bit 1 is shared by most pins.
+ * A function is only accepted for a group whose pins actually implement it;
+ * otherwise the operation fails without writing anything.
+ *
+ * Additionally, four groups (the jtag_gpio2..5 groups) need one bit in mux
+ * word 8 (byte offset 8) set when they are selected; that is the group-level
+ * mux field encoded in the group table.
+ *
+ * Pin configuration model: one 32-bit word per pin, at cfg offset 4 * pin.
+ * The vendor pin controller implements six generic pin configuration
+ * parameters against that word, all as read-modify-write of a bit field:
+ *
+ *   bitfield	parameter
+ *   [0]	pull up enable		PIN_CONFIG_BIAS_PULL_UP
+ *   [1]	pull down enable	PIN_CONFIG_BIAS_PULL_DOWN
+ *   [4:2]	drive strength		PIN_CONFIG_DRIVE_STRENGTH (raw 3-bit value)
+ *   [5]	schmitt trigger		PIN_CONFIG_INPUT_SCHMITT_ENABLE
+ *   [7]	input enable		PIN_CONFIG_INPUT_ENABLE
+ *   [10]	output level		PIN_CONFIG_LEVEL
+ *
+ * The drive-strength field is a raw three-bit setting; the vendor driver
+ * treats the generic parameter's argument as the raw field value and no
+ * mA-per-code calibration is known, so the argument is documented as the raw
+ * value here as well.  The output-level bit is the vendor parameter for
+ * driving a value on an output pin; in this kernel that generic parameter is
+ * PIN_CONFIG_LEVEL.  No other generic parameter (bias disable, bus hold,
+ * open drain/source, output enable, ...) is expressed by the table this
+ * driver was transcribed from, so those are rejected with -EINVAL instead of
+ * being silently mapped to a guessed bit.
+ *
+ * Deliberately not done here:
+ *
+ *   - Probe performs no register access.  Which mux/cfg state the vendor
+ *     driver establishes at probe time (if any) is not known: its probe
+ *     unwinds to the reset controller and the pinctrl core only, and the
+ *     boot loader has already been driving these pins.  Writing a guessed
+ *     default state could remux the console or the boot flash, so a state is
+ *     only ever programmed when a consumer asks for it through the standard
+ *     pinctrl interface.
+ *   - There is no clock and no reset line in the vendor description of this
+ *     block and no reset provider cell is used.  The vendor driver obtains an
+ *     optional reset named "mux", but the board devicetree gives that node no
+ *     reset specifier, so nothing was deasserted there either; no reset is
+ *     invented here.
+ *   - The iomux JTAG-select register in the middle of the same 4 KiB page is
+ *     a separate, differently described block and is not part of this
+ *     binding.  This driver only claims the two documented windows.
+ *   - The group-level power-source parameter path present in the vendor
+ *     driver is dead on this SoC: its group field is zero for every group
+ *     and its callback is not populated, so it is not carried over.
+ */
+
+#include <linux/io.h>
+#include <linux/module.h>
