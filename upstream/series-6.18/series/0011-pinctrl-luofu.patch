+};
+
+#undef LUOFU_MUX
+
+/* ---- pin configuration table ---- */
+
+static const struct luofu_pinconf_field luofu_pinconf_fields[] = {
+	{ PIN_CONFIG_BIAS_PULL_UP,		0, 1 },
+	{ PIN_CONFIG_BIAS_PULL_DOWN,		1, 1 },
+	{ PIN_CONFIG_DRIVE_STRENGTH,		2, 3 },
+	{ PIN_CONFIG_INPUT_SCHMITT_ENABLE,	5, 1 },
+	{ PIN_CONFIG_INPUT_ENABLE,		7, 1 },
+	{ PIN_CONFIG_LEVEL,			10, 1 },
+};
+
+static const struct luofu_pinconf_field *
+luofu_pinconf_field(enum pin_config_param param)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(luofu_pinconf_fields); i++)
+		if (luofu_pinconf_fields[i].param == param)
+			return &luofu_pinconf_fields[i];
+
+	return NULL;
+}
+
+/* ---- pinctrl ops ---- */
+
+static int luofu_get_groups_count(struct pinctrl_dev *pctldev)
+{
+	return LUOFU_NGROUPS;
+}
+
+static const char *luofu_get_group_name(struct pinctrl_dev *pctldev,
+					unsigned int selector)
+{
+	if (selector >= LUOFU_NGROUPS)
+		return NULL;
+
+	return luofu_groups[selector].name;
+}
+
+static int luofu_get_group_pins(struct pinctrl_dev *pctldev,
+				unsigned int selector,
+				const unsigned int **pins,
+				unsigned int *num_pins)
+{
+	if (selector >= LUOFU_NGROUPS)
+		return -EINVAL;
+
+	*pins = luofu_groups[selector].pins;
+	*num_pins = luofu_groups[selector].npins;
+	return 0;
+}
+
+static int luofu_dt_node_to_map(struct pinctrl_dev *pctldev,
+				struct device_node *np_config,
+				struct pinctrl_map **map,
+				unsigned int *num_maps)
+{
+	return pinconf_generic_dt_node_to_map_all(pctldev, np_config, map,
+						  num_maps);
+}
+
+static const struct pinctrl_ops luofu_pctl_ops = {
+	.get_groups_count = luofu_get_groups_count,
+	.get_group_name = luofu_get_group_name,
+	.get_group_pins = luofu_get_group_pins,
+	.dt_node_to_map = luofu_dt_node_to_map,
+	.dt_free_map = pinconf_generic_dt_free_map,
+};
+
+/* ---- pinmux ops ---- */
+
+static int luofu_get_functions_count(struct pinctrl_dev *pctldev)
+{
+	return LUOFU_NFUNCTIONS;
+}
+
+static const char *luofu_get_function_name(struct pinctrl_dev *pctldev,
+					   unsigned int selector)
+{
+	if (selector >= LUOFU_NFUNCTIONS)
+		return NULL;
+
+	return luofu_functions[selector].name;
+}
+
+static int luofu_get_function_groups(struct pinctrl_dev *pctldev,
+				     unsigned int selector,
+				     const char * const **groups,
+				     unsigned int *num_groups)
+{
+	if (selector >= LUOFU_NFUNCTIONS)
+		return -EINVAL;
+
+	*groups = luofu_functions[selector].groups;
+	*num_groups = luofu_functions[selector].ngroups;
+	return 0;
+}
+
+static void luofu_set_mux_group(struct luofu_pinctrl *priv,
+				const struct luofu_pingroup *group)
+{
+	u32 val;
+
+	val = readl(priv->mux_base + group->mux_reg);
+	val &= ~group->mux_mask;
+	val |= group->mux_val << __ffs(group->mux_mask);
+	writel(val, priv->mux_base + group->mux_reg);
+}
+
+static int luofu_set_mux(struct pinctrl_dev *pctldev, unsigned int func_selector,
+			 unsigned int group_selector)
+{
+	struct luofu_pinctrl *priv = pinctrl_dev_get_drvdata(pctldev);
+	const struct luofu_function *func = &luofu_functions[func_selector];
+	const struct luofu_pingroup *group = &luofu_groups[group_selector];
+	unsigned long flags;
+	unsigned int i, k;
+
+	for (i = 0; i < func->ngroups; i++) {
+		if (!strcmp(func->groups[i], group->name))
+			break;
+	}
+	if (i == func->ngroups) {
+		dev_err(priv->dev, "function %s does not support group %s\n",
+			func->name, group->name);
+		return -EINVAL;
+	}
+
+	spin_lock_irqsave(&priv->lock, flags);
+	for (i = 0; i < group->npins; i++) {
+		unsigned int pin = group->pins[i];
+		bool matched = false;
+
+		for (k = 0; k < LUOFU_MUX_HITS; k++) {
+			const struct luofu_mux *mux = &luofu_pin_mux[pin][k];
+			u32 val = readl(priv->mux_base + mux->reg);
+
+			val &= ~BIT(mux->shift);
+			if (!strcmp(mux->func, func->name)) {
+				val |= BIT(mux->shift);
+				matched = true;
+			}
+			writel(val, priv->mux_base + mux->reg);
+		}
+
+		if (!matched) {
+			spin_unlock_irqrestore(&priv->lock, flags);
+			dev_err(priv->dev,
+				"pin %u has no mux setting for function %s\n",
+				pin, func->name);
+			return -EINVAL;
+		}
+	}
+
+	if (group->mux_en)
+		luofu_set_mux_group(priv, group);
+	spin_unlock_irqrestore(&priv->lock, flags);
+
+	return 0;
+}
+
+static const struct pinmux_ops luofu_pmx_ops = {
+	.get_functions_count = luofu_get_functions_count,
+	.get_function_name = luofu_get_function_name,
+	.get_function_groups = luofu_get_function_groups,
+	.set_mux = luofu_set_mux,
+};
+
+/* ---- pinconf ops ---- */
+
+static u32 luofu_pinconf_mask(const struct luofu_pinconf_field *field)
+{
+	return ((1U << field->width) - 1) << field->shift;
+}
+
+static int luofu_pin_config_set(struct pinctrl_dev *pctldev, unsigned int pin,
+				unsigned long *configs,
+				unsigned int num_configs)
+{
+	struct luofu_pinctrl *priv = pinctrl_dev_get_drvdata(pctldev);
+	unsigned long flags;
+	unsigned int i;
+	int ret = 0;
+
+	if (pin >= LUOFU_NPINS)
+		return -EINVAL;
+
+	spin_lock_irqsave(&priv->lock, flags);
+	for (i = 0; i < num_configs; i++) {
+		const struct luofu_pinconf_field *field;
+		u32 arg, mask, val;
+
+		field = luofu_pinconf_field(pinconf_to_config_param(configs[i]));
+		if (!field) {
+			ret = -EINVAL;
+			break;
+		}
+
+		arg = pinconf_to_config_argument(configs[i]);
+		mask = luofu_pinconf_mask(field);
+		val = readl(priv->cfg_base + 4 * pin);
+		val &= ~mask;
+		val |= (arg << field->shift) & mask;
+		writel(val, priv->cfg_base + 4 * pin);
+	}
+	spin_unlock_irqrestore(&priv->lock, flags);
+
+	return ret;
+}
+
+static int luofu_pin_config_get(struct pinctrl_dev *pctldev, unsigned int pin,
+				unsigned long *config)
+{
+	struct luofu_pinctrl *priv = pinctrl_dev_get_drvdata(pctldev);
+	const struct luofu_pinconf_field *field;
+	enum pin_config_param param;
+	u32 arg, val;
+
+	if (pin >= LUOFU_NPINS)
+		return -EINVAL;
+
+	param = pinconf_to_config_param(*config);
+	field = luofu_pinconf_field(param);
+	if (!field)
+		return -EINVAL;
+
+	val = readl(priv->cfg_base + 4 * pin);
+	arg = (val & luofu_pinconf_mask(field)) >> field->shift;
+	*config = pinconf_to_config_packed(param, arg);
+
+	return 0;
+}
+
+static int luofu_pin_config_group_set(struct pinctrl_dev *pctldev,
+				      unsigned int selector,
+				      unsigned long *configs,
+				      unsigned int num_configs)
+{
+	const struct luofu_pingroup *group = &luofu_groups[selector];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < group->npins; i++) {
+		ret = luofu_pin_config_set(pctldev, group->pins[i], configs,
+					   num_configs);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * A group has no single configuration value of its own: the register is per
+ * pin.  Report the value of the group's first pin, which is what the vendor
+ * pin controller does; the set side applies the requested configuration to
+ * every pin of the group.
+ */
+static int luofu_pin_config_group_get(struct pinctrl_dev *pctldev,
+				      unsigned int selector,
+				      unsigned long *config)
+{
+	const struct luofu_pingroup *group = &luofu_groups[selector];
+
+	return luofu_pin_config_get(pctldev, group->pins[0], config);
+}
+
+static const struct pinconf_ops luofu_conf_ops = {
+	.is_generic = true,
+	.pin_config_get = luofu_pin_config_get,
+	.pin_config_set = luofu_pin_config_set,
+	.pin_config_group_get = luofu_pin_config_group_get,
+	.pin_config_group_set = luofu_pin_config_group_set,
+};
+
+static struct pinctrl_desc luofu_pinctrl_desc = {
+	.name = "luofu-pinctrl",
+	.pins = luofu_pins,
+	.npins = ARRAY_SIZE(luofu_pins),
+	.pctlops = &luofu_pctl_ops,
+	.pmxops = &luofu_pmx_ops,
+	.confops = &luofu_conf_ops,
+	.owner = THIS_MODULE,
+};
+
+static int luofu_pinctrl_probe(struct platform_device *pdev)
+{
+	struct luofu_pinctrl *priv;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->dev = &pdev->dev;
+
+	priv->mux_base = devm_platform_ioremap_resource_byname(pdev, "mux");
+	if (IS_ERR(priv->mux_base))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->mux_base),
+				     "failed to map mux window\n");
+
+	priv->cfg_base = devm_platform_ioremap_resource_byname(pdev, "cfg");
+	if (IS_ERR(priv->cfg_base))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->cfg_base),
+				     "failed to map cfg window\n");
+
+	spin_lock_init(&priv->lock);
+
+	priv->pctldev = devm_pinctrl_register(&pdev->dev, &luofu_pinctrl_desc,
+					      priv);
+	if (IS_ERR(priv->pctldev))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->pctldev),
+				     "failed to register pin controller\n");
+
+	platform_set_drvdata(pdev, priv);
+
+	return 0;
+}
+
+static const struct of_device_id luofu_pinctrl_of_match[] = {
+	{ .compatible = "hisilicon,luofu-pinctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, luofu_pinctrl_of_match);
+
+static struct platform_driver luofu_pinctrl_driver = {
+	.probe = luofu_pinctrl_probe,
+	.driver = {
+		.name = "luofu-pinctrl",
+		.of_match_table = luofu_pinctrl_of_match,
+	},
+};
+module_platform_driver(luofu_pinctrl_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi5671Y (luofu) peripheral pin controller");
+MODULE_LICENSE("GPL");
diff --git a/Documentation/devicetree/bindings/pinctrl/hisilicon,luofu-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/hisilicon,luofu-pinctrl.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/hisilicon,luofu-pinctrl.yaml
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/hisilicon,luofu-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Luofu peripheral pin controller
+
+maintainers:
+  - ShibbityShwab <18537102+ShibbityShwab@users.noreply.github.com>
+
+description: |
+  The peripheral pin controller of the HiSilicon Hi5671Y "luofu" SoC selects
+  the peripheral function of each SoC pin and configures its electrical
+  properties.  It owns two register windows: the mux window, which carries the
+  function-select bits of all pins, and the pin configuration window, which
+  carries one 32-bit configuration word per pin.
+
+  There are 37 pins, 24 pin groups and 24 functions.  The group and function
+  names are the names the pin controller's own tables use; every function
+  belongs to exactly one group and every group to exactly one function.
+
+  Pin configuration states use the generic bindings.  A state node contains
+  one or more child nodes: a child carrying "function" and "groups" selects a
+  pin function, and a child carrying pin configuration properties (with
+  "pins" or "groups") configures the electrical properties of the pins.  The
+  driver implements only the parameters it can decode: bias-pull-up,
+  bias-pull-down, drive-strength, input-schmitt-enable, input-enable and the
+  output level; other generic pin configuration properties must not be used.
+
+properties:
+  compatible:
+    const: hisilicon,luofu-pinctrl
+
+  reg:
+    items:
+      - description: mux register window
+      - description: pin configuration register window
+
+  reg-names:
+    items:
+      - const: mux
+      - const: cfg
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+allOf:
+  - $ref: pinctrl.yaml#
+
+additionalProperties: false
+
+patternProperties:
+  '-state$':
+    type: object
+    description:
+      A pin configuration state that a consumer references with
+      pinctrl-names/pinctrl-N.
+    additionalProperties: false
+
+    patternProperties:
+      '-pins$':
+        type: object
+        description:
+          One pin multiplexing and/or pin configuration entry of the state.
+        allOf:
+          - $ref: pinmux-node.yaml#
+          - $ref: pincfg-node.yaml#
+        unevaluatedProperties: false
+        properties:
+          function:
+            enum: [sfc, uart1, uart0, mdio1, spi, i2c, rgmii0,
+                   eth_act_led0, eth_act_led1, eth_act_led2, eth_act_led3,
+                   eth_act_led4, led0_0, led1_0, led0_1, led1_1, clk_test,
+                   avs, phy_clk, usb, jtag_gpio2, jtag_gpio3, jtag_gpio4,
+                   jtag_gpio5]
+          groups:
+            minItems: 1
+            items:
+              enum: [sfc_grp, uart1_grp, uart0_grp, mdio1_grp, spi_grp,
+                     i2c_grp, rgmii0_grp, eth_act_led0_grp,
+                     eth_act_led1_grp, eth_act_led2_grp, eth_act_led3_grp,
+                     eth_act_led4_grp, led0_0_grp, led1_0_grp, led0_1_grp,
+                     led1_1_grp, clk_test_grp, avs_grp, phy_clk_grp,
+                     usb_grp, jtag_gpio2_grp, jtag_gpio3_grp,
+                     jtag_gpio4_grp, jtag_gpio5_grp]
+          pins:
+            minItems: 1
+            items:
+              enum: [pin0, pin1, pin2, pin3, pin4, pin5, pin6, pin7, pin8,
