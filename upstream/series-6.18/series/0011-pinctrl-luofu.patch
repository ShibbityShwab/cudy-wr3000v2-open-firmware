+#define LUOFU_NPINS		37
+#define LUOFU_NGROUPS		24
+#define LUOFU_NFUNCTIONS	24
+#define LUOFU_MUX_HITS		5
+
+/* One mux bit: selecting @func programs bit @shift of mux word @reg. */
+struct luofu_mux {
+	u8 reg;
+	u8 shift;
+	const char *func;
+};
+
+struct luofu_pingroup {
+	const char *name;
+	const unsigned int *pins;
+	unsigned int npins;
+	/* Group-level mux bit, programmed when @mux_en is set. */
+	bool mux_en;
+	u8 mux_reg;
+	u8 mux_mask;
+	u8 mux_val;
+};
+
+struct luofu_function {
+	const char *name;
+	const char * const *groups;
+	unsigned int ngroups;
+};
+
+struct luofu_pinconf_field {
+	enum pin_config_param param;
+	u8 shift;
+	u8 width;
+};
+
+struct luofu_pinctrl {
+	struct device *dev;
+	struct pinctrl_dev *pctldev;
+	void __iomem *mux_base;
+	void __iomem *cfg_base;
+	/* protects the mux and cfg read-modify-write sequences */
+	spinlock_t lock;
+};
