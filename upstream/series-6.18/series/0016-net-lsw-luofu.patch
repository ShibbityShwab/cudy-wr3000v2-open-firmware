--- a/drivers/net/ethernet/hisilicon/Kconfig
+++ b/drivers/net/ethernet/hisilicon/Kconfig
@@ -181,4 +181,17 @@
 
 	  If you are unsure, say N.
 
+config LUOFU_SWITCH
+	tristate "HiSilicon Luofu internal LSW switch (draft, probe refuses)"
+	depends on OF
+	help
+	  Platform driver for the internal Ethernet switch of the Hi5671Y
+	  "luofu" SoC, the switch core between the GEMAC ports and the PHY side
+	  of the wired data path.  This is a draft port: it validates the
+	  register windows, the clocks, the resets and the devicetree switch port
+	  model, then refuses to program the switch until the register, queue and
+	  port-id model has been verified against the running hardware.  The
+	  board devicetree keeps the node disabled.  Say N unless you are
+	  working on that port.
+
 endif # NET_VENDOR_HISILICON
