--- /dev/null
+++ b/arch/arm/boot/dts/hisilicon/luofu-r116.dts
@@ -0,0 +1,712 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Cudy WR3000 v2.0 (HiSilicon Hi5671Y "luofu", board R116) board devicetree.
+ *
+ * All register bases, interrupt numbers, clock/reset IDs, GPIOs and the NAND
+ * partition map below are measured board facts or decoded vendor-devicetree
+ * values.  See upstream/series-6.18/07-dts-upstream-bindings.md for the
+ * provenance of every value, the cleanup record (removed/renamed nodes), and
+ * the items that still block an upstream submission.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/hisilicon,luofu-crg.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	model = "Cudy WR3000 v2.0";
+
+	/*
+	 * The OpenWrt target's board_name/sysupgrade metadata still keys off the
+	 * hisilicon compatibles; the board compatible is expected first upstream.
+	 * Reorder to "cudy,wr3000-v2" first when the target metadata is synced
+	 * (documented in 07-dts-upstream-bindings.md).
+	 */
+	compatible = "hisilicon,luofu-r116", "hisilicon,luofu", "cudy,wr3000-v2";
+
+	interrupt-parent = <&gic>;
+
+	aliases {
+		serial0 = &uart1;
+		/* the stock U-Boot hand-off fixup requires this alias */
+		console = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		enable-method = "hisilicon,luofu-smp";
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <0>;
+		};
+
+		cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <1>;
+		};
+	};
+
+	/* 128 MiB DDR3; the low 5 MiB below 0x80500000 are not system DRAM */
+	memory@80500000 {
+		device_type = "memory";
+		reg = <0x80500000 0x7b00000>;
+	};
+
+	/*
+	 * Stock loader hand-off window: the ATAG is staged at
+	 * 0x80600000 + atag-offset.  The loader requires this node and the
+	 * console alias above to complete its pre-kernel staging.
+	 */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		flashinfo@80600000 {
+			compatible = "hsan,flashinfo_reserved";
+			reg = <0x80600000 0x4000>;
+			atag-offset = <0x1000>;
+		};
+	};
+
+	/* measured fixed input clocks of the CRG tree */
+	osc: oscillator {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <20000000>;
+		clock-output-names = "osc";
+	};
+
+	ahb_clk: clock-ahb {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+		clock-output-names = "ahb_clk";
+	};
+
+	apb_clk: clock-apb {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+		clock-output-names = "apb_clk";
+	};
+
+	gemacn_clk: clock-gemacn {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <125000000>;
+		clock-output-names = "gemacN_clk";
+	};
+
+	lsw_dp_clk: clock-lsw-dp {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166000000>;
+		clock-output-names = "lsw_dp_clk";
+	};
+
+	lsw_pfe_clk: clock-lsw-pfe {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <333000000>;
+		clock-output-names = "lsw_pfe_clk";
+	};
+
+	efuse_ring_clk: clock-efuse-ring {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <20000000>;
+		clock-output-names = "efuse_ring_clk";
+	};
+
+	corrector_clk: clock-corrector {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <1000000000>;
+		clock-output-names = "corrector_clk";
+	};
+
+	twd_clk: clock-twd {
+		compatible = "fixed-factor-clock";
+		#clock-cells = <0>;
+		clocks = <&corrector_clk>;
+		clock-div = <4>;
+		clock-mult = <1>;
+		clock-output-names = "twd_clk";
+	};
+
+	sysctrl: system-controller@10100000 {
+		compatible = "hisilicon,luofu-sysctrl", "syscon";
+		reg = <0x10100000 0x1000>;
+	};
+
+	reboot {
+		compatible = "hisilicon,luofu-reboot";
+		hisilicon,sysctrl = <&sysctrl>;
+		hisilicon,crg = <&crg>;
+	};
+
+	/* A/B boot selector cell: 0x10 = A pair, 0x11 = B pair (measured) */
+	boot-selector {
+		compatible = "hisilicon,luofu-boot-selector";
+		hisilicon,sysctrl = <&sysctrl>;
+		hisilicon,selector-offset = <0x0c08>;
+	};
+
+	/*
+	 * CRG clock/reset controller.  The 4 KiB page also carries the
+	 * watchdog registers, so it is a shared syscon/simple-mfd and the
+	 * watchdog is a child using the parent regmap.
+	 */
+	crg: system-controller@14880000 {
+		compatible = "hisilicon,luofu-crg", "syscon", "simple-mfd";
+		reg = <0x14880000 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <2>;
+		clocks = <&osc>, <&ahb_clk>, <&apb_clk>, <&gemacn_clk>,
+			 <&lsw_dp_clk>, <&lsw_pfe_clk>, <&efuse_ring_clk>;
+		clock-names = "osc", "ahb", "apb", "gemacN", "lsw_dp",
+			      "lsw_pfe", "efuse_ring";
+
+		watchdog {
+			compatible = "hisilicon,luofu-wdt";
+			timeout-sec = <30>;
+		};
+	};
+
+	gic: interrupt-controller@10181000 {
+		compatible = "arm,cortex-a9-gic";
+		#interrupt-cells = <3>;
+		interrupt-controller;
+		reg = <0x10181000 0x1000>,
+		      <0x10180100 0x100>;
+	};
+
+	scu@10180000 {
+		compatible = "arm,cortex-a9-scu";
+		reg = <0x10180000 0x1000>;
+	};
+
+	l2_cache: l2-cache@7f000000 {
+		compatible = "arm,pl310-cache";
+		reg = <0x7f000000 0x1000>;
+		cache-level = <2>;
+		cache-unified;
+	};
+
+	local_timer: timer@10180600 {
+		compatible = "arm,cortex-a9-twd-timer";
+		reg = <0x10180600 0x20>;
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) |
+					 IRQ_TYPE_EDGE_RISING)>;
+		clocks = <&twd_clk>;
+	};
+
+	uart0: serial@1010e000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0x1010e000 0x1000>;
+		reg-shift = <2>;
+		interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&apb_clk>;
+		clock-names = "apb_pclk";
+		status = "disabled";
+	};
+
+	uart1: serial@1010f000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0x1010f000 0x1000>;
+		reg-shift = <2>;
+		interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&apb_clk>;
+		clock-names = "apb_pclk";
+	};
+
+	gpio0: gpio@10106000 {
+		compatible = "snps,dw-apb-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x10106000 0x1000>;
+		clocks = <&crg LUOFU_CLK_GPIO0>;
+
+		porta: gpio-port@0 {
+			compatible = "snps,dw-apb-gpio-port";
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&gic>;
+			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0>;
+			snps,nr-gpios = <32>;
+		};
+	};
+
+	gpio1: gpio@10107000 {
+		compatible = "snps,dw-apb-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x10107000 0x1000>;
+		clocks = <&crg LUOFU_CLK_GPIO1>;
+
+		portb: gpio-port@0 {
+			compatible = "snps,dw-apb-gpio-port";
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&gic>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0>;
+			snps,nr-gpios = <5>;
+		};
+	};
+
+	/* stock board_id=3 overlay: reset and WPS keys, active-low, 20 ms poll */
+	gpio-keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <20>;
+
+		key-reset {
+			label = "reset";
+			gpios = <&porta 22 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		key-wps {
+			label = "wps";
+			gpios = <&porta 23 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+		};
+	};
+
+	/* stock board_id=3 overlay: six green LEDs, active-low */
+	gpio-leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			label = "oem:green:status";
+			gpios = <&porta 24 GPIO_ACTIVE_LOW>;
+		};
+
+		led-1 {
+			label = "oem:green:wan";
+			gpios = <&porta 25 GPIO_ACTIVE_LOW>;
+		};
+
+		led-2 {
+			label = "oem:green:lan";
+			gpios = <&porta 3 GPIO_ACTIVE_LOW>;
+		};
+
+		led-3 {
+			label = "oem:green:internet";
+			gpios = <&porta 2 GPIO_ACTIVE_LOW>;
+		};
+
+		led-4 {
+			label = "oem:green:wifi";
+			gpios = <&porta 0 GPIO_ACTIVE_LOW>;
+		};
+
+		led-5 {
+			label = "oem:green:wifi5g";
+			gpios = <&porta 1 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	i2c0: i2c@10111000 {
+		compatible = "snps,designware-i2c";
+		reg = <0x10111000 0x1000>;
+		interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&crg LUOFU_CLK_I2C0>;
+		clock-frequency = <100000>;
+		status = "disabled";
+	};
+
+	pinctrl_peri: pinctrl@14900100 {
+		compatible = "hisilicon,luofu-pinctrl";
+		reg = <0x14900100 0x3c>,
+		      <0x14940000 0x100>;
+		reg-names = "mux", "cfg";
+	};
+
+	fmc: spi@10a20000 {
+		compatible = "hisilicon,luofu-fmc";
+		reg = <0x10a20000 0x1000>,
+		      <0x1c000000 0x100000>;
+		reg-names = "regs", "window";
+		clocks = <&crg LUOFU_CLK_SFC>;
+		clock-names = "sfc_clk";
+		resets = <&crg 0x2c 0x0>;
+		reset-names = "sfc_rst";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		flash@1 {
+			compatible = "spi-nand";
+			reg = <1>;
+			spi-max-frequency = <50000000>;
+			spi-tx-bus-width = <4>;
+			spi-rx-bus-width = <4>;
+
+			/* stock 128 MiB A/B partition map, verbatim from the vendor base DTB */
+			partitions {
+				compatible = "fixed-partitions";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				partition@0 {
+					label = "esbc";
+					reg = <0x0 0x40000>;
+				};
+				partition@40000 {
+					label = "uboota";
+					reg = <0x40000 0x100000>;
+				};
+				partition@140000 {
+					label = "ubootb";
+					reg = <0x140000 0x100000>;
+				};
+				partition@240000 {
+					label = "enva";
+					reg = <0x240000 0x40000>;
+				};
+				partition@280000 {
+					label = "envb";
+					reg = <0x280000 0x40000>;
+				};
+				partition@2c0000 {
+					label = "fac";
+					reg = <0x2c0000 0x200000>;
+				};
+				partition@4c0000 {
+					label = "bdinfo";
+					reg = <0x4c0000 0x40000>;
+					read-only;
+
+					nvmem-layout {
+						compatible = "fixed-layout";
+						#address-cells = <1>;
+						#size-cells = <1>;
+
+						bdinfo_mac: mac@de00 {
+							compatible = "mac-base";
+							reg = <0xde00 0x6>;
+							#nvmem-cell-cells = <1>;
+						};
+					};
+				};
+				partition@500000 {
+					label = "cfga";
+					reg = <0x500000 0x200000>;
+				};
+				partition@700000 {
+					label = "cfgb";
+					reg = <0x700000 0x200000>;
+				};
+				partition@900000 {
+					label = "log";
+					reg = <0x900000 0x440000>;
+				};
+				partition@d40000 {
+					label = "pstore";
+					reg = <0xd40000 0x40000>;
+				};
+				partition@d80000 {
+					label = "kernela";
+					reg = <0xd80000 0x840000>;
+				};
+				partition@15c0000 {
+					label = "kernelb";
+					reg = <0x15c0000 0x840000>;
+				};
+				partition@1e00000 {
+					label = "rootfsa";
+					reg = <0x1e00000 0x1740000>;
+				};
+				partition@3540000 {
+					label = "rootfsb";
+					reg = <0x3540000 0x1740000>;
+				};
+				partition@4c80000 {
+					label = "rootfs_data";
+					reg = <0x4c80000 0x1600000>;
+				};
+				partition@6280000 {
+					label = "upgrade";
+					reg = <0x6280000 0x1d80000>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * Internal LSW switch.  The binding's reg-names order puts the two
+	 * engine DDR regions first, so the node's unit address is the queue
+	 * region; the 15 MMIO windows follow.  The DDR regions are validated but
+	 * never mapped by Linux.
+	 */
+	lsw: ethernet-switch@80000000 {
+		compatible = "hisilicon,luofu-switch";
+		reg = <0x80000000 0x400000>,
+		      <0x80400000 0x100000>,
+		      <0x11000000 0x80000>,
+		      <0x11080000 0x80000>,
+		      <0x11100000 0x80000>,
+		      <0x11180000 0x80000>,
+		      <0x11200000 0x80000>,
+		      <0x11280000 0x80000>,
+		      <0x11380000 0x80000>,
+		      <0x12000000 0x80000>,
+		      <0x12080000 0x80000>,
+		      <0x12100000 0x80000>,
+		      <0x12180000 0x80000>,
+		      <0x12280000 0x80000>,
+		      <0x12380000 0x80000>,
+		      <0x12400000 0x80000>,
+		      <0x12480000 0x80000>;
+		reg-names = "queue", "flow", "dp", "ips", "fam", "pe", "eqm",
+			    "eps", "prbs", "pfe_glb", "pa", "ifc", "l2", "napt",
+			    "mcc", "opp", "pub";
+		clocks = <&crg LUOFU_CLK_LSW_DP>, <&crg LUOFU_CLK_LSW_PFE>;
+		clock-names = "lsw_dp_clk", "lsw_pfe_clk";
+		resets = <&crg 0x30 0x0>, <&crg 0x30 0x1>,
+			 <&crg 0x30 0x3>, <&crg 0x30 0x4>;
+		reset-names = "dp_logic", "dp_srst", "pfe_logic", "pfe_srst";
+		hisilicon,crg = <&crg>;
+		hisilicon,port-bitmap = <0xf01 0x1ff0>;
+
+		ethernet-ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ethernet-port@0 {
+				reg = <0>;
+				hisilicon,port = <9>;
+				ethernet = <&gmac1>;
+			};
+
+			ethernet-port@1 {
+				reg = <1>;
+				hisilicon,port = <10>;
+				ethernet = <&gmac2>;
+			};
+
+			ethernet-port@2 {
+				reg = <2>;
+				hisilicon,port = <11>;
+				ethernet = <&gmac3>;
+			};
+
+			ethernet-port@3 {
+				reg = <3>;
+				hisilicon,port = <12>;
+				ethernet = <&gmac4>;
+			};
+		};
+	};
+
+	packet-engine@10a70000 {
+		compatible = "hisilicon,luofu-pie";
+		reg = <0x10a70000 0x10000>;
+		interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "ch0-7", "ch1-6", "ch2-5", "ch3-4";
+		clocks = <&crg LUOFU_CLK_PIE>;
+		resets = <&crg 0x30 0x19>;
+		dma-coherent;
+		/* measured live board ring configuration */
+		hisilicon,rx-ring = <0x8 0x600 0x8 0x600>;
+		hisilicon,tx-ring = <0xc 0x2>;
+	};
+
+	gmac0: ethernet@14300000 {
+		compatible = "hisilicon,luofu-gmac";
+		reg = <0x14300000 0x10000>;
+		hisilicon,port = <0x8>;
+		phy-mode = "rgmii";
+		phy-handle = <&phy2>;
+		clocks = <&crg LUOFU_CLK_GMAC0>;
+		resets = <&crg 0x30 0xd>, <&crg 0x30 0xe>;
+		reset-names = "mac-logic", "mac";
+		status = "disabled";
+	};
+
+	gmac1: ethernet@14380000 {
+		compatible = "hisilicon,luofu-gmac";
+		reg = <0x14380000 0x10000>;
+		hisilicon,port = <0x9>;
+		phy-mode = "gmii";
+		phy-handle = <&phy2>;
+		nvmem-cells = <&bdinfo_mac 0>;
+		nvmem-cell-names = "mac-address";
+		clocks = <&crg LUOFU_CLK_GMAC1>;
+		resets = <&crg 0x30 0xf>, <&crg 0x30 0x10>;
+		reset-names = "mac-logic", "mac";
+	};
+
+	gmac2: ethernet@14400000 {
+		compatible = "hisilicon,luofu-gmac";
+		reg = <0x14400000 0x10000>;
+		hisilicon,port = <0xa>;
+		phy-mode = "gmii";
+		phy-handle = <&phy3>;
+		nvmem-cells = <&bdinfo_mac 0>;
+		nvmem-cell-names = "mac-address";
+		clocks = <&crg LUOFU_CLK_GMAC2>;
+		resets = <&crg 0x30 0x11>, <&crg 0x30 0x12>;
+		reset-names = "mac-logic", "mac";
+	};
+
+	gmac3: ethernet@14480000 {
+		compatible = "hisilicon,luofu-gmac";
+		reg = <0x14480000 0x10000>;
+		hisilicon,port = <0xb>;
+		phy-mode = "gmii";
+		phy-handle = <&phy4>;
+		nvmem-cells = <&bdinfo_mac 0>;
+		nvmem-cell-names = "mac-address";
+		clocks = <&crg LUOFU_CLK_GMAC3>;
+		resets = <&crg 0x30 0x13>, <&crg 0x30 0x14>;
+		reset-names = "mac-logic", "mac";
+	};
+
+	gmac4: ethernet@14500000 {
+		compatible = "hisilicon,luofu-gmac";
+		reg = <0x14500000 0x10000>;
+		hisilicon,port = <0xc>;
+		phy-mode = "gmii";
+		phy-handle = <&phy5>;
+		nvmem-cells = <&bdinfo_mac 1>;
+		nvmem-cell-names = "mac-address";
+		clocks = <&crg LUOFU_CLK_GMAC4>;
+		resets = <&crg 0x30 0x15>, <&crg 0x30 0x16>;
+		reset-names = "mac-logic", "mac";
+	};
+
+	mdio0: mdio@14000000 {
+		compatible = "hisilicon,luofu-mdio";
+		reg = <0x14000000 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clocks = <&crg LUOFU_CLK_MDIO>;
+		resets = <&crg 0x30 0x6>,
+			 <&crg 0x30 0x1a>,
+			 <&crg 0x30 0x1b>,
+			 <&crg 0x30 0x1c>,
+			 <&crg 0x30 0x1d>,
+			 <&crg 0x30 0x1e>,
+			 <&crg 0x30 0x1f>;
+		reset-names = "mdio", "gephyall", "gephy0", "gephy1",
+			      "gephy2", "gephy3", "gephy4";
+
+		phy2: ethernet-phy@2 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <2>;
+			max-speed = <1000>;
+		};
+
+		phy3: ethernet-phy@3 {
+			compatible = "ethernet-phy-ieee802.3-c22";
