diff --git a/hi5622_dfs160.c b/hi5622_dfs160.c
new file mode 100644
index 0000000..b2c2d9e
--- /dev/null
+++ b/hi5622_dfs160.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_dfs160.c - 5 GHz 160 MHz width selector + DFS/CAC/NOL model
+ * (lane dfs160 / shared task task-240, 2026-11-26).  Clean-room, portable
+ * C99: the same file compiles in the 6.18.60 kernel module and in the host
+ * selftest.  Constants are decoded protocol facts (see the header and
+ * ../wifi-5g-160-dfs/TABLES.md); no vendor source/object/firmware bytes.
+ */
+#include "hi5622_dfs160.h"
+
+#ifdef __KERNEL__
+#include <linux/kernel.h>
+#include <linux/string.h>
+#else
+#include <stdio.h>
+#include <string.h>
+#endif
+
+/* ===================================================================
+ * 1. 160 MHz width selector
+ * =================================================================== */
+
+int hi5622_dfs160_width_selector(u32 width, u8 *sel)
+{
+	u8 out;
+
+	switch (width) {
+	case HI5622_DFS160_WIDTH_20NOHT:
+	case HI5622_DFS160_WIDTH_20:
+		out = HI5622_DFS160_BW_20;
+		break;
+	case HI5622_DFS160_WIDTH_40:
+		out = HI5622_DFS160_BW_40;
+		break;
+	case HI5622_DFS160_WIDTH_80:
+		out = HI5622_DFS160_BW_80;
+		break;
+	case HI5622_DFS160_WIDTH_160:
+		out = HI5622_DFS160_BW_160;
+		break;
+	case HI5622_DFS160_WIDTH_80P80:
+	case HI5622_DFS160_WIDTH_320:
+		/* The vendor wiphy VHT cap 0x00400064 has the 160 MHz bit but
+		 * neither the 160+80+80 nor the 320 MHz bit: refuse instead of
+		 * pretending a width the firmware cannot select. */
+		return -EOPNOTSUPP;
+	default:
+		return -EINVAL;
+	}
+	if (!sel)
+		return -EINVAL;
+	*sel = out;
+	return 0;
+}
+
+int hi5622_dfs160_ccfs1_160(u8 channel, u32 *ccfs1)
+{
+	u32 out;
+
+	if (channel >= 36u && channel <= 64u)
+		out = 50u;		/* 36-64 @ 5250 MHz */
+	else if (channel >= 100u && channel <= 128u)
+		out = 114u;		/* 100-128 @ 5570 MHz */
+	else if (channel >= 149u && channel <= 177u)
+		out = 163u;		/* 149-177 @ 5815 MHz */
+	else
+		return -EOPNOTSUPP;
+	if (!ccfs1)
+		return -EINVAL;
+	*ccfs1 = out;
+	return 0;
+}
+
+int hi5622_dfs160_ccfs1_80(u8 channel, u32 *ccfs1)
+{
+	u32 out;
+
+	if (channel >= 36u && channel <= 48u)
+		out = 42u;
+	else if (channel >= 52u && channel <= 64u)
+		out = 58u;
+	else if (channel >= 100u && channel <= 112u)
+		out = 106u;
+	else if (channel >= 116u && channel <= 128u)
+		out = 122u;
+	else if (channel >= 132u && channel <= 144u)
+		out = 138u;
+	else if (channel >= 149u && channel <= 161u)
+		out = 155u;
+	else if (channel >= 165u && channel <= 177u)
+		out = 171u;
+	else
+		return -EOPNOTSUPP;
+	if (!ccfs1)
+		return -EINVAL;
+	*ccfs1 = out;
+	return 0;
+}
+
+int hi5622_dfs160_width_check(u32 width, u8 channel, u32 ccfs1, u32 ccfs2)
+{
+	u8 sel = HI5622_DFS160_BW_LEGACY;
+	u32 want = 0u;
+	int rc;
+
+	if (!channel)
+		return -EINVAL;
+	rc = hi5622_dfs160_width_selector(width, &sel);
+	if (rc)
+		return rc;	/* 80+80/320 are refused before any centre logic */
+	if (ccfs2)
+		return -EINVAL;	/* no 80+80 support: CCFS2 must be 0 */
+	switch (sel) {
+	case HI5622_DFS160_BW_20:
+		break;		/* no centre required */
+	case HI5622_DFS160_BW_40:
+		/* 40 MHz CCFS1 is optional in cfg80211; accept 0 or the
+		 * derived centre when the channel is in a 40 MHz segment.
+		 * The exact 40 MHz centre check is left to cfg80211. */
+		break;
+	case HI5622_DFS160_BW_80:
+		rc = hi5622_dfs160_ccfs1_80(channel, &want);
+		if (rc)
+			return rc;
+		if (ccfs1 && ccfs1 != want)
+			return -EINVAL;
+		break;
+	case HI5622_DFS160_BW_160:
+		rc = hi5622_dfs160_ccfs1_160(channel, &want);
+		if (rc)
+			return rc;
+		if (ccfs1 != want)
+			return -EINVAL;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+/* ===================================================================
+ * 2. DFS channel set / hours
+ * =================================================================== */
+
+int hi5622_dfs160_chan_freq(u8 channel, u16 *mhz)
+{
+	u16 f;
+
+	if (!channel)
+		return -EINVAL;
+	if (channel == 14u)
+		f = 2484u;
+	else if (channel >= 1u && channel <= 13u)
+		f = (u16)(2407u + 5u * channel);
+	else if (channel == 144u)
+		f = 5720u;
+	else if (channel >= 184u && channel <= 196u)
+		f = (u16)(4000u + 5u * channel);	/* 4920..4980 */
+	else if ((channel >= 36u && channel <= 64u) ||
+		 (channel >= 100u && channel <= 140u) ||
+		 (channel >= 149u && channel <= 165u))
+		f = (u16)(5000u + 5u * channel);
+	else
+		return -EINVAL;
+	if (mhz)
+		*mhz = f;
+	return 0;
+}
+
+int hi5622_dfs160_is_dfs_chan(u8 channel)
+{
+	/* The vendor band-1 table CA 0x117AD4 DFS channels: 52-64 and 100-144.
+	 * ch144 is the "ch144 gap" of our current wiphy list (hi5622_cfg80211.c
+	 * advertises 52-64/100-140 only) and is restored by this lane. */
+	return (channel >= 52u && channel <= 64u) ||
+	       (channel >= 100u && channel <= 144u);
+}
+
+int hi5622_dfs160_is_tdwr_chan(u8 channel)
+{
+	return channel >= 100u && channel <= 128u;
+}
+
+int hi5622_dfs160_is_tdwr_center(u16 center_freq)
+{
+	return center_freq >= 5600u && center_freq <= 5650u;
+}
+
+/* ===================================================================
+ * 3. CAC / NOL timing and state machine
+ * =================================================================== */
+
+int hi5622_dfs160_cac_plan(u8 channel, u16 center_freq, u32 requested_ms,
+			   struct hi5622_dfs160_cac_plan *out)
+{
+	u32 cac_ms;
+
+	if (!out || !channel)
+		return -EINVAL;
+	if (!hi5622_dfs160_is_dfs_chan(channel))
+		return -EOPNOTSUPP;
+	if (!center_freq) {
+		u16 f;
+
+		if (hi5622_dfs160_chan_freq(channel, &f))
+			return -EINVAL;
+		center_freq = f;
+	}
+	memset(out, 0, sizeof(*out));
+	out->channel = channel;
+	if (hi5622_dfs160_is_tdwr_center(center_freq) ||
+	    hi5622_dfs160_is_tdwr_chan(channel))
+		out->tdwr = 1u;
+	cac_ms = out->tdwr ? HI5622_DFS160_CAC_MS_TDWR
+			   : HI5622_DFS160_CAC_MS_DEFAULT;
+	if (requested_ms > cac_ms)
+		cac_ms = requested_ms;	/* hostapd may ask for longer */
+	out->cac_ms = cac_ms;
+	/* The vendor tick arithmetic (hmac_dfs_cac_start): CAC > 59999 ms
+	 * uses a 63000 ms first timer and max = cac_ms/60000 ticks; the
+	 * short path registers one 60000 ms timer.  We always take the
+	 * 63000 ms first timer so the cfg80211 CAC_FINISHED jiffies check
+	 * (start_time + cac_time_ms) can never fire early. */
+	out->first_ms = HI5622_DFS160_CAC_FIRST_MS;
+	out->tick_ms = HI5622_DFS160_CAC_TICK_MS;
+	out->ticks = cac_ms > 59999u ? cac_ms / 60000u : 1u;
+	if (!out->ticks)
+		out->ticks = 1u;
+	out->nol_ms = HI5622_DFS160_NOL_MS;
+	return 0;
+}
+
+void hi5622_dfs160_cac_init(struct hi5622_dfs160_cac *st)
+{
+	if (!st)
+		return;
+	memset(st, 0, sizeof(*st));
+	st->state = HI5622_DFS160_CAC_OFF;
+	st->radar_type = 0xffu;
+}
+
+int hi5622_dfs160_cac_begin(struct hi5622_dfs160_cac *st, u8 channel,
+			    u16 center_freq, u32 requested_ms)
+{
+	struct hi5622_dfs160_cac_plan plan;
+	int rc;
+
+	if (!st)
+		return -EINVAL;
+	if (st->state == HI5622_DFS160_CAC_ARMED)
+		return -EALREADY;
+	rc = hi5622_dfs160_cac_plan(channel, center_freq, requested_ms, &plan);
+	if (rc)
+		return rc;
+	st->channel = channel;
+	st->center_freq = center_freq;
+	st->tdwr = plan.tdwr;
+	st->cac_ms = plan.cac_ms;
+	st->first_ms = plan.first_ms;
+	st->tick_ms = plan.tick_ms;
+	st->ticks = plan.ticks;
+	st->ticks_done = 0u;
+	st->nol_ms = plan.nol_ms;
+	st->nol_end_ms = 0u;
+	st->radar_type = 0xffu;
+	st->plan = plan;
+	st->state = HI5622_DFS160_CAC_ARMED;
+	return 0;
+}
+
+u32 hi5622_dfs160_cac_delay_ms(const struct hi5622_dfs160_cac *st)
+{
+	if (!st || st->state != HI5622_DFS160_CAC_ARMED)
+		return 0u;
+	if (st->ticks_done >= st->ticks)
+		return 0u;	/* the FINISH tick: no re-arm */
+	return st->ticks_done ? st->tick_ms : st->first_ms;
+}
+
+enum hi5622_dfs160_cac_step
+hi5622_dfs160_cac_tick(struct hi5622_dfs160_cac *st)
+{
+	if (!st || st->state != HI5622_DFS160_CAC_ARMED)
+		return HI5622_DFS160_STEP_IDLE;
+	st->ticks_done++;
+	if (st->ticks_done >= st->ticks)
+		return HI5622_DFS160_STEP_FINISH;
+	return HI5622_DFS160_STEP_REARM;
+}
+
+void hi5622_dfs160_cac_finish(struct hi5622_dfs160_cac *st)
+{
+	if (!st)
+		return;
+	st->state = HI5622_DFS160_CAC_FINISHED;
+}
+
+void hi5622_dfs160_cac_abort(struct hi5622_dfs160_cac *st)
+{
+	if (!st)
+		return;
+	st->state = HI5622_DFS160_CAC_ABORTED;
+	st->ticks_done = 0u;
+}
+
+int hi5622_dfs160_cac_radar(struct hi5622_dfs160_cac *st, u8 type, u32 now_ms)
+{
+	if (!st)
+		return -EINVAL;
+	if (type > 8u)
+		return -EINVAL;	/* the vendor counts radar types 0..8 */
+	st->radar_type = type;
+	st->radar_count++;
+	st->state = HI5622_DFS160_CAC_ABORTED;
+	st->nol_end_ms = now_ms + st->nol_ms;
+	return 0;
+}
+
+int hi5622_dfs160_nol_active(const struct hi5622_dfs160_cac *st, u32 now_ms)
+{
+	if (!st || !st->nol_end_ms)
+		return 0;
+	/* Wrapping-safe subtraction on the caller's monotonic clock. */
+	return (int32_t)(st->nol_end_ms - now_ms) > 0;
+}
+
+int hi5622_dfs160_cac_ap_gate(const struct hi5622_dfs160_cac *st, u8 channel,
+			      u16 center_freq, u32 now_ms)
+{
+	u16 want = 0u;
+
+	if (!st || !channel)
+		return -EINVAL;
+	if (!hi5622_dfs160_is_dfs_chan(channel))
+		return 0;	/* non-DFS channel: the gate does not apply */
+	if (hi5622_dfs160_chan_freq(channel, &want) || !want)
+		return -EINVAL;
+	if (center_freq && center_freq != want)
+		return -EINVAL;
+	if (st->state != HI5622_DFS160_CAC_FINISHED)
+		return -EAGAIN;
+	if (st->channel != channel)
+		return -EAGAIN;
+	if (hi5622_dfs160_nol_active(st, now_ms))
+		return -EAGAIN;
+	return 0;
+}
+
+const char *hi5622_dfs160_cac_state_name(u8 state)
+{
+	switch (state) {
+	case HI5622_DFS160_CAC_OFF:		return "off";
+	case HI5622_DFS160_CAC_ARMED:		return "armed";
+	case HI5622_DFS160_CAC_FINISHED:	return "finished";
+	case HI5622_DFS160_CAC_ABORTED:		return "aborted";
+	default:				return "?";
+	}
+}
+
+int hi5622_dfs160_status_line(unsigned int ht_bw, unsigned int dfs_cac,
+			      const struct hi5622_dfs160_cac *st,
+			      int last_rc, unsigned int arms,
+			      unsigned int finishes, unsigned int aborts,
+			      unsigned int refusals, char *buf, size_t len)
+{
+	int n;
+
+	if (!buf || !len)
+		return -EINVAL;
+	n = snprintf(buf, len,
+		     "dfs_cac: ht_bw=%u (%s) dfs_cac=%u (%s) state=%s channel=%u cac_ms=%u ticks=%u/%u nol_ms=%u nol_active=%u radar=%u arms=%u finishes=%u aborts=%u refusals=%u last_rc=%d\n",
+		     ht_bw, ht_bw ? "0x0124 width selector" : "off",
+		     dfs_cac, dfs_cac ? "cfg80211 CAC op" : "off",
+		     st ? hi5622_dfs160_cac_state_name(st->state) : "?",
+		     st ? st->channel : 0u,
+		     st ? st->cac_ms : 0u,
+		     st ? st->ticks_done : 0u, st ? st->ticks : 0u,
+		     st ? st->nol_ms : 0u,
+		     st ? (unsigned int)(st->nol_end_ms ? 1u : 0u) : 0u,
+		     st ? st->radar_type : 0xffu,
+		     arms, finishes, aborts, refusals, last_rc);
+	if (n < 0)
+		return -EINVAL;
+	return (size_t)n < len ? n : (int)(len - 1u);
+}
diff --git a/hi5622_dfs160.h b/hi5622_dfs160.h
new file mode 100644
index 0000000..9ae1387
--- /dev/null
+++ b/hi5622_dfs160.h
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_dfs160.h - 5 GHz 160 MHz width selector + DFS/CAC/NOL model for the
+ * Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane dfs160 / shared task task-240, 2026-11-26).
+ * No vendor source, object code or firmware byte is reproduced; every
+ * constant is a decoded protocol fact from the committed decode lanes
+ * ../wifi-5g-160-dfs/ (TABLES T2/T4/T5/T7/T8), ../wifi-5g-dfs-set/
+ * (0x07E7 frame/worker) and ../wifi-5g-cac-context/ (+0x4A0 writer), with
+ * the grade markers kept in that lane's TABLES.md.
+ *
+ * WHAT THIS MODULE DECIDES (pure C99, host-testable):
+ *   1. the 160 MHz WIDTH SELECTOR: the H2D g0-id1 key 0x0124 channel-config
+ *      body is {band, bandwidth, channel, 0}; byte[1] is the vendor bandwidth
+ *      selector (0=20M, 1=40M, 2=80M, 3=160M, the value the firmware worker
+ *      CA 0x841B8 stores at module ctx+0x12 and the band-1 RF branch
+ *      CA 0x40684 feeds to CA 0x101890's descriptor selector).  The
+ *      cfg80211 chandef width maps onto that selector; 80+80 and 320 MHz are
+ *      refused because the vendor wiphy VHT cap 0x00400064 has neither bit.
+ *      The 160 MHz centre (CCFS1) is checked against the IEEE channelisation
+ *      (36-64 -> 50, 100-128 -> 114, 149-177 -> 163).
+ *   2. the DFS CHANNEL SET: 52-64 and 100-144 (the vendor band-1 table
+ *      CA 0x117AD4's DFS channels, including the ch144 entry our channel
+ *      list is missing - "the ch144 gap") and the 5600..5650 MHz TDWR
+ *      window (ch 100-128) that carries the 600000 ms CAC time.
+ *   3. the CAC/NOL TIMING state machine (the HOST-side hmac_dfs_* machinery):
+ *      CAC 60000 ms default / 600000 ms TDWR, the vendor tick arithmetic
+ *      (first timer 63000 ms, then 60000 ms per tick, ticks = cac_ms/60000)
+ *      and the 1800000 ms (30 min) non-occupancy period.  No vendor bytes
+ *      are decoded here; the timing constants are the committed TABLES T4
+ *      values, and the 0x07E7 ARM/CLEAR frame itself is built by the
+ *      sibling hi5622_dfs_set.c (lane wifi-5g-dfs-set).
+ *
+ * The kernel-side wire state machine and the cfg80211 radar-detect ops live
+ * in hi5622_dfs_cac.c (src/); this header is portable so the host selftest
+ * (src/dfs160_selftest.c) exercises every decision without a device.
+ */
+#ifndef HI5622_DFS160_H
+#define HI5622_DFS160_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/stddef.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+/* ===================================================================
+ * 1. The 160 MHz width selector (0x0124 body[1])
+ * =================================================================== */
+
+/* nl80211_chan_width UAPI values (linux/nl80211.h, stable ABI). */
+#define HI5622_DFS160_WIDTH_20NOHT	0u
+#define HI5622_DFS160_WIDTH_20		1u
+#define HI5622_DFS160_WIDTH_40		2u
+#define HI5622_DFS160_WIDTH_80		3u
+#define HI5622_DFS160_WIDTH_160		4u
+#define HI5622_DFS160_WIDTH_80P80	5u
+#define HI5622_DFS160_WIDTH_320		6u
+
+/* The vendor bandwidth selector written to 0x0124 body[1] [V for 0; I 1..3
+ * from the HAL channel-assemble enum order; PROBES P-160a decides 3]. */
+#define HI5622_DFS160_BW_20		0u
+#define HI5622_DFS160_BW_40		1u
+#define HI5622_DFS160_BW_80		2u
+#define HI5622_DFS160_BW_160		3u
+#define HI5622_DFS160_BW_MAX		3u
+/* Sentinel for the legacy path: body[1] keeps the old vap_id byte (the
+ * bench-validated F2/first fire wire bytes are byte-identical then). */
+#define HI5622_DFS160_BW_LEGACY		0xffu
+
+/* Map a cfg80211 chandef width onto the vendor selector.
+ *  0 on success (sel in 0..3);
+ * -EOPNOTSUPP for 80+80 and 320 MHz (the vendor cap has neither bit);
+ * -EINVAL     for NULL/unknown widths. */
+int hi5622_dfs160_width_selector(u32 width, u8 *sel);
+
+/* 160 MHz single-segment CCFS1 (IEEE channelisation [I, IEEE]).
+ * 36-64 -> 50 (5250), 100-128 -> 114 (5570), 149-177 -> 163 (5815).
+ * 0 on success; -EOPNOTSUPP when the channel is not in a 160 MHz segment. */
+int hi5622_dfs160_ccfs1_160(u8 channel, u32 *ccfs1);
+
+/* 80 MHz CCFS1 for the fail-closed 80 MHz centre check: 36-48->42,
+ * 52-64->58, 100-112->106, 116-128->122, 132-144->138, 149-161->155,
+ * 165-177->171.  0 on success; -EOPNOTSUPP outside the 80 MHz segments. */
+int hi5622_dfs160_ccfs1_80(u8 channel, u32 *ccfs1);
+
+/* Full fail-closed start_ap chandef check for the ht_bw=1 path.
+ * Validates the selector width, the centre-frequency arguments and, on
+ * 160 MHz, that ccfs1 is the segment centre and ccfs2 == 0.  Returns 0/-errno.
+ * (cfg80211 validates the chandef first; this is the driver-side belt.) */
+int hi5622_dfs160_width_check(u32 width, u8 channel, u32 ccfs1, u32 ccfs2);
+
+/* ===================================================================
+ * 2. The DFS channel set (the ch144 gap)
+ * =================================================================== */
+
+/* IEEE channel number -> centre frequency in MHz (only the 29 vendor
+ * band-1 channels are known; 0 on success, -EINVAL otherwise). */
+int hi5622_dfs160_chan_freq(u8 channel, u16 *mhz);
+
+/* 1 = the vendor band-1 table channel is a DFS channel (52-64, 100-144). */
+int hi5622_dfs160_is_dfs_chan(u8 channel);
+
+/* 1 = the channel is in the 5600..5650 MHz TDWR window (ch 100-128) - the
+ * 600000 ms CAC time channel class (the vendor adds the 600 s CAC for
+ * frequency - 5600 <= 50). */
+int hi5622_dfs160_is_tdwr_chan(u8 channel);
+
+/* 1 = centre_freq is inside 5600..5650 MHz (the same TDWR rule on MHz). */
+int hi5622_dfs160_is_tdwr_center(u16 center_freq);
+
+/* ===================================================================
+ * 3. CAC / NOL timing and the host state machine
+ * =================================================================== */
+#define HI5622_DFS160_CAC_MS_DEFAULT	60000u		/* UNII-2/2e */
+#define HI5622_DFS160_CAC_MS_TDWR	600000u		/* 5600..5650 MHz */
+#define HI5622_DFS160_CAC_FIRST_MS	63000u		/* vendor first timer */
+#define HI5622_DFS160_CAC_TICK_MS	60000u		/* vendor re-arm tick */
+#define HI5622_DFS160_NOL_MS		1800000u	/* 30 min non-occupancy */
+#define HI5622_DFS160_CAC_MIN_MS	60000u
+
+/* One CAC plan (derived from the channel, the centre frequency and the
+ * cfg80211-provided cac_time_ms; the driver floor is the vendor value). */
+struct hi5622_dfs160_cac_plan {
+	u8	channel;
+	u8	tdwr;		/* 1 = the 560000..5650 window */
+	u32	cac_ms;		/* 60000 or 600000 (or a longer request) */
+	u32	first_ms;	/* 63000 */
+	u32	tick_ms;	/* 60000 */
+	u32	ticks;		/* cac_ms / 60000 (>= 1) */
+	u32	nol_ms;		/* 1800000 */
+};
+
+/* Fill *out for a DFS channel.  The driver floor wins: cac_ms >= 60000 and,
+ * in the TDWR window, >= 600000; a cfg80211 cac_time_ms above the floor is
+ * honoured (hostapd's own value).  Returns 0 or -EINVAL/-EOPNOTSUPP. */
+int hi5622_dfs160_cac_plan(u8 channel, u16 center_freq, u32 requested_ms,
+			   struct hi5622_dfs160_cac_plan *out);
+
+enum hi5622_dfs160_cac_state {
+	HI5622_DFS160_CAC_OFF = 0,	/* no CAC attempted / idle */
+	HI5622_DFS160_CAC_ARMED = 1,	/* 0x07E7{01} posted, timer running */
+	HI5622_DFS160_CAC_FINISHED = 2,	/* CAC complete, 0x07E7{00} posted */
+	HI5622_DFS160_CAC_ABORTED = 3,	/* end_cac / teardown */
+};
+
+struct hi5622_dfs160_cac {
+	u8	state;
+	u8	channel;
+	u8	tdwr;
+	u8	radar_type;	/* last radar type 0..8, 0xff = none */
+	u16	center_freq;
+	u32	cac_ms;
+	u32	first_ms;
+	u32	tick_ms;
+	u32	ticks;
+	u32	ticks_done;
+	u32	nol_ms;
+	u32	nol_end_ms;	/* 0 = no NOL */
+	u32	radar_count;
+	struct hi5622_dfs160_cac_plan plan;
+};
+
+void hi5622_dfs160_cac_init(struct hi5622_dfs160_cac *st);
+
+/* Begin CAC on a DFS channel (the state must be OFF/FINISHED/ABORTED).
+ *  0 ok; -EALREADY when already ARMED; -EINVAL bad args/not a DFS channel. */
+int hi5622_dfs160_cac_begin(struct hi5622_dfs160_cac *st, u8 channel,
+			    u16 center_freq, u32 requested_ms);
+
+/* The delay before the next timer callback: first_ms on the first tick,
+ * tick_ms afterwards.  0 when not ARMED. */
+u32 hi5622_dfs160_cac_delay_ms(const struct hi5622_dfs160_cac *st);
+
+enum hi5622_dfs160_cac_step {
+	HI5622_DFS160_STEP_REARM = 0,	/* timer must be re-armed */
+	HI5622_DFS160_STEP_FINISH = 1,	/* CAC complete: post 0x07E7{00} */
+	HI5622_DFS160_STEP_IDLE = 2,	/* not armed */
+};
+
+/* Advance one timer tick.  FINISH when ticks_done reached ticks. */
+enum hi5622_dfs160_cac_step hi5622_dfs160_cac_tick(struct hi5622_dfs160_cac *st);
+
+/* Terminal transitions (idempotent): FINISHED / ABORTED. */
+void hi5622_dfs160_cac_finish(struct hi5622_dfs160_cac *st);
+void hi5622_dfs160_cac_abort(struct hi5622_dfs160_cac *st);
+
+/* Radar detected: abort a running CAC (a radar hit during CAC invalidates
+ * it) and start the 30 min non-occupancy period.  type is the decoded
+ * radar type 0..8 (the vendor's per-type counters).  now_ms is the caller's
+ * monotonic clock (only used for the NOL end).  0/-EINVAL. */
+int hi5622_dfs160_cac_radar(struct hi5622_dfs160_cac *st, u8 type, u32 now_ms);
+
+/* 1 = the NOL for this channel is still running at now_ms. */
+int hi5622_dfs160_nol_active(const struct hi5622_dfs160_cac *st, u32 now_ms);
+
+/* start_ap gate: the CAC on (channel, center_freq) is finished and no NOL is
+ * running => 0; -EAGAIN otherwise (the AP must not beacon on an unchained
+ * DFS channel); -EINVAL bad args. */
+int hi5622_dfs160_cac_ap_gate(const struct hi5622_dfs160_cac *st, u8 channel,
+			      u16 center_freq, u32 now_ms);
+
+const char *hi5622_dfs160_cac_state_name(u8 state);
+
+/* One read-only sysfs status line (the driver appends it to cfg80211_status):
+ *   dfs_cac: param=N (...) bw=N state=... channel=... cac_ms=... nol_ms=...
+ *            ticks=... radar=... arms=P finishes=F aborts=A refusals=R last_rc=R
+ * Returns the length, clamped like the sibling status lines. */
+int hi5622_dfs160_status_line(unsigned int ht_bw, unsigned int dfs_cac,
+			      const struct hi5622_dfs160_cac *st,
+			      int last_rc, unsigned int arms,
+			      unsigned int finishes, unsigned int aborts,
+			      unsigned int refusals, char *buf, size_t len);
+
+#endif /* HI5622_DFS160_H */
diff --git a/hi5622_dfs_cac.c b/hi5622_dfs_cac.c
new file mode 100644
index 0000000..2e4b6d3
--- /dev/null
+++ b/hi5622_dfs_cac.c
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_dfs_cac.c - the kernel-side DFS/CAC runtime for the Hi5622V100
+ * clean-room full-MAC driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane dfs160 / shared task task-240, 2026-11-26).
+ * Wire facts: the H2D g0-id1 key 0x07E7 body {01}=ARM / {00}=CLEAR and the
+ * firmware worker CA 0xB58FC are the committed decode of
+ * ../wifi-5g-dfs-set (TABLES) and ../wifi-5g-cac-context; the CAC/NOL
+ * timings are the committed decode of ../wifi-5g-160-dfs/TABLES T4/T5.  No
+ * vendor source, object code or firmware byte is reproduced.
+ *
+ * The cfg80211 contract (net/wireless/nl80211.c + mlme.c, 6.18):
+ *   - start_radar_detection(...) returning 0 makes cfg80211 mark the wdev
+ *     CAC as started; the driver must later report
+ *     cfg80211_cac_event(NL80211_RADAR_CAC_FINISHED) (or ABORTED);
+ *   - cfg80211_cac_event(FINISHED) WARNs when it arrives before
+ *     start_time + cac_time_ms, so the first timer is 63000 ms (the vendor
+ *     hmac_dfs_cac_start timer is 63000 ms too) and the re-arm tick is
+ *     60000 ms: 60000 ms -> 63 s, 600000 ms -> 63 s + 9 x 60 s = 603 s;
+ *   - end_cac(..) is called by cfg80211 for an abort/teardown; the driver
+ *     only stops its hardware state (the core emits NL80211_RADAR_CAC_ABORTED).
+ *
+ * The 0x07E7 ARM is posted only after the SAME live precheck the AP-start
+ * dfs_set step uses (hi5622_dfs_set_precheck on the hi5622_scan_dfs_set_probe
+ * pack): the firmware ARM worker's started-module gate needs the 0x0065 VAP
+ * start, so on a fresh interface the op fails CLOSED with -EAGAIN and the
+ * probe pack in dmesg - the bench learns exactly which prerequisite is
+ * missing instead of the driver posting a frame the worker would drop.
+ */
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+#include <net/cfg80211.h>
+
+#include "hi5622_cfg80211.h"
+#include "hi5622_dfs_cac.h"
+#include "hi5622_dfs160.h"
+#include "hi5622_dfs_set.h"
+#include "hi5622_driver.h"
+#include "hi5622_frame_post.h"
+#include "hi5622_scan.h"
+
+unsigned int hi5622_dfs_cac;
+module_param_named(dfs_cac, hi5622_dfs_cac, uint, 0444);
+MODULE_PARM_DESC(dfs_cac,
+		 "5 GHz DFS: cfg80211 start_radar_detection/end_cac CAC runtime (0=off default = no op, no frame, no AP-start DFS gate; 1=on: probe the live 0x0065/started-module prerequisite, post the H2D key 0x07E7 ARM, run the CAC 60000 ms (600000 ms in the 5600-5650 MHz TDWR window) host timer, report CAC_FINISHED, keep a DFS AP from beaconing before the CAC finished; >1 refused)");
+
+#define HI5622_DFS_CAC_WIRE_MAX	64u
+
+static void hi5622_dfs_cac_work(struct work_struct *work);
+
+static struct device *hi5622_dfs_cac_dev(struct hi5622_dfs_cac *r)
+{
+	return &r->ctx->pdev->dev;
+}
+
+static int hi5622_dfs_cac_post(struct hi5622_dfs_cac *r, u8 body,
+			       const char *name)
+{
+	u8 wire[HI5622_DFS_CAC_WIRE_MAX];
+	size_t len = 0;
+	int rc;
+
+	rc = hi5622_dfs_set_build(wire, sizeof(wire), &len, body);
+	if (rc)
+		return rc;
+	return hi5622_frame_post(r->ctx, wire, len, name, NULL);
+}
+
+/* The timer callback: one vendor CAC tick.  REARM schedules the next tick;
+ * FINISH posts 0x07E7{00} and (only for a cfg80211-owned CAC) reports
+ * NL80211_RADAR_CAC_FINISHED. */
+static void hi5622_dfs_cac_work(struct work_struct *work)
+{
+	struct hi5622_dfs_cac *r = container_of(to_delayed_work(work),
+						struct hi5622_dfs_cac, work);
+	struct device *dev = hi5622_dfs_cac_dev(r);
+	struct hi5622_dfs160_cac *st = &r->model;
+	enum hi5622_dfs160_cac_step step;
+	u32 delay;
+	int rc;
+
+	mutex_lock(&r->lock);
+	if (st->state != HI5622_DFS160_CAC_ARMED) {
+		mutex_unlock(&r->lock);
+		return;
+	}
+	step = hi5622_dfs160_cac_tick(st);
+	if (step == HI5622_DFS160_STEP_REARM) {
+		delay = hi5622_dfs160_cac_delay_ms(st);
+
+		dev_info(dev,
+			 "cfg80211: dfs_cac tick %u/%u on ch%u (next in %u ms)\n",
+			 st->ticks_done, st->ticks, st->channel, delay);
+		if (delay)
+			schedule_delayed_work(&r->work,
+					      msecs_to_jiffies(delay));
+		mutex_unlock(&r->lock);
+		return;
+	}
+	/* CAC complete: disarm the firmware radar detector, then report. */
+	rc = hi5622_dfs_cac_post(r, HI5622_DFS_SET_BODY_CLEAR, "dfs_cac_clear");
+	r->last_rc = rc ? (unsigned int)-rc : 0u;
+	if (rc) {
+		r->aborts++;
+		dev_warn(dev,
+			 "cfg80211: dfs_cac CLEAR not posted (%d) on ch%u - CAC state kept, reporting ABORTED\n",
+			 rc, st->channel);
+		hi5622_dfs160_cac_abort(st);
+	} else {
+		hi5622_dfs160_cac_finish(st);
+		r->finishes++;
+		dev_info(dev,
+			 "cfg80211: dfs_cac CAC FINISHED on ch%u (cac_ms=%u, %u tick(s)) - 0x07E7{00} CLEAR posted\n",
+			 st->channel, st->cac_ms, st->ticks);
+		if (r->requested && r->dev)
+			cfg80211_cac_event(r->dev, &r->chandef,
+					   NL80211_RADAR_CAC_FINISHED,
+					   GFP_KERNEL, r->link_id);
+	}
+	r->requested = 0u;
+	r->dev = NULL;
+	mutex_unlock(&r->lock);
+}
+
+struct hi5622_dfs_cac *hi5622_dfs_cac_create(struct hi5622_pci *ctx)
+{
+	struct hi5622_dfs_cac *r;
+
+	if (!ctx)
+		return NULL;
+	r = kzalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return NULL;
+	r->ctx = ctx;
+	r->last_rc = (unsigned int)-ENODATA;
+	mutex_init(&r->lock);
+	hi5622_dfs160_cac_init(&r->model);
+	INIT_DELAYED_WORK(&r->work, hi5622_dfs_cac_work);
+	return r;
+}
+
+void hi5622_dfs_cac_destroy(struct hi5622_dfs_cac *r)
+{
+	if (!r)
+		return;
+	cancel_delayed_work_sync(&r->work);
+	mutex_destroy(&r->lock);
+	kfree(r);
+}
+
+int hi5622_dfs_cac_op_start(struct wiphy *wiphy, struct net_device *dev,
+			    struct cfg80211_chan_def *chandef,
+			    u32 cac_time_ms, int link_id)
+{
+	struct hi5622_cfg80211 *c;
+	struct hi5622_dfs_cac *r;
+	struct hi5622_dfs_set_probe probe;
+	struct device *pdev;
+	u8 channel;
+	int rc;
+
+	if (!wiphy || !dev)
+		return -EINVAL;
+	c = wiphy_priv(wiphy);
+	if (!c || !c->dfs_cac)
+		return -EOPNOTSUPP;
+	r = c->dfs_cac;
+	if (hi5622_dfs_cac != 1u)
+		return -EOPNOTSUPP;	/* the default: no DFS service */
+	pdev = hi5622_dfs_cac_dev(r);
+	if (!dev->ieee80211_ptr ||
+	    dev->ieee80211_ptr->iftype != NL80211_IFTYPE_AP) {
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - start_radar_detection is only supported on an AP interface\n");
+		r->refusals++;
+		return -EINVAL;
+	}
+	if (!chandef || !chandef->chan)
+		return -EINVAL;
+	if (chandef->chan->band != NL80211_BAND_5GHZ) {
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - channel %u is not a 5 GHz channel\n",
+			 chandef->chan->hw_value);
+		r->refusals++;
+		return -EINVAL;
+	}
+	channel = (u8)chandef->chan->hw_value;
+	mutex_lock(&r->lock);
+	rc = hi5622_dfs160_cac_begin(&r->model, channel,
+				     chandef->chan->center_freq, cac_time_ms);
+	if (rc) {
+		r->refusals++;
+		r->last_rc = (unsigned int)-rc;
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - CAC on ch%u cannot start (%d): %s (already armed=%d, DFS channel=%d)\n",
+			 channel, rc,
+			 rc == -EALREADY ? "a CAC is already running on this module load" :
+			 rc == -EOPNOTSUPP ? "not a DFS channel" : "bad parameter",
+			 r->model.state == HI5622_DFS160_CAC_ARMED,
+			 hi5622_dfs160_is_dfs_chan(channel));
+		mutex_unlock(&r->lock);
+		return rc == -EALREADY ? -EBUSY : -EINVAL;
+	}
+	/* The live firmware precondition: the SAME fail-closed pack the
+	 * AP-start dfs_set step uses.  The 0x07E7 worker needs a started
+	 * module context (the 0x0065 VAP start writes mctx[0x0E]=1) and the
+	 * band-1 CAC context; without them the frame would be silently
+	 * dropped, so refuse and print the pack. */
+	hi5622_scan_dfs_set_probe(c->ctx, &probe);
+	rc = hi5622_dfs_set_precheck(&probe, HI5622_DFS_SET_MODE_ARM);
+	if (rc) {
+		r->refusals++;
+		r->last_rc = (unsigned int)-rc;
+		hi5622_dfs160_cac_abort(&r->model);
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac ARM REFUSED (%d): %s - live pack mctx=0x%08x band=%u state=%u ec8=%u cac=%u ctx_present=%u b4a0=0x%08x regs=0x%02x (the firmware ARM worker needs the 0x0065 VAP start's started module context; no frame posted)\n",
