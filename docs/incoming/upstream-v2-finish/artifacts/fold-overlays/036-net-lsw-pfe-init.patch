+/*
+ * W8: the PFE forwarding-engine base init.
+ *
+ * The round-3 hardware run (image 75868fe0) armed W3-W7 and the GEMAC front end
+ * registered with a 1 Gbps link, but no frame crossed the switch: the PIE RX
+ * rings never fired and the consumed PIE TX descriptors never reached the wire.
+ * The vendor's data path is not complete with the DP/EQM/EPS init alone - the
+ * PFE module (hi_lsw_pfe) probes after the DP module and programs the
+ * forwarding-engine globals before its CFE/rootif layer is usable.  The four
+ * direct register writes below are the whole hardware write set of that base
+ * init (hi_pfe_probe -> hi_pfe_init / hi_pfe_opp_init); the rest builds software
+ * table managers, and the IFC default-classification table (ifc+0x50000, 16-byte
+ * entries via hi_lsw_write_tab128) is decoded but deliberately not in this
+ * write set yet - its field semantics are [U] and it needs its own attended
+ * verification.
+ *
+ * Every word is snapshotted, the pre-write value is required to be stable, the
+ * written value is computed (two words are the vendor constants, pfe_glb+0x2c
+ * is the vendor's read-modify-write keeping bits 15..0), and every word is read
+ * back; on a mismatch the snapshot is restored.  The write shape is [V] from the
+ * fixture, the field semantics are [U].
+ */
+enum luofu_switch_pfe_word {
+	LUOFU_SWITCH_PFE_PE_CFG,
+	LUOFU_SWITCH_PFE_GLB_CFG,
+	LUOFU_SWITCH_PFE_GLB_EN,
+	LUOFU_SWITCH_PFE_OPP_INIT,
+};
+
+struct luofu_switch_pfe_write {
+	enum luofu_switch_window window;
+	u32 offset;
+	u32 value;
+	u32 keep;	/* bits taken from the pre-write value */
+};
+
+static const struct luofu_switch_pfe_write luofu_switch_v250_pfe_writes[] = {
+	[LUOFU_SWITCH_PFE_PE_CFG] = {
+		.window = LUOFU_SWITCH_WIN_PE,
+		.offset = LUOFU_SWITCH_PE_PFE_CFG,
+		.value = 2,
+	},
+	[LUOFU_SWITCH_PFE_GLB_CFG] = {
+		.window = LUOFU_SWITCH_WIN_PFE_GLB,
+		.offset = LUOFU_SWITCH_PFE_GLB_TAB_CFG,
+		.value = 0,
+		.keep = LUOFU_SWITCH_PFE_GLB_TAB_MASK,
+	},
+	[LUOFU_SWITCH_PFE_GLB_EN] = {
+		.window = LUOFU_SWITCH_WIN_PFE_GLB,
+		.offset = LUOFU_SWITCH_PFE_GLB_ENABLE,
+		.value = 1,
+	},
+	[LUOFU_SWITCH_PFE_OPP_INIT] = {
+		.window = LUOFU_SWITCH_WIN_OPP,
+		.offset = LUOFU_SWITCH_OPP_PFE_INIT,
+		.value = 0,
+	},
+};
+
+/* Undo the W8 write set from the snapshot kept by luofu_switch_pfe_program(). */
+static void luofu_switch_pfe_restore(struct luofu_switch *lsw)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_pfe_writes); i++) {
+		const struct luofu_switch_pfe_write *w =
+			&luofu_switch_v250_pfe_writes[i];
+
+		writel(lsw->pfe_pre[i], lsw->window[w->window] + w->offset);
+	}
+}
+
+static int luofu_switch_pfe_program(struct luofu_switch *lsw)
+{
+	u32 want[LUOFU_SWITCH_PFE_WRITES];
+	unsigned int i;
+	u32 got;
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_pfe_writes); i++) {
+		const struct luofu_switch_pfe_write *w =
+			&luofu_switch_v250_pfe_writes[i];
+		void __iomem *base = lsw->window[w->window];
+
+		if (!base)
+			return dev_err_probe(lsw->dev, -EINVAL,
+					     "missing %s window for the W8 PFE init\n",
+					     luofu_switch_window_names[w->window]);
+		lsw->pfe_pre[i] = readl(base + w->offset);
+		want[i] = (lsw->pfe_pre[i] & w->keep) | w->value;
+		if (readl(base + w->offset) != lsw->pfe_pre[i])
+			return dev_err_probe(lsw->dev, -EIO,
+					     "PFE register %s+%#x changed between two reads (%#x -> %#x); refusing to write it\n",
+					     luofu_switch_window_names[w->window],
+					     w->offset, lsw->pfe_pre[i],
+					     readl(base + w->offset));
+	}
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_pfe_writes); i++) {
+		const struct luofu_switch_pfe_write *w =
+			&luofu_switch_v250_pfe_writes[i];
+
+		writel(want[i], lsw->window[w->window] + w->offset);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_pfe_writes); i++) {
+		const struct luofu_switch_pfe_write *w =
+			&luofu_switch_v250_pfe_writes[i];
+
+		got = readl(lsw->window[w->window] + w->offset);
+		if (got == want[i])
+			continue;
+		dev_err(lsw->dev,
+			"PFE init readback mismatch at %s+%#x: read %#x, expected %#x (snapshot %#x); restoring the snapshot\n",
+			luofu_switch_window_names[w->window], w->offset, got,
+			want[i], lsw->pfe_pre[i]);
+		luofu_switch_pfe_restore(lsw);
+		return -EIO;
+	}
+
+	dev_info(lsw->dev,
+		 "W8: PFE forwarding-engine base init programmed and verified (pe+%#x=%#x pfe_glb+%#x=%#x pfe_glb+%#x=%#x opp+%#x=%#x)\n",
+		 luofu_switch_v250_pfe_writes[LUOFU_SWITCH_PFE_PE_CFG].offset,
+		 want[LUOFU_SWITCH_PFE_PE_CFG],
+		 luofu_switch_v250_pfe_writes[LUOFU_SWITCH_PFE_GLB_CFG].offset,
+		 want[LUOFU_SWITCH_PFE_GLB_CFG],
+		 luofu_switch_v250_pfe_writes[LUOFU_SWITCH_PFE_GLB_EN].offset,
+		 want[LUOFU_SWITCH_PFE_GLB_EN],
+		 luofu_switch_v250_pfe_writes[LUOFU_SWITCH_PFE_OPP_INIT].offset,
+		 want[LUOFU_SWITCH_PFE_OPP_INIT]);
+	return 0;
+}
