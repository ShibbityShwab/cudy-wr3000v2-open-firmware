+/* ------------------------------------------------------------------ */
+/* wifi-rx-vendor-diff (task-162, shared task-162): the VENDOR-vs-OURS    */
+/* RX state parity (read-only) and the observe-only drain rung.           */
+/* ------------------------------------------------------------------ */
+
+/* Config-block address words are classified by content:
+ *  +0x04/+0x20/+0x24/+0x28 = 4-byte-aligned host-DRAM device VAs;
+ *  +0x10 = the device-RAM MSDU-info table ACP alias. */
+static int dptx_cfg_word_range_ok(u32 off, u32 v)
+{
+	if ((v & 3u) != 0u)
+		return 0;
+	switch (off) {
+	case 0x04u:
+	case 0x20u:
+	case 0x24u:
+	case 0x28u:
+		return v >= DP_HOST_DMA_LO && v <= DP_HOST_DMA_HI;
+	case 0x10u:
+		return v >= DP_ACP_CA_LO && v <= DP_ACP_CA_HI;
+	default:
+		return 1;
+	}
+}
+
+struct dptx_parity_stat {
+	u32 cfg_checked;
+	u32 cfg_mismatch;
+	u32 cfg_read_fail;
+	u32 live_checked;
+	u32 live_mismatch;
+	u32 live_device_zero;
+	u32 live_read_fail;
+};
+
+static void dptx_par_line(char *buf, size_t cap, size_t *pos,
+			  const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+
+	if (!buf || !pos || *pos >= cap)
+		return;
+	va_start(ap, fmt);
+	n = vscnprintf(buf + *pos, cap - *pos, fmt, ap);
+	va_end(ap);
+	if (n > 0)
+		*pos += (size_t)n;
+}
+
+/* Read-only scan of the two vendor RX blocks.  verbos=1 renders every word
+ * (dp_rx_parity); verbose=0 only refreshes the counters (dp_rx_capture). */
+static int dptx_rx_parity_scan(struct hi5622_dp_txrx *t, int verbose,
+			       char *buf, size_t cap, size_t *pos,
+			       struct dptx_parity_stat *st)
+{
+	const struct hi5622_rx_word *tab;
+	unsigned int n, i;
+	enum hi5622_rx_parity par;
+	u32 v;
+	int rc;
+
+	memset(st, 0, sizeof(*st));
+	tab = hi5622_rx_cfg_words(&n);
+	for (i = 0; i < n; i++) {
+		int range_ok;
+
+		v = dptx_mac_read(t->ctx, tab[i].off);
+		range_ok = dptx_cfg_word_range_ok(tab[i].off, v);
+		rc = hi5622_rx_parity_classify(&tab[i], v, range_ok, &par);
+		if (rc)
+			return rc;
+		st->cfg_checked++;
+		if (par == HIRD_PAR_READ_FAIL)
+			st->cfg_read_fail++;
+		else if (par == HIRD_PAR_MISMATCH || par == HIRD_PAR_RANGE_BAD)
+			st->cfg_mismatch++;
+		if (verbose)
+			dptx_par_line(buf, cap, pos,
+				      "parity cfg %08x+0x%02x actual=0x%08x stock=0x%08x %-10s %s\n",
+				      HIRD_CFG_CA, (unsigned int)tab[i].off, v,
+				      tab[i].v, hi5622_rx_parity_name(par),
+				      tab[i].name);
+	}
+	tab = hi5622_rx_live_words(&n);
+	for (i = 0; i < n; i++) {
+		v = dptx_mac_read_live(t->ctx, tab[i].off);
+		rc = hi5622_rx_parity_classify(&tab[i], v, 0, &par);
+		if (rc)
+			return rc;
+		st->live_checked++;
+		if (par == HIRD_PAR_READ_FAIL)
+			st->live_read_fail++;
+		else if (par == HIRD_PAR_MISMATCH)
+			st->live_mismatch++;
+		else if (par == HIRD_PAR_DEVICE_ZERO)
+			st->live_device_zero++;
+		if (verbose)
+			dptx_par_line(buf, cap, pos,
+				      "parity live %08x+0x%02x actual=0x%08x stock=0x%08x %-10s %s\n",
+				      HIRD_LIVE_CA, (unsigned int)tab[i].off, v,
+				      tab[i].v, hi5622_rx_parity_name(par),
+				      tab[i].name);
+	}
+	return HIL_RX_OK;
+}
+
+ssize_t hi5622_dp_rx_parity_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct hi5622_dp_txrx *t = dptx_from_dev(dev);
+	struct dptx_parity_stat st;
+	struct hi5622_rx_status_dec dec;
+	char bits[112];
+	size_t pos = 0;
+	u32 status, mask;
+	int rc, bl;
+
+	(void)attr;
+	if (!t || !t->ctx)
+		return -ENODEV;
+	mutex_lock(&t->lock);
+	if (!t->bound) {
+		mutex_unlock(&t->lock);
+		return -ENODEV;
+	}
+	rc = dptx_rx_parity_scan(t, 1, buf, PAGE_SIZE, &pos, &st);
+	if (rc) {
+		mutex_unlock(&t->lock);
+		return rc;
+	}
+	status = dptx_mac_read_live(t->ctx, HIL_RX_LIVE_STATUS);
+	mask = dptx_mac_read(t->ctx, HIL_RX_CFG_INT_MASK);
+	rc = hi5622_rx_status_decode(status, mask, &dec);
+	if (rc) {
+		mutex_unlock(&t->lock);
+		return rc;
+	}
+	bl = hi5622_rx_status_bits_str(&dec, bits, sizeof(bits));
+	dptx_par_line(buf, PAGE_SIZE, &pos,
+		      "parity summary: cfg{checked=%u mismatch=%u read_fail=%u} live{checked=%u mismatch=%u device_zero=%u read_fail=%u} passes=%u\n",
+		      st.cfg_checked, st.cfg_mismatch, st.cfg_read_fail,
+		      st.live_checked, st.live_mismatch, st.live_device_zero,
+		      st.live_read_fail, t->rx_parity_passes + 1u);
+	dptx_par_line(buf, PAGE_SIZE, &pos,
+		      "parity status: CA 0x%08x status=0x%08x mask=0x%08x active=0x%08x %s%s\n",
+		      HIRD_LIVE_CA, status, mask, dec.active,
+		      bl > 0 ? bits : "(bits?)",
+		      dec.rx_active ? " rx-completion-pending" : " rx-completion-idle");
+	dptx_par_line(buf, PAGE_SIZE, &pos,
+		      "parity note: DEVICE_ZERO on live +0x14/+0x24..+0x30 means the device-side RX/MAC state never reached the vendor stock shape (the highest-value missing link); MISMATCH on cfg fixed words means the host RX program differs.\n");
+	t->rx_parity_passes++;
+	t->rx_parity_cfg_mismatch = st.cfg_mismatch;
+	t->rx_parity_live_mismatch = st.live_mismatch;
+	t->rx_parity_live_device_zero = st.live_device_zero;
+	t->rx_parity_read_fail = st.cfg_read_fail + st.live_read_fail;
+	mutex_unlock(&t->lock);
+	dev_info(dev,
+		 "DP rx_parity: read-only vendor-state diff rendered (cfg mismatch=%u live mismatch=%u live device_zero=%u read_fail=%u)\n",
+		 st.cfg_mismatch, st.live_mismatch, st.live_device_zero,
+		 st.cfg_read_fail + st.live_read_fail);
+	return (ssize_t)pos;
+}
+
+/* Observe-only drain rung: prove the device wrote completions WITHOUT moving
+ * any ring pointer (the crash-containment rung).  Reads the live bank, the
+ * completion ring memory and the returned buffers; never writes a register or
+ * ring entry.  A malformed entry/header is counted, not lane-closing: nothing
+ * was consumed, so the next action can still be a clean observe or (if the
+ * diagnostic says so) a write-enabled drain. */
+static int dptx_rx_observe(struct device *dev,
+			   struct hi5622_dp_txrx *t, u32 max,
+			   u32 *frames_out, u32 *bad_out)
+{
+	struct hi5622_pci *ctx = t->ctx;
+	struct hi5622_rx_status_dec dec;
+	char bits[112];
+	u32 st, nr, sr, cw, mask, pending, cons, frames = 0, bad = 0;
+	u32 chains = 0, shown = 0;
+	int rc, bl;
+
+	*frames_out = 0;
+	*bad_out = 0;
+	dptx_live_read(ctx, &st, &nr, &sr, &cw);
+	t->rx_live_status = st;
+	t->rx_live_norm_rptr = nr;
+	t->rx_live_small_rptr = sr;
+	t->rx_live_cmp_wptr = cw;
+	if (st == 0xffffffffu || nr == 0xffffffffu || sr == 0xffffffffu ||
+	    cw == 0xffffffffu)
+		return -EFAULT;
+	mask = dptx_mac_read(ctx, HIL_RX_CFG_INT_MASK);
+	rc = hi5622_rx_status_decode(st, mask, &dec);
+	if (rc)
+		return rc;
+	bl = hi5622_rx_status_bits_str(&dec, bits, sizeof(bits));
+	rc = hi5622_rx_ring_pending(cw, t->rx_cmp_cons, HIL_RX_CMP_DEPTH,
+				    &pending);
+	if (rc)
+		return rc;
+	t->rx_obs_seen_wptr = cw;
+	t->rx_obs_last_status = st;
+	if (pending == 0u) {
+		t->rx_obs_actions++;
+		dev_info(dev,
+			 "DP rx_observe: OBSERVE-ONLY (zero device writes) status=0x%08x %s norm_rptr=0x%04x small_rptr=0x%04x cmp_wptr=0x%04x cmp_cons=0x%04x - no completion pending\n",
+			 st, bl > 0 ? bits : "(bits?)", nr, sr, cw,
+			 t->rx_cmp_cons);
+		return HIL_RX_OK;
+	}
+	if (pending > max)
+		pending = max;
+	cons = t->rx_cmp_cons;
+	for (u32 i = 0; i < pending; i++) {
+		u32 slot = cons & HIL_RX_IDX_MASK;
+		u32 entry, slot_idx = 0, buf_dma = 0;
+		u8 ring_kind = 0xffu;
+		const u8 *cpu;
+		struct hi5622_rx_hdr hdr;
+		u32 dma_cap;
+
+		if (slot >= HIL_RX_CMP_DEPTH) {
+			bad++;
+			break;
+		}
+		dma_rmb();
+		entry = ((const u32 *)(const void *)t->rx_cmp_ring)[slot];
+		rc = hi5622_rx_obs_entry(entry, t->rx_norm_dma,
+					 HIL_RX_NORM_DEPTH, t->rx_small_dma,
+					 HIL_RX_SMALL_DEPTH, &ring_kind,
+					 &slot_idx, &buf_dma);
+		if (rc != HIRD_OBS_FRAME) {
+			bad++;
+			break;
+		}
+		cpu = (ring_kind == 0u) ?
+			(const u8 *)t->rx_norm_cpu[slot_idx] :
+			(const u8 *)t->rx_small_cpu[slot_idx];
+		if (!cpu) {
+			bad++;
+			break;
+		}
+		dma_cap = (ring_kind == 0u) ? HIL_RX_NORM_BUFLEN :
+					      HIL_RX_SMALL_BUFLEN;
+		rc = hi5622_rx_hdr_parse(cpu + HIL_RX_SKB_WORD, dma_cap, &hdr);
+		if (rc == HIL_RX_ECHAIN) {
+			chains++;
+			bad++;
+			break;
+		}
+		if (rc != HIL_RX_OK) {
+			bad++;
+			break;
+		}
+		frames++;
+		if (shown < 3u) {
+			shown++;
+			dev_info(dev,
+				 "DP rx_observe: frame %u %s slot=%u entry=0x%08x len(+0x1a)=%u flags9=0x%02x status_b=0x%02x next=0x%08x (READ-ONLY: no pointer published)\n",
+				 frames, ring_kind == 0u ? "norm" : "small",
+				 slot_idx, entry, hdr.payload_len, hdr.flags9,
+				 hdr.status_b, hdr.next_devva);
+		}
+		cons = hi5622_rx_idx_advance(cons, HIL_RX_CMP_DEPTH);
+	}
+	t->rx_obs_actions++;
+	t->rx_obs_frames += frames;
+	t->rx_obs_bad += bad;
+	t->rx_obs_chains += chains;
+	dev_info(dev,
+		 "DP rx_observe: OBSERVE-ONLY (zero device writes) status=0x%08x %s norm_rptr=0x%04x small_rptr=0x%04x cmp_wptr=0x%04x cmp_cons=0x%04x pending=%u frames=%u bad=%u chains=%u totals{actions=%u frames=%u bad=%u} - no ring pointer moved\n",
+		 st, bl > 0 ? bits : "(bits?)", nr, sr, cw, t->rx_cmp_cons,
+		 pending, frames, bad, chains, t->rx_obs_actions,
+		 t->rx_obs_frames, t->rx_obs_bad);
+	*frames_out = frames;
+	*bad_out = bad;
+	return HIL_RX_OK;
+}
+
+/* The one vendor RX-service write our driver never performed: after serving a
+ * completion the vendor ISR W1Cs the served status bits to config +0x44
+ * (shuangta_clear_host_mac_int_status).  This action is fail-closed: only the
+ * RX-completion bit (2) may be cleared, only when it is actually observable,
+ * and only with rx_status_service=1 + rx_enable=1 + the dp_setup/TXQ write
+ * gate satisfied. */
+ssize_t hi5622_dp_rx_status_clear_store(struct device *dev,
+					struct device_attribute *attr,
+					const char *buf, size_t count)
+{
+	struct hi5622_dp_txrx *t = dptx_from_dev(dev);
+	struct hi5622_pci *ctx;
+	struct hi5622_rx_status_dec dec;
+	char bits[112];
+	u32 status, mask, w1c;
+	int rc, bl;
+
+	(void)attr;
+	if (!t || !t->ctx)
+		return -ENODEV;
+	ctx = t->ctx;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	mutex_lock(&t->lock);
+	if (!t->bound || t->failed) {
+		mutex_unlock(&t->lock);
+		return -ENODEV;
+	}
+	if (!dptx_rx_status_service) {
+		dev_warn(dev,
+			 "DP rx_status_clear: REFUSED - rx_status_service=0 (default; read-only policy)\n");
+		mutex_unlock(&t->lock);
+		return -EPERM;
+	}
+	if (!dptx_rx_enable || !t->rx_armed) {
+		mutex_unlock(&t->lock);
+		return -EPERM;
+	}
+	rc = dptx_write_gate(ctx);
+	if (rc) {
+		dev_warn(dev,
+			 "DP rx_status_clear: refused by gate '%s' - no device write\n",
+			 dptx_gate_name(rc));
+		mutex_unlock(&t->lock);
+		return rc;
+	}
+	status = dptx_mac_read_live(ctx, HIL_RX_LIVE_STATUS);
+	mask = dptx_mac_read(ctx, HIL_RX_CFG_INT_MASK);
+	rc = hi5622_rx_status_decode(status, mask, &dec);
+	if (rc) {
+		mutex_unlock(&t->lock);
+		return rc;
+	}
+	bl = hi5622_rx_status_bits_str(&dec, bits, sizeof(bits));
+	if (!dec.rx_active) {
+		mutex_unlock(&t->lock);
+		dev_info(dev,
+			 "DP rx_status_clear: status=0x%08x %s - RX completion bit not observable, no write performed\n",
+			 status, bl > 0 ? bits : "(bits?)");
+		return (ssize_t)count;
+	}
+	w1c = 1u << HIRD_STATUS_RX_BIT;
+	rc = dptx_mac_write_checked(ctx, HIL_RX_CFG_INT_STATUS, w1c);
+	if (rc) {
+		mutex_unlock(&t->lock);
+		return -EIO;
+	}
+	t->rx_status_clears++;
+	t->rx_status_last_cleared = w1c;
+	mutex_unlock(&t->lock);
+	dev_info(dev,
+		 "DP rx_status_clear: W1C 0x%08x to config +0x44 from status=0x%08x %s (vendor clear path; only the RX completion bit) - clears=%u\n",
+		 w1c, status, bl > 0 ? bits : "(bits?)", t->rx_status_clears);
+	return (ssize_t)count;
+}
