+/* dp_rx_cmp_prepublish: the task-168 phase-1 completion-consumer rung.
+ *
+ * Publishes the packed completion-consumer word 0x8000 (index 0, phase 1) to
+ * the host-interface config block +0x40 BEFORE dp_rx_arm, then probes the
+ * host-MAC status word for a device reaction.  This is an experiment, not a
+ * vendor sequence: the vendor's own initial consumer is 0x0000 (stock dump
+ * cfg +0x40 = 0; the phase bit only becomes 1 after a full 4095-entry lap),
+ * and the vendor ring library's phase-aware arithmetic reads
+ * (device producer 0x0000, consumer 0x8000) as ONE FULL LAP.  The rung is
+ * therefore probe-and-rollback: if status bit 7 (rptr overtake wptr) or
+ * bit 10 (rx_ppdu_desc error) transitions 0->1 after the store, 0x0000 is
+ * restored immediately and the verdict is PHASE1-REJECTED-BY-DEVICE.  A clean
+ * probe leaves 0x8000 published for the attended R2 (frames) rung and records
+ * PHASE1-ACCEPTED-IDLE.  One shot per load, before arm, exact-width 32-bit
+ * store with read-back; no other RX state is touched. */
+ssize_t hi5622_dp_rx_cmp_prepublish_store(struct device *dev,
+					 struct device_attribute *attr,
+					 const char *buf, size_t count)
+{
+	struct hi5622_dp_txrx *t = dptx_from_dev(dev);
+	struct hi5622_pci *ctx;
+	u32 old, before, after, store, rb, rb2 = 0u;
+	u32 reaction, cw, pending = 0u, full = 0u;
+	enum rxc_gate gate;
+	u32 ready;
+	int rc;
+
+	(void)attr;
+	if (!t || !t->ctx)
+		return -ENODEV;
+	ctx = t->ctx;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	mutex_lock(&t->lock);
+	if (!t->bound || t->failed) {
+		mutex_unlock(&t->lock);
+		return -ENODEV;
+	}
+	ready = (ctx->windows_programmed && ctx->hcc && ctx->hcc->armed &&
+		 dptx_write_gate(ctx) == 0) ? 1u : 0u;
+	old = dptx_mac_read(ctx, HIL_RX_CFG_CMP_RPTR);
+	if (old == 0xffffffffu) {
+		mutex_unlock(&t->lock);
+		dev_err(dev,
+			"DP rx_cmp_prepublish: REFUSED - config +0x40 transport miss (0xffffffff) - no write\n");
+		return -EFAULT;
+	}
+	gate = rxc_prepublish_gate(dptx_rx_cmp_prepublish, dptx_rx_enable,
+				   ready, t->rx_armed,
+				   t->rx_cmp_prepublish_done, t->rx_failed,
+				   old);
+	switch (gate) {
+	case RXC_GATE_ALLOW:
+		break;
+	case RXC_GATE_DISABLED:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: REFUSED - rx_cmp_prepublish=0 (fail-closed; reload with rx_cmp_prepublish=1 for the phase-1 rung)\n");
+		return -EPERM;
+	case RXC_GATE_NO_RX_ENABLE:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: REFUSED - rx_enable=0 (fail-closed)\n");
+		return -EPERM;
+	case RXC_GATE_NOT_READY:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: refused - transport/write gate is not up (needs dp_setup + dp_txq_sync in this load); no write\n");
+		return -EBUSY;
+	case RXC_GATE_ARMED:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: REFUSED - dp_rx_arm already ran; the prepublish must happen BEFORE the arm (reload)\n");
+		return -EALREADY;
+	case RXC_GATE_ALREADY_DONE:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: REFUSED - one-shot already used in this load\n");
+		return -EALREADY;
+	case RXC_GATE_LANE_FAILED:
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: REFUSED - the RX lane/device is already closed in this load\n");
+		return -EIO;
+	case RXC_GATE_CONSUMER_DIRTY:
+	default:
+		mutex_unlock(&t->lock);
+		dev_err(dev,
+			"DP rx_cmp_prepublish: REFUSED - config +0x40 = 0x%08x is not the vendor initial consumer 0x0000; refusing to overwrite a moved consumer (no write)\n",
+			old);
+		return -ERANGE;
+	}
+	before = dptx_mac_read_live(ctx, HIL_RX_LIVE_STATUS);
+	if (before == 0xffffffffu) {
+		mutex_unlock(&t->lock);
+		dev_err(dev,
+			"DP rx_cmp_prepublish: REFUSED - live status transport miss - no write\n");
+		return -EFAULT;
+	}
+	store = rxc_store_value(old, RXC_PHASE1_PREPUBLISH);
+	rc = dptx_mac_write_checked(ctx, HIL_RX_CFG_CMP_RPTR, store);
+	if (rc) {
+		mutex_unlock(&t->lock);
+		dev_err(dev,
+			"DP rx_cmp_prepublish: REFUSED - store failed rc=%d; no further action\n",
+			rc);
+		return -EFAULT;
+	}
+	rb = dptx_mac_read(ctx, HIL_RX_CFG_CMP_RPTR);
+	if (rb == 0xffffffffu || !rxc_readback_ok(rb, RXC_PHASE1_PREPUBLISH)) {
+		/* Best-effort restore of the vendor initial consumer. */
+		(void)dptx_mac_write_checked(ctx, HIL_RX_CFG_CMP_RPTR,
+					     rxc_store_value(rb,
+						RXC_VENDOR_INITIAL_CONSUMER));
+		mutex_unlock(&t->lock);
+		dev_err(dev,
+			"DP rx_cmp_prepublish: FAILED - read-back 0x%08x does not carry 0x8000; restored the vendor initial consumer, no traffic rung\n",
+			rb);
+		return -EIO;
+	}
+	/* Let the device reflect a reaction, then probe the two phase flags. */
+	msleep(10);
+	after = dptx_mac_read_live(ctx, HIL_RX_LIVE_STATUS);
+	if (after == 0xffffffffu)
+		after = before;
+	reaction = rxc_status_reaction(before, after);
+	t->rx_cmp_prepublish_old = old;
+	t->rx_cmp_prepublish_new = store;
+	t->rx_cmp_prepublish_rb = rb;
+	t->rx_cmp_prepublish_status_before = before;
+	t->rx_cmp_prepublish_status_after = after;
+	t->rx_cmp_prepublish_reaction = reaction;
+	t->rx_cmp_prepublish_done = 1u;
+	if (reaction != 0u) {
+		rc = dptx_mac_write_checked(ctx, HIL_RX_CFG_CMP_RPTR,
+					    rxc_store_value(rb,
+						RXC_VENDOR_INITIAL_CONSUMER));
+		if (rc == 0) {
+			rb2 = dptx_mac_read(ctx, HIL_RX_CFG_CMP_RPTR);
+			if (rb2 == 0xffffffffu ||
+			    !rxc_readback_ok(rb2, RXC_VENDOR_INITIAL_CONSUMER))
+				rc = -EIO;
+		}
+		t->rx_cmp_prepublish_rollback = (rc == 0) ? 1u : 0u;
+		t->rx_cmp_prepublish_active = 0u;
+		mutex_unlock(&t->lock);
+		dev_warn(dev,
+			 "DP rx_cmp_prepublish: PHASE1-REJECTED-BY-DEVICE status 0x%08x -> 0x%08x reaction=0x%08x (bit7=rptr-overtake bit10=ppdu-desc-err) old=0x%08x rb=0x%08x rollback=%s rb_after=0x%08x - the device validates the completion consumer phase; the phase-1 state is NOT usable and the vendor initial consumer 0x0000 is restored.  Do not send traffic; report this line.\n",
+			 before, after, reaction, old, rb,
+			 t->rx_cmp_prepublish_rollback ? "OK" : "FAILED",
+			 rb2);
+		return (ssize_t)count;
+	}
+	t->rx_cmp_prepublish_active = 1u;
+	cw = dptx_mac_read_live(ctx, HIL_RX_LIVE_CMP_WPTR);
+	if (cw != 0xffffffffu &&
+	    rxc_ring_state(cw, RXC_PHASE1_PREPUBLISH, HIL_RX_CMP_DEPTH,
+			   &pending, &full) != RXC_OK)
+		full = 1u;
+	mutex_unlock(&t->lock);
+	dev_warn(dev,
+		 "DP rx_cmp_prepublish: PHASE1-ACCEPTED-IDLE status 0x%08x -> 0x%08x (no device reaction) cfg+0x40 0x%08x -> 0x%08x (vendor initial was 0x0000); phase-aware view: producer=0x%04x consumer=0x8000 pending=%u full_lap=%u - one full-lap ring ahead of the first completion.  Probe is clean only for the no-traffic discriminator; do NOT claim a fix.  R2 (attended, recovery armed) may now send the auth frames.\n",
+		 before, after, old, rb, cw, pending, full);
+	return (ssize_t)count;
+}
