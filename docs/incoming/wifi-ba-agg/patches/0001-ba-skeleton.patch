--- a/Kbuild	2026-11-25 18:02:45.750764511 +0700
+++ b/Kbuild	2026-11-25 18:02:45.750797353 +0700
@@ -37,7 +37,8 @@
 		 hi5622_sta_logic.o hi5622_sta_frames.o hi5622_sta.o \
 		 hi5622_sta_ops_logic.o hi5622_sta_ops.o \
 		 hi5622_mgmt_logic.o hi5622_mgmt.o \
-		 hi5622_data_tx_logic.o hi5622_data_tx.o
+		 hi5622_data_tx_logic.o hi5622_data_tx.o \
