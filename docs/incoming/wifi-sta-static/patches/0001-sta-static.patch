@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_sta.c - cfg80211 STA connect/disconnect for the Hi5622V100
+ * clean-room driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (wifi-sta-static lane, shared task task-141,
+ * 2026-11-24).  No vendor source text/object/firmware byte reproduced.
+ * Decoded facts and their evidence markers: ../REPORT.md sections 3-5.
+ *
+ * WHAT THE VENDOR DOES (2.5.24, link-time .text offsets)
+ * -----------------------------------------------------
+ *   wal_cfg80211_connect            +0x100590
+ *     -> wal_cfg80211_start_connect +0x128310
+ *        -> wal_cfg80211_start_req  +0x127ec4
+ *           -> wal_send_cfg_event   +0x1270d8
+ *              == HCC group 2, HCC id 0, WAL cfg-event id 1, WAL opcode
+ *                 0x0123, body 108 B (hi5622_sta_frames.h)
+ *   wal_cfg80211_disconnect         +0x100844
+ *     -> wal_cfg80211_start_disconnect +0x128334
+ *        -> WAL opcode 0x00d0, body 16 B {bssid[6], reason u16, [15]=1}
+ *
+ * The 108-byte connect body carries four host-DRAM buffer addresses
+ * (bssid/ssid/ie/key).  The device reaches host DRAM through the same
+ * inbound window the data-plane rings use (devva == dma_addr), which makes
+ * the vendor-shaped frame expressible here - but the exact firmware
+ * dereference contract is [U], so posting is gated twice:
+ *
+ *   hi5622_sta_join=0  (default) fail closed: -EOPNOTSUPP, no frame built
+ *   hi5622_sta_join=1            build + validate + log the frame, no post
+ *   hi5622_sta_join=2            post it (EXPERIMENTAL: needs allow_frames>0
+ *                                and the bench ladder in TEST-LADDER.md)
+ *
+ * cfg80211_connect_done() is deliberately NOT called: the firmware's connect
+ * result arrives on the D2H management path, which this driver does not
+ * decode yet (the RX lane owns it).  Returning success without completing
+ * would be a fake success; userspace sees a clean timeout instead.
+ */
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <net/cfg80211.h>
+
+#include "hi5622_cfg80211.h"
+#include "hi5622_driver.h"
+#include "hi5622_frame_post.h"
+#include "hi5622_sta.h"
+#include "hi5622_sta_frames.h"
+#include "hi5622_sta_logic.h"
+
+/* 0 = fail closed (default), 1 = build+validate only, 2 = post. */
+unsigned int hi5622_sta_join;
+module_param_named(sta_join, hi5622_sta_join, uint, 0644);
+MODULE_PARM_DESC(sta_join,
+		 "STA join path: 0=fail closed (default), 1=build+validate the vendor WAL cfg-event join frame only, 2=post it (experimental; also needs allow_frames>0)");
+
+#define HI5622_STA_JOIN_MAX	2u
+
+/* Host-DRAM buffer the connect body points at, laid out as one coherent
+ * allocation: bssid[6], ssid[32], key[32], ies[512]. */
+#define HI5622_STA_OFF_BSSID	0u
+#define HI5622_STA_OFF_SSID	8u
+#define HI5622_STA_OFF_KEY	40u
+#define HI5622_STA_OFF_IE	72u
+#define HI5622_STA_BUF_SIZE	(HI5622_STA_OFF_IE + HI5622_STA_MAX_IE)	/* 584 */
+
+static void hi5622_sta_free_buffer(struct hi5622_cfg80211 *c)
+{
+	struct hi5622_sta_ctx *s = &c->sta;
+
+	if (s->join_buf && c->ctx && c->ctx->pdev) {
+		dma_free_coherent(&c->ctx->pdev->dev, HI5622_STA_BUF_SIZE,
+				  s->join_buf, (dma_addr_t)s->join_dma);
+	}
+	s->join_buf = NULL;
+	s->join_dma = 0;
+}
+
+/* Fill the coherent buffer with the cfg80211 request data and return the
+ * device-visible addresses for the body. */
+static int hi5622_sta_fill_buffer(struct hi5622_cfg80211 *c,
+				  struct cfg80211_connect_params *sme,
+				  struct hi5622_sta_join_bufs *bufs)
+{
+	struct hi5622_sta_ctx *s = &c->sta;
+	struct device *dev = &c->ctx->pdev->dev;
+	dma_addr_t dma;
+	void *buf;
+
+	buf = dma_alloc_coherent(dev, HI5622_STA_BUF_SIZE, &dma, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, 0, HI5622_STA_BUF_SIZE);
+
+	/* BSSID is mandatory for a posted join (body always carries a bssid
+	 * address; a NULL would hand the firmware a wild pointer). */
+	memcpy((u8 *)buf + HI5622_STA_OFF_BSSID, sme->bssid, ETH_ALEN);
+	memcpy((u8 *)buf + HI5622_STA_OFF_SSID, sme->ssid, sme->ssid_len);
+	if (sme->key && sme->key_len)
+		memcpy((u8 *)buf + HI5622_STA_OFF_KEY, sme->key, sme->key_len);
+	if (sme->ie && sme->ie_len)
+		memcpy((u8 *)buf + HI5622_STA_OFF_IE, sme->ie, sme->ie_len);
+
+	hi5622_sta_free_buffer(c);
+	s->join_buf = buf;
+	s->join_dma = (u32)dma;
+
+	bufs->bssid_va = s->join_dma + HI5622_STA_OFF_BSSID;
+	bufs->ssid_va = s->join_dma + HI5622_STA_OFF_SSID;
+	bufs->key_va = sme->key_len ? s->join_dma + HI5622_STA_OFF_KEY : 0u;
+	bufs->ie_va = sme->ie_len ? s->join_dma + HI5622_STA_OFF_IE : 0u;
+	bufs->ie_len = sme->ie_len;
+	return 0;
+}
+
+static int hi5622_sta_build_connect(struct hi5622_cfg80211 *c,
+				    struct cfg80211_connect_params *sme,
+				    u8 *frame, size_t cap, size_t *frame_len,
+				    bool with_buffers)
+{
+	struct hi5622_sta_join_bufs bufs;
+	struct hi5622_sta_connect_check chk;
+	u8 body[HI5622_STA_CONNECT_BODY_LEN];
+	int rc;
+
+	memset(&bufs, 0, sizeof(bufs));
+	chk.ssid = sme->ssid;
+	chk.ssid_len = (u32)sme->ssid_len;
+	chk.bssid = sme->bssid;
+	chk.ie_len = (u32)sme->ie_len;
+	chk.key_len = (u32)sme->key_len;
+	chk.auth_type = (u32)sme->auth_type;
+	rc = hi5622_sta_connect_check(&chk);
+	if (rc)
+		return rc;
+	if (with_buffers) {
+		if (!sme->bssid) {
+			dev_warn(&c->ctx->pdev->dev,
+				 "sta connect: wildcard BSSID is not postable (the vendor body always carries a bssid address) - fail closed\n");
+			return -EOPNOTSUPP;
+		}
+		rc = hi5622_sta_fill_buffer(c, sme, &bufs);
+		if (rc)
+			return rc;
+	}
+	bufs.ssid_len = (u8)sme->ssid_len;
+	bufs.mfp = (u8)sme->mfp;
+	bufs.privacy = sme->privacy ? 1u : 0u;
+	bufs.auth_type = (u8)sme->auth_type;
+	bufs.key_len = sme->key_len;
+	bufs.key_idx = sme->key_idx;
+
+	rc = hi5622_sta_connect_body(body, sizeof(body), &bufs);
+	if (rc)
+		return rc;
+	rc = hi5622_sta_wal_frame(frame, cap, frame_len,
+				  HI5622_STA_WAL_CMD_CONNECT, body,
+				  sizeof(body), c->sta.seq++, 0u);
+	if (rc)
+		return rc;
+	return hi5622_sta_frame_check(frame, *frame_len,
+				      HI5622_STA_WAL_CMD_CONNECT,
+				      sizeof(body));
+}
+
+int hi5622_sta_connect(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       struct cfg80211_connect_params *sme)
+{
+	u8 frame[HI5622_STA_FRAME_MAX];
+	size_t frame_len = 0;
+	int rc;
+
+	if (!c || !dev || !sme || !c->ctx || !c->ctx->pdev)
+		return -EINVAL;
+	if (!c->wiphy_registered)
+		return -ENODEV;
+	if (dev->ieee80211_ptr && dev->ieee80211_ptr->iftype !=
+	    NL80211_IFTYPE_STATION) {
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta connect: only STATION interfaces are supported (iftype %d)\n",
+			 dev->ieee80211_ptr->iftype);
+		return -EOPNOTSUPP;
+	}
+	if (hi5622_sta_join > HI5622_STA_JOIN_MAX) {
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta connect: sta_join=%u out of range (0..%u)\n",
+			 hi5622_sta_join, HI5622_STA_JOIN_MAX);
+		return -EINVAL;
+	}
+	if (!hi5622_sta_join) {
+		dev_info_once(&c->ctx->pdev->dev,
+			      "sta connect: host STA model validated but the firmware join is disabled (sta_join=0 fail-closed); the vendor path is WAL cfg-event opcode 0x123 - see docs/incoming/wifi-sta-static/\n");
+		return -EOPNOTSUPP;
+	}
+
+	c->sta.connects++;
+	rc = hi5622_sta_build_connect(c, sme, frame, sizeof(frame), &frame_len,
+				      hi5622_sta_join >= 2u);
+	if (rc) {
+		c->sta.last_error = rc;
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta connect: frame build refused (%d) - no device write\n", rc);
+		return rc;
+	}
+	if (hi5622_sta_join == 1u) {
+		dev_info(&c->ctx->pdev->dev,
+			 "sta connect: WAL cfg-event opcode 0x%x frame built+validated (%zu B, ssid_len=%zu auth=%d privacy=%d bssid=%pM) - dry run (sta_join=1), nothing posted\n",
+			 HI5622_STA_WAL_CMD_CONNECT, frame_len, sme->ssid_len,
+			 (int)sme->auth_type, sme->privacy ? 1 : 0, sme->bssid);
+		c->sta.last_error = -EOPNOTSUPP;
+		return -EOPNOTSUPP;
+	}
+
+	rc = hi5622_frame_post(c->ctx, frame, frame_len, "sta_connect", NULL);
+	if (rc) {
+		c->sta.last_error = rc;
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta connect: WAL join frame NOT posted (%d) - fail closed (allow_frames=%u)\n",
+			 rc, hi5622_allow_frames);
+		return rc;
+	}
+	memcpy(c->sta.bssid, sme->bssid, ETH_ALEN);
+	c->sta.join_posted = true;
+	dev_info(&c->ctx->pdev->dev,
+		 "sta connect: WAL cfg-event opcode 0x%x posted (%zu B, ssid_len=%zu auth=%d privacy=%d bssid=%pM) - EXPERIMENTAL: completion needs the D2H management path, no cfg80211_connect_done is faked\n",
+		 HI5622_STA_WAL_CMD_CONNECT, frame_len, sme->ssid_len,
+		 (int)sme->auth_type, sme->privacy ? 1 : 0, c->sta.bssid);
+	return 0;
+}
+
+int hi5622_sta_disconnect(struct hi5622_cfg80211 *c, struct net_device *dev,
+			  u16 reason_code)
+{
+	struct hi5622_sta_disconnect_params p;
+	u8 body[HI5622_STA_DISCONNECT_BODY_LEN];
+	u8 frame[HI5622_STA_FRAME_MAX];
+	size_t frame_len = 0;
+	int rc;
+
+	if (!c || !dev || !c->ctx || !c->ctx->pdev)
+		return -EINVAL;
+	if (!hi5622_sta_join || hi5622_sta_join > HI5622_STA_JOIN_MAX)
+		return -EOPNOTSUPP;
+	if (!c->sta.join_posted)
+		return -ENOTCONN;
+
+	c->sta.disconnects++;
+	memset(&p, 0, sizeof(p));
+	memcpy(p.bssid, c->sta.bssid, ETH_ALEN);
+	p.reason_code = reason_code;
+	rc = hi5622_sta_disconnect_body(body, sizeof(body), &p);
+	if (rc == 0)
+		rc = hi5622_sta_wal_frame(frame, sizeof(frame), &frame_len,
+					  HI5622_STA_WAL_CMD_DISCONNECT, body,
+					  sizeof(body), c->sta.seq++, 0u);
+	if (rc == 0)
+		rc = hi5622_sta_frame_check(frame, frame_len,
+					    HI5622_STA_WAL_CMD_DISCONNECT,
+					    sizeof(body));
+	if (rc) {
+		c->sta.last_error = rc;
+		return rc;
+	}
+	if (hi5622_sta_join == 1u) {
+		dev_info(&c->ctx->pdev->dev,
+			 "sta disconnect: WAL cfg-event opcode 0x%x frame built+validated (%zu B, reason=%u) - dry run, nothing posted\n",
+			 HI5622_STA_WAL_CMD_DISCONNECT, frame_len, reason_code);
+		return -EOPNOTSUPP;
+	}
+	rc = hi5622_frame_post(c->ctx, frame, frame_len, "sta_disconnect", NULL);
+	if (rc) {
+		c->sta.last_error = rc;
+		return rc;
+	}
+	c->sta.join_posted = false;
+	dev_info(&c->ctx->pdev->dev,
+		 "sta disconnect: WAL cfg-event opcode 0x%x posted (%zu B, reason=%u, bssid=%pM)\n",
+		 HI5622_STA_WAL_CMD_DISCONNECT, frame_len, reason_code,
+		 c->sta.bssid);
+	return 0;
+}
+
+void hi5622_sta_remove(struct hi5622_cfg80211 *c)
+{
+	if (!c)
+		return;
+	hi5622_sta_free_buffer(c);
+	c->sta.join_posted = false;
+}
--- a/hi5622_sta_frames.c
+++ b/hi5622_sta_frames.c
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_sta_frames.c - WAL cfg-event STA join/disconnect frame builders
+ * (clean-room).  See hi5622_sta_frames.h and ../REPORT.md sec 3.
+ */
+#include "hi5622_sta_frames.h"
+
+#ifdef __KERNEL__
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+
+static void hst_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+static void hst_put32(u8 *p, u32 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+	p[2] = (u8)((v >> 16) & 0xffu);
+	p[3] = (u8)((v >> 24) & 0xffu);
+}
+
+static u16 hst_get16(const u8 *p)
+{
+	return (u16)((u16)p[0] | ((u16)p[1] << 8));
+}
+
+static u32 hst_get32(const u8 *p)
+{
+	return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) |
+	       ((u32)p[3] << 24);
+}
+
+int hi5622_sta_connect_body(u8 *body, size_t cap,
+			    const struct hi5622_sta_join_bufs *p)
+{
+	if (!body || !p)
+		return -EINVAL;
+	if (cap < HI5622_STA_CONNECT_BODY_LEN)
+		return -ENOSPC;
+	if (p->ssid_len == 0u || p->ssid_len > HI5622_STA_MAX_SSID)
+		return -EINVAL;
+	if (p->ie_len > HI5622_STA_MAX_IE)
+		return -EINVAL;
+	if (p->key_len > HI5622_STA_MAX_KEY)
+		return -EINVAL;
+	if (!hi5622_sta_auth_type_valid(p->auth_type))
+		return -EINVAL;
+
+	memset(body, 0, HI5622_STA_CONNECT_BODY_LEN);
+	/* +0x00 stays 0 (reserved [V]: the vendor struct is memset() to 0). */
+	body[0x01] = p->ssid_len;
+	body[0x02] = p->mfp;
+	body[0x03] = 0u;
+	hst_put32(body + 0x04, p->ie_va);
+	hst_put32(body + 0x08, p->ssid_va);
+	hst_put32(body + 0x0c, p->bssid_va);
+	body[0x10] = p->privacy ? 1u : 0u;
+	body[0x11] = p->auth_type;
+	body[0x12] = p->key_len;
+	body[0x13] = p->key_idx;
+	hst_put32(body + 0x14, p->key_va);
+	hst_put32(body + 0x68, p->ie_len);
+	return 0;
+}
+
+int hi5622_sta_disconnect_body(u8 *body, size_t cap,
+			      const struct hi5622_sta_disconnect_params *p)
+{
+	if (!body || !p)
+		return -EINVAL;
+	if (cap < HI5622_STA_DISCONNECT_BODY_LEN)
+		return -ENOSPC;
+	memset(body, 0, HI5622_STA_DISCONNECT_BODY_LEN);
+	memcpy(body, p->bssid, 6);
+	hst_put16(body + 0x06, p->reason_code);
+	body[0x0f] = 1u;	/* vendor constant [V] */
+	return 0;
+}
+
+int hi5622_sta_wal_frame(u8 *out, size_t cap, size_t *out_len, u16 wal_cmd,
+			 const u8 *body, u16 body_len, u32 seq, u8 dst)
+{
+	size_t total;
+	u16 data_len;
+
+	if (!out || (body_len && !body) || dst > 0x0fu)
+		return -EINVAL;
+	if (wal_cmd == 0u)
+		return -EINVAL;
+	if (body_len > (u16)(HI5622_STA_FRAME_MAX - HI5622_STA_WAL_HDR_LEN))
+		return -E2BIG;
+	total = (size_t)HI5622_STA_WAL_HDR_LEN + body_len;
+	data_len = (u16)(4u + body_len);
+	if (cap < total)
+		return -ENOSPC;
+
+	memset(out, 0, total);
+	/* 12-byte HCC header: group 2 (core/band), HCC id 0 (the WAL carrier
+	 * the bench-proven AP-start frames use), tag 0x5a5a. */
+	out[0] = (u8)(HI5622_STA_HCC_GROUP_CORE & 0x0fu);
+	out[1] = (u8)(0x01u | ((dst & 0x0fu) << 4));
+	out[2] = 0u;
+	out[3] = 0u;
+	hst_put16(out + 0x04, (u16)total);
+	hst_put16(out + 0x06, HI5622_STA_HCC_ID_WAL);
+	out[8] = 0u;
+	out[9] = (u8)(dst & 0x0fu);
+	hst_put16(out + 0x0a, HI5622_STA_HCC_TAG);
+	/* WAL envelope. */
+	hst_put32(out + 0x0c, 0u);			/* cookie */
+	hst_put32(out + 0x10, HI5622_STA_WAL_MSG_CFG);
+	hst_put16(out + 0x14, 0u);			/* pad */
+	hst_put16(out + 0x16, data_len);
+	hst_put32(out + 0x18, seq);
+	hst_put16(out + 0x1c, wal_cmd);
+	hst_put16(out + 0x1e, body_len);
+	if (body_len)
+		memcpy(out + HI5622_STA_WAL_HDR_LEN, body, body_len);
+	if (out_len)
+		*out_len = total;
+	return 0;
+}
+
+int hi5622_sta_frame_check(const u8 *frame, size_t len, u16 wal_cmd,
+			   u16 body_len)
+{
+	size_t total = (size_t)HI5622_STA_WAL_HDR_LEN + body_len;
+
+	if (!frame || len != total)
+		return -EINVAL;
+	if ((frame[0] & 0x0fu) != HI5622_STA_HCC_GROUP_CORE)
+		return -EINVAL;
+	if (((frame[1] >> 4) & 0x0fu) != (frame[9] & 0x0fu))
+		return -EINVAL;
+	if (hst_get16(frame + 0x04) != (u16)total)
+		return -EINVAL;
+	if (hst_get16(frame + 0x06) != HI5622_STA_HCC_ID_WAL)
+		return -EINVAL;
+	if (hst_get16(frame + 0x0a) != HI5622_STA_HCC_TAG)
+		return -EINVAL;
+	if (hst_get32(frame + 0x10) != HI5622_STA_WAL_MSG_CFG)
+		return -EINVAL;
+	if (hst_get16(frame + 0x16) != (u16)(4u + body_len))
+		return -EINVAL;
+	if (hst_get16(frame + 0x1c) != wal_cmd)
+		return -EINVAL;
+	if (hst_get16(frame + 0x1e) != body_len)
+		return -EINVAL;
+	return 0;
+}
--- a/hi5622_sta_frames.h
+++ b/hi5622_sta_frames.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_sta_frames.h - WAL cfg-event STA join/disconnect frame builders
+ * for the Hi5622V100 clean-room driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (wifi-sta-static lane, shared task task-141,
+ * 2026-11-24).  Only decoded wire facts are encoded here; the vendor code
+ * itself is not reproduced or linked.
+ *
+ * WIRE SHAPE (proven on the bench for the same WAL family by the AP-start
+ * lane, whose 4 frames are consumed by the firmware):
+ *
+ *   12-byte HCC header (group 2 = core/band, HCC id 0, tag 0x5a5a)
+ *   +0x0c u32 cookie        (0)
+ *   +0x10 u32 wal message   (1 = WAL_MSG_CFG)
+ *   +0x14 u16 pad           (0)
+ *   +0x16 u16 data_len      (4 + body_len)
+ *   +0x18 u32 sequence
+ *   +0x1c u16 wal opcode    (0x123 connect / 0x0d0 disconnect)
+ *   +0x1e u16 body_len
+ *   +0x20 body[body_len]    (total = 32 + body_len)
+ *
+ * CONNECT BODY (108 B; wal_cfg80211_connect 2.5.24 .text+0x100590, the
+ * 108-byte local struct it memcpy()s into wal_cfg80211_start_req):
+ *   +0x01 u8  ssid_len      (cfg80211_connect_params.ssid_len)
+ *   +0x02 u8  mfp
+ *   +0x04 u32 ie buffer address      (host-DRAM address, see REPORT 3.3)
+ *   +0x08 u32 ssid buffer address
+ *   +0x0c u32 bssid buffer address
+ *   +0x10 u8  privacy
+ *   +0x11 u8  auth_type
+ *   +0x12 u8  key_len
+ *   +0x13 u8  key_idx
+ *   +0x14 u32 key buffer address
+ *   +0x18..+0x67 zero
+ *   +0x68 u32 ie_len
+ *
+ * DISCONNECT BODY (16 B; wal_cfg80211_disconnect .text+0x100844):
+ *   +0x00 u8 bssid[6]
+ *   +0x06 u16 reason code
+ *   +0x0f u8 1 (vendor constant, wal_cfg80211_start_disconnect [V])
+ *
+ * FAIL CLOSED: these are pure builders; nothing posts unless the kernel
+ * caller passes the hi5622_sta module-parameter gate.
+ */
+#ifndef HI5622_STA_FRAMES_H
+#define HI5622_STA_FRAMES_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+#include "hi5622_sta_logic.h"
+
+#define HI5622_STA_CONNECT_BODY_LEN	108u
+#define HI5622_STA_DISCONNECT_BODY_LEN	16u
+#define HI5622_STA_WAL_HDR_LEN		32u
+#define HI5622_STA_HCC_HDR_LEN		12u
+#define HI5622_STA_HCC_TAG		0x5a5au
+#define HI5622_STA_HCC_GROUP_CORE	2u
+#define HI5622_STA_HCC_ID_WAL		0u	/* bench-proven AP WAL carrier */
+#define HI5622_STA_WAL_MSG_CFG		1u	/* WAL message class          */
+#define HI5622_STA_FRAME_MAX							\
+	(HI5622_STA_WAL_HDR_LEN + HI5622_STA_CONNECT_BODY_LEN)
+
+/* The four host-DRAM buffer addresses the body carries.  0 = absent
+ * (the firmware must not dereference it - connect [I]/[U] contract). */
+struct hi5622_sta_join_bufs {
+	u32 ssid_va;
+	u32 bssid_va;
+	u32 ie_va;
+	u32 ie_len;
+	u32 key_va;
+	u8  ssid_len;
+	u8  mfp;
+	u8  privacy;
+	u8  auth_type;
+	u8  key_len;
+	u8  key_idx;
+};
+
+struct hi5622_sta_disconnect_params {
+	u8  bssid[6];
+	u16 reason_code;
+};
+
+/* Fill the 108-byte connect body; 0 on success, -EINVAL/-ENOSPC otherwise. */
+int hi5622_sta_connect_body(u8 *body, size_t cap,
+			    const struct hi5622_sta_join_bufs *p);
+
+/* Fill the 16-byte disconnect body. */
+int hi5622_sta_disconnect_body(u8 *body, size_t cap,
+			      const struct hi5622_sta_disconnect_params *p);
+
+/* Assemble one complete WAL cfg-event frame (HCC header + WAL envelope +
+ * body).  out_len is written on success.  dst is the HCC destination
+ * nibble (0 = local endpoint). */
+int hi5622_sta_wal_frame(u8 *out, size_t cap, size_t *out_len, u16 wal_cmd,
+			 const u8 *body, u16 body_len, u32 seq, u8 dst);
+
+/* Structural self-check of a finished frame: header group/id/tag, lengths,
+ * WAL envelope and opcode.  0 = acceptable. */
+int hi5622_sta_frame_check(const u8 *frame, size_t len, u16 wal_cmd,
+			   u16 body_len);
+
+#endif /* HI5622_STA_FRAMES_H */
