+    mutex_lock(&t->lock);
+    pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+                     "DP MAC band0 role-5 tail (read-only; host programs 0x00..0x54 only):\n");
+    for (i = 0; i < ARRAY_SIZE(offs); i++)
+        pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+                         "  +0x%02x = 0x%08x%s\n", offs[i],
