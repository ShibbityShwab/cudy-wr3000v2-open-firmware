+/* ===================================================================
+ * 4. Free-ring refill watermark (lane wifi-rx-watermark, task-156)
+ *
+ * Publishing free-buffer producer entries is what keeps the MAC RX engine
+ * fed: the device consumes one posted entry per received frame and hands the
+ * buffer back through the completion ring.  The drain may only re-publish
+ * buffers a validated completion returned, and one drain action consumes at
+ * most rx_drain_max completions; a completion backlog larger than that used
+ * to leak posted entries permanently (their free-ring slots were never
+ * re-published), so sustained EAPOL/data traffic could starve the MAC at its
+ * prefetch watermark (the iwlwifi RX_STALLED shape; the sibling Hi1105 HAL
+ * treats a free-ring-empty event as a first-class refill trigger).  The
+ * watermark pass keeps the posted count at >= wm_pct percent of depth
+ * (ath11k-style >= 3/4) as long as returned buffers exist.
+ *
+ * Policy (all integer, bounded, fail-closed - host-tested by
+ * tools/rx_wm_selftest.c):
+ *   target  = depth * wm_pct / 100      (0 = disabled; clamped to >= 1 for
+ *                                        any 0 < wm_pct <= 100)
+ *   trigger = posted < target
+ *   refill  = min(avail, depth - posted, cap) when triggered, else 0
+ * posted is the producer-consumer distance (hi5622_rx_ring_pending is used in
+ * that direction as well); avail is the count of buffers returned by drained
+ * completions and still queued; cap is the per-action bound.  depth - posted
+ * is exactly the number of consumed-but-not-republished slots, so a refill can
+ * never overwrite a posted entry.  Malformed input returns a negative error;
+ * nothing is clamped or guessed.
+ * =================================================================== */
+#define HIL_RX_WM_PCT_MAX    100u  /* rx_refill_wm is a percent of depth   */
+#define HIL_RX_WM_PCT_DEF     75u  /* keep >= 3/4 posted (ath11k-style)    */
+
+/* Target posted slots for one free ring (0 = watermark disabled). */
+int hi5622_rx_wm_target(rx_u32 depth, unsigned int wm_pct, rx_u32 *target);
+/* 1 = posted is below the watermark (refill needed), 0 = healthy, <0 = error. */
+int hi5622_rx_wm_triggered(rx_u32 depth, unsigned int wm_pct, rx_u32 posted);
+/* Buffers to re-publish this action: 0 when healthy, else min(avail,
+ * depth - posted, cap).  Errors are returned, never clamped. */
+int hi5622_rx_wm_plan(rx_u32 depth, unsigned int wm_pct, rx_u32 posted,
+                      rx_u32 avail, rx_u32 cap, rx_u32 *refill);
+
 #endif /* HI5622_RX_LIVE_H */
