+++ patched-clean/hi5622_monitor.h	2026-11-26 15:54:13.882451970 +0700
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_monitor.h - local-mirror monitor mode integration for the Hi5622V100
+ * clean-room driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (monitor2 lane, shared task task-246, 2026-11-26).
+ * Materialises the cfg80211 monitor design documented by the monitor-mode lane
+ * (task-241); no vendor source/object/firmware bytes are reproduced.
+ *
+ * It answers exactly the two cfg80211 gaps the IMAGE #3 driver had:
+ *   1. .set_monitor_channel (metadata-only chandef store; NEVER a firmware
+ *      tune), fail-closed at monitor=0;
+ *   2. radiotap delivery of the frames that already reach the two existing RX
+ *      sinks (mgmt D2H event and the completion-ring data path).
+ * The capture is a *mirror of what the AP VAP receives*, not promiscuous
+ * mode; the true sniffer needs a firmware switch the vendor driver does not
+ * have.  The mirror is a no-op until the F1 RX gate (host-bound g1 id13 copy)
+ * is fixed, because the sinks themselves are silent until then.
+ */
+#ifndef _HI5622_MONITOR_H
+#define _HI5622_MONITOR_H
+
+#include <linux/types.h>
+
+struct cfg80211_chan_def;
+struct hi5622_cfg80211;
+struct hi5622_pci;
+struct himg_rx_frame;
+struct net_device;
+struct wiphy;
+
+/* cfg80211 ops implementation (registered as .set_monitor_channel). */
+int hi5622_monitor_op_set_channel(struct wiphy *wiphy, struct net_device *dev,
+				  struct cfg80211_chan_def *chandef);
+
+/* One-shot status line when the monitor interface is created. */
+void hi5622_monitor_iface_created(struct hi5622_cfg80211 *c);
+
+/* Mirror hooks: called by the two existing RX sinks BEFORE their own policy
+ * gates, so the mirror does not depend on mgmt_rx/eapol_rx.  Both take the cfg
+ * lock with mutex_trylock only (HCC service thread; a busy lock drops the
+ * mirror frame and counts it, never blocks the RX path). */
+void hi5622_monitor_rx_mgmt(struct hi5622_pci *ctx,
+			    const struct himg_rx_frame *rx);
+void hi5622_monitor_rx_data(struct hi5622_pci *ctx, const u8 *mpdu, u32 len);
+
+#endif /* _HI5622_MONITOR_H */
diff -ruN pristine/hi5622_monitor_logic.c patched-clean/hi5622_monitor_logic.c
--- pristine/hi5622_monitor_logic.c	1970-01-01 07:00:00.000000000 +0700
+++ patched-clean/hi5622_monitor_logic.c	2026-11-26 15:53:51.884544027 +0700
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_monitor_logic.c - portable local-mirror monitor logic (host-testable).
+ *
+ * ORIGINAL clean-room code (monitor2 lane, task-246, 2026-11-26).
+ * See hi5622_monitor_logic.h for the semantics and the pinned byte vectors.
+ * No vendor material is reproduced.
+ */
+#include "hi5622_monitor_logic.h"
+
+int himon_mode_ok(uint32_t mode)
+{
+	return mode == HIMON_OFF || mode == HIMON_LOCAL_MIRROR;
+}
+
+const char *himon_mode_name(uint32_t mode)
+{
+	switch (mode) {
+	case HIMON_OFF:
+		return "off";
+	case HIMON_LOCAL_MIRROR:
+		return "local-mirror";
+	default:
+		return "invalid";
+	}
+}
+
+int himon_chan_to_freq(uint32_t band, uint32_t channel, uint16_t *freq)
+{
+	uint32_t mhz;
+
+	if (!freq)
+		return -1;
+	if (band == 0u) {
+		if (channel >= 1u && channel <= 13u)
+			mhz = 2407u + 5u * channel;
+		else if (channel == 14u)
+			mhz = 2484u;
+		else
+			return -1;
+	} else if (band == 1u) {
+		/* 5 GHz UNII-1..UNII-3/ISM centre channels (36..177 step 4
+		 * plus the common 5 MHz-indexed values); a simple static map,
+		 * no regulatory decision is made here. */
+		if (channel < 36u || channel > 177u)
+			return -1;
+		mhz = 5000u + 5u * channel;
+	} else {
+		return -1;
+	}
+	if (mhz > 0xffffu)
+		return -1;
+	*freq = (uint16_t)mhz;
+	return 0;
+}
+
+static void himon_put_le16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v & 0xffu);
+	p[1] = (uint8_t)((v >> 8) & 0xffu);
+}
+
+static void himon_put_le32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v & 0xffu);
+	p[1] = (uint8_t)((v >> 8) & 0xffu);
+	p[2] = (uint8_t)((v >> 16) & 0xffu);
+	p[3] = (uint8_t)((v >> 24) & 0xffu);
+}
+
+size_t himon_rt_build(uint8_t *buf, size_t cap, uint16_t freq,
+		      int have_chan, int rssi, int have_rssi)
+{
+	size_t len = 8u;
+	size_t off = 8u;
+	uint32_t present = 0u;
+
+	if (!buf)
+		return 0u;
+	if (have_chan && have_rssi)
+		len = 13u;
+	else if (have_chan)
+		len = 12u;
+	if (cap < len)
+		return 0u;
+
+	/* radiotap fixed part: version 0, pad, it_len, it_present */
+	buf[0] = 0u;
+	buf[1] = 0u;
+	himon_put_le16(&buf[2], (uint16_t)len);
+	if (have_chan && have_rssi) {
+		present = 0x00000008u;		/* IEEE80211_RADIOTAP_CHANNEL */
+		present |= 0x00000808u;		/* IEEE80211_RADIOTAP_DBM_ANTSIGNAL */
+	} else if (have_chan) {
+		present = 0x00000008u;
+	}
+	himon_put_le32(&buf[4], present);
+
+	if (!have_chan)
+		return len;	/* R0: no per-frame channel metadata */
+
+	himon_put_le16(&buf[off], freq);
+	off += 2u;
+	himon_put_le16(&buf[off], 0u);	/* channel flags: unknown, never guessed */
+	off += 2u;
+	if (have_rssi) {
+		buf[off] = (uint8_t)(int8_t)rssi;
+		off += 1u;
+	}
+	return len;
+}
diff -ruN pristine/hi5622_monitor_logic.h patched-clean/hi5622_monitor_logic.h
--- pristine/hi5622_monitor_logic.h	1970-01-01 07:00:00.000000000 +0700
+++ patched-clean/hi5622_monitor_logic.h	2026-11-26 15:55:09.096224999 +0700
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_monitor_logic.h - portable, kernel-free logic for the local-mirror
+ * monitor mode of the Hi5622V100 clean-room driver (Cudy WR3000 v2.0).
+ *
+ * ORIGINAL clean-room code (monitor2 lane, shared task task-246, 2026-11-26).
+ * Materialises the monitor-mode design first committed as documentation by the
+ * monitor-mode lane (task-241) / MONITOR-MODE/CFG80211-MONITOR.md.
+ *
+ * This file has NO kernel dependencies (stdint/stddef only) so the exact byte
+ * vectors below can be asserted by a host compiler without a kernel tree.
+ * No vendor source/object/firmware bytes are reproduced.
+ *
+ * v1 semantics (deliberate, fail-closed):
+ *   - monitor=0 (off)     : the monitor netdev is inert, set channel is
+ *                           -EOPNOTSUPP, nothing is mirrored;
+ *   - monitor=1 (mirror)  : frames that already reach the two existing RX
+ *                           sinks are copied to the first monitor netdev with
+ *                           a radiotap header; NO firmware write, NO channel
+ *                           tune - the mirror follows the AP;
+ *   - monitor>1           : refused, mirroring disabled.
+ * This is NOT a promiscuous sniffer: true promiscuous mode needs a decoded
+ * hi5622 firmware switch that does not exist in the vendor driver.
+ */
+#ifndef _HI5622_MONITOR_LOGIC_H
+#define _HI5622_MONITOR_LOGIC_H
+
+/* kernel build: <linux/types.h> provides size_t + uint8_t/uint16_t/uint32_t;
+ * host build: the C library headers do.  No other kernel dependency. */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#endif
+
+#define HIMON_OFF		0u	/* default, fail-closed */
+#define HIMON_LOCAL_MIRROR	1u
+
+/* RX MPDU sanity cap used by the data path (0x618 = 1560 B). */
+#define HIMON_MAX_FRAME		0x618u
+/* Largest radiotap header this builder produces (R2 = 13 B fixed+fields). */
+#define HIMON_RT_MAX		13u
+
+/* 1 = mode allowed by policy (0 or 1), 0 = refused. */
+int himon_mode_ok(uint32_t mode);
+/* "off" / "local-mirror" / "invalid"; never NULL. */
+const char *himon_mode_name(uint32_t mode);
+
+/* Channel -> centre frequency (MHz). band 0 = 2.4 GHz, band 1 = 5 GHz.
+ * 0 = mapped, -1 = not a channel this band plan can map. */
+int himon_chan_to_freq(uint32_t band, uint32_t channel, uint16_t *freq);
+
+/* Radiotap header builder (version 0, no FCS, no TX flags).
+ * have_chan selects the CHANNEL field (u16 freq + u16 flags = 0); have_rssi
+ * additionally selects DBM_ANTSIGNAL (s8 rssi).  have_rssi without have_chan
+ * degrades to the R0 8-byte header (no per-frame channel metadata available).
+ *
+ * Pinned vectors (asserted by tools/monitor_selftest.c):
+ *   R0                     = 00 00 08 00 00 00 00 00
+ *   R1 @2412 MHz           = 00 00 0c 00 08 00 00 00 | 6c 09 | 00 00
+ *   R2 @2437 MHz rssi -62  = 00 00 0d 00 08 08 00 00 | 85 09 | 00 00 | c2
+ *
+ * Returns the header length in bytes, or 0 when refused (NULL buf, cap too
+ * small).  Never writes past cap.
+ */
+size_t himon_rt_build(uint8_t *buf, size_t cap, uint16_t freq,
+		      int have_chan, int rssi, int have_rssi);
+
+#endif /* _HI5622_MONITOR_LOGIC_H */
