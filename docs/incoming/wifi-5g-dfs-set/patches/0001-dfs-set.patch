diff -ruN -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x '.*.cmd' -x Module.symvers -x 'modules.order*' -x build.log -x '*.a' r5-build/hi5622_dfs_set.c dfs-set-src/hi5622_dfs_set.c
--- a/hi5622_dfs_set.c	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_dfs_set.c	2026-11-26 12:26:26.982905749 +0700
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_dfs_set.c - H2D 0x07E7 DFS-SET frame builder and the fail-closed
+ * AP-start gates (see the header for the decoded contract).
+ *
+ * ORIGINAL clean-room code (lane wifi-5g-dfs-set, task-227).  The frame
+ * layout is the committed g0-id1 config-event shape of the sibling lanes
+ * (wifi-fw-desc-table T2, wifi-dfs-mode-send); the key/worker/register/flag
+ * facts are this lane's ../REPORT.md + ../TABLES.md, re-derived by
+ * tools/fw_dfs_set_re.py.  This file only synthesizes the host-built
+ * protocol bytes and refuses malformed/unrequested requests.
+ */
+#include "hi5622_dfs_set.h"
+
+#ifdef __KERNEL__
+#include <linux/kernel.h>
+#include <linux/string.h>
+#else
+#include <stdio.h>
+#include <string.h>
+#endif
+
+static const u32 hi5622_dfs_set_reg_ca[HI5622_DFS_SET_REG_COUNT] = {
+	HI5622_DFS_SET_REG0_CA,
+	HI5622_DFS_SET_REG0_CA + HI5622_DFS_SET_REG_STRIDE_A,
+	HI5622_DFS_SET_REG0_CA + 2u * HI5622_DFS_SET_REG_STRIDE_A,
+	HI5622_DFS_SET_REG_A0_CA,
+	HI5622_DFS_SET_REG_A0_CA + HI5622_DFS_SET_REG_STRIDE_A,
+	HI5622_DFS_SET_REG_A0_CA + 2u * HI5622_DFS_SET_REG_STRIDE_A,
+};
+
+const u32 *hi5622_dfs_set_regs(void)
+{
+	return hi5622_dfs_set_reg_ca;
+}
+
+static void ds_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+int hi5622_dfs_set_plan(unsigned int dfs_set, unsigned int beacon_static,
+			unsigned int band, struct hi5622_dfs_set_plan *out)
+{
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (dfs_set > HI5622_DFS_SET_PARM_MAX)
+		return -EINVAL;
+	if (band > 1u)
+		return -EINVAL;
+	/* An explicit 0x07E7 request outside the vendor-order AP ladder cannot be
+	 * honoured (the frame has no safe slot in the legacy ladder): refuse
+	 * instead of silently dropping it. */
+	if (dfs_set != HI5622_DFS_SET_MODE_OFF && beacon_static != 1u)
+		return -EINVAL;
+	out->mode = (u8)dfs_set;
+	/* Band-1 AP start only: the six registers the worker writes are the
+	 * band-1 SMAC sub-base CA 0x4010E000 (the band-0 sibling is +0x4010A000
+	 * and is not touched by the worker). */
+	out->post = (dfs_set != HI5622_DFS_SET_MODE_OFF && band == 1u);
+	return 0;
+}
+
+int hi5622_dfs_set_build(u8 *wire, size_t cap, size_t *out_len, u8 body)
+{
+	u8 *b;
+
+	if (!wire || !out_len)
+		return -EINVAL;
+	if (body != (u8)HI5622_DFS_SET_BODY_ARM &&
+	    body != (u8)HI5622_DFS_SET_BODY_CLEAR)
+		return -EINVAL;
+	if (cap < HI5622_DFS_SET_WIRE_LEN)
+		return -ENOSPC;
+
+	b = wire;
+	memset(b, 0, HI5622_DFS_SET_WIRE_LEN);
+
+	/* 12-byte HCC header: group 0, id 1 (the config-event carrier), the
+	 * inherited fa/fb field bytes (fb = the AP-start module context, the
+	 * F2 field-B fix) and the transport tag.  Same header path as the
+	 * committed 0x00F7 / 0x01F7 frames. */
+	b[0] = 0x00u;
+	b[1] = 0x01u;
+	b[2] = (u8)HI5622_DFS_SET_FA;
+	b[3] = (u8)HI5622_DFS_SET_FB;
+	ds_put16(b + 4, (u16)HI5622_DFS_SET_WIRE_LEN);
+	ds_put16(b + 6, (u16)HI5622_DFS_SET_ID);
+	b[8] = 0x00u;
+	b[9] = 0x00u;
+	ds_put16(b + 10, (u16)HI5622_DFS_SET_TAG);
+
+	/* 8-byte token (the inherited bench-executed g0-id1 pattern), key u16 at
+	 * hdr+20, body length u16 at hdr+22, body at hdr+24. */
+	b[HI5622_DFS_SET_TOKEN_OFF + 4u] = 0x01u;
+	ds_put16(b + HI5622_DFS_SET_KEY_OFF, (u16)HI5622_DFS_SET_KEY);
+	ds_put16(b + HI5622_DFS_SET_LEN_OFF, (u16)HI5622_DFS_SET_BODY_LEN);
+	b[HI5622_DFS_SET_BODY_OFF] = body;
+
+	/* The inherited 4-byte 0xFF tail every working g0-id1 frame carries. */
+	memset(b + HI5622_DFS_SET_TAIL_OFF, 0xff, 4);
+
+	*out_len = HI5622_DFS_SET_WIRE_LEN;
+	return 0;
+}
+
+u8 hi5622_dfs_set_reg_pattern(const u16 regs[HI5622_DFS_SET_REG_COUNT])
+{
+	u8 pattern = 0u;
+	unsigned int i;
+
+	if (!regs)
+		return 0u;
+	for (i = 0u; i < HI5622_DFS_SET_REG_COUNT; i++)
+		if (regs[i] & 1u)
+			pattern |= (u8)(1u << i);
+	return pattern;
+}
+
+bool hi5622_dfs_set_armed(u8 regs_pattern)
+{
+	return regs_pattern == (u8)HI5622_DFS_SET_ARM_MASK;
+}
+
+int hi5622_dfs_set_precheck(const struct hi5622_dfs_set_probe *p, u8 mode)
+{
+	if (!p)
+		return -EINVAL;
+	if (mode > HI5622_DFS_SET_PARM_MAX || mode == HI5622_DFS_SET_MODE_OFF)
+		return -EINVAL;
+	/* The worker's own gate 2: the per-link resolver and the started-module
+	 * scan CA 0xA4C0E need a module context whose state byte is 1..3. */
+	if (!p->mctx || !p->b4ac)
+		return -ENODEV;
+	if (p->band != 1u)
+		return -EINVAL;
+	if (p->state < HI5622_DFS_SET_STATE_MIN ||
+	    p->state > HI5622_DFS_SET_STATE_MAX)
+		return -EAGAIN;
+	if (p->ec8 != 1u)
+		return -EAGAIN;
+	if (mode == HI5622_DFS_SET_MODE_CLEAR) {
+		/* The worker writes the clear pattern only when it reads the
+		 * armed state back; otherwise the path is diagnostic-only. */
+		if (p->cac != 1u)
+			return -EPERM;
+		if (!hi5622_dfs_set_armed(p->regs_pattern))
+			return -EPERM;
+		return 0;
+	}
+	/* ARM / ARM_CLEAR: the arm is skipped when u32[ctx+0x4A0] is set, and
+	 * the helper pair is skipped when the CAC flag is already 1. */
+	if (p->b4a0)
+		return -EBUSY;
+	if (p->cac)
+		return -EALREADY;
+	return 0;
+}
+
+const char *hi5622_dfs_set_verdict(const struct hi5622_dfs_set_probe *p,
+				   u8 mode)
+{
+	if (!p)
+		return "?";
+	if (!p->mctx)
+		return "module ctx unresolved - the key-0x0064 bind cannot have run";
+	if (!p->b4ac)
+		return "u32[mctx+0x4AC] helper object is ZERO - the worker returns before arming";
+	if (p->band != 1u)
+		return "mctx band is not 5 GHz - the 0x07E7 worker is a band-1 step";
+	if (p->state < HI5622_DFS_SET_STATE_MIN ||
+	    p->state > HI5622_DFS_SET_STATE_MAX)
+		return "mctx[0x0E] is not 1..3 - the CA 0xA4C0E started-module scan returns 0 (post the 0x0065 VAP start first)";
+	if (p->ec8 != 1u)
+		return "bandobj+0xEC8 band-up flag is not 1 - the band is not up";
+	if (mode == HI5622_DFS_SET_MODE_CLEAR) {
+		if (p->cac != 1u)
+			return "CLEAR refused: the CAC-active flag is already 0";
+		if (!hi5622_dfs_set_armed(p->regs_pattern))
+			return "CLEAR refused: the sub-base registers are not in the armed pattern {1,0,1,1,0,1}";
+		return "the CLEAR gates are open";
+	}
+	if (p->b4a0)
+		return "u32[mctx+0x4A0] gate is nonzero - the worker would return without setting the flag";
+	if (p->cac)
+		return "the CAC-active flag is already 1 - ARM is a no-op";
+	return "the ARM gates are open";
+}
+
+int hi5622_dfs_set_postcheck(unsigned int cac_flag, u8 mode)
+{
+	if (mode == HI5622_DFS_SET_MODE_CLEAR)
+		return cac_flag == 0u ? 0 : -EIO;
+	/* ARM and the ARM half of ARM_CLEAR must show the flag set. */
+	return cac_flag == 1u ? 0 : -EIO;
+}
+
+int hi5622_dfs_set_status_line(unsigned int dfs_set, int last_rc,
+			       unsigned int posts, unsigned int refusals,
+			       char *buf, size_t len)
+{
+	const char *mode;
+	int n;
+
+	if (!buf || !len)
+		return -EINVAL;
+	switch (dfs_set) {
+	case HI5622_DFS_SET_MODE_OFF:
+		mode = "off";
+		break;
+	case HI5622_DFS_SET_MODE_ARM:
+		mode = "arm";
+		break;
+	case HI5622_DFS_SET_MODE_ARM_CLEAR:
+		mode = "arm+clear";
+		break;
+	case HI5622_DFS_SET_MODE_CLEAR:
+		mode = "clear";
+		break;
+	default:
+		mode = "invalid";
+		break;
+	}
+	n = snprintf(buf, len,
+		     "dfs_set: param=%u (%s) last_rc=%d posts=%u refusals=%u\n",
+		     dfs_set, mode, last_rc, posts, refusals);
+	if (n < 0)
+		return n;
+	return (int)((size_t)n < len ? (size_t)n : len - 1);
+}
diff -ruN -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x '.*.cmd' -x Module.symvers -x 'modules.order*' -x build.log -x '*.a' r5-build/hi5622_dfs_set.h dfs-set-src/hi5622_dfs_set.h
--- a/hi5622_dfs_set.h	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_dfs_set.h	2026-11-26 12:26:31.140951898 +0700
@@ -0,0 +1,196 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_dfs_set.h - H2D g0-id1 config-event key 0x07E7 (the DFS SET: CAC
+ * arm/clear, the firmware writer of the band-1 SMAC sub-base) for the
+ * Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-5g-dfs-set, shared task task-227,
+ * 2026-11-26).  The frame, worker, register and flag facts are the committed
+ * decode of this lane's tools/fw_dfs_set_re.py (89/89) on the pinned image
+ * (928,920 B, sha256 7fc87e20...311b, CA = file + 0x40000):
+ *
+ *   g0-id1 table A row 94: key 0x07E7 -> worker CA 0xB58FC
+ *   body = u8(hdr+24), 1 byte:  0x01 = ARM (CAC/radar detect), 0x00 = CLEAR
+ *   the worker's gates: u8[hcc_ctx+17] == 1; u32[hcc_ctx+0x4B0] != 0;
+ *                       the started-module-context scan CA 0xA4C0E != 0
+ *                       (>= 1 module ctx with state u8[ctx+0x0E] in 1..3)
+ *   the ARM writes bit0 of six u16 registers of the BAND-1 SMAC sub-base
+ *     CA 0x4010E000 {1} +4 {0} +8 {1} +0xA0 {1} +0xA4 {0} +0xA8 {1}
+ *     (the non-bit0 bits are preserved: val = (old & ~1) | bit)
+ *   the CLEAR writes bit0 = 0 on all six (only when it reads the exact ARM
+ *     pattern back; the mismatch path is diagnostic-only)
+ *   then the CAC-active flag u8[module_ctx+0x4A5] is set 1 (ARM) / 0 (CLEAR)
+ *     through the helper pair CA 0xF593C+0x5F450 (arm) / 0xF58D8+0x5E95C
+ *     (clear); the arm is gated by u32[module_ctx+0x4A0] == 0.
+ *
+ * The vendor HOST-side CAC machinery (60 s / 600 s CAC timers, the 30 min
+ * NOL, hmac_start_all_bss_of_band on CAC completion) is NOT implemented
+ * here: this module posts the 0x07E7 SET/CLEAR wire frame only, with the
+ * fail-closed live gates.  That is exactly the missing writer the bench
+ * needs (the band-1 SMAC sub-base 0x4010E000 bit0 = 0 on our boot vs 1 on
+ * the stock); a full CAC state machine is a later rung.
+ *
+ * NOT the same key as the sibling dfs_mode (0x01F7, body {03}, the RF/DFS
+ * mode): 0x01F7 writes the band object's RF mode byte +0xF04 and the RF
+ * register image; 0x07E7 writes the SMAC sub-base radar-detect bits and the
+ * CAC-active flag.  The two frames share only the g0-id1 carrier geometry.
+ *
+ * fail-closed module parameter (owned by hi5622_scan.c):
+ *   dfs_set=0 (default)  no 0x07E7 frame at all - current behaviour;
+ *   dfs_set=1            ARM: post body {01} on a band-1 AP start AFTER
+ *                        the 0x0065 VAP start (the only ladder step that
+ *                        sets mctx[0x0E] in our ladder, i.e. passes the
+ *                        0xA4C0E gate) and BEFORE the 0x0242 band start;
+ *   dfs_set=2            ARM then CLEAR back-to-back (both frames); the
+ *                        post-read must see the CAC flag 1 then 0;
+ *   dfs_set=3            CLEAR only (requires the armed state + pattern);
+ *   dfs_set>3            refused (-EINVAL) before any frame.
+ *
+ * Pure C99: the same code compiles in the kernel module and in the host
+ * selftest (src/dfs_set_selftest.c).  No vendor source or object code is
+ * reproduced; the frame bytes are the host-built protocol bytes.
+ */
+#ifndef HI5622_DFS_SET_H
+#define HI5622_DFS_SET_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+/* ---- fail-closed module parameter contract ---------------------------- */
+#define HI5622_DFS_SET_PARM_MAX		3u
+#define HI5622_DFS_SET_MODE_OFF		0u
+#define HI5622_DFS_SET_MODE_ARM		1u
+#define HI5622_DFS_SET_MODE_ARM_CLEAR	2u
+#define HI5622_DFS_SET_MODE_CLEAR	3u
+
+/* ---- frame geometry [V] (the g0-id1 config-event carrier) -------------- */
+#define HI5622_DFS_SET_HDR_LEN		12u
+#define HI5622_DFS_SET_TOKEN_OFF	12u
+#define HI5622_DFS_SET_KEY_OFF		20u
+#define HI5622_DFS_SET_LEN_OFF		22u
+#define HI5622_DFS_SET_BODY_OFF		24u
+#define HI5622_DFS_SET_TAIL_OFF		25u
+#define HI5622_DFS_SET_TAG		0x5a5au
+#define HI5622_DFS_SET_ID		1u
+#define HI5622_DFS_SET_KEY		0x07e7u
+#define HI5622_DFS_SET_BODY_LEN		1u
+#define HI5622_DFS_SET_BODY_ARM		0x01u
+#define HI5622_DFS_SET_BODY_CLEAR	0x00u
+#define HI5622_DFS_SET_FA		0x00u
+#define HI5622_DFS_SET_FB		0x00u	/* header byte 3: field B = AP-start module ctx */
+#define HI5622_DFS_SET_WIRE_LEN		29u	/* 12+8+2+2+1+4 */
+#define HI5622_DFS_SET_TOTAL_FIELD	0x001du
+#define HI5622_DFS_SET_NODE_WORD1	0x001d6d2bu
+
+/* ---- the band-1 SMAC sub-base (CA = device IO; phys = CA + 0x3B8000) -- */
+#define HI5622_DFS_SET_REG_COUNT	6u
+#define HI5622_DFS_SET_REG0_CA		0x4010e000u
+#define HI5622_DFS_SET_REG_STRIDE_A	4u	/* +0/+4/+8 */
+#define HI5622_DFS_SET_REG_A0_CA	0x4010e0a0u	/* +0xA0/+0xA4/+0xA8 */
+/* bit i of the pattern = bit0 of REG_CA[i]; the stock's armed state reads
+ * {1,0,1,1,0,1} = 0x2D.  The value written is always (old & ~1) | bit. */
+#define HI5622_DFS_SET_ARM_MASK		0x2du
+#define HI5622_DFS_SET_ARM_BITS		{1u, 0u, 1u, 1u, 0u, 1u}
+
+/* ---- live firmware fields the gates read (read-only) [V] -------------- */
+#define HI5622_DFS_SET_MCTX_STATE_OFF	0x0eu	/* u8: VAP state, 1..3 started */
+#define HI5622_DFS_SET_MCTX_BAND_OFF	0x11u	/* u8: 1 = 5 GHz */
+#define HI5622_DFS_SET_MCTX_BAND_OBJ_OFF 0x4b8u	/* u32: band object */
+#define HI5622_DFS_SET_MCTX_GATE_OFF	0x4a0u	/* u32: 0 to arm */
+#define HI5622_DFS_SET_MCTX_CAC_OFF	0x4a5u	/* u8: CAC active flag */
+#define HI5622_DFS_SET_MCTX_HELPER_OFF	0x4acu	/* u32: helper object */
+#define HI5622_DFS_SET_BANDOBJ_EC8_OFF	0x0ec8u	/* u8: band-up, 1 = normal */
+#define HI5622_DFS_SET_STATE_MIN	1u
+#define HI5622_DFS_SET_STATE_MAX	3u
+
+/* ---- fail-closed decision --------------------------------------------- */
+struct hi5622_dfs_set_plan {
+	bool	post;	/* true = build + post the frame(s) */
+	u8	mode;	/* the dfs_set parameter value when post is true */
+};
+
+/* Fill *out with the DFS-SET decision.
+ *  - 0 on success.  post = true only for 1..3 on a band-1 AP with the
+ *    beacon_static vendor order enabled;
+ *  - -EINVAL for NULL out, dfs_set > HI5622_DFS_SET_PARM_MAX, band > 1, or
+ *    a non-zero dfs_set without beacon_static == 1 (fail closed: never
+ *    silently ignore an explicit request, never guess a band).
+ * band == 0 with a valid parameter is a clean no-post: the firmware
+ * registers the 0x07E7 worker touches are the BAND-1 SMAC sub-base. */
+int hi5622_dfs_set_plan(unsigned int dfs_set, unsigned int beacon_static,
+			unsigned int band, struct hi5622_dfs_set_plan *out);
+
+/* Build one 29-byte HCC wire frame into wire/cap (body = arm or clear).
+ * Refuses (-EINVAL) NULL/bad arguments or a body other than 0/1; -ENOSPC
+ * when cap < HI5622_DFS_SET_WIRE_LEN.  The caller posts the result through
+ * hi5622_frame_post() (the only wire path); this module never touches the
+ * device. */
+int hi5622_dfs_set_build(u8 *wire, size_t cap, size_t *out_len, u8 body);
+
+/* Read-only live snapshot the gates test.  The kernel layer fills it from
+ * firmware RAM + the six device registers; no field is ever a wire input. */
+struct hi5622_dfs_set_probe {
+	u32	mctx;		/* module context (0 = unresolved) */
+	u8	band;		/* u8[mctx+0x11]; 1 = 5 GHz */
+	u8	state;		/* u8[mctx+0x0E]; 1..3 = started */
+	u8	ec8;		/* u8[bandobj+0xEC8]; 1 = band up */
+	u8	cac;		/* u8[mctx+0x4A5]; 1 = CAC active */
+	u32	b4a0;		/* u32[mctx+0x4A0]; 0 = arm allowed */
+	u32	b4ac;		/* u32[mctx+0x4AC]; helper object */
+	u8	regs_pattern;	/* bit i = bit0 of REG_CA[i] (device IO read) */
+};
+
+/* Check the fail-closed pre-post gates for plan->mode.
+ *  - 0 when the frame may be posted;
+ *  - -ENODEV  mctx unresolved or the helper object u32[mctx+0x4AC] is 0;
+ *  - -EINVAL  band is not 5 GHz;
+ *  - -EAGAIN  the VAP state u8[mctx+0x0E] is not 1..3, or the band-up flag
+ *             u8[bandobj+0xEC8] is not 1;
+ *  - -EBUSY   ARM/ARM_CLEAR: u32[mctx+0x4A0] is non-zero (the worker would
+ *             return without setting the flag);
+ *  - -EALREADY ARM/ARM_CLEAR: the CAC flag is already 1;
+ *  - -EPERM   CLEAR: the CAC flag is not 1 or the registers are not in the
+ *             armed pattern {1,0,1,1,0,1} (the worker would not write). */
+int hi5622_dfs_set_precheck(const struct hi5622_dfs_set_probe *p, u8 mode);
+
+/* Human-readable verdict of the FIRST failing gate, for the dmesg line. */
+const char *hi5622_dfs_set_verdict(const struct hi5622_dfs_set_probe *p,
+				   u8 mode);
+
+/* Post-post verdict (read-only): 0 when the expected CAC flag is seen.
+ *  - -EIO for ARM/ARM_CLEAR when the flag is not 1, or CLEAR when not 0. */
+int hi5622_dfs_set_postcheck(unsigned int cac_flag, u8 mode);
+
+/* The six band-1 SMAC sub-base register addresses (CA), in ARM-pattern
+ * order: {+0, +4, +8, +0xA0, +0xA4, +0xA8}.  The kernel layer converts each
+ * through hi5622_io_bar0() and readl()s bit0 for the read-only evidence. */
+const u32 *hi5622_dfs_set_regs(void);
+
+/* Bit pattern of the six u16 registers (bit i = val[i] & 1), and the armed
+ * test.  Used for the dmesg evidence line and the CLEAR pre-gate. */
+u8 hi5622_dfs_set_reg_pattern(const u16 regs[HI5622_DFS_SET_REG_COUNT]);
+bool hi5622_dfs_set_armed(u8 regs_pattern);
+
+/* One read-only sysfs status line (the driver appends it to cfg80211_status):
+ *   dfs_set: param=N (off|arm|arm+clear|clear) last_rc=R posts=P refusals=F
+ * last_rc is -ENODATA until the first attempt.  Returns the length, clamped
+ * like the sibling status lines. */
+int hi5622_dfs_set_status_line(unsigned int dfs_set, int last_rc,
+			       unsigned int posts, unsigned int refusals,
+			       char *buf, size_t len);
+
+#endif /* HI5622_DFS_SET_H */
