+			mctx + HI5622_DFS_SET_MCTX_BAND_OFF);
+	p->b4a0 = hi5622_fw_ram_read(ctx, mctx + HI5622_DFS_SET_MCTX_GATE_OFF);
+	p->b4ac = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_DFS_SET_MCTX_HELPER_OFF);
+	p->cac = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_DFS_SET_MCTX_CAC_OFF);
+	bandobj = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_DFS_SET_MCTX_BAND_OBJ_OFF);
