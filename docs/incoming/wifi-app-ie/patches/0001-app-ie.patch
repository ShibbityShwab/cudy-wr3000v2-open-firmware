diff --git a/hi5622_app_ie.c b/hi5622_app_ie.c
new file mode 100644
index 0000000..2e47ad6
--- /dev/null
+++ b/hi5622_app_ie.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_app_ie.c - H2D g0 id 0x20 app/vendor IE frame builder, the cfg80211
+ * vendor-IE collector and the fail-closed AP-start gate (see the header for
+ * the decoded contract).
+ *
+ * ORIGINAL clean-room code (lane wifi-app-ie, task-234).  The frame layout,
+ * the payload geometry and the firmware handler behaviour are the committed
+ * facts of ../TABLES.md T1-T5 (stock capture + builder/firmware decode); this
+ * file only synthesizes the host-built protocol bytes and refuses malformed
+ * requests.
+ */
+#include "hi5622_app_ie.h"
+
+#ifdef __KERNEL__
+#include <linux/kernel.h>
+#include <linux/string.h>
+#else
+#include <stdio.h>
+#include <string.h>
+#endif
+
+static void ai_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+static void ai_put32(u8 *p, u32 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+	p[2] = (u8)((v >> 16) & 0xffu);
+	p[3] = (u8)((v >> 24) & 0xffu);
+}
+
+/* Walk one IE TLV list: count its elements and vendor-specific (0xDD) IEs and
+ * prove the list is well formed (every element's len field fits the buffer).
+ * Returns 0 or -EINVAL.  Does not copy. */
+static int ai_ie_list_check(const u8 *ies, size_t len, unsigned int *vendor_ies)
+{
+	size_t off = 0;
+	unsigned int v = 0;
+
+	if (!ies || !len)
+		return 0;
+	while (off + 2u <= len) {
+		size_t elen = ies[off + 1u];
+
+		if (off + 2u + elen > len)
+			return -EINVAL;
+		if (ies[off] == HI5622_APP_IE_ELEM_ID)
+			v++;
+		off += 2u + elen;
+	}
+	if (off != len)
+		return -EINVAL;
+	if (vendor_ies)
+		*vendor_ies = v;
+	return 0;
+}
+
+int hi5622_app_ie_plan(unsigned int app_ie,
+		       unsigned int beacon_static,
+		       unsigned int vap_start_g0,
+		       unsigned int band,
+		       unsigned int type,
+		       unsigned int vap,
+		       const u8 *ies, size_t ies_len,
+		       struct hi5622_app_ie_plan *out)
+{
+	unsigned int vendor = 0;
+
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (app_ie > HI5622_APP_IE_PARM_MAX)
+		return -EINVAL;
+	if (app_ie == 0u)
+		return 0;		/* off: never build a frame */
+	/* The ladder slot this lane reuses is the beacon_static vendor order:
+	 * it is the only AP-start path that posts the key-0x0065 VAP start
+	 * (vap_start_g0) this frame must follow. */
+	if (beacon_static != 1u || vap_start_g0 != 1u)
+		return -EINVAL;
+	if (band > 1u || type > HI5622_APP_IE_TYPE_MAX ||
+	    vap > HI5622_APP_IE_VAP_MAX)
+		return -EINVAL;
+	if (ies_len > HI5622_APP_IE_MAX_BYTES)
+		return -EINVAL;
+	if (ai_ie_list_check(ies, ies_len, &vendor))
+		return -EINVAL;
+	out->post = true;
+	out->vap = vap;
+	out->type = (u8)type;
+	out->mode = HI5622_APP_IE_MODE_SAVE;
+	out->ie_len = ies_len;
+	if (ies_len) {
+		if (!ies)
+			return -EINVAL;
+		memcpy(out->ie, ies, ies_len);
+	}
+	out->vendor_ies = vendor;
+	return 0;
+}
+
+int hi5622_app_ie_build(u8 *wire, size_t cap, size_t *out_len,
+			const struct hi5622_app_ie_plan *plan)
+{
+	size_t wire_len;
+	u8 *p;
+
+	if (!wire || !out_len || !plan)
+		return -EINVAL;
+	if (!plan->post)
+		return -EINVAL;		/* never build an unrequested frame */
+	if (plan->ie_len > HI5622_APP_IE_MAX_BYTES)
+		return -EINVAL;
+	wire_len = HI5622_APP_IE_HDR_LEN + HI5622_APP_IE_PAYLOAD_HDR_LEN +
+		   plan->ie_len;
+	if (cap < wire_len)
+		return -ENOSPC;
+
+	memset(wire, 0, wire_len);
+
+	/* 12-byte HCC header: group 0, message id 0x20, total length, tag.
+	 * Byte-for-byte the vendor builder (CA 0x600cc) and the captured stock
+	 * frame (T1): b0 low nibble cleared, b1 = 0x01, b2 = ctx[1] = 0,
+	 * b3 = ctx[0] = the VAP/module index. */
+	wire[0] = (u8)HI5622_APP_IE_GROUP;
+	wire[1] = HI5622_APP_IE_HDR_B1;
+	wire[2] = HI5622_APP_IE_HDR_B2;
+	wire[3] = (u8)(plan->vap & 0xffu);
+	ai_put16(wire + 4, (u16)wire_len);		/* total */
+	ai_put16(wire + 6, (u16)HI5622_APP_IE_MSG_ID);
+	wire[8] = 0u;
+	wire[9] = 0u;
+	ai_put16(wire + 10, (u16)HI5622_APP_IE_TAG);
+
+	/* Payload = the vendor caller struct copy: u32 ie_len, u8 type,
+	 * u8 mode, 2 pad, ie bytes, and the copied-but-unused 3-byte tail. */
+	p = wire + HI5622_APP_IE_HDR_LEN;
+	ai_put32(p, (u32)plan->ie_len);
+	p[4] = plan->type;
+	p[5] = plan->mode;
+	if (plan->ie_len)
+		memcpy(p + HI5622_APP_IE_DATA_OFF, plan->ie, plan->ie_len);
+	/* p[DATA_OFF + ie_len .. +2] stay zero: memset above guarantees the
+	 * 3-byte tail the vendor builder copies past the used struct. */
+
+	*out_len = wire_len;
+	return 0;
+}
+
+int hi5622_app_ie_collect(u8 *out, size_t cap, size_t *out_len,
+			  unsigned int *vendor_ies,
+			  const u8 *ies, size_t ies_len)
+{
+	size_t off = 0, used;
+
+	if (!out || !out_len)
+		return -EINVAL;
+	used = *out_len;
+	if (!ies || !ies_len)
+		return 0;
+	while (off + 2u <= ies_len) {
+		size_t elen = ies[off + 1u];
+		size_t total = 2u + elen;
+
+		if (off + total > ies_len)
+			return -EBADMSG;
+		if (ies[off] == HI5622_APP_IE_ELEM_ID) {
+			if (used + total > cap)
+				return -ENOSPC;
+			memcpy(out + used, ies + off, total);
+			used += total;
+			if (vendor_ies)
+				(*vendor_ies)++;
+		}
+		off += total;
+	}
+	if (off != ies_len)
+		return -EBADMSG;
+	*out_len = used;
+	return 0;
+}
+
+int hi5622_app_ie_status_line(unsigned int app_ie, unsigned int type,
+			      unsigned int beacon_static,
+			      unsigned int vap_start_g0,
+			      int last_rc, unsigned int posted,
+			      unsigned int refused, unsigned int ie_len,
+			      unsigned int vendor_ies,
+			      char *buf, size_t len)
+{
+	const char *mode;
+	int n;
+
+	if (!buf || !len)
+		return -EINVAL;
+	if (app_ie == 0u)
+		mode = "off";
+	else if (app_ie == HI5622_APP_IE_PARM_MAX)
+		mode = "ap-post";
+	else
+		mode = "invalid";
+	n = snprintf(buf, len,
+		     "app_ie: param=%u (%s) type=%u beacon_static=%u vap_start_g0=%u last_rc=%d posted=%u refused=%u ie_len=%u vendor_ies=%u\n",
+		     app_ie, mode, type, beacon_static, vap_start_g0,
+		     last_rc, posted, refused, ie_len, vendor_ies);
+	if (n < 0)
+		return n;
+	return (int)((size_t)n < len ? (size_t)n : len - 1);
+}
diff --git a/hi5622_app_ie.h b/hi5622_app_ie.h
new file mode 100644
index 0000000..4f333ac
--- /dev/null
+++ b/hi5622_app_ie.h
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_app_ie.h - H2D g0 id 0x20 vendor/app IE set (hmac_config_h2d_send_app_ie)
+ * for the Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-app-ie, shared task task-234, 2026-11-26).
+ * The frame geometry and the firmware handler behaviour are the committed
+ * decode of the first-ever stock H2D capture (sibling lane wifi-stock-h2d-census,
+ * task-232, commit e977557) plus this lane's builder/firmware disassembly:
+ * see ../REPORT.md and ../TABLES.md.  No vendor source, object code, firmware
+ * byte, calibration value, MAC or secret is reproduced here.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * The vendor host builds a group-0 / message-id 0x20 HCC frame whose payload is
+ * a per-VAP IE table entry: {u32 ie_len; u8 type; u8 mode; u8 pad[2]; u8 ie[]}
+ * plus a 3-byte zero tail (the vendor builder copies ie_len+11 bytes from its
+ * caller struct; the stock capture shows the 11-byte payload geometry exactly).
+ * The firmware handler (CA 0x85631) validates payload_len <= 616 and ie_len <=
+ * 608, looks the VAP up by hdr[3], and stores the IE blob in the per-VAP slot
+ * table chip_vap+0x24c+20*type (types 0..19; mode 0 = path A "save/clear").
+ *
+ * The driver half: cfg80211 hands the AP's cfg80211_beacon_data down in
+ * start_ap() (beacon tail, beacon_ies, proberesp_ies, assocresp_ies - the
+ * buffers hostapd fills from its vendor_elements= option, via
+ * NL80211_ATTR_BEACON_TAIL / NL80211_ATTR_IE_PROBE_RESP /
+ * NL80211_ATTR_IE_ASSOC_RESP).  This module extracts the well-formed
+ * vendor-specific IEs (element id 0xDD) from those buffers and synthesizes the
+ * 0x20 frame; the fail-closed app_ie parameter decides whether it may be
+ * posted inside the beacon_static AP-start ladder (after the 0x0065 VAP start,
+ * before the 0x0242 band start).
+ *
+ * Frame-type slot semantics (payload byte 4 = "type") are graded [I] in
+ * TABLES.md: 0..19 are the vendor's per-VAP IE classes; the stock capture
+ * cleared class 4, the vendor's AP association-response builder appends classes
+ * 4 and 9, a scan path uses class 1, an internal WPS/P2P wrapper hardcodes
+ * class 3, and classes 12/17/18 use a different (mode != 0) payload shape that
+ * this lane does not ship.  The type is therefore an explicit module parameter
+ * (default 4 = the stock-observed class), never a guess in code.
+ *
+ * Pure C99: the same code compiles in the kernel module and in the host
+ * selftest (src/app_ie_selftest.c); tools/run-host-tests.sh compiles both.
+ */
+#ifndef HI5622_APP_IE_H
+#define HI5622_APP_IE_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+/* ---- fail-closed module parameter contract ---------------------------- */
+/* The only accepted non-zero value of app_ie; anything above is refused. */
+#define HI5622_APP_IE_PARM_MAX		1u
+/* The firmware's per-VAP IE slot count is 20 (index 0..19). */
+#define HI5622_APP_IE_TYPE_MAX		19u
+#define HI5622_APP_IE_VAP_MAX		255u
+
+/* ---- frame geometry [V] (wifi-stock-h2d-census T6 + this lane's builder) */
+#define HI5622_APP_IE_HDR_LEN		12u	/* HCC header */
+#define HI5622_APP_IE_PAYLOAD_HDR_LEN	11u	/* 8 used bytes + 3 zero tail */
+#define HI5622_APP_IE_DATA_OFF		8u	/* IE bytes start in the payload */
+#define HI5622_APP_IE_TAIL_PAD		3u	/* vendor copies ie_len+11 bytes */
+#define HI5622_APP_IE_MAX_BYTES		608u	/* firmware ie_len bound */
+#define HI5622_APP_IE_MAX_PAYLOAD	(HI5622_APP_IE_DATA_OFF + HI5622_APP_IE_MAX_BYTES + HI5622_APP_IE_TAIL_PAD)
+#define HI5622_APP_IE_WIRE_MAX		(HI5622_APP_IE_HDR_LEN + HI5622_APP_IE_MAX_PAYLOAD)
+#define HI5622_APP_IE_MSG_ID		0x0020u	/* hdr[6] u16 LE */
+#define HI5622_APP_IE_GROUP		0u	/* hdr[0] high nibble */
+#define HI5622_APP_IE_TAG		0x5a5au	/* hdr[10] u16 LE */
+#define HI5622_APP_IE_HDR_B1		0x01u	/* stock frame byte 1 */
+#define HI5622_APP_IE_HDR_B2		0x00u	/* stock frame byte 2 */
+#define HI5622_APP_IE_MODE_SAVE		0u	/* payload byte 5 = 0 (path A) */
+#define HI5622_APP_IE_MAX_SOURCES	4u	/* tail/beacon/proberesp/assocresp */
+
+/* The vendor-specific IE element id this lane injects. */
+#define HI5622_APP_IE_ELEM_ID		0xddu
+
+/* The firmware per-VAP IE slot table (path A): slot = vap + 0x24c +
+ * 20*type; the slot is {u32 ie_ptr; u32 ie_len; u32 ie_cap; u8 key[6];}
+ * (firmware handler CA 0xFDB72 / host mirror mac_vap_save_app_ie).  These
+ * offsets are the read-only evidence the fire's probe uses. */
+#define HI5622_APP_IE_SLOT_OFF		0x24cu
+#define HI5622_APP_IE_SLOT_LEN_OFF	0x250u
+#define HI5622_APP_IE_SLOT_CAP_OFF	0x254u
+#define HI5622_APP_IE_SLOT_STRIDE	20u
+
+/* One prepared frame request (the plan) and the builder contract. */
+struct hi5622_app_ie_plan {
+	bool	 post;		/* 1 = build/post, 0 = parameter off */
+	u32	 vap;		/* VAP/module index -> hdr[3] (0..255) */
+	u8	 type;		/* firmware per-VAP IE class (0..19) */
+	u8	 mode;		/* payload byte 5: 0 = path A save/clear */
+	size_t	 ie_len;	/* bytes of ie[] (0 = clear the slot) */
+	u8	 ie[HI5622_APP_IE_MAX_BYTES];
+	unsigned int vendor_ies;/* count of 0xDD IEs inside ie[] */
+};
+
+/*
+ * Decide, fail-closed, whether the current AP start may post one 0x20 frame.
+ * Refusals (-EINVAL) happen before any wire byte:
+ *   - app_ie > HI5622_APP_IE_PARM_MAX
+ *   - app_ie == 1 without beacon_static == 1 (no ladder slot for the frame)
+ *   - app_ie == 1 without vap_start_g0 == 1 (no started VAP to attach to)
+ *   - band > 1, type > 19, vap > 255
+ *   - ie_len > 608 or a malformed IE TLV list
+ * app_ie == 0 returns a plan with post = false (the frame is never built).
+ */
+int hi5622_app_ie_plan(unsigned int app_ie,
+		       unsigned int beacon_static,
+		       unsigned int vap_start_g0,
+		       unsigned int band,
+		       unsigned int type,
+		       unsigned int vap,
+		       const u8 *ies, size_t ies_len,
+		       struct hi5622_app_ie_plan *out);
+
+/*
+ * Build the 12-byte HCC header + 11-byte payload header + IE bytes + 3 zero
+ * tail bytes.  Refuses a plan with post = false (never build an unrequested
+ * frame), a bad IE length, or a short buffer.
+ */
+int hi5622_app_ie_build(u8 *wire, size_t cap, size_t *out_len,
+			const struct hi5622_app_ie_plan *plan);
+
+/*
+ * Append every well-formed vendor-specific IE (element id 0xDD, whole TLV) of
+ * one cfg80211 IE buffer to out[] (multiple sources are collected by calling
+ * this repeatedly).  Malformed TLVs fail closed (-EBADMSG); an overflowing
+ * destination fails closed (-ENOSPC).  Empty input (NULL/0) is a no-op.
+ */
+int hi5622_app_ie_collect(u8 *out, size_t cap, size_t *out_len,
+			  unsigned int *vendor_ies,
+			  const u8 *ies, size_t ies_len);
+
+/* One read-only sysfs status line (the driver appends it to cfg80211_status). */
+int hi5622_app_ie_status_line(unsigned int app_ie, unsigned int type,
+			      unsigned int beacon_static,
+			      unsigned int vap_start_g0,
+			      int last_rc, unsigned int posted,
+			      unsigned int refused, unsigned int ie_len,
+			      unsigned int vendor_ies,
+			      char *buf, size_t len);
+
+#endif /* HI5622_APP_IE_H */
diff --git a/hi5622_scan.c b/hi5622_scan.c
index 3cef4f8..6d807e0 100644
--- a/hi5622_scan.c
+++ b/hi5622_scan.c
@@ -45,6 +45,7 @@
 #include "hi5622_band_start.h"
 #include "hi5622_dfs_mode.h"
 #include "hi5622_vap_start_g0.h"
+#include "hi5622_app_ie.h"
 
 /* =====================================================================
  * helpers
@@ -249,6 +250,38 @@ static int hi5622_vap_start_g0_last_rc = -ENODATA;	/* never attempted */
 static unsigned int hi5622_vap_start_g0_posts;
 static unsigned int hi5622_vap_start_g0_refusals;
 
+/* lane wifi-app-ie (task-234), FAIL-CLOSED default 0.  The H2D g0 id 0x20
+ * app/vendor IE set (the vendor builder CA 0x600cc): the firmware handler
+ * (CA 0x85631) stores a per-VAP IE blob in the slot table
+ * vap+0x24c+20*type the firmware frame builders read (TABLES T3/T4).  The
+ * driver collects the cfg80211 vendor IEs (element id 0xDD) that hostapd
+ * delivered through start_ap()'s cfg80211_beacon_data (beacon tail /
+ * beacon_ies / proberesp_ies / assocresp_ies - NL80211_ATTR_BEACON_TAIL,
+ * NL80211_ATTR_IE, NL80211_ATTR_IE_PROBE_RESP, NL80211_ATTR_IE_ASSOC_RESP)
+ * and posts ONE 0x20 frame inside the beacon_static ladder.
+ *   app_ie=0 (default) = no frame at all - current behaviour, byte-identical;
+ *   app_ie=1 = post the frame after the key-0x0065 VAP start and before the
+ *              0x0242 band start, on a beacon_static AP start only; needs a
+ *              non-empty vendor-IE list and the vap_start_g0=1 step;
+ *   app_ie>1 = refused at use time BEFORE any frame (fail closed).
+ * app_ie_type = the firmware per-VAP IE class (0..19; 4 = the class the stock
+ * capture cleared, T6 - an explicit parameter, never a guess in code).
+ * One meaning per module load; read-only. */
+static unsigned int hi5622_app_ie;
+module_param_named(app_ie, hi5622_app_ie, uint, 0444);
+MODULE_PARM_DESC(app_ie,
+		 "app/vendor IE injection (H2D g0 id 0x20): 0=off default, 1=post the cfg80211 vendor-IE list during the beacon_static AP start (needs vap_start_g0=1 and a non-empty 0xDD list), >1 refused");
+#define HI5622_APP_IE_TYPE_DEFAULT	4u	/* stock-observed class [I] */
+static unsigned int hi5622_app_ie_type = HI5622_APP_IE_TYPE_DEFAULT;
+module_param_named(app_ie_type, hi5622_app_ie_type, uint, 0444);
+MODULE_PARM_DESC(app_ie_type,
+		 "firmware per-VAP IE class for app_ie (0..19; default 4 = the stock-observed class; >19 refused)");
+static int hi5622_app_ie_last_rc = -ENODATA;	/* never attempted */
+static unsigned int hi5622_app_ie_posts;
+static unsigned int hi5622_app_ie_refusals;
+static unsigned int hi5622_app_ie_ie_len;
+static unsigned int hi5622_app_ie_vendor_ies;
+
 /* scan-complete lane (task-123): the bench measured the firmware returning 6
  * of the 13 requested per-channel results within the wifi-scan-ap lane's 5 s
  * bound (~830 ms/channel, ledger 2026-11-26 14:00), so a 13-channel request
@@ -1967,6 +2000,12 @@ int hi5622_scan_op_start_ap(struct wiphy *wiphy, struct net_device *dev,
 	/* G12 latch: only a confirmed mctx[0x0E] == 1 after the 0x0065 post may
 	 * allow the 0x0242 band start (read-only). */
 	bool vap_start_g0_ok = false;
+	/* lane wifi-app-ie (task-234): the collected cfg80211 vendor IEs and
+	 * the "a step is wanted" latch (app_ie=1 AND a non-empty list). */
+	u8 *app_ie_ies = NULL;
+	size_t app_ie_ies_len = 0;
+	unsigned int app_ie_vendor = 0;
+	bool app_ie_step = false;
 	int rc;
 
 	if (!s || !s->initialized || !settings || !dev)
@@ -2008,7 +2047,8 @@ int hi5622_scan_op_start_ap(struct wiphy *wiphy, struct net_device *dev,
 		return -EOPNOTSUPP;
 	p = kzalloc(sizeof(*p), GFP_KERNEL);
 	wire = kmalloc(HI5622_FRAME_MAX_TOTAL, GFP_KERNEL);
-	if (!p || !wire) {
+	app_ie_ies = kmalloc(HI5622_APP_IE_MAX_BYTES, GFP_KERNEL);
+	if (!p || !wire || !app_ie_ies) {
 		rc = -ENOMEM;
 		goto out;
 	}
@@ -2167,6 +2207,44 @@ int hi5622_scan_op_start_ap(struct wiphy *wiphy, struct net_device *dev,
 		rc = -EINVAL;
 		goto out;
 	}
+	/* lane wifi-app-ie (task-234): FAIL-CLOSED parameter gate for the H2D
+	 * g0 id 0x20 app/vendor IE set.  Runs BEFORE any frame (no partial
+	 * ladder on a bad parameter): app_ie 0 is the current behaviour; exactly
+	 * 1 needs the beacon_static vendor order (the only ladder with a slot
+	 * for the frame) AND the key-0x0065 VAP-start step (a started VAP to
+	 * attach the IE table to); app_ie_type is the firmware class 0..19. */
+	if (hi5622_app_ie > HI5622_APP_IE_PARM_MAX) {
+		dev_warn(wdev_dev,
+			 "cfg80211: start_ap REFUSED - app_ie=%u is not a valid app/vendor IE parameter (0=off, 1=post; no frame sent\n",
+			 hi5622_app_ie);
+		hi5622_app_ie_refusals++;
+		rc = -EINVAL;
