diff --git a/hi5622_sta_ops.c b/hi5622_sta_ops.c
new file mode 100644
index 0000000..ea253b6
--- /dev/null
+++ b/hi5622_sta_ops.c
@@ -0,0 +1,581 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_sta_ops.c - cfg80211 station operations + EAPOL/data RX delivery
+ * (Hi5622V100 clean-room driver, Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-sta-ops, shared task task-149,
+ * 2026-11-24).  Decoded facts and evidence markers: ../REPORT.md and
+ * ../TABLES.md; the portable builders/parsers are in hi5622_sta_ops_logic.c.
+ *
+ * The firmware per-STA context installed by .add_station is the vendor
+ * hmac AP-SME sequence (hmac_ap_assoc_check_chip_exist_user_proc):
+ *   g0 id7  user_add   (180 B: u16 AID, MAC, type=2, RSSI)
+ *   g0 id1  cfg event  (cmd 0x07d2: u16 AID, u8 asoc_state=1)
+ * The firmware table A row 0x07d2 -> worker CA 0x83e25 was decoded from the
+ * local PD4 image; it validates the user by AID and writes the state byte.
+ * .del_station mirrors the vendor cfg80211 op (WAL cfg-event kick opcode
+ * 0x00d0); the explicit g0 id9 user_del is decoded and host-tested but
+ * deliberately only posted when the sta_user_del module parameter enables
+ * it (deleting a firmware user twice is the documented E2 crash class).
+ */
+#include <linux/device.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <net/cfg80211.h>
+
+#include "hi5622_cfg80211.h"
+#include "hi5622_driver.h"
+#include "hi5622_frame_post.h"
+#include "hi5622_sta_frames.h"
+#include "hi5622_sta_ops.h"
+#include "hi5622_sta_ops_logic.h"
+
+/* 0 = fail closed (default), 1 = enable the cfg80211 station ops. */
+unsigned int hi5622_sta_ops_enable;
+module_param_named(sta_ops, hi5622_sta_ops_enable, uint, 0644);
+MODULE_PARM_DESC(sta_ops,
+		 "cfg80211 station ops: 0=fail closed (default; .add_station returns -EOPNOTSUPP), 1=post the decoded per-STA firmware context (g0 id7 user_add + g0 id1 cmd 0x07d2) and allow .del/.change/.get/.dump");
+
+/* 0 = no data RX delivery (default), 1 = deliver received data frames to the
+ * AP VAP netdev (EAPOL always, other ethertypes only for authorized STAs). */
+unsigned int hi5622_eapol_rx;
+module_param_named(eapol_rx, hi5622_eapol_rx, uint, 0644);
+MODULE_PARM_DESC(eapol_rx,
+		 "deliver received 802.11 data frames to the AP netdev (0=fail closed default, 1=EAPOL always + authorized-station data); used by dp_rx_drain");
+
+/* 0 = only the vendor .del_station kick (default), 1 = also post the g0 id9
+ * user_del for the station.  Double-deleting a firmware user is the E2 crash
+ * class, so this stays off unless a ladder explicitly enables it. */
+unsigned int hi5622_sta_user_del;
+module_param_named(sta_user_del, hi5622_sta_user_del, uint, 0644);
+MODULE_PARM_DESC(sta_user_del,
+		 "also post the decoded g0 id9 user_del on .del_station (0=vendor kick only default, 1=experimental)");
+
+#define HSOP_RX_ETH_MAX	(HSOP_ETH_HDR_LEN + 0x618u)	/* + max MPDU payload */
+
+static unsigned int hsop_flag_authorized(u32 mask, u32 set)
+{
+	u32 bit = 1u << NL80211_STA_FLAG_AUTHORIZED;
+
+	if (!(mask & bit))
+		return 0;
+	return (set & bit) ? 1u : 0u;
+}
+
+static unsigned int hsop_flag_authenticated(u32 mask, u32 set)
+{
+	u32 bit = 1u << NL80211_STA_FLAG_AUTHENTICATED;
+
+	if (!(mask & bit))
+		return 0;
+	return (set & bit) ? 1u : 0u;
+}
+
+static unsigned int hsop_flag_associated(u32 mask, u32 set)
+{
+	u32 bit = 1u << NL80211_STA_FLAG_ASSOCIATED;
+
+	if (!(mask & bit))
+		return 0;
+	return (set & bit) ? 1u : 0u;
+}
+
+void hi5622_sta_ops_init(struct hi5622_cfg80211 *c)
+{
+	if (!c)
+		return;
+	hsop_sta_table_init(&c->sta_table);
+	c->sta_ops_ap_dev = NULL;
+	c->sta_ops_seq = 0;
+}
+
+void hi5622_sta_ops_remove(struct hi5622_cfg80211 *c)
+{
+	if (!c)
+		return;
+	hsop_sta_table_init(&c->sta_table);
+	c->sta_ops_ap_dev = NULL;
+}
+
+static int hsop_vap_slot(struct hi5622_cfg80211 *c, struct net_device *dev)
+{
+	unsigned int i;
+
+	if (!c || !dev)
+		return -EINVAL;
+	for (i = 0; i < HI5622_CFG_MAX_VAPS; i++)
+		if (c->vap_dev[i] == dev)
+			return (int)i;
+	return -ENODEV;
+}
+
+static int hsop_is_ap_dev(struct net_device *dev)
+{
+	return dev && dev->ieee80211_ptr &&
+	       dev->ieee80211_ptr->iftype == NL80211_IFTYPE_AP;
+}
+
+static int hsop_post_user_add(struct hi5622_cfg80211 *c, u8 band, u8 vap_id,
+			      u16 aid, const u8 *mac)
+{
+	struct hsop_user_add_params p;
+	u8 wire[HSOP_USER_ADD_WIRE_LEN];
+	size_t len = 0;
+	int rc;
+
+	memset(&p, 0, sizeof(p));
+	p.band = band;
+	p.vap_id = vap_id;
+	p.hdr2 = 0;
+	p.dst = 0;
+	p.aid = aid;
+	memcpy(p.mac, mac, 6);
+	p.type = (u8)HSOP_USER_TYPE_AP;
+	p.rssi = (s8)HSOP_DEFAULT_RSSI;
+	rc = hsop_build_user_add(wire, sizeof(wire), &len, &p);
+	if (rc)
+		return rc;
+	rc = hsop_check_user_add(wire, len);
+	if (rc)
+		return rc;
+	rc = hi5622_frame_post(c->ctx, wire, len, "sta_user_add", NULL);
+	if (!rc)
+		c->sta_ops_user_add++;
+	return rc;
+}
+
+static int hsop_post_asoc_syn(struct hi5622_cfg80211 *c, u8 band, u8 vap_id,
+			      u16 aid, u8 state)
+{
+	struct hsop_asoc_syn_params p;
+	u8 wire[HSOP_ASOC_SYN_WIRE_LEN];
+	size_t len = 0;
+	int rc;
+
+	memset(&p, 0, sizeof(p));
+	p.band = band;
+	p.vap_id = vap_id;
+	p.hdr2 = 0;
+	p.dst = 0;
+	p.module = vap_id;
+	p.aid = aid;
+	p.state = state;
+	rc = hsop_build_asoc_syn(wire, sizeof(wire), &len, &p);
+	if (rc)
+		return rc;
+	rc = hsop_check_asoc_syn(wire, len);
+	if (rc)
+		return rc;
+	rc = hi5622_frame_post(c->ctx, wire, len, "sta_asoc_syn", NULL);
+	if (!rc)
+		c->sta_ops_asoc_syn++;
+	return rc;
+}
+
+static int hsop_post_kick(struct hi5622_cfg80211 *c, const u8 *mac, u16 reason,
+			  u8 subtype)
+{
+	struct hsop_kick_params p;
+	u8 body[HSOP_KICK_BODY_LEN];
+	u8 wire[HI5622_STA_FRAME_MAX];
+	size_t len = 0;
+	int rc;
+
+	if (!mac)
+		return -EINVAL;
+	memset(&p, 0, sizeof(p));
+	memcpy(p.mac, mac, 6);
+	p.reason = reason;
+	p.subtype = subtype;
+	rc = hsop_build_kick_body(body, sizeof(body), &p);
+	if (rc)
+		return rc;
+	rc = hi5622_sta_wal_frame(wire, sizeof(wire), &len,
+				  HI5622_STA_WAL_CMD_DISCONNECT, body,
+				  sizeof(body), c->sta_ops_seq++, 0u);
+	if (rc)
+		return rc;
+	rc = hi5622_frame_post(c->ctx, wire, len, "sta_kick", NULL);
+	if (!rc)
+		c->sta_ops_kick++;
+	return rc;
+}
+
+static int hsop_post_user_del(struct hi5622_cfg80211 *c, u8 band, u8 vap_id,
+			      u16 aid, const u8 *mac)
+{
+	struct hsop_user_del_params p;
+	u8 wire[HSOP_USER_DEL_WIRE_LEN];
+	size_t len = 0;
+	int rc;
+
+	memset(&p, 0, sizeof(p));
+	p.band = band;
+	p.vap_id = vap_id;
+	p.hdr2 = 0;
+	p.dst = 0;
+	p.uid = aid;
+	memcpy(p.mac, mac, 6);
+	p.flag = (u8)HSOP_USER_DEL_FLAG_AP;
+	rc = hsop_build_user_del(wire, sizeof(wire), &len, &p);
+	if (rc)
+		return rc;
+	rc = hsop_check_user_del(wire, len);
+	if (rc)
+		return rc;
+	rc = hi5622_frame_post(c->ctx, wire, len, "sta_user_del", NULL);
+	if (!rc)
+		c->sta_ops_user_del++;
+	return rc;
+}
+
+static void hsop_fill_sinfo(const struct hsop_sta *s, struct station_info *sinfo)
+{
+	memset(sinfo, 0, sizeof(*sinfo));
+	sinfo->filled = BIT(NL80211_STA_INFO_STA_FLAGS);
+	sinfo->sta_flags.mask = s->flags_mask;
+	sinfo->sta_flags.set = s->flags_set;
+}
+
+int hi5622_sta_ops_add(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       const u8 *mac, struct station_parameters *params)
+{
+	struct hsop_sta *existing;
+	u8 band, vap_id;
+	int slot, rc;
+
+	if (!hi5622_sta_ops_enable) {
+		pr_info_once("hi5622: .add_station reached - fails closed (sta_ops=0; see docs/incoming/wifi-sta-ops/)\n");
+		return -EOPNOTSUPP;
+	}
+	if (!c || !dev || !mac || !params)
+		return -EINVAL;
+	if (!is_valid_ether_addr(mac))
+		return -EINVAL;
+	if (!hsop_is_ap_dev(dev))
+		return -EOPNOTSUPP;
+	if (params->aid == 0u || params->aid > 0x0fffu)
+		return -EINVAL;
+	slot = hsop_vap_slot(c, dev);
+	if (slot < 0)
+		return slot;
+	mutex_lock(&c->lock);
+	existing = hsop_sta_find(&c->sta_table, mac);
+	if (existing) {
+		c->sta_table.stats.dup_updates++;
+		mutex_unlock(&c->lock);
+		return -EEXIST;
+	}
+	band = c->band;
+	vap_id = (u8)slot;
+	rc = hsop_post_user_add(c, band, vap_id, params->aid, mac);
+	if (rc) {
+		c->sta_table.stats.refused++;
+		mutex_unlock(&c->lock);
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta_ops: .add_station %pM AID %u: user_add (g0 id7) NOT posted (%d) - fail closed (allow_frames budget / HCC gate)\n",
+			 mac, params->aid, rc);
+		return rc;
+	}
+	rc = hsop_post_asoc_syn(c, band, vap_id, params->aid,
+				(u8)HSOP_ASOC_STATE_ASSOC);
+	if (rc) {
+		c->sta_table.stats.refused++;
+		mutex_unlock(&c->lock);
+		dev_warn(&c->ctx->pdev->dev,
+			 "sta_ops: .add_station %pM AID %u: association sync (g0 id1 cmd 0x%x) NOT posted (%d) - user_add already committed, station not recorded\n",
+			 mac, params->aid, HSOP_CFG_CMD_ASOC_SYN, rc);
+		return rc;
+	}
+	rc = hsop_sta_add(&c->sta_table, mac, params->aid,
+			  params->sta_flags_mask, params->sta_flags_set);
+	if (rc) {
+		mutex_unlock(&c->lock);
+		return rc;
+	}
+	existing = hsop_sta_find(&c->sta_table, mac);
+	if (existing) {
+		existing->authorized = (int)hsop_flag_authorized(
+			params->sta_flags_mask, params->sta_flags_set);
+		existing->authenticated = (int)hsop_flag_authenticated(
+			params->sta_flags_mask, params->sta_flags_set);
+		existing->associated = (int)hsop_flag_associated(
+			params->sta_flags_mask, params->sta_flags_set);
+	}
+	c->sta_ops_ap_dev = dev;
+	mutex_unlock(&c->lock);
+	dev_info(&c->ctx->pdev->dev,
+		 "sta_ops: STA %pM added (AID %u, vap %d, band %u): firmware context committed (g0 id7 user_add 180 B + g0 id1 cmd 0x%x asoc state %u); host station table=%u\n",
+		 mac, params->aid, slot, band, HSOP_CFG_CMD_ASOC_SYN,
+		 HSOP_ASOC_STATE_ASSOC, hsop_sta_count(&c->sta_table));
+	return 0;
+}
+
+int hi5622_sta_ops_change(struct hi5622_cfg80211 *c, struct net_device *dev,
+			  const u8 *mac, struct station_parameters *params)
+{
+	struct hsop_sta *s;
+	int rc;
+
+	if (!hi5622_sta_ops_enable)
+		return -EOPNOTSUPP;
+	if (!c || !dev || !mac || !params)
+		return -EINVAL;
+	if (!hsop_is_ap_dev(dev))
+		return -EOPNOTSUPP;
+	mutex_lock(&c->lock);
+	s = hsop_sta_find(&c->sta_table, mac);
+	if (!s) {
+		c->sta_table.stats.refused++;
+		mutex_unlock(&c->lock);
+		return -ENOENT;
+	}
+	rc = hsop_sta_update(&c->sta_table, mac, params->sta_flags_mask,
+			     params->sta_flags_set);
+	if (rc) {
+		mutex_unlock(&c->lock);
+		return rc;
+	}
+	s->authorized = (int)hsop_flag_authorized(s->flags_mask, s->flags_set);
+	s->authenticated = (int)hsop_flag_authenticated(s->flags_mask,
+							s->flags_set);
+	s->associated = (int)hsop_flag_associated(s->flags_mask, s->flags_set);
+	dev_info(&c->ctx->pdev->dev,
+		 "sta_ops: CHANGE_STATION %pM: authorized=%d authenticated=%d associated=%d (host-side flag mirror; no extra firmware message - [U])\n",
+		 mac, s->authorized, s->authenticated, s->associated);
+	mutex_unlock(&c->lock);
+	return 0;
+}
+
+int hi5622_sta_ops_del(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       struct station_del_parameters *params)
+{
+	struct hsop_sta *s;
+	u8 mac[6];
+	u16 aid;
+	u8 band, vap_id;
+	int slot, rc = 0;
+
+	if (!hi5622_sta_ops_enable)
+		return -EOPNOTSUPP;
+	if (!c || !dev || !params)
+		return -EINVAL;
+	if (!hsop_is_ap_dev(dev))
+		return -EOPNOTSUPP;
+	slot = hsop_vap_slot(c, dev);
+	if (slot < 0)
+		return slot;
+	mutex_lock(&c->lock);
+	band = c->band;
+	vap_id = (u8)slot;
+	if (!params->mac) {
+		/* cfg80211 flush-all: host state only (firmware users are left
+		 * for the stop_ap/power-cycle owner; a per-station kick storm
+		 * would exceed the post budget). */
+		c->sta_table.stats.flush++;
+		hsop_sta_table_init(&c->sta_table);
+		mutex_unlock(&c->lock);
+		dev_info(&c->ctx->pdev->dev,
+			 "sta_ops: DEL_STATION flush (host table cleared; no firmware message)\n");
+		return 0;
+	}
+	s = hsop_sta_find(&c->sta_table, params->mac);
+	if (!s) {
+		c->sta_table.stats.unknown_del++;
+		mutex_unlock(&c->lock);
+		return -ENOENT;
+	}
+	memcpy(mac, s->mac, 6);
+	aid = s->aid;
+	if (hi5622_sta_user_del) {
+		int drc = hsop_post_user_del(c, band, vap_id, aid, mac);
+
+		if (drc) {
+			dev_warn(&c->ctx->pdev->dev,
+				 "sta_ops: .del_station %pM: g0 id9 user_del NOT posted (%d)\n",
+				 mac, drc);
+			rc = drc;
+		}
+	}
+	{
+		int krc = hsop_post_kick(c, mac, params->reason_code,
+					 params->subtype);
+
+		if (krc) {
+			dev_warn(&c->ctx->pdev->dev,
+				 "sta_ops: .del_station %pM: WAL cfg-event kick (0x%x) NOT posted (%d)\n",
+				 mac, HSOP_WAL_KICK_CMD, krc);
+			rc = rc ? rc : krc;
+		}
+	}
+	(void)hsop_sta_del(&c->sta_table, mac);
+	mutex_unlock(&c->lock);
+	dev_info(&c->ctx->pdev->dev,
+		 "sta_ops: DEL_STATION %pM (AID %u, subtype %u, reason %u): kick%s; host table=%u\n",
+		 mac, aid, params->subtype, params->reason_code,
+		 rc ? " incomplete" : " committed", hsop_sta_count(&c->sta_table));
+	return rc;
+}
+
+int hi5622_sta_ops_get(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       const u8 *mac, struct station_info *sinfo)
+{
+	struct hsop_sta *s;
+
+	if (!hi5622_sta_ops_enable)
+		return -EOPNOTSUPP;
+	if (!c || !dev || !mac || !sinfo)
+		return -EINVAL;
+	mutex_lock(&c->lock);
+	s = hsop_sta_find(&c->sta_table, mac);
+	if (!s) {
+		mutex_unlock(&c->lock);
+		return -ENOENT;
+	}
+	hsop_fill_sinfo(s, sinfo);
+	mutex_unlock(&c->lock);
+	return 0;
+}
+
+int hi5622_sta_ops_dump(struct hi5622_cfg80211 *c, struct net_device *dev,
+			int idx, u8 *mac, struct station_info *sinfo)
+{
+	struct hsop_sta s;
+	int rc;
+
+	if (!hi5622_sta_ops_enable)
+		return -EOPNOTSUPP;
+	if (!c || !dev || !mac || !sinfo)
+		return -EINVAL;
+	if (idx < 0)
+		return -EINVAL;
+	mutex_lock(&c->lock);
+	rc = hsop_sta_at(&c->sta_table, (u32)idx, &s);
+	if (!rc) {
+		memcpy(mac, s.mac, 6);
+		hsop_fill_sinfo(&s, sinfo);
+	}
+	mutex_unlock(&c->lock);
+	return rc;
+}
+
+void hi5622_sta_ops_rx_deliver(struct hi5622_pci *ctx, const u8 *mpdu,
+			       u32 len)
+{
+	struct hi5622_cfg80211 *c;
+	struct hsop_rx_info rx;
+	struct hsop_sta *s;
+	struct net_device *dev;
+	struct sk_buff *skb;
+	u8 *eth;
+	size_t eth_len = 0;
+	int rc;
+
+	if (!ctx || !ctx->cfg || !hi5622_eapol_rx || !mpdu || len == 0u)
+		return;
+	c = ctx->cfg;
+	if (!c->sta_ops_ap_dev)
+		return;
+	mutex_lock(&c->lock);
+	c->sta_ops_rx_frames++;
+	rc = hsop_rx_parse(mpdu, len, &rx);
+	if (rc || !rx.is_data) {
+		c->sta_ops_rx_bad++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	if (rx.is_eapol)
+		c->sta_ops_rx_eapol++;
+	s = hsop_sta_find(&c->sta_table, rx.src);
+	if (!s) {
+		c->sta_ops_rx_dropped++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	if (!hsop_rx_deliverable(&rx, s->authorized)) {
+		c->sta_ops_rx_dropped++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	dev = c->sta_ops_ap_dev;
+	if (!netif_running(dev)) {
+		c->sta_ops_rx_dropped++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	eth = kmalloc(HSOP_RX_ETH_MAX, GFP_KERNEL);
+	if (!eth) {
+		c->sta_ops_rx_dropped++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	rc = hsop_rx_to_eth(mpdu, len, eth, HSOP_RX_ETH_MAX, &eth_len, &rx);
+	if (rc) {
+		kfree(eth);
+		c->sta_ops_rx_bad++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	skb = netdev_alloc_skb(dev, (unsigned int)eth_len + 2u);
+	if (!skb) {
+		kfree(eth);
+		c->sta_ops_rx_dropped++;
+		mutex_unlock(&c->lock);
+		return;
+	}
+	memcpy(skb_put(skb, eth_len), eth, eth_len);
+	kfree(eth);
+	skb->protocol = eth_type_trans(skb, dev);
+	netif_rx(skb);
+	c->sta_ops_rx_delivered++;
+	mutex_unlock(&c->lock);
+}
+
+void hi5622_sta_ops_xmit_drop(struct net_device *dev)
+{
+	struct wireless_dev *wdev;
+	struct hi5622_cfg80211 *c;
+
+	if (!dev)
+		return;
+	wdev = dev->ieee80211_ptr;
+	if (!wdev || !wdev->wiphy)
+		return;
+	c = wiphy_priv(wdev->wiphy);
+	if (!c)
+		return;
+	c->sta_ops_xmit_dropped++;
+}
+
+int hi5622_sta_ops_status(struct hi5622_cfg80211 *c, char *buf, size_t len)
+{
+	int n;
+
+	if (!c || !buf)
+		return -EINVAL;
+	n = scnprintf(buf, len,
+		      "sta-ops: sta_ops=%u eapol_rx=%u sta_user_del=%u stations=%u added=%u updated=%u deleted=%u refused=%u\n",
+		      hi5622_sta_ops_enable, hi5622_eapol_rx,
+		      hi5622_sta_user_del, hsop_sta_count(&c->sta_table),
+		      c->sta_table.stats.added, c->sta_table.stats.updated,
+		      c->sta_table.stats.deleted, c->sta_table.stats.refused);
+	if (n > 0 && (size_t)n < len) {
+		int m = scnprintf(buf + n, len - (size_t)n,
+				  "sta-ops wire: user_add=%u asoc_syn=%u kick=%u user_del=%u; rx frames=%u eapol=%u delivered=%u dropped=%u bad=%u; xmit_dropped=%u\n",
+				  c->sta_ops_user_add, c->sta_ops_asoc_syn,
+				  c->sta_ops_kick, c->sta_ops_user_del,
+				  c->sta_ops_rx_frames, c->sta_ops_rx_eapol,
+				  c->sta_ops_rx_delivered,
+				  c->sta_ops_rx_dropped, c->sta_ops_rx_bad,
+				  c->sta_ops_xmit_dropped);
+		if (m > 0)
+			n += m;
+	}
+	return n;
+}
diff --git a/hi5622_sta_ops.h b/hi5622_sta_ops.h
new file mode 100644
index 0000000..efc31dc
--- /dev/null
+++ b/hi5622_sta_ops.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_sta_ops.h - kernel glue for cfg80211 station operations and the
+ * EAPOL/data RX delivery path (Hi5622V100 clean-room driver).
+ *
+ * ORIGINAL clean-room code (lane wifi-sta-ops, shared task task-149,
+ * 2026-11-24).  Pure builders / parsing live in hi5622_sta_ops_logic.h/.c
+ * (host-tested); this file is the kernel-only half.
+ *
+ * Fail-closed policy:
+ *   sta_ops=0 (default)  every station op returns -EOPNOTSUPP (hostapd logs
+ *                        "Could not add STA to kernel driver") and no frame
+ *                        is built or posted;
+ *   sta_ops=1            .add_station posts the decoded per-STA firmware
+ *                        context (g0 id7 user_add + g0 id1 cmd 0x07d2
+ *                        association sync), .del_station posts the vendor
+ *                        WAL cfg-event kick (opcode 0x00d0) and optionally
+ *                        the g0 id9 user_del (sta_user_del=1);
+ *   eapol_rx=0 (default) received data frames are NOT delivered to the
+ *                        netdev (the RX lane keeps its capture-only
+ *                        behaviour);
+ *   eapol_rx=1           dp_rx_drain delivers received 802.11 data frames
+ *                        to the AP VAP netdev after 802.11->Ethernet
+ *                        conversion: EAPOL always, other ethertypes only
+ *                        for an authorized station.
+ */
+#ifndef HI5622_STA_OPS_H
+#define HI5622_STA_OPS_H
+
+#include <linux/skbuff.h>
+#include <linux/types.h>
+#include <net/cfg80211.h>
+
+#include "hi5622_sta_ops_logic.h"
+
+struct hi5622_cfg80211;
+struct hi5622_pci;
+struct net_device;
+
+/* Module parameters (defined in hi5622_sta_ops.c). */
+extern unsigned int hi5622_sta_ops_enable;	/* sta_ops */
+extern unsigned int hi5622_eapol_rx;		/* eapol_rx */
+extern unsigned int hi5622_sta_user_del;	/* sta_user_del */
+
+void hi5622_sta_ops_init(struct hi5622_cfg80211 *c);
+void hi5622_sta_ops_remove(struct hi5622_cfg80211 *c);
+int hi5622_sta_ops_status(struct hi5622_cfg80211 *c, char *buf, size_t len);
+
+/* cfg80211 ops. */
+int hi5622_sta_ops_add(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       const u8 *mac, struct station_parameters *params);
+int hi5622_sta_ops_change(struct hi5622_cfg80211 *c, struct net_device *dev,
+			  const u8 *mac, struct station_parameters *params);
+int hi5622_sta_ops_del(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       struct station_del_parameters *params);
+int hi5622_sta_ops_get(struct hi5622_cfg80211 *c, struct net_device *dev,
+		       const u8 *mac, struct station_info *sinfo);
+int hi5622_sta_ops_dump(struct hi5622_cfg80211 *c, struct net_device *dev,
+			int idx, u8 *mac, struct station_info *sinfo);
+
+/* RX delivery from the dp_txrx completion drain (eapol_rx gate inside). */
+void hi5622_sta_ops_rx_deliver(struct hi5622_pci *ctx, const u8 *mpdu,
+			       u32 len);
+
+/* Account a host -> netdev frame the data path cannot transmit yet (the
+ * netdev xmit still drains the skb; this makes the drop visible). */
+void hi5622_sta_ops_xmit_drop(struct net_device *dev);
+
+#endif /* HI5622_STA_OPS_H */
diff --git a/hi5622_sta_ops_logic.c b/hi5622_sta_ops_logic.c
new file mode 100644
index 0000000..94898fa
--- /dev/null
+++ b/hi5622_sta_ops_logic.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_sta_ops_logic.c - portable station-operations logic (clean-room).
+ * See hi5622_sta_ops_logic.h for the decoded facts and their evidence.
+ *
+ * Pure C99, device-free: the 6.18 kernel module and tools/sta_ops_selftest.c
+ * compile the same code.  No vendor source/object/firmware byte reproduced.
+ */
+#include "hi5622_sta_ops_logic.h"
+
+#ifdef __KERNEL__
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+
+/* ------------------------------------------------------------------ */
+/* little-endian helpers                                              */
+/* ------------------------------------------------------------------ */
+static void hsop_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+static u16 hsop_get16(const u8 *p)
+{
+	return (u16)((u16)p[0] | ((u16)p[1] << 8));
+}
+
+static u16 hsop_getbe16(const u8 *p)
+{
+	return (u16)(((u16)p[0] << 8) | (u16)p[1]);
+}
+
+/* The two group-0 families share the first 12 bytes of the HCC header:
+ *   [0] group nibble            [1] alloc nibble | band nibble<<4
+ *   [2] vendor field [U]        [3] vap_id
+ *   [4..5] total length         [6..7] HCC id
+ *   [8] 0                       [9] destination nibble
+ *   [10..11] tag 0x5a5a
+ * (vendor vs_frame_open / hmac_user_add / hmac_del_user_notify_dmac). */
+static int hsop_hdr(u8 *wire, size_t cap, size_t total, u8 id, u8 band,
+		    u8 vap_id, u8 hdr2, u8 dst)
+{
+	if (!wire || cap < total || total > 0xffffu || dst > 0x0fu)
+		return -EINVAL;
+	memset(wire, 0, total);
+	wire[0] = (u8)(HSOP_HCC_GROUP_CHIP & 0x0fu);
+	wire[1] = (u8)(HSOP_ALLOC_NIBBLE | (u8)((band & 0x0fu) << 4));
+	wire[2] = hdr2;
+	wire[3] = vap_id;
+	hsop_put16(wire + 4, (u16)total);
+	hsop_put16(wire + 6, (u16)id);
+	wire[8] = 0u;
+	wire[9] = (u8)(dst & 0x0fu);
+	hsop_put16(wire + 10, HSOP_HCC_TAG);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* g0 id7 user_add (180 B wire, 168 B body)                           */
+/* ------------------------------------------------------------------ */
+int hsop_build_user_add(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_user_add_params *p)
+{
+	u8 *body;
+	int rc;
+
+	if (!wire || !out_len || !p)
+		return -EINVAL;
+	if (p->type == 0u || p->aid == 0u || p->aid > 0x0fffu)
+		return -EINVAL;	/* firmware user id space is 12-bit [V] */
+	if (cap < HSOP_USER_ADD_WIRE_LEN)
+		return -ENOSPC;
+	rc = hsop_hdr(wire, cap, HSOP_USER_ADD_WIRE_LEN, HSOP_ID_USER_ADD,
+		      p->band, p->vap_id, p->hdr2, p->dst);
+	if (rc)
+		return rc;
+	body = wire + HSOP_HCC_HDR_LEN;
+	hsop_put16(body + HSOP_UA_OFF_UID, p->aid);
+	memcpy(body + HSOP_UA_OFF_MAC, p->mac, sizeof(p->mac));
+	body[HSOP_UA_OFF_TYPE] = p->type;
+	body[HSOP_UA_OFF_RSSI] = (u8)(s8)p->rssi;
+	*out_len = HSOP_USER_ADD_WIRE_LEN;
+	return 0;
+}
+
+int hsop_check_user_add(const u8 *wire, size_t len)
+{
+	u32 body_len;
+	const u8 *body;
+	u16 tag;
+
+	if (!wire || len != HSOP_USER_ADD_WIRE_LEN)
+		return -EINVAL;
+	if ((wire[0] & 0x0fu) != HSOP_HCC_GROUP_CHIP)
+		return -EINVAL;
+	if ((wire[1] & 0x0fu) != HSOP_ALLOC_NIBBLE)
+		return -EINVAL;
+	if (hsop_get16(wire + 4) != (u16)len)
+		return -EINVAL;
+	if (hsop_get16(wire + 6) != HSOP_ID_USER_ADD)
+		return -EINVAL;
+	tag = hsop_get16(wire + 10);
+	if (tag != HSOP_HCC_TAG)
+		return -EINVAL;
+	body = wire + HSOP_HCC_HDR_LEN;
+	body_len = (u32)len - HSOP_HCC_HDR_LEN;
+	if (body_len != HSOP_USER_ADD_BODY_LEN)
+		return -EINVAL;
+	if (hsop_get16(body + HSOP_UA_OFF_UID) == 0u)
+		return -EINVAL;
+	if (body[HSOP_UA_OFF_TYPE] == 0u)
+		return -EINVAL;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* g0 id9 user_del (24 B wire, 12 B body)                             */
+/* ------------------------------------------------------------------ */
+int hsop_build_user_del(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_user_del_params *p)
+{
+	u8 *body;
+	int rc;
+
+	if (!wire || !out_len || !p)
+		return -EINVAL;
+	if (p->uid == 0u || p->uid > 0x0fffu)
+		return -EINVAL;
+	if (cap < HSOP_USER_DEL_WIRE_LEN)
+		return -ENOSPC;
+	rc = hsop_hdr(wire, cap, HSOP_USER_DEL_WIRE_LEN, HSOP_ID_USER_DEL,
+		      p->band, p->vap_id, p->hdr2, p->dst);
+	if (rc)
+		return rc;
+	body = wire + HSOP_HCC_HDR_LEN;
+	hsop_put16(body + HSOP_UD_OFF_UID, p->uid);
+	memcpy(body + HSOP_UD_OFF_MAC, p->mac, sizeof(p->mac));
+	body[HSOP_UD_OFF_FLAG] = p->flag;
+	*out_len = HSOP_USER_DEL_WIRE_LEN;
+	return 0;
+}
+
+int hsop_check_user_del(const u8 *wire, size_t len)
+{
+	const u8 *body;
+
+	if (!wire || len != HSOP_USER_DEL_WIRE_LEN)
+		return -EINVAL;
+	if (hsop_get16(wire + 4) != (u16)len)
+		return -EINVAL;
+	if (hsop_get16(wire + 6) != HSOP_ID_USER_DEL)
+		return -EINVAL;
+	if (hsop_get16(wire + 10) != HSOP_HCC_TAG)
+		return -EINVAL;
+	body = wire + HSOP_HCC_HDR_LEN;
+	if (hsop_get16(body + HSOP_UD_OFF_UID) == 0u)
+		return -EINVAL;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* g0 id1 config event cmd 0x07d2 (32 B wire, 4 B body)               */
+/* ------------------------------------------------------------------ */
+int hsop_build_asoc_syn(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_asoc_syn_params *p)
+{
+	u8 *token, *body;
+	size_t total = HSOP_ASOC_SYN_WIRE_LEN;
+	int rc;
+
+	if (!wire || !out_len || !p)
+		return -EINVAL;
+	if (p->aid == 0u || p->aid > 0x0fffu)
+		return -EINVAL;
+	if (p->state == 0u)
+		return -EINVAL;	/* 0 would mean "clear": not modelled */
+	if (cap < total)
+		return -ENOSPC;
+	rc = hsop_hdr(wire, cap, total, HSOP_ID_CFG_EVENT, p->band, p->vap_id,
+		      p->hdr2, p->dst);
+	if (rc)
+		return rc;
+	/* Proven g0 id1 carrier shape: token[8] | cmd u16 | len u16 | body. */
+	token = wire + HSOP_HCC_HDR_LEN;
+	token[HSOP_CFG_TOKEN_BYTE] = HSOP_CFG_TOKEN_VALUE;
+	hsop_put16(token + 8, HSOP_CFG_CMD_ASOC_SYN);
+	hsop_put16(token + 10, HSOP_ASOC_SYN_BODY_LEN);
+	body = token + 12;
+	hsop_put16(body + HSOP_ASOC_OFF_UID, p->aid);
+	body[HSOP_ASOC_OFF_STATE] = p->state;
+	/* inherited 0xff pad after the body */
+	memset(wire + total - 4u, HSOP_CFG_PAD_VALUE, 4u);
+	*out_len = total;
+	return 0;
+}
+
+int hsop_check_asoc_syn(const u8 *wire, size_t len)
+{
+	const u8 *token, *body;
+	unsigned int i;
+
+	if (!wire || len != HSOP_ASOC_SYN_WIRE_LEN)
+		return -EINVAL;
+	if ((wire[0] & 0x0fu) != HSOP_HCC_GROUP_CHIP)
+		return -EINVAL;
+	if (hsop_get16(wire + 4) != (u16)len)
+		return -EINVAL;
+	if (hsop_get16(wire + 6) != HSOP_ID_CFG_EVENT)
+		return -EINVAL;
+	if (hsop_get16(wire + 10) != HSOP_HCC_TAG)
+		return -EINVAL;
+	token = wire + HSOP_HCC_HDR_LEN;
+	if (hsop_get16(token + 8) != HSOP_CFG_CMD_ASOC_SYN)
+		return -EINVAL;
+	if (hsop_get16(token + 10) != HSOP_ASOC_SYN_BODY_LEN)
+		return -EINVAL;
+	body = token + 12;
+	if (hsop_get16(body + HSOP_ASOC_OFF_UID) == 0u)
+		return -EINVAL;
+	if (body[HSOP_ASOC_OFF_STATE] == 0u)
+		return -EINVAL;
+	for (i = 0; i < 4u; i++)
+		if (wire[len - 4u + i] != HSOP_CFG_PAD_VALUE)
+			return -EINVAL;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* WAL cfg-event kick body (16 B; the sta lane supplies the envelope) */
+/* ------------------------------------------------------------------ */
+int hsop_build_kick_body(u8 *body, size_t cap,
+			 const struct hsop_kick_params *p)
+{
+	if (!body || !p)
+		return -EINVAL;
+	if (cap < HSOP_KICK_BODY_LEN)
+		return -ENOSPC;
+	memset(body, 0, HSOP_KICK_BODY_LEN);
+	memcpy(body + HSOP_KICK_OFF_MAC, p->mac, sizeof(p->mac));
+	hsop_put16(body + HSOP_KICK_OFF_REASON, p->reason);
+	body[HSOP_KICK_OFF_SUBTYPE] =
+		(p->subtype == HSOP_KICK_SUBTYPE_DEAUTH) ?
+		HSOP_KICK_FLAG_DEAUTH : 0u;
+	body[HSOP_KICK_OFF_LAST] = 1u;	/* vendor constant [V] */
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* station table                                                      */
+/* ------------------------------------------------------------------ */
+static int hsop_mac_ok(const u8 *mac)
+{
+	return mac && !(mac[0] & 0x01);	/* unicast only */
+}
+
+void hsop_sta_table_init(struct hsop_sta_table *t)
+{
+	if (!t)
+		return;
+	memset(t, 0, sizeof(*t));
+}
+
+struct hsop_sta *hsop_sta_find(struct hsop_sta_table *t, const u8 *mac)
+{
+	unsigned int i;
+
+	if (!t || !mac)
+		return NULL;
+	for (i = 0; i < HSOP_MAX_STA; i++) {
+		if (t->sta[i].used && !memcmp(t->sta[i].mac, mac, 6))
+			return &t->sta[i];
+	}
+	return NULL;
+}
+
+const struct hsop_sta *hsop_sta_find_const(const struct hsop_sta_table *t,
+					   const u8 *mac)
+{
+	unsigned int i;
+
+	if (!t || !mac)
+		return NULL;
+	for (i = 0; i < HSOP_MAX_STA; i++) {
+		if (t->sta[i].used && !memcmp(t->sta[i].mac, mac, 6))
+			return &t->sta[i];
+	}
+	return NULL;
+}
+
+int hsop_sta_add(struct hsop_sta_table *t, const u8 *mac, u16 aid,
+		 u32 flags_mask, u32 flags_set)
+{
+	unsigned int i, slot = HSOP_MAX_STA;
+
+	if (!t || !hsop_mac_ok(mac) || aid == 0u)
+		return -EINVAL;
+	if (hsop_sta_find(t, mac)) {
+		t->stats.refused++;
+		return -EEXIST;
+	}
+	for (i = 0; i < HSOP_MAX_STA; i++) {
+		if (!t->sta[i].used) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == HSOP_MAX_STA) {
+		t->stats.refused++;
+		return -ENOSPC;
+	}
+	memset(&t->sta[slot], 0, sizeof(t->sta[slot]));
+	t->sta[slot].used = 1;
+	memcpy(t->sta[slot].mac, mac, 6);
+	t->sta[slot].aid = aid;
+	t->sta[slot].flags_mask = flags_mask;
+	t->sta[slot].flags_set = flags_set;
+	t->stats.added++;
+	return 0;
+}
+
+int hsop_sta_update(struct hsop_sta_table *t, const u8 *mac,
+		    u32 flags_mask, u32 flags_set)
+{
+	struct hsop_sta *s = hsop_sta_find(t, mac);
+
+	if (!s)
+		return -ENOENT;
+	s->flags_mask |= flags_mask;
+	s->flags_set = (s->flags_set & ~flags_mask) | (flags_set & flags_mask);
+	t->stats.updated++;
+	return 0;
+}
+
+int hsop_sta_del(struct hsop_sta_table *t, const u8 *mac)
+{
+	struct hsop_sta *s = hsop_sta_find(t, mac);
+
+	if (!s) {
+		t->stats.unknown_del++;
+		return -ENOENT;
+	}
+	memset(s, 0, sizeof(*s));
+	t->stats.deleted++;
+	return 0;
+}
+
+u32 hsop_sta_count(const struct hsop_sta_table *t)
+{
+	u32 i, n = 0;
+
+	if (!t)
+		return 0;
+	for (i = 0; i < HSOP_MAX_STA; i++)
+		if (t->sta[i].used)
+			n++;
+	return n;
+}
+
+int hsop_sta_at(const struct hsop_sta_table *t, u32 index, struct hsop_sta *out)
+{
+	u32 i, n = 0;
+
+	if (!t || !out)
+		return -EINVAL;
+	for (i = 0; i < HSOP_MAX_STA; i++) {
+		if (!t->sta[i].used)
+			continue;
+		if (n == index) {
+			memcpy(out, &t->sta[i], sizeof(*out));
+			return 0;
+		}
+		n++;
+	}
+	return -ENOENT;
+}
+
+/* ------------------------------------------------------------------ */
+/* 802.11 data RX parse + Ethernet conversion                         */
+/* ------------------------------------------------------------------ */
+
+/* MAC header length from the frame control, identical in effect to the
+ * vendor hmac_rx_get_mac_header_len: base 24, 4-address (ToDS+FromDS) 30,
+ * +2 when a QoS control field is present (data subtype bit 3), +4 when the
+ * HT-control/order bit is set. */
+static u32 hsop_hdr_len(u16 fc)
+{
+	u32 len = ((fc & 0x0300u) == 0x0300u) ? 30u : 24u;
+
+	if ((fc & 0x0080u) != 0u)
+		len += 2u;	/* QoS control, data subtype bit 3 */
+	if ((fc & 0x8000u) != 0u)
+		len += 4u;	/* HT control / order bit */
+	return len;
+}
+
+int hsop_rx_parse(const u8 *mpdu, u32 len, struct hsop_rx_info *out)
+{
+	u16 fc;
+	u32 hdr_len, off;
+	const u8 *h;
+
+	if (!mpdu || !out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (len < 24u)
+		return -EINVAL;
+	fc = hsop_get16(mpdu);
+	out->fc = fc;
+	out->type = (u8)((fc >> 2) & 0x3u);
+	out->subtype = (u8)((fc >> 4) & 0x0fu);
+	out->tods = (fc & 0x0100u) ? 1 : 0;
+	out->fromds = (fc & 0x0200u) ? 1 : 0;
+	out->is_data = (out->type == 2u);
+	if (!out->is_data) {
+		out->hdr_len = hsop_hdr_len(fc);
+		return 0;
+	}
+	hdr_len = hsop_hdr_len(fc);
+	if (hdr_len > len)
+		return -EINVAL;
+	out->hdr_len = hdr_len;
+	h = mpdu;
+	/* Address selection (vendor hmac_rx_ring_entry_proc_frame rules):
+	 *   FromDS=0: src=addr2, dst = ToDS ? addr3 : addr1
+	 *   FromDS=1: src = addr3 (addr4 when 4-address), dst = addr1 */
+	if (!out->fromds) {
+		memcpy(out->src, h + 10, 6);
+		memcpy(out->dst, h + (out->tods ? 16 : 4), 6);
+	} else {
+		memcpy(out->dst, h + 4, 6);
+		if (out->tods) {	/* both bits set = 4-address */
+			if (len < 30u)
+				return -EINVAL;
+			memcpy(out->src, h + 24, 6);
+		} else {
+			memcpy(out->src, h + 16, 6);
+		}
+	}
+	/* LLC/SNAP: AA AA 03 00 00 00 + ethertype */
+	off = hdr_len;
+	if (len < off + HSOP_SNAP_HDR_LEN)
+		return 0;	/* data frame, but no LLC/SNAP payload */
+	if (mpdu[off] != 0xaau || mpdu[off + 1] != 0xaau || mpdu[off + 2] != 0x03u)
+		return 0;
+	if (mpdu[off + 3] != 0x00u || mpdu[off + 4] != 0x00u ||
+	    mpdu[off + 5] != 0x00u)
+		return 0;
+	out->has_snap = 1;
+	out->payload_off = off + HSOP_SNAP_HDR_LEN;
+	out->ethertype = hsop_getbe16(mpdu + off + 6);
+	if (out->ethertype != HSOP_ETH_P_PAE)
+		return 0;
+	if (len < out->payload_off + HSOP_EAPOL_HDR_LEN)
+		return 0;
+	out->is_eapol = 1;
+	out->eapol_type = mpdu[out->payload_off + 1u];
+	out->eapol_len = hsop_getbe16(mpdu + out->payload_off + 2u);
+	if (out->eapol_type != 3u)	/* 3 = EAPOL-Key */
+		return 0;
+	if (len < out->payload_off + HSOP_EAPOL_KEY_MIN)
+		return 0;
+	out->eapol_key = 1;
+	{
+		u16 ki = hsop_getbe16(mpdu + out->payload_off +
+				      HSOP_EAPOL_KEY_INFO_OFF);
+
+		out->eapol_key_datalen = hsop_getbe16(mpdu + out->payload_off +
+						      HSOP_EAPOL_KEYDLEN_OFF);
+		out->eapol_key_pairwise = (ki & HSOP_EAPOL_KEY_PAIRWISE) ? 1 : 0;
+		/* vendor hmac_is_eapol_key_ptk_4_4 semantics: pairwise and,
+		 * for the completion detection, zero key-data length. */
+		out->eapol_ptk_done_like =
+			(out->eapol_key_pairwise && out->eapol_key_datalen == 0u) ?
+			1 : 0;
+	}
+	return 0;
+}
+
+int hsop_rx_to_eth(const u8 *mpdu, u32 len, u8 *eth, size_t cap,
+		   size_t *eth_len, struct hsop_rx_info *info)
+{
+	struct hsop_rx_info local;
+	struct hsop_rx_info *rx = info ? info : &local;
+	u32 payload;
+	size_t total;
+	int rc;
+
+	if (!mpdu || !eth || !eth_len)
+		return -EINVAL;
+	rc = hsop_rx_parse(mpdu, len, rx);
+	if (rc)
+		return rc;
+	if (!rx->is_data || !rx->has_snap)
+		return -EOPNOTSUPP;
+	payload = rx->payload_off;
+	if (payload >= len)
+		return -EINVAL;
+	total = (size_t)HSOP_ETH_HDR_LEN + (size_t)(len - payload);
+	if (cap < total)
+		return -ENOSPC;
+	memcpy(eth, rx->dst, 6);
+	memcpy(eth + 6, rx->src, 6);
+	eth[12] = (u8)(rx->ethertype >> 8);
+	eth[13] = (u8)(rx->ethertype & 0xffu);
+	memcpy(eth + HSOP_ETH_HDR_LEN, mpdu + payload, len - payload);
+	*eth_len = total;
+	return 0;
+}
+
+int hsop_rx_deliverable(const struct hsop_rx_info *rx, int authorized)
+{
+	if (!rx || !rx->is_data)
+		return 0;
+	if (rx->is_eapol)
+		return 1;	/* the 4-way handshake needs EAPOL before auth */
+	return authorized ? 1 : 0;
+}
diff --git a/hi5622_sta_ops_logic.h b/hi5622_sta_ops_logic.h
new file mode 100644
index 0000000..f624cf4
--- /dev/null
+++ b/hi5622_sta_ops_logic.h
@@ -0,0 +1,307 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_sta_ops_logic.h - portable, kernel-free station-operations logic for
+ * the Hi5622V100 clean-room driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-sta-ops, shared task task-149,
+ * 2026-11-24).  Only derived wire facts are encoded here; the vendor host
+ * module / firmware image is never linked or reproduced.  Every constant is
+ * re-derived by tools/sta_ops_re.py from the local (gitignored) artifacts and
+ * re-asserted by tools/sta_ops_selftest.c against LITERAL wire offsets.
+ *
+ * WHAT THE VENDOR DOES (2.5.24 link-time .text offsets; PD4 firmware
+ * workers are file offsets + 0x40000 = CA)
+ * -------------------------------------------------------------------
+ * AP client station creation (the hmac AP-SME path; the cfg80211
+ * .add_station/.change_station ops are 8-byte "return 0" stubs because the
+ * vendor does the AP SME in its own hmac layer):
+ *
+ *   hmac_ap_assoc_check_chip_exist_user_proc  +0x4e598
+ *     -> hmac_ap_rx_auth_chip_find_user_proc  +0x9fb90  (find/alloc user)
+ *     -> hmac_user_add                        +0x8eb34  (g0 id7, 180 B)
+ *     -> hmac_user_get_valid / hmac_user_init_key
+ *     -> mac_user_set_asoc_state(user+0xa6c, state=1)
+ *     -> hmac_config_user_asoc_state_syn      +0x63338  (g0 id1 cmd 0x07d2)
+ *
+ *   hmac_config_user_asoc_state_syn sends a g0 id1 config event:
+ *     cmd = 0x07d2, body 4 B {u16 AID/user_id; u8 asoc_state; u8 pad}
+ *   Firmware table A (CA 0x10c23c, 8-byte rows {u16 key; u16 pad; u32 worker})
+ *   has row key 0x07d2 -> worker CA 0x83e25 [V], and that worker reads
+ *   body[0..1] as the user id (lookup), writes body[2] to user+0x3d
+ *   (the same "association state" byte the host mirror writes), and returns
+ *   0 / 0x64 (user not found).
+ *
+ *   hmac_user_add sends a g0 id7 HCC message, 180 B wire (12 B header +
+ *   168 B body).  Body fields it writes: +0x00 u16 user id/AID (from
+ *   user+0xa84), +0x02 u8 MAC[6], +0x8e u8 user type (2 for an AP mode VAP),
+ *   +0xa4 s8 RSSI (+100 when the host has no scanned BSS entry).
+ *
+ *   hmac_del_user_notify_dmac +0x8d7f0 (called from hmac_user_del):
+ *   g0 id9, 24 B wire (12 + 12): body {u16 user id/AID, u8 MAC[6],
+ *   u8 flag} - flag is 2 for an AP-mode VAP user.
+ *
+ *   vendor cfg80211 .del_station +0x102470 posts the WAL cfg-event kick
+ *   (opcode 0x00d0, body 16 B {u8 peer MAC[6]; u16 reason; u8 subtype_flag;
+ *   pad[7]; u8 1}) where subtype_flag = 0xc0 when the cfg80211
+ *   station_del_parameters.subtype is 12 (deauthentication), else 0.  This
+ *   refines wifi-sta-static TABLES T3 (which saw +0x0f = 1 only).
+ *
+ * EAPOL / data RX (vendor data path):
+ *   hmac_rx_ring_entry_proc (+0x101e8) -> hmac_rx_ring_entry_proc_frame
+ *   (+0xf258) -> hmac_rx_frame_80211_to_eth (+0x125f8):
+ *     - strip the 802.11 MAC header; length from the frame control:
+ *       24 B base, 30 B for a 4-address frame, +2 for QoS, +4 for HT control
+ *       (hmac_rx_get_mac_header_len +0x13b94);
+ *     - LLC/SNAP type extraction (hmac_rx_frame_get_snap_type +0x12274);
+ *     - build a 14-byte Ethernet header: for FromDS=0 frames src = addr2
+ *       and dst = (ToDS ? addr3 : addr1); for FromDS=1 frames src =
+ *       addr3/addr4 and dst = addr1;
+ *     - EAPOL detection: ethertype 0x888e; EAPOL-Key = EAPOL type 3 with
+ *       length > 0x5e; pairwise = EAPOL-Key key-info bit 3; a PTK
+ *       "4/4-like" message additionally has key-data-length 0
+ *       (hmac_is_eapol_key_ptk_4_4 +0x18750 -> mac_is_eapol_key_ptk
+ *       +0x23094; the vendor uses it on the TX completion of the message).
+ *   Delivery to a host netdev is the clean-room driver's job: the vendor
+ *   forwards to its own offload/bridging layer (hyfi), not netif_rx (only
+ *   its proxy-ARP/ND path calls netif_rx).  This driver uses the standard
+ *   cfg80211 full-MAC convention: convert to Ethernet and netif_rx() on the
+ *   AP VAP netdev.
+ *
+ * FAIL-CLOSED: every builder is pure and refuses impossible input; the
+ * kernel glue only posts when the sta_ops/eapol_rx module params are set and
+ * the RX delivery is gated by station lookup + authorization.
+ */
+#ifndef HI5622_STA_OPS_LOGIC_H
+#define HI5622_STA_OPS_LOGIC_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef int8_t   s8;
+typedef int16_t  s16;
+typedef int32_t  s32;
+#endif
+#endif
+
+/* ===================================================================
+ * 1. Wire constants (decoded; every one is re-derived by sta_ops_re.py)
+ * =================================================================== */
+#define HSOP_HCC_HDR_LEN	12u
+#define HSOP_HCC_GROUP_CHIP	0u
+#define HSOP_ALLOC_NIBBLE	0x01u
+#define HSOP_HCC_TAG		0x5a5au
+
+/* g0 id7 user_add: 12 B header + 168 B body = 180 B [V]. */
+#define HSOP_ID_USER_ADD	7u
+#define HSOP_USER_ADD_BODY_LEN	168u
+#define HSOP_USER_ADD_WIRE_LEN	(HSOP_HCC_HDR_LEN + HSOP_USER_ADD_BODY_LEN)
+#define HSOP_UA_OFF_UID		0x00u	/* u16 user id / AID            */
+#define HSOP_UA_OFF_MAC		0x02u	/* u8[6] MAC                    */
+#define HSOP_UA_OFF_TYPE	0x8eu	/* u8 user type (2 = normal AP) */
+#define HSOP_UA_OFF_RSSI	0xa4u	/* s8 RSSI (+100 default)      */
+#define HSOP_USER_TYPE_AP	2u
+#define HSOP_DEFAULT_RSSI	100
+
+/* g0 id9 user_del: 12 B header + 12 B body = 24 B [V]. */
+#define HSOP_ID_USER_DEL	9u
+#define HSOP_USER_DEL_BODY_LEN	12u
+#define HSOP_USER_DEL_WIRE_LEN	(HSOP_HCC_HDR_LEN + HSOP_USER_DEL_BODY_LEN)
+#define HSOP_UD_OFF_UID		0x00u	/* u16 user id / AID */
+#define HSOP_UD_OFF_MAC		0x02u	/* u8[6] MAC         */
+#define HSOP_UD_OFF_FLAG	0x08u	/* u8 flag (2 = AP)  */
+#define HSOP_USER_DEL_FLAG_AP	2u
+
+/* g0 id1 config event (the proven key-lane carrier shape):
+ *   hdr[12] | token[8] | cmd u16 | len u16 | body[len] | pad[4]  (0xff pad)
+ * The firmare g0 id1 handler receives the message with the data pointer at
+ * the token, i.e. cmd = payload+8, len = payload+10, body = payload+12 [V]. */
+#define HSOP_ID_CFG_EVENT	1u
+#define HSOP_CFG_OVERHEAD	28u	/* 12 hdr + 8 token + 2 cmd + 2 len + 4 pad */
+#define HSOP_CFG_CMD_ASOC_SYN	0x07d2u
+#define HSOP_ASOC_SYN_BODY_LEN	4u
+#define HSOP_ASOC_SYN_WIRE_LEN	(HSOP_CFG_OVERHEAD + HSOP_ASOC_SYN_BODY_LEN)
+#define HSOP_ASOC_OFF_UID	0x00u	/* u16 AID/user id   */
+#define HSOP_ASOC_OFF_STATE	0x02u	/* u8 association state */
+#define HSOP_ASOC_STATE_ASSOC	1u	/* hmac_ap_* state=1 [V] */
+#define HSOP_ASOC_STATE_FT	3u	/* hmac_ft_assoc state=3 [V] */
+#define HSOP_CFG_TOKEN_BYTE	4u	/* token[8] pattern byte (proven key carrier) */
+#define HSOP_CFG_TOKEN_VALUE	0x01u
+#define HSOP_CFG_PAD_VALUE	0xffu
+
+/* WAL cfg-event kick, opcode 0x00d0, inherited H2D_WAL_CMD_KICK_STA. */
+#define HSOP_WAL_KICK_CMD	0x00d0u
+#define HSOP_KICK_BODY_LEN	16u
+#define HSOP_KICK_OFF_MAC	0x00u
+#define HSOP_KICK_OFF_REASON	0x06u
+#define HSOP_KICK_OFF_SUBTYPE	0x08u	/* 0xc0 = deauth (subtype 12) [V] */
+#define HSOP_KICK_OFF_LAST	0x0fu	/* vendor constant 1 [V] */
+#define HSOP_KICK_SUBTYPE_DEAUTH 12u
+#define HSOP_KICK_FLAG_DEAUTH	0xc0u
+
+/* ===================================================================
+ * 2. Neutral parameter structs + wire builders
+ * =================================================================== */
+struct hsop_user_add_params {
+	u8	band;		/* 0 = 2.4 GHz (header high nibble)   */
+	u8	vap_id;		/* header[3]                          */
+	u8	hdr2;		/* header[2] (vendor vap+0xfa9, [U])   */
+	u8	dst;		/* HCC destination nibble (0 = local) */
+	u16	aid;		/* firmware user id / AID             */
+	u8	mac[6];
+	u8	type;		/* 2 = normal AP-mode user             */
+	s8	rssi;
+};
+
+struct hsop_user_del_params {
+	u8	band;
+	u8	vap_id;
+	u8	hdr2;
+	u8	dst;
+	u16	uid;
+	u8	mac[6];
+	u8	flag;		/* 2 = AP-mode user */
+};
+
+struct hsop_asoc_syn_params {
+	u8	band;
+	u8	vap_id;
+	u8	hdr2;
+	u8	dst;
+	u8	module;		/* g0 header module/VAP index          */
+	u16	aid;
+	u8	state;
+};
+
+struct hsop_kick_params {
+	u8	mac[6];
+	u16	reason;
+	u8	subtype;	/* cfg80211 station_del_parameters.subtype */
+};
+
+/* Builders: fill the complete HCC wire frame; return 0 / -errno.
+ * The caller supplies a buffer of at least the matching *_WIRE_LEN. */
+int hsop_build_user_add(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_user_add_params *p);
+int hsop_build_user_del(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_user_del_params *p);
+int hsop_build_asoc_syn(u8 *wire, size_t cap, size_t *out_len,
+			const struct hsop_asoc_syn_params *p);
+int hsop_build_kick_body(u8 *body, size_t cap,
+			 const struct hsop_kick_params *p);
+
+/* Structural re-check of a built frame (0 = acceptable).  These re-read the
+ * wire bytes, so a header regression cannot make the host test lie. */
+int hsop_check_user_add(const u8 *wire, size_t len);
+int hsop_check_user_del(const u8 *wire, size_t len);
+int hsop_check_asoc_syn(const u8 *wire, size_t len);
+
+/* ===================================================================
+ * 3. Host station table (mirrors the cfg80211 station state)
+ * =================================================================== */
+#define HSOP_MAX_STA	32u
+
+struct hsop_sta {
+	u8	used;
+	u8	mac[6];
+	u16	aid;
+	int	authorized;	/* cfg80211 STA_FLAG_AUTHORIZED set  */
+	int	authenticated;
+	int	associated;
+	u32	flags_mask;	/* last station_parameters mask/set  */
+	u32	flags_set;
+};
+
+struct hsop_sta_stats {
+	u32	added;
+	u32	updated;
+	u32	deleted;
+	u32	refused;
+	u32	flush;
+	u32	dup_updates;
+	u32	unknown_del;
+};
+
+struct hsop_sta_table {
+	struct hsop_sta	sta[HSOP_MAX_STA];
+	struct hsop_sta_stats stats;
+};
+
+void hsop_sta_table_init(struct hsop_sta_table *t);
+int hsop_sta_add(struct hsop_sta_table *t, const u8 *mac, u16 aid,
+		 u32 flags_mask, u32 flags_set);
+struct hsop_sta *hsop_sta_find(struct hsop_sta_table *t, const u8 *mac);
+const struct hsop_sta *hsop_sta_find_const(const struct hsop_sta_table *t,
+					   const u8 *mac);
+int hsop_sta_update(struct hsop_sta_table *t, const u8 *mac,
+		    u32 flags_mask, u32 flags_set);
+int hsop_sta_del(struct hsop_sta_table *t, const u8 *mac);
+u32 hsop_sta_count(const struct hsop_sta_table *t);
+/* Return the unix-time-ish index-th station (dump_station helper):
+ * 0 = found, -ENOENT past the end. */
+int hsop_sta_at(const struct hsop_sta_table *t, u32 index, struct hsop_sta *out);
+
+/* ===================================================================
+ * 4. 802.11 data RX -> Ethernet conversion + EAPOL classification
+ *
+ * These are the vendor rules decoded from hmac_rx_frame_80211_to_eth /
+ * hmac_rx_get_mac_header_len / hmac_rx_frame_get_snap_type, restricted to
+ * what a host AP needs: data frames from an associated station.
+ * =================================================================== */
+#define HSOP_ETH_HDR_LEN	14u
+#define HSOP_ETH_P_PAE		0x888eu
+#define HSOP_ETH_P_MAX		0xffffu
+#define HSOP_SNAP_HDR_LEN	8u	/* AA AA 03 00 00 00 + ethertype */
+#define HSOP_EAPOL_HDR_LEN	4u
+#define HSOP_EAPOL_KEY_MIN	99u	/* 4 + 95 fixed EAPOL-Key bytes  */
+#define HSOP_EAPOL_KEY_INFO_OFF	5u	/* inside the EAPOL frame        */
+#define HSOP_EAPOL_KEYDLEN_OFF	97u	/* inside the EAPOL frame        */
+#define HSOP_EAPOL_KEY_PAIRWISE	0x0008u	/* key-info bit 3                */
+
+struct hsop_rx_info {
+	u16	fc;		/* frame control (little-endian)     */
+	int	is_data;	/* 802.11 type == 2                  */
+	u8	type;
+	u8	subtype;
+	int	tods;
+	int	fromds;
+	u32	hdr_len;	/* 802.11 header length              */
+	u32	payload_off;	/* = hdr_len + SNAP (when present)   */
+	u8	src[6];
+	u8	dst[6];
+	int	has_snap;
+	u16	ethertype;	/* host order                        */
+	int	is_eapol;
+	u8	eapol_type;
+	u16	eapol_len;
+	int	eapol_key;
+	int	eapol_key_pairwise;
+	u16	eapol_key_datalen;
+	int	eapol_ptk_done_like; /* pairwise + key-datalen 0 [V] */
+};
+
+/* Parse an 802.11 MPDU as delivered by the MAC.  -EINVAL/-ENOSPC style
+ * negative errors refuse a frame; is_data is set for data frames even when
+ * the LLC/SNAP type is absent (ethertype 0). */
+int hsop_rx_parse(const u8 *mpdu, u32 len, struct hsop_rx_info *out);
+
+/* Convert one parsed data MPDU to a complete Ethernet frame (14 B header +
+ * payload).  Refuses non-data frames and frames without an LLC/SNAP. */
+int hsop_rx_to_eth(const u8 *mpdu, u32 len, u8 *eth, size_t cap,
+		   size_t *eth_len, struct hsop_rx_info *out);
+
+/* True when the frame may be delivered to the host for the given station
+ * authorization state: EAPOL always (the 4-way needs it before the key is
+ * installed), other data only when authorized. */
+int hsop_rx_deliverable(const struct hsop_rx_info *rx, int authorized);
+
+#endif /* HI5622_STA_OPS_LOGIC_H */
