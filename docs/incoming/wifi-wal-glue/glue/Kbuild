# hi5622 wal config-command front end - 6.18 out-of-tree build
# Lane: wifi-wal-glue (host-only research). Original GPL-2.0 text.
# Links the alg_cfg command codec (wifi-algcfg-slice/codec/) into one
# front-end module: hi5622_wal_cfg.ko.
#
# Usage (same tree/toolchain as the codec slice):
#   export KDIR=/home/shibbityshwab/openwrt-lab-selectorfix-img/build_dir/target-arm_cortex-a9_musl_eabi/linux-hisilicon_luofu/linux-6.18.60
#   export TC=/home/shibbityshwab/openwrt-lab-selectorfix-img/staging_dir/toolchain-arm_cortex-a9_gcc-14.4.0_musl_eabi/bin
#   make ARCH=arm CROSS_COMPILE=$(TC)/arm-openwrt-linux-muslgnueabi- -C $(KDIR) M=$(pwd) modules
#
# Result: hi5622_wal_cfg.ko (license=GPL, vermagic 6.18.60).

MODULE_NAME := hi5622_wal_cfg

# codec core lives in the previous slice (sibling directory)
CODEC_DIR := $(abspath $(src)/../../wifi-algcfg-slice/codec)

ccflags-y += -std=gnu99 -fno-strict-aliasing -Wno-unused-variable -Wno-unused-function
# OpenWrt-patched kernel Makefile drops the stock '-isystem $(CC -print-file-name=include)';
# the harness-style headers need bare <stddef.h> from the toolchain.
ccflags-y += -isystem $(shell $(CC) -print-file-name=include)
ccflags-y += -Wno-sign-compare -Wno-pointer-sign -Wno-format -Wno-declaration-after-statement
ccflags-y += -D_FORTIFY_SOURCE=0
# kernel build takes the shim branch (pr_* logs, local securec impls)
ccflags-y += -DOAL_COMPAT_KERNEL
ccflags-y += -I$(CODEC_DIR)

$(MODULE_NAME)-y := wal_cfg_frontend.o \
                    wal_cfg_module.o \
                    wal_cfg_lut.o \
                    hmac_cfg_stubs.o \
                    wal_config_alg_cfg.o \
                    kernel_util.o
obj-m := $(MODULE_NAME).o

# cfg80211 vendor-command symbols are provided by cfg80211.ko (not built
# in-tree on this luofu tree); declare them for modpost, see the file.
KBUILD_EXTRA_SYMBOLS += $(src)/cfg80211-provider.symvers

# The two codec translation units live outside this module directory:
# give make explicit compile rules for them (out-of-tree external sources).
$(obj)/wal_config_alg_cfg.o: $(CODEC_DIR)/wal_config_alg_cfg.c FORCE
	$(call if_changed_rule,cc_o_c)

$(obj)/kernel_util.o: $(CODEC_DIR)/kernel_util.c FORCE
	$(call if_changed_rule,cc_o_c)
