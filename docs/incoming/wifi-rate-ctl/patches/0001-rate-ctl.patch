+/* Generalised alg_cfg config event: one decoded vendor command on the
+ * proven g0 id2 / key 0x0101 carrier.  See h2d_send_logic.h. */
+int h2d_build_alg_cfg(struct h2d_frame *f, u8 dst, u8 fb, u16 cfg_id,
+		      u8 cfg_type, u8 pkt_type, const u8 *value, u16 value_len,
+		      enum h2d_err *err)
+{
+	u8 blob[H2D_ALG_HDR_LEN + H2D_ALG_MAX_VALUE];
+	u16 blob_len;
+
+	if (!f || cfg_id == 0u || cfg_type > 1u || pkt_type > 13u ||
+	    value_len > H2D_ALG_MAX_VALUE || (value_len && !value)) {
+		if (err)
+			*err = H2D_EARG;
+		return -1;
+	}
+	if (fb > H2D_CTX_MAX_MODULE) {
+		if (err)
+			*err = H2D_EBOUNDS;
+		return -1;
+	}
+	blob_len = (u16)(H2D_ALG_HDR_LEN + value_len);
+	memset(blob, 0, sizeof(blob));
+	blob[0] = (u8)(cfg_id & 0xffu);
+	blob[1] = (u8)((cfg_id >> 8) & 0xffu);
+	blob[2] = cfg_type;	/* 0 = SET, 1 = GET */
+	blob[3] = pkt_type;	/* 13 = no leading packet-type token */
+	blob[8] = 1u;		/* need_w4_dev_return: the device answers */
+	if (value_len)
+		memcpy(blob + H2D_ALG_HDR_LEN, value, value_len);
+	return h2d_build_g0_cfg_event(f, 2u, dst, 0u, fb, 0u, h2d_cal_token,
+				      H2D_CAL_KEY, blob, blob_len,
+				      h2d_cal_tail, err);
