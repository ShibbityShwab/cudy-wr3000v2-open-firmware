+	/* The WAL group-2 cfg-event family has no static receive-table slot;
+	 * validate its decoded envelope instead of refusing the shape the
+	 * vendor host itself emits (see h2d_check_wal_cfg). */
+	if (f->group == H2D_GROUP_CORE && f->id == H2D_WAL_ID)
+		return h2d_check_wal_cfg(f);
+
