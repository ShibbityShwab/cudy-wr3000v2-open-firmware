+/* WAL group-2 cfg-event family validation (wifi-vap-start lane).
+ *
+ * WHY: the vendor host emits VAP create/start as HCC group-2 frames whose
+ * 12-byte header id is 0; the firmware's static group-2 receive table has
+ * no id-0 entry, so h2d_fw_handler_lookup() cannot vet it.  The 2026-11-26
+ * bench fire showed the consequence: "frame rejected by the h2d_frames
+ * validator (firmware receive slot has no handler)" and the VAP start
+ * sequence never reached the wire.  The family is therefore validated
+ * STRUCTURALLY - exact envelope, WAL cfg-event id 1, command allowlist and
+ * per-command body size.  Unknown commands, mismatched lengths and a
+ * mutated envelope are still refused (fail-closed); every other
+ * (group,id) keeps the generic non-NULL handler-slot rule. */
+static enum h2d_err h2d_check_wal_cfg(const struct h2d_frame *f)
+{
+	static const struct {
+		u16 cmd;
+		u16 body_len;
+	} wal_cmds[] = {
+		{ H2D_WAL_CMD_VAP_ADD, 24u },
+		{ H2D_WAL_CMD_VAP_START, 12u },
+		{ H2D_WAL_CMD_KICK_STA, 16u },
+		{ H2D_WAL_CMD_AP_START, 156u },
+	};
+	u32 data_len;
+	u16 cmd, body_len;
+	size_t i;
+
+	if (f->payload_len < H2D_WAL_HDR_LEN)
+		return H2D_ESHORT;
+	if (h2d_get32(f->payload + 4) != H2D_WAL_CFG_ID)
+		return H2D_EWALCMD;
+	data_len = h2d_get16(f->payload + 0x0a);
+	cmd = h2d_get16(f->payload + 0x10);
+	body_len = h2d_get16(f->payload + 0x12);
+	if (data_len != (u32)body_len + 4u)
+		return H2D_EARG;
+	if ((u32)f->payload_len != (u32)H2D_WAL_HDR_LEN + (u32)body_len)
+		return H2D_ELEN;
+	for (i = 0; i < H2D_ARRAY_SIZE(wal_cmds); i++) {
+		if (wal_cmds[i].cmd != cmd)
+			continue;
+		if (wal_cmds[i].body_len != body_len)
+			return H2D_EARG;
+		return H2D_OK;
+	}
+	return H2D_EWALCMD;
+}
+
+/* Public predicate used by the frame-post path (hi5622_frame_post.c): the
+ * WAL family is handled by the firmware WAL module, not by an HCC
+ * handler-table slot.  Reuses the same structural family check. */
+int h2d_frame_is_wal_cfg(const struct h2d_frame *f)
+{
+	if (!f || f->group != H2D_GROUP_CORE || f->id != H2D_WAL_ID)
+		return 0;
+	return h2d_check_wal_cfg(f) == H2D_OK;
+}
