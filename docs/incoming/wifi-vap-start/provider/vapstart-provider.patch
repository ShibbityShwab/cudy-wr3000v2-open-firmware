+					(u8)request->wdev->iftype, c->band,
+					(u8)hi5622_vap_start_module);
+	if (rc) {
+		dev_warn(dev,
+			 "cfg80211: VAP start sequence not posted (%d) - scan aborted, no scan message\n",
+			 rc);
+		goto out;
+	}
+
