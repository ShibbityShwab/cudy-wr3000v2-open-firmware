+static int hi5622_scan_post_vap_start(struct hi5622_pci *ctx,
+				      const struct hi5622_frame_ops *ops,
+				      u8 iftype, u8 band, u8 module)
+{
+	struct hi5622_vap_start_params vp;
+	u8 *wire;
+	size_t len = 0;
