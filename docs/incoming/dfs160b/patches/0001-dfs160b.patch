--- dfs-relax-build/hi5622_dfsb.c	1970-01-01 07:00:00.000000000 +0700
+++ dfs160b-work/hi5622_dfsb.c	2026-11-26 16:00:43.651408940 +0700
@@ -0,0 +1,386 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_dfsb.c - the portable 160 MHz width selector + DFS/CAC/NOL model
+ * for the Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, 6.18.60).
+ *
+ * ORIGINAL clean-room code (lane dfs160b / shared task task-245).  The
+ * protocol facts are the committed decode lanes ../wifi-5g-160-dfs,
+ * ../wifi-5g-dfs-set, ../wifi-5g-dfs-order and ../wifi-5g-cac-context; no
+ * vendor source, object code or firmware byte is reproduced.  This file is
+ * the DECISION layer only: the kernel glue (hi5622_dfsb_k.c) owns the
+ * timers, the H2D posts and the cfg80211 events.
+ */
+#include "hi5622_dfsb.h"
+
+#ifdef __KERNEL__
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+
+/* ---- the vendor band-1 channel table (29 entries, TABLES T3) [V] ----- */
+struct dfsb_chan {
+	u8	ch;
+	u16	mhz;
+};
+
+static const struct dfsb_chan dfsb_band1[29] = {
+	{ 36, 5180 }, { 40, 5200 }, { 44, 5220 }, { 48, 5240 },
+	{ 52, 5260 }, { 56, 5280 }, { 60, 5300 }, { 64, 5320 },
+	{ 100, 5500 }, { 104, 5520 }, { 108, 5540 }, { 112, 5560 },
+	{ 116, 5580 }, { 120, 5600 }, { 124, 5620 }, { 128, 5640 },
+	{ 132, 5660 }, { 136, 5680 }, { 140, 5700 }, { 144, 5720 },
+	{ 149, 5745 }, { 153, 5765 }, { 157, 5785 }, { 161, 5805 },
+	{ 165, 5825 }, { 184, 4920 }, { 188, 4940 }, { 192, 4960 },
+	{ 196, 4980 },
+};
+
+static const struct dfsb_chan *dfsb_find_band1(u8 channel)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(dfsb_band1) / sizeof(dfsb_band1[0]); i++)
+		if (dfsb_band1[i].ch == channel)
+			return &dfsb_band1[i];
+	return NULL;
+}
+
+int hi5622_dfsb_chan_freq(u8 channel, u16 *mhz)
+{
+	const struct dfsb_chan *c;
+
+	if (!mhz)
+		return -EINVAL;
+	c = dfsb_find_band1(channel);
+	if (!c)
+		return -EINVAL;
+	*mhz = c->mhz;
+	return 0;
+}
+
+/* DFS set: 52-64 and 100-144 (the vendor band-1 table includes ch144; the
+ * driver list had the ch144 gap). [V, TABLES T4] */
+int hi5622_dfsb_is_dfs_chan(u8 channel)
+{
+	return ((channel >= 52u && channel <= 64u) ||
+		(channel >= 100u && channel <= 144u)) ? 1 : 0;
+}
+
+/* TDWR/weather window: the vendor computes freq - 5600 and tests <= 50,
+ * i.e. 5600..5650 MHz.  In the band-1 table that is ch 120/124/128. */
+int hi5622_dfsb_is_tdwr_chan(u8 channel)
+{
+	u16 mhz = 0;
+
+	if (hi5622_dfsb_chan_freq(channel, &mhz))
+		return 0;
+	return (mhz >= 5600u && mhz <= 5650u) ? 1 : 0;
+}
+
+/* ---- 160 / 80 MHz single-segment centres (IEEE channelisation) ------- */
+int hi5622_dfsb_ccfs1_160(u8 channel, u32 *ccfs1_mhz)
+{
+	u32 c;
+
+	if (!ccfs1_mhz)
+		return -EINVAL;
+	if (channel >= 36u && channel <= 64u)
+		c = 5250u;
+	else if (channel >= 100u && channel <= 128u)
+		c = 5570u;
+	else if (channel >= 149u && channel <= 177u)
+		c = 5815u;
+	else
+		return -EOPNOTSUPP;
+	*ccfs1_mhz = c;
+	return 0;
+}
+
+int hi5622_dfsb_ccfs1_80(u8 channel, u32 *ccfs1_mhz)
+{
+	u32 c;
+
+	if (!ccfs1_mhz)
+		return -EINVAL;
+	if (channel >= 36u && channel <= 48u)
+		c = 5210u;
+	else if (channel >= 52u && channel <= 64u)
+		c = 5290u;
+	else if (channel >= 100u && channel <= 112u)
+		c = 5530u;
+	else if (channel >= 116u && channel <= 128u)
+		c = 5610u;
+	else if (channel >= 132u && channel <= 144u)
+		c = 5690u;
+	else if (channel >= 149u && channel <= 161u)
+		c = 5775u;
+	else if (channel >= 165u && channel <= 177u)
+		c = 5855u;
+	else
+		return -EOPNOTSUPP;
+	*ccfs1_mhz = c;
+	return 0;
+}
+
+/* ---- 1. the 0x0124 body[1] width selector ---------------------------- */
+int hi5622_dfsb_width_plan(unsigned int ht_bw, u8 band, u8 channel, u32 width,
+			   u32 ccfs1, u32 ccfs2,
+			   struct hi5622_dfsb_width_plan *out)
+{
+	u32 centre = 0;
+	u8 sel;
+
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (ht_bw > HI5622_DFSB_PARM_MAX)
+		return -EINVAL;
+	out->width = width <= 255u ? (u8)width : 0xffu;
+	if (ht_bw == HI5622_DFSB_PARM_OFF) {
+		/* The legacy byte-identical path: body[1] stays 0. */
+		return 0;
+	}
+	if (!channel)
+		return -EINVAL;
+	if (band == 0u) {
+		if (channel < 1u || channel > 14u)
+			return -EINVAL;
+	} else if (band != 1u) {
+		return -EINVAL;
+	} else if (!dfsb_find_band1(channel)) {
+		return -EINVAL;
+	}
+
+	switch (width) {
+	case HI5622_DFSB_WIDTH_20NOHT:
+	case HI5622_DFSB_WIDTH_20:
+		sel = HI5622_DFSB_BW_20;
+		break;
+	case HI5622_DFSB_WIDTH_40:
+		sel = HI5622_DFSB_BW_40;
+		break;
+	case HI5622_DFSB_WIDTH_80: {
+		int rc;
+
+		if (band == 0u)
+			return -EOPNOTSUPP;	/* 2.4 GHz has no 80 MHz */
+		if (ccfs2 != 0u)
+			return -EINVAL;
+		rc = hi5622_dfsb_ccfs1_80(channel, &centre);
+		if (rc)
+			return rc;
+		if (ccfs1 != centre)
+			return -EINVAL;
+		sel = HI5622_DFSB_BW_80;
+		break;
+	}
+	case HI5622_DFSB_WIDTH_160: {
+		int rc;
+
+		if (band != 1u)
+			return -EOPNOTSUPP;	/* 2.4 GHz has no 160 MHz */
+		/* Single segment only: the vendor VHT cap has the 160 bit
+		 * but not the 80+80 bit (TABLES T7), so CCFS2 must be 0. */
+		if (ccfs2 != 0u)
+			return -EINVAL;
+		rc = hi5622_dfsb_ccfs1_160(channel, &centre);
+		if (rc)
+			return rc;
+		if (ccfs1 != centre)
+			return -EINVAL;
+		sel = HI5622_DFSB_BW_160;
+		break;
+	}
+	case HI5622_DFSB_WIDTH_80P80:
+	case HI5622_DFSB_WIDTH_320:
+		/* Neither capability bit exists in the vendor wiphy. */
+		return -EOPNOTSUPP;
+	case HI5622_DFSB_WIDTH_5:
+	case HI5622_DFSB_WIDTH_10:
+	case HI5622_DFSB_WIDTH_1:
+	case HI5622_DFSB_WIDTH_2:
+	case HI5622_DFSB_WIDTH_4:
+	case HI5622_DFSB_WIDTH_8:
+	case HI5622_DFSB_WIDTH_16:
+		return -EOPNOTSUPP;
+	default:
+		return -EINVAL;
+	}
+	out->enabled = true;
+	out->sel = sel;
+	out->width = (u8)width;
+	return 0;
+}
+
+/* ---- 3. the CAC / NOL state machine ---------------------------------- */
+int hi5622_dfsb_cac_begin(struct hi5622_dfsb_cac *st, u8 channel,
+			  u16 center_freq, u32 cac_time_ms)
+{
+	u16 mhz = 0;
+	u32 vendor_ms;
+
+	if (!st)
+		return -EINVAL;
+	if (st->state == HI5622_DFSB_CAC_ARMED)
+		return -EALREADY;
+	if (hi5622_dfsb_chan_freq(channel, &mhz))
+		return -EINVAL;
+	if (!hi5622_dfsb_is_dfs_chan(channel))
+		return -EOPNOTSUPP;
+	if (center_freq && center_freq != mhz)
+		return -EINVAL;
+	memset(st, 0, sizeof(*st));
+	vendor_ms = hi5622_dfsb_is_tdwr_chan(channel) ?
+		     HI5622_DFSB_CAC_MS_TDWR : HI5622_DFSB_CAC_MS;
+	if (cac_time_ms > vendor_ms)
+		vendor_ms = cac_time_ms;	/* never report before cfg80211's time */
+	st->state = HI5622_DFSB_CAC_ARMED;
+	st->channel = channel;
+	st->tdwr = (u8)hi5622_dfsb_is_tdwr_chan(channel);
+	st->center_freq = mhz;
+	st->cac_ms = vendor_ms;
+	st->ticks = vendor_ms > 59999u ? vendor_ms / 60000u : 0u;
+	st->tick_ms = HI5622_DFSB_TICK_MS;
+	st->first_ms = vendor_ms > 59999u ?
+			HI5622_DFSB_FIRST_TICK_MS : HI5622_DFSB_TICK_MS;
+	st->ticks_done = 0u;
+	st->finish_ms = 0u;
+	st->nol_ms = HI5622_DFSB_NOL_MS;
+	return 0;
+}
+
+u32 hi5622_dfsb_cac_delay_ms(const struct hi5622_dfsb_cac *st)
+{
+	if (!st || st->state != HI5622_DFSB_CAC_ARMED)
+		return 0u;
+	return st->ticks_done == 0u ? st->first_ms : st->tick_ms;
+}
+
+int hi5622_dfsb_cac_tick(struct hi5622_dfsb_cac *st, u32 now_ms,
+			 enum hi5622_dfsb_cac_step *out)
+{
+	u32 need;
+
+	if (!st || !out)
+		return -EINVAL;
+	if (st->state != HI5622_DFSB_CAC_ARMED)
+		return -EPERM;
+	st->ticks_done++;
+	need = st->ticks ? st->ticks : 1u;
+	if (st->ticks_done < need) {
+		*out = HI5622_DFSB_STEP_REARM;
+		return 0;
+	}
+	st->state = HI5622_DFSB_CAC_FINISHED;
+	st->finish_ms = now_ms;
+	*out = HI5622_DFSB_STEP_FINISH;
+	return 0;
+}
+
+void hi5622_dfsb_cac_abort(struct hi5622_dfsb_cac *st)
+{
+	if (!st)
+		return;
+	memset(st, 0, sizeof(*st));
+}
+
+int hi5622_dfsb_cac_ap_gate(const struct hi5622_dfsb_cac *st, u8 channel,
+			    u32 now_ms)
+{
+	u32 elapsed;
+
+	if (!st || !channel)
+		return -EINVAL;
+	if (st->state != HI5622_DFSB_CAC_FINISHED)
+		return -EAGAIN;
+	if (st->channel != channel)
+		return -EINVAL;
+	/* Wrap-safe u32 millisecond difference; the NOL window is 30 min. */
+	elapsed = now_ms - st->finish_ms;
+	if (elapsed >= st->nol_ms)
+		return -EAGAIN;
+	return 0;
+}
+
+/* ---- 4. the 0x07E7 DFS-SET frame ------------------------------------- */
+static void dfsb_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+int hi5622_dfsb_set_build(u8 *wire, size_t cap, size_t *out_len, u8 body)
+{
+	if (!wire || !out_len)
+		return -EINVAL;
+	if (body != HI5622_DFSB_SET_BODY_ARM &&
+	    body != HI5622_DFSB_SET_BODY_CLEAR)
+		return -EINVAL;
+	if (cap < HI5622_DFSB_SET_WIRE_LEN)
+		return -ENOSPC;
+	memset(wire, 0, HI5622_DFSB_SET_WIRE_LEN);
+	/* 12-byte HCC header: g0 id1, the inherited fa/fb bytes (0 here, the
+	 * AP-start ladder owns the field-B module byte) and the tag. */
+	wire[0] = 0x00u;
+	wire[1] = 0x01u;
+	wire[2] = 0x00u;
+	wire[3] = 0x00u;
+	dfsb_put16(wire + 4, (u16)HI5622_DFSB_SET_WIRE_LEN);
+	dfsb_put16(wire + 6, (u16)HI5622_DFSB_SET_ID);
+	wire[8] = 0x00u;
+	wire[9] = 0x00u;
+	dfsb_put16(wire + 10, (u16)HI5622_DFSB_SET_TAG);
+	/* 8-byte token at +12: the inherited bench-executed pattern, byte
+	 * +16 = 0x01 (TABLES of ../wifi-5g-dfs-set). */
+	wire[16] = 0x01u;
+	dfsb_put16(wire + HI5622_DFSB_SET_KEY_OFF, (u16)HI5622_DFSB_SET_KEY);
+	dfsb_put16(wire + HI5622_DFSB_SET_LEN_OFF,
+		   (u16)HI5622_DFSB_SET_BODY_LEN);
+	wire[HI5622_DFSB_SET_BODY_OFF] = body;
+	memset(wire + HI5622_DFSB_SET_TAIL_OFF, 0xff, 4);
+	*out_len = HI5622_DFSB_SET_WIRE_LEN;
+	return 0;
+}
+
+int hi5622_dfsb_order_before(enum hi5622_dfsb_op a, enum hi5622_dfsb_op b)
+{
+	if ((unsigned int)a >= (unsigned int)HI5622_DFSB_OP_MAX ||
+	    (unsigned int)b >= (unsigned int)HI5622_DFSB_OP_MAX)
+		return -EINVAL;
+	return (unsigned int)a < (unsigned int)b ? 1 : 0;
+}
+
+/* ---- 5. the start_ap feature plan ------------------------------------ */
+int hi5622_dfsb_ap_plan(unsigned int ht_bw, unsigned int dfs_cac,
+			unsigned int dfs_set_on, u8 band, u8 channel,
+			u32 width, u32 ccfs1, u32 ccfs2,
+			const struct hi5622_dfsb_cac *cac, u32 now_ms,
+			struct hi5622_dfsb_ap_plan *out)
+{
+	struct hi5622_dfsb_width_plan wp;
+	int rc;
+
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (ht_bw > HI5622_DFSB_PARM_MAX || dfs_cac > HI5622_DFSB_PARM_MAX)
+		return -EINVAL;
+	/* One meaning per load: the CAC runtime owns the 0x07E7 frames. */
+	if (dfs_cac == HI5622_DFSB_PARM_ON && dfs_set_on)
+		return -EINVAL;
+	rc = hi5622_dfsb_width_plan(ht_bw, band, channel, width, ccfs1, ccfs2,
+				    &wp);
+	if (rc)
+		return rc;
+	out->width_enabled = wp.enabled;
+	out->width_sel = wp.sel;
+	if (dfs_cac == HI5622_DFSB_PARM_ON && band == 1u &&
+	    hi5622_dfsb_is_dfs_chan(channel)) {
+		out->cac_required = true;
+		rc = hi5622_dfsb_cac_ap_gate(cac, channel, now_ms);
+		if (rc)
+			return rc;
+		out->cac_gate = true;
+	}
+	return 0;
+}
diff -ruN '--exclude=*.o' '--exclude=*.ko' '--exclude=*.mod' '--exclude=*.mod.c' '--exclude=.*.cmd' '--exclude=*.cmd' '--exclude=modules.order' '--exclude=Module.symvers' '--exclude=build.log' dfs-relax-build/hi5622_dfsb.h dfs160b-work/hi5622_dfsb.h
--- dfs-relax-build/hi5622_dfsb.h	1970-01-01 07:00:00.000000000 +0700
+++ dfs160b-work/hi5622_dfsb.h	2026-11-26 15:57:08.109753304 +0700
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_dfsb.h - the 5 GHz 160 MHz width selector + the DFS/CAC/NOL model
+ * for the Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, Linux
+ * 6.18.60).
+ *
+ * ORIGINAL clean-room code (lane dfs160b / shared task task-245, 2026-11-26).
+ * Pure C99, portable: the same file compiles into the kernel module (via
+ * ../hi5622_dfsb_k.c) and into the host selftest (src/dfs160b_selftest.c).
+ * No vendor source, object code or firmware byte is reproduced; every
+ * constant is a decoded protocol fact of the committed decode lanes
+ * ../wifi-5g-160-dfs (T2/T3/T4/T5/T7/T8), ../wifi-5g-dfs-set (0x07E7 frame
+ * and worker), ../wifi-5g-dfs-order (the forced order) and
+ * ../wifi-5g-cac-context (the +0x49C/+0x4A0 CAC context).
+ *
+ * WHAT THIS MODULE DECIDES
+ *  1. the 0x0124 WIDTH SELECTOR.  The H2D g0-id1 channel-config body is
+ *     {band, bandwidth, channel, 0}; byte[1] is the vendor bandwidth selector
+ *     (0=20M, 1=40M, 2=80M, 3=160M; the firmware worker CA 0x841B8 stores it
+ *     at module ctx+0x12, and the 5 GHz RF branch CA 0x40684 feeds it to the
+ *     descriptor selector CA 0x101890).  This model maps a cfg80211 chandef
+ *     width onto it and validates the single-segment 160 MHz centre (CCFS1).
+ *     IMPORTANT: the nl80211_chan_width values are the Linux 6.18 UAPI ones
+ *     (80P80=4, 160=5, 320=13) - the pre-5.19 numbering (160=4, 80P80=5) is
+ *     WRONG for this target; hi5622_dfsb_k.c pins that with _Static_assert.
+ *  2. the DFS CHANNEL SET: the vendor band-1 table's 29 channels, the DFS
+ *     subset 52-64 / 100-144 (including the ch144 the driver list missed) and
+ *     the 5600..5650 MHz TDWR window that carries the 600000 ms CAC time.
+ *  3. the CAC/NOL TIMING state machine: 60000 ms default / 600000 ms TDWR
+ *     CAC, the vendor tick arithmetic (first timer 63000 ms, then 60000 ms
+ *     per tick, ticks = cac_ms/60000 floor) and the 1800000 ms (30 min)
+ *     non-occupancy period (../wifi-5g-160-dfs TABLES T4/T5).
+ *  4. the 0x07E7 DFS-SET wire frame (ARM {01} / CLEAR {00}, 29-B carrier)
+ *     and the ladder ORDER contract 0x0124 -> ... -> 0x0065 -> 0x07E7 ->
+ *     0x01F7 -> 0x0242.
+ */
+#ifndef HI5622_DFSB_H
+#define HI5622_DFSB_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+/* =====================================================================
+ * 1. The 0x0124 body[1] width selector
+ * ===================================================================== */
+
+/* enum nl80211_chan_width, Linux 6.18.60 UAPI (include/uapi/linux/nl80211.h).
+ * These are NOT the pre-5.19 values: 80P80 is 4 and 160 is 5. */
+#define HI5622_DFSB_WIDTH_20NOHT	0u
+#define HI5622_DFSB_WIDTH_20		1u
+#define HI5622_DFSB_WIDTH_40		2u
+#define HI5622_DFSB_WIDTH_80		3u
+#define HI5622_DFSB_WIDTH_80P80		4u
+#define HI5622_DFSB_WIDTH_160		5u
+#define HI5622_DFSB_WIDTH_5		6u
+#define HI5622_DFSB_WIDTH_10		7u
+#define HI5622_DFSB_WIDTH_1		8u
+#define HI5622_DFSB_WIDTH_2		9u
+#define HI5622_DFSB_WIDTH_4		10u
+#define HI5622_DFSB_WIDTH_8		11u
+#define HI5622_DFSB_WIDTH_16		12u
+#define HI5622_DFSB_WIDTH_320		13u
+
+/* The vendor bandwidth selector (0x0124 body[1]) [V 0/2 from the vendor
+ * width->value table 20/20/40/80/80/160; I for the 40/80/160 assemble
+ * order, to be pinned by probe P-160a]. */
+#define HI5622_DFSB_BW_20		0u
+#define HI5622_DFSB_BW_40		1u
+#define HI5622_DFSB_BW_80		2u
+#define HI5622_DFSB_BW_160		3u
+#define HI5622_DFSB_BW_MAX		3u
+
+/* ht_bw / dfs_cac module-parameter contract (owned by hi5622_dfsb_k.c). */
+#define HI5622_DFSB_PARM_OFF		0u
+#define HI5622_DFSB_PARM_ON		1u
+#define HI5622_DFSB_PARM_MAX		1u
+
+struct hi5622_dfsb_width_plan {
+	bool	enabled;	/* ht_bw=1: the selector drives body[1] */
+	u8	sel;		/* the 0x0124 body[1] value when enabled */
+	u8	width;		/* the nl80211_chan_width value */
+};
+
+/* Plan the 0x0124 body[1] byte.
+ *  ht_bw    : the module parameter (0/1; >1 -> -EINVAL)
+ *  band     : 0 = 2.4 GHz, 1 = 5 GHz
+ *  channel  : the control channel (hw_value)
+ *  width    : nl80211_chan_width
+ *  ccfs1/2  : the chandef centre frequencies (MHz)
+ *  0 on success; -EINVAL/-EOPNOTSUPP on a bad parameter or an unselectable
+ *  width (80+80 and 320 MHz are refused: the vendor VHT cap 0x00400064 has
+ *  neither the 80+80 nor the 320 MHz bit).  ht_bw=0 always yields sel=0 -
+ *  the pre-feature wire byte. */
+int hi5622_dfsb_width_plan(unsigned int ht_bw, u8 band, u8 channel, u32 width,
+			   u32 ccfs1, u32 ccfs2,
+			   struct hi5622_dfsb_width_plan *out);
+
+/* The single-segment 160 MHz CCFS1 of a control channel:
+ * 36-64 -> 50, 100-128 -> 114, 149-177 -> 163 (IEEE channelisation).
+ * 0 on success; -EOPNOTSUPP when the channel is not in a 160 MHz segment. */
+int hi5622_dfsb_ccfs1_160(u8 channel, u32 *ccfs1_mhz);
+
+/* The 80 MHz CCFS1: 36-48->42, 52-64->58, 100-112->106, 116-128->122,
+ * 132-144->138, 149-161->155, 165-177->171. */
+int hi5622_dfsb_ccfs1_80(u8 channel, u32 *ccfs1_mhz);
+
+/* =====================================================================
+ * 2. The DFS channel set (the ch144 gap, the TDWR window)
+ * ===================================================================== */
+
+/* The vendor band-1 table (29 channels): 36 40 44 48 52 56 60 64 100 104
+ * 108 112 116 120 124 128 132 136 140 144 149 153 157 161 165 184 188 192
+ * 196 (../wifi-5g-160-dfs TABLES T3).  0 on success / -EINVAL. */
+int hi5622_dfsb_chan_freq(u8 channel, u16 *mhz);
+
+/* 1 when the channel is a DFS channel (52-64 or 100-144) [V, TABLES T4]. */
+int hi5622_dfsb_is_dfs_chan(u8 channel);
+
+/* 1 when the channel frequency is in the 5600..5650 MHz TDWR/weather window
+ * (vendor: freq - 5600 <= 50) - the 600000 ms CAC channel class. */
+int hi5622_dfsb_is_tdwr_chan(u8 channel);
+
+/* =====================================================================
+ * 3. The CAC / NOL state machine (host side, vendor hmac_dfs_cac_*)
+ * ===================================================================== */
+
+#define HI5622_DFSB_CAC_MS		60000u
+#define HI5622_DFSB_CAC_MS_TDWR		600000u
+#define HI5622_DFSB_NOL_MS		1800000u
+#define HI5622_DFSB_TICK_MS		60000u
+#define HI5622_DFSB_FIRST_TICK_MS	63000u
+
+enum hi5622_dfsb_cac_state {
+	HI5622_DFSB_CAC_IDLE = 0,
+	HI5622_DFSB_CAC_ARMED = 1,
+	HI5622_DFSB_CAC_FINISHED = 2,
+};
+
+enum hi5622_dfsb_cac_step {
+	HI5622_DFSB_STEP_REARM = 0,
+	HI5622_DFSB_STEP_FINISH = 1,
+};
+
+struct hi5622_dfsb_cac {
+	u8	state;		/* enum hi5622_dfsb_cac_state */
+	u8	channel;
+	u8	tdwr;
+	u8	pad;
+	u16	center_freq;	/* MHz */
+	u32	cac_ms;		/* the effective CAC time */
+	u32	ticks;		/* timer ticks (floor(cac_ms/60000)) */
+	u32	tick_ms;	/* 60000 */
+	u32	first_ms;	/* 63000 when cac_ms > 59999, else 60000 */
+	u32	ticks_done;
+	u32	finish_ms;	/* now_ms at FINISH (wrap-safe difference) */
+	u32	nol_ms;		/* 1800000 */
+};
+
+/* Arm the state machine for a DFS channel.
+ *  - -EOPNOTSUPP when the channel is not a DFS channel;
+ *  - -EALREADY when a CAC is already running;
+ *  - 0 on success: ARMED, tdwr from the frequency window, cac_ms =
+ *    max(the vendor class time, cac_time_ms) so a report can never be
+ *    earlier than the cfg80211-provided CAC time.
+ * The caller keeps the 0x07E7 ARM/CLEAR frames and the cfg80211 events. */
+int hi5622_dfsb_cac_begin(struct hi5622_dfsb_cac *st, u8 channel,
+			  u16 center_freq, u32 cac_time_ms);
+
+/* The delay from now to the next tick (the first 63000/60000 ms, then
+ * 60000 ms).  0 when no CAC is armed. */
+u32 hi5622_dfsb_cac_delay_ms(const struct hi5622_dfsb_cac *st);
+
+/* One vendor timer tick at now_ms: REARM or FINISH (which sets FINISHED and
+ * records finish_ms).  0 on success; -EPERM when no CAC is armed. */
+int hi5622_dfsb_cac_tick(struct hi5622_dfsb_cac *st, u32 now_ms,
+			 enum hi5622_dfsb_cac_step *out);
+
+/* Abort/cancel: IDLE with the channel cleared. */
+void hi5622_dfsb_cac_abort(struct hi5622_dfsb_cac *st);
+
+/* The start_ap DFS gate with the feature ON: 0 only when a CAC FINISHED on
+ * exactly this channel and the 1800000 ms NOL window since finish_ms has not
+ * elapsed; -EAGAIN otherwise (-EINVAL on a bad argument). */
+int hi5622_dfsb_cac_ap_gate(const struct hi5622_dfsb_cac *st, u8 channel,
+			    u32 now_ms);
+
+/* =====================================================================
+ * 4. The 0x07E7 DFS-SET frame and the ladder order contract
+ * ===================================================================== */
+
+#define HI5622_DFSB_SET_WIRE_LEN	29u
+#define HI5622_DFSB_SET_HDR_LEN		12u
+#define HI5622_DFSB_SET_KEY_OFF		20u
+#define HI5622_DFSB_SET_LEN_OFF		22u
+#define HI5622_DFSB_SET_BODY_OFF		24u
+#define HI5622_DFSB_SET_TAIL_OFF		25u
+#define HI5622_DFSB_SET_TAG		0x5a5au
+#define HI5622_DFSB_SET_ID		1u
+#define HI5622_DFSB_SET_KEY		0x07e7u
+#define HI5622_DFSB_SET_BODY_LEN		1u
+#define HI5622_DFSB_SET_BODY_ARM		0x01u
+#define HI5622_DFSB_SET_BODY_CLEAR	0x00u
+#define HI5622_DFSB_SET_ARM_PATTERN	0x2du	/* the six sub-base bit0s {1,0,1,1,0,1} */
+
+/* Build the g0-id1 key 0x07E7 wire frame (the committed ../wifi-5g-dfs-set
+ * carrier geometry; ARM = body 0x01, CLEAR = body 0x00).  Byte-exact KAT:
+ * ARM = 00 01 00 00 1d 00 01 00 00 00 5a 5a | 00 00 00 00 01 00 00 00 |
+ *       e7 07 01 00 01 ff ff ff ff. */
+int hi5622_dfsb_set_build(u8 *wire, size_t cap, size_t *out_len, u8 body);
+
+/* The ladder steps this feature constrains. */
+enum hi5622_dfsb_op {
+	HI5622_DFSB_OP_VAP_ADD = 0,
+	HI5622_DFSB_OP_DESC_TABLE,
+	HI5622_DFSB_OP_AP_CHAN,
+	HI5622_DFSB_OP_AP_SSID,
+	HI5622_DFSB_OP_AP_CFG,
+	HI5622_DFSB_OP_VAP_START,
+	HI5622_DFSB_OP_DFS_SET,
+	HI5622_DFSB_OP_DFS_MODE,
+	HI5622_DFSB_OP_BAND_START,
+	HI5622_DFSB_OP_MAX,
+};
+
+/* 1 when op a must be posted strictly before op b in the AP-start ladder
+ * (task-228 order: ..., ap_chan, ..., vap_start(0x0065), dfs_set(0x07E7),
+ * dfs_mode(0x01F7), band_start(0x0242)); -EINVAL on a bad op. */
+int hi5622_dfsb_order_before(enum hi5622_dfsb_op a, enum hi5622_dfsb_op b);
+
+/* =====================================================================
+ * 5. The start_ap feature plan (the one decision point both features share)
+ * ===================================================================== */
+
+struct hi5622_dfsb_ap_plan {
+	bool	width_enabled;
+	u8	width_sel;
+	bool	cac_required;	/* the chandef is a DFS channel and dfs_cac=1 */
+	bool	cac_gate;	/* the CAC gate passed for this channel */
+};
+
+/* Combine the two module parameters with the live state for one start_ap.
+ *  - -EINVAL for ht_bw/dfs_cac > 1, or dfs_cac=1 together with the ladder
+ *    dfs_set step on (one meaning per load: the CAC runtime owns 0x07E7);
+ *  - the width errors of hi5622_dfsb_width_plan();
+ *  - -EAGAIN from the CAC gate when dfs_cac=1 and the DFS channel has no
+ *    valid finished CAC (the AP-start DFS gate).
+ * now_ms: the wrap-safe millisecond clock the caller uses for the CAC
+ * machine (0 when the caller has no clock). */
+int hi5622_dfsb_ap_plan(unsigned int ht_bw, unsigned int dfs_cac,
+			unsigned int dfs_set_on, u8 band, u8 channel,
+			u32 width, u32 ccfs1, u32 ccfs2,
+			const struct hi5622_dfsb_cac *cac, u32 now_ms,
+			struct hi5622_dfsb_ap_plan *out);
+
+#endif /* HI5622_DFSB_H */
diff -ruN '--exclude=*.o' '--exclude=*.ko' '--exclude=*.mod' '--exclude=*.mod.c' '--exclude=.*.cmd' '--exclude=*.cmd' '--exclude=modules.order' '--exclude=Module.symvers' '--exclude=build.log' dfs-relax-build/hi5622_dfsb_k.c dfs160b-work/hi5622_dfsb_k.c
--- dfs-relax-build/hi5622_dfsb_k.c	1970-01-01 07:00:00.000000000 +0700
+++ dfs160b-work/hi5622_dfsb_k.c	2026-11-26 15:59:45.100160734 +0700
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_dfsb_k.c - the kernel-side DFS/CAC runtime and the 160 MHz width
+ * selector wiring for the Hi5622V100 clean-room full-MAC driver
+ * (Cudy WR3000 v2.0, Linux 6.18.60).
+ *
+ * ORIGINAL clean-room code (lane dfs160b / shared task task-245, 2026-11-26).
+ * Protocol facts: the 0x07E7 ARM/CLEAR frame + worker CA 0xB58FC of
+ * ../wifi-5g-dfs-set and ../wifi-5g-cac-context, the CAC/NOL timings of
+ * ../wifi-5g-160-dfs TABLES T4/T5, the width selector/table facts of
+ * TABLES T2/T3/T7.  No vendor source, object code or firmware byte is
+ * reproduced; the module artifact is local evidence only and never
+ * committed.
+ *
+ * cfg80211 contract (net/wireless/nl80211.c, mlme.c, 6.18.60):
+ *   - .start_radar_detection returning 0 makes cfg80211 mark the wdev CAC
+ *     started; the driver must later report cfg80211_cac_event(
+ *     NL80211_RADAR_CAC_FINISHED) / (ABORTED) with the same chandef;
+ *   - cfg80211_cac_event(FINISHED) WARNs if it arrives before
+ *     start_time + cac_time_ms, so the arithmetic below is strictly longer
+ *     than the requested CAC (vendor first tick 63000 ms, then 60000 ms);
+ *   - .end_cac is the abort path: the driver stops its hardware state, the
+ *     core emits NL80211_RADAR_CAC_ABORTED itself.
+ *
+ * THE HONEST LIMIT (documented in REPORT.md): the firmware 0x07E7 ARM worker
+ * needs a started module context (state u8[mctx+0x0E] in 1..3), which the
+ * 0x0065 VAP-start step writes.  A RADAR_DETECT arriving before start_ap
+ * therefore hits the fail-closed precheck and the op returns -EAGAIN with
+ * the live probe pack in dmesg (the bench learns which prerequisite is
+ * missing; no frame is posted into a worker that would drop it).
+ */
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+#include <net/cfg80211.h>
+
+#include "hi5622_cfg80211.h"
+#include "hi5622_dfs_set.h"
+#include "hi5622_dfsb.h"
+#include "hi5622_dfsb_k.h"
+#include "hi5622_driver.h"
+#include "hi5622_frame_post.h"
+#include "hi5622_scan.h"
+
+/* The model's nl80211 width pins are the 6.18.60 UAPI values: a drift is a
+ * compile error here, not a silent wrong selector (the sibling-lane defect
+ * class this lane guards against). */
+_Static_assert((int)NL80211_CHAN_WIDTH_20_NOHT ==
+	       (int)HI5622_DFSB_WIDTH_20NOHT, "nl80211 width 20_NOHT drift");
+_Static_assert((int)NL80211_CHAN_WIDTH_20 == (int)HI5622_DFSB_WIDTH_20,
+	       "nl80211 width 20 drift");
+_Static_assert((int)NL80211_CHAN_WIDTH_40 == (int)HI5622_DFSB_WIDTH_40,
+	       "nl80211 width 40 drift");
+_Static_assert((int)NL80211_CHAN_WIDTH_80 == (int)HI5622_DFSB_WIDTH_80,
+	       "nl80211 width 80 drift");
+_Static_assert((int)NL80211_CHAN_WIDTH_80P80 == (int)HI5622_DFSB_WIDTH_80P80,
+	       "nl80211 width 80P80 drift (6.18 value is 4)");
+_Static_assert((int)NL80211_CHAN_WIDTH_160 == (int)HI5622_DFSB_WIDTH_160,
+	       "nl80211 width 160 drift (6.18 value is 5)");
+_Static_assert((int)NL80211_CHAN_WIDTH_320 == (int)HI5622_DFSB_WIDTH_320,
+	       "nl80211 width 320 drift (6.18 value is 13)");
+
+unsigned int hi5622_ht_bw;
+module_param_named(ht_bw, hi5622_ht_bw, uint, 0444);
+MODULE_PARM_DESC(ht_bw,
+		 "5GHz AP start: 160 MHz/80 MHz channel width selector for the H2D key 0x0124 body[1] (0=off default = legacy byte, 1=derive 20/40/80/160 MHz from the cfg80211 chandef width with the 160 MHz CCFS1 check, >1 refused)");
+
+unsigned int hi5622_dfs_cac;
+module_param_named(dfs_cac, hi5622_dfs_cac, uint, 0444);
+MODULE_PARM_DESC(dfs_cac,
+		 "5GHz DFS: cfg80211 start_radar_detection/end_cac CAC runtime + the start_ap DFS gate (0=off default: no op, no frame; 1=on: fail-closed live precheck, H2D key 0x07E7 ARM/CLEAR, CAC 60000 ms / 600000 ms in the 5600-5650 MHz TDWR window, NOL 1800000 ms, no DFS AP start without a finished CAC; >1 refused; mutually exclusive with dfs_set)");
+
+#define HI5622_DFSB_WIRE_MAX	64u
+
+static void hi5622_dfsb_k_work(struct work_struct *work);
+
+struct hi5622_dfsb_k_rt {
+	struct mutex		lock;
+	struct hi5622_pci	*ctx;
+	struct hi5622_dfsb_cac	model;
+	struct delayed_work	work;
+	struct device		*pdev;		/* logging only */
+	struct net_device	*dev;		/* the CAC wdev's netdev */
+	struct cfg80211_chan_def chandef;
+	unsigned int		link_id;
+	bool			requested;
+	bool			initialized;
+	int			last_rc;
+	unsigned int		arms;
+	unsigned int		finishes;
+	unsigned int		aborts;
+	unsigned int		refusals;
+};
+
+static struct hi5622_dfsb_k_rt dfsb_k;
+
+static u32 hi5622_dfsb_k_now_ms(void)
+{
+	return (u32)jiffies_to_msecs(jiffies);
+}
+
+static int hi5622_dfsb_k_post(struct hi5622_pci *ctx, u8 body,
+			      const char *name)
+{
+	u8 wire[HI5622_DFSB_WIRE_MAX];
+	size_t len = 0;
+	int rc;
+
+	rc = hi5622_dfsb_set_build(wire, sizeof(wire), &len, body);
+	if (rc)
+		return rc;
+	return hi5622_frame_post(ctx, wire, len, name, NULL);
+}
+
+void hi5622_dfsb_k_init(void)
+{
+	if (dfsb_k.initialized)
+		return;
+	memset(&dfsb_k, 0, sizeof(dfsb_k));
+	mutex_init(&dfsb_k.lock);
+	hi5622_dfsb_cac_abort(&dfsb_k.model);
+	INIT_DELAYED_WORK(&dfsb_k.work, hi5622_dfsb_k_work);
+	dfsb_k.last_rc = -ENODATA;
+	dfsb_k.initialized = true;
+}
+
+void hi5622_dfsb_k_exit(void)
+{
+	if (!dfsb_k.initialized)
+		return;
+	cancel_delayed_work_sync(&dfsb_k.work);
+	mutex_lock(&dfsb_k.lock);
+	hi5622_dfsb_cac_abort(&dfsb_k.model);
+	dfsb_k.requested = false;
+	dfsb_k.dev = NULL;
+	dfsb_k.ctx = NULL;
+	mutex_unlock(&dfsb_k.lock);
+	dfsb_k.initialized = false;
+}
+
+/* The vendor CAC tick work: REARM keeps the 0x07E7 ARM state and schedules
+ * the next 60000 ms tick; FINISH posts the 0x07E7 CLEAR and reports
+ * NL80211_RADAR_CAC_FINISHED to cfg80211.  A failed CLEAR aborts and reports
+ * ABORTED instead - a CAC that cannot be disarmed is not a passed CAC. */
+static void hi5622_dfsb_k_work(struct work_struct *work)
+{
+	struct hi5622_dfsb_k_rt *r = container_of(to_delayed_work(work),
+						  struct hi5622_dfsb_k_rt,
+						  work);
+	enum hi5622_dfsb_cac_step step = HI5622_DFSB_STEP_REARM;
+	struct net_device *dev = NULL;
+	struct cfg80211_chan_def chandef;
+	unsigned int link_id = 0;
+	u32 delay;
+	int rc;
+
+	mutex_lock(&r->lock);
+	if (r->model.state != HI5622_DFSB_CAC_ARMED) {
+		mutex_unlock(&r->lock);
+		return;
+	}
+	rc = hi5622_dfsb_cac_tick(&r->model, hi5622_dfsb_k_now_ms(), &step);
+	if (rc) {
+		r->last_rc = rc;
+		hi5622_dfsb_cac_abort(&r->model);
+		r->requested = false;
+		mutex_unlock(&r->lock);
+		return;
+	}
+	if (step == HI5622_DFSB_STEP_REARM) {
+		delay = hi5622_dfsb_cac_delay_ms(&r->model);
+		dev_info(r->pdev,
+			 "cfg80211: dfs_cac tick %u/%u on ch%u (next in %u ms)\n",
+			 r->model.ticks_done, r->model.ticks,
+			 r->model.channel, delay);
+		if (delay)
+			schedule_delayed_work(&r->work,
+					      msecs_to_jiffies(delay));
+		mutex_unlock(&r->lock);
+		return;
+	}
+	dev = r->dev;
+	chandef = r->chandef;
+	link_id = r->link_id;
+	rc = hi5622_dfsb_k_post(r->ctx, HI5622_DFSB_SET_BODY_CLEAR,
+				"dfs_cac_clear");
+	r->last_rc = rc;
+	if (rc) {
+		r->aborts++;
+		hi5622_dfsb_cac_abort(&r->model);
+		dev_warn(r->pdev,
+			 "cfg80211: dfs_cac CLEAR not posted (%d) on ch%u - reporting ABORTED\n",
+			 rc, chandef.chan ? chandef.chan->hw_value : 0u);
+	} else {
+		r->finishes++;
+		dev_info(r->pdev,
+			 "cfg80211: dfs_cac CAC FINISHED on ch%u (cac_ms=%u, %u tick(s)) - 0x07E7{00} CLEAR posted; reporting NL80211_RADAR_CAC_FINISHED\n",
+			 chandef.chan ? chandef.chan->hw_value : 0u,
+			 r->model.cac_ms, r->model.ticks_done);
+	}
+	r->requested = false;
+	r->dev = NULL;
+	mutex_unlock(&r->lock);
+	if (dev)
+		cfg80211_cac_event(dev, &chandef,
+				   rc ? NL80211_RADAR_CAC_ABORTED :
+					NL80211_RADAR_CAC_FINISHED,
+				   GFP_KERNEL, link_id);
+}
+
+int hi5622_dfsb_k_op_start_radar_detection(struct wiphy *wiphy,
+					   struct net_device *dev,
+					   struct cfg80211_chan_def *chandef,
+					   u32 cac_time_ms, int link_id)
+{
+	struct hi5622_cfg80211 *c;
+	struct hi5622_dfs_set_probe probe;
+	struct device *pdev;
+	u8 channel;
+	int rc;
+
+	if (!wiphy || !dev || !chandef || !chandef->chan)
+		return -EINVAL;
+	if (hi5622_dfs_cac != HI5622_DFSB_PARM_ON)
+		return -EOPNOTSUPP;
+	c = wiphy_priv(wiphy);
+	if (!c || !c->ctx)
+		return -ENODEV;
+	if (!dfsb_k.initialized)
+		return -ENODEV;
+	pdev = &c->ctx->pdev->dev;
+	if (!dev->ieee80211_ptr ||
+	    dev->ieee80211_ptr->iftype != NL80211_IFTYPE_AP) {
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - start_radar_detection is only supported on an AP interface\n");
+		dfsb_k.refusals++;
+		return -EINVAL;
+	}
+	if (chandef->chan->band != NL80211_BAND_5GHZ) {
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - channel %u is not a 5 GHz channel\n",
+			 chandef->chan->hw_value);
+		dfsb_k.refusals++;
+		return -EINVAL;
+	}
+	channel = (u8)chandef->chan->hw_value;
+	mutex_lock(&dfsb_k.lock);
+	if (dfsb_k.requested ||
+	    dfsb_k.model.state == HI5622_DFSB_CAC_ARMED) {
+		dfsb_k.refusals++;
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - a CAC is already running on ch%u\n",
+			 dfsb_k.model.channel);
+		mutex_unlock(&dfsb_k.lock);
+		return -EBUSY;
+	}
+	dfsb_k.ctx = c->ctx;
+	dfsb_k.pdev = pdev;
+	rc = hi5622_dfsb_cac_begin(&dfsb_k.model, channel,
+				   chandef->chan->center_freq, cac_time_ms);
+	if (rc) {
+		dfsb_k.refusals++;
+		dfsb_k.last_rc = rc;
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac REFUSED - CAC on ch%u cannot start (%d): DFS channel=%d\n",
+			 channel, rc, hi5622_dfsb_is_dfs_chan(channel));
+		mutex_unlock(&dfsb_k.lock);
+		return rc == -EALREADY ? -EBUSY :
+		       rc == -EOPNOTSUPP ? -EINVAL : rc;
+	}
+	/* The live firmware precondition: the SAME fail-closed pack the ladder
+	 * dfs_set step uses.  The 0x07E7 worker needs a started module context
+	 * (the 0x0065 VAP start writes mctx[0x0E]) and the band-1 helper; if
+	 * they are absent the frame would be silently dropped, so refuse with
+	 * the pack in dmesg instead. */
+	hi5622_scan_dfs_set_probe(c->ctx, &probe);
+	rc = hi5622_dfs_set_precheck(&probe, HI5622_DFS_SET_MODE_ARM);
+	if (rc) {
+		dfsb_k.refusals++;
+		dfsb_k.last_rc = rc;
+		hi5622_dfsb_cac_abort(&dfsb_k.model);
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac ARM REFUSED (%d): %s - live pack mctx=0x%08x band=%u state=%u ec8=%u cac=%u ctx_present=%u b4a0=0x%08x regs=0x%02x (the firmware ARM worker needs the 0x0065 VAP start's started module context; no frame posted)\n",
+			 rc,
+			 hi5622_dfs_set_verdict(&probe, HI5622_DFS_SET_MODE_ARM),
+			 probe.mctx, probe.band, probe.state, probe.ec8,
+			 probe.cac, probe.ctx_present, probe.b4a0,
+			 probe.regs_pattern);
+		mutex_unlock(&dfsb_k.lock);
+		return -EAGAIN;
+	}
+	rc = hi5622_dfsb_k_post(c->ctx, HI5622_DFSB_SET_BODY_ARM,
+				"dfs_cac_arm");
+	dfsb_k.last_rc = rc;
+	if (rc) {
+		dfsb_k.refusals++;
+		hi5622_dfsb_cac_abort(&dfsb_k.model);
+		dev_warn(pdev,
+			 "cfg80211: dfs_cac ARM frame not posted (%d) - no CAC started\n",
+			 rc);
+		mutex_unlock(&dfsb_k.lock);
+		return rc;
+	}
+	dfsb_k.requested = true;
+	dfsb_k.dev = dev;
+	dfsb_k.chandef = *chandef;
+	dfsb_k.link_id = (unsigned int)link_id;
+	dfsb_k.arms++;
+	schedule_delayed_work(&dfsb_k.work,
+			      msecs_to_jiffies(
+				      hi5622_dfsb_cac_delay_ms(&dfsb_k.model)));
+	dev_info(pdev,
+		 "cfg80211: dfs_cac CAC STARTED on ch%u (%u MHz): 0x07E7{01} ARM posted, cac_ms=%u (tdwr=%u), ticks=%u x %u ms after the %u ms first timer, NOL %u ms - CAC_FINISHED follows when the host timer completes (cfg80211 core emits CAC_STARTED itself)\n",
+		 dfsb_k.model.channel, dfsb_k.model.center_freq,
+		 dfsb_k.model.cac_ms, dfsb_k.model.tdwr,
+		 dfsb_k.model.ticks, dfsb_k.model.tick_ms,
+		 dfsb_k.model.first_ms, dfsb_k.model.nol_ms);
+	mutex_unlock(&dfsb_k.lock);
+	return 0;
+}
+
+void hi5622_dfsb_k_op_end_cac(struct wiphy *wiphy, struct net_device *dev,
+			      unsigned int link_id)
+{
+	struct hi5622_cfg80211 *c;
+	struct device *pdev;
+	int rc;
+
+	(void)dev;
+	(void)link_id;
+	if (!wiphy || !dfsb_k.initialized)
+		return;
+	c = wiphy_priv(wiphy);
+	if (!c || !c->ctx)
+		return;
+	pdev = &c->ctx->pdev->dev;
+	/* Cancel OUTSIDE the lock: the work item takes the same lock. */
+	cancel_delayed_work_sync(&dfsb_k.work);
+	mutex_lock(&dfsb_k.lock);
+	if (dfsb_k.model.state == HI5622_DFSB_CAC_ARMED) {
+		rc = hi5622_dfsb_k_post(c->ctx, HI5622_DFSB_SET_BODY_CLEAR,
+					"dfs_cac_clear");
+		dfsb_k.last_rc = rc;
+		hi5622_dfsb_cac_abort(&dfsb_k.model);
+		dfsb_k.aborts++;
+		dev_info(pdev,
+			 "cfg80211: dfs_cac CAC ABORTED on end_cac: 0x07E7{00} CLEAR %s (%d); cfg80211 emits NL80211_RADAR_CAC_ABORTED\n",
+			 rc ? "post failed" : "posted", rc);
+	}
+	dfsb_k.requested = false;
+	dfsb_k.dev = NULL;
+	mutex_unlock(&dfsb_k.lock);
+}
+
+int hi5622_dfsb_k_ap_plan(u8 band, u8 channel, u32 width, u32 ccfs1,
+			  u32 ccfs2, unsigned int dfs_set_on,
+			  struct hi5622_dfsb_ap_plan *out)
+{
+	int rc;
+
+	if (!out || !dfsb_k.initialized)
+		return -EINVAL;
+	if (hi5622_ht_bw > HI5622_DFSB_PARM_MAX ||
+	    hi5622_dfs_cac > HI5622_DFSB_PARM_MAX)
+		return -EINVAL;
+	mutex_lock(&dfsb_k.lock);
+	rc = hi5622_dfsb_ap_plan(hi5622_ht_bw, hi5622_dfs_cac, dfs_set_on,
+				 band, channel, width, ccfs1, ccfs2,
+				 &dfsb_k.model, hi5622_dfsb_k_now_ms(), out);
+	if (rc)
+		dfsb_k.refusals++;
+	mutex_unlock(&dfsb_k.lock);
+	return rc;
+}
