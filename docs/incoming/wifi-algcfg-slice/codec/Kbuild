# hi5622 alg_cfg command codec - 6.18 out-of-tree build
# Lane: wifi-algcfg-slice (host-only research). Original GPL-2.0 text.
# Usage:
#   export KDIR=/home/shibbityshwab/openwrt-lab-selectorfix-img/build_dir/target-arm_cortex-a9_musl_eabi/linux-hisilicon_luofu/linux-6.18.60
#   export TC=/home/shibbityshwab/openwrt-lab-selectorfix-img/staging_dir/toolchain-arm_cortex-a9_gcc-14.4.0_musl_eabi/bin
#   make ARCH=arm CROSS_COMPILE=$(TC)/arm-openwrt-linux-muslgnueabi- -C $(KDIR) M=$(pwd) modules

MODULE_NAME := hi5622_alg_cfg_codec

ccflags-y += -std=gnu99 -fno-strict-aliasing -Wno-unused-variable -Wno-unused-function
# OpenWrt-patched kernel Makefile drops the stock '-isystem $(CC -print-file-name=include)';
# the harness-style headers need bare <stddef.h> from the toolchain.
ccflags-y += -isystem $(shell $(CC) -print-file-name=include)
ccflags-y += -Wno-sign-compare -Wno-pointer-sign -Wno-format -Wno-declaration-after-statement
ccflags-y += -D_FORTIFY_SOURCE=0
# kernel build takes the shim branch (pr_* logs, local securec impls)
ccflags-y += -DOAL_COMPAT_KERNEL

$(MODULE_NAME)-y := wal_config_alg_cfg.o kernel_util.o skel_mod.o
obj-m := $(MODULE_NAME).o
