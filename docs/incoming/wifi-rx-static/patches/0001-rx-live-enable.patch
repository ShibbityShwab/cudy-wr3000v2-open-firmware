+/* Publish a packed 16-bit ring index to a config-block word, preserving the
+ * upper half (the vendor hal_set_* accessors do a 32-bit RMW while the
+ * hal_ring_set_sw2hw paths store a zero-extended u16).  Read-back checked. */
+static int dptx_publish16(struct hi5622_pci *ctx, u32 off, u32 packed,
+			  u32 *readback)
+{
+	u32 old, val, rb;
+
+	if (packed > 0xffffu)
+		return -ERANGE;
+	old = dptx_mac_read(ctx, off);
+	if (old == 0xffffffffu)
+		return -EFAULT;
+	val = (old & 0xffff0000u) | packed;
+	if (dptx_mac_write_checked(ctx, off, val) != 0)
+		return -EFAULT;
+	rb = dptx_mac_read(ctx, off);
+	if (readback)
+		*readback = rb;
+	if ((rb & 0xffffu) != packed)
+		return -EIO;
+	return 0;
+}
