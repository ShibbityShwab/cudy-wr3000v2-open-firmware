diff -ruN a/hi5622_bss_color.c b/hi5622_bss_color.c
--- a/hi5622_bss_color.c	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_bss_color.c	2026-11-26 14:26:59.582937937 +0700
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_bss_color.c - portable builder/policy for the vendor g0 id36
+ * hmac_scan_config_bss_color frame + the fail-closed AP-colour posting path.
+ *
+ * ORIGINAL clean-room code (lane wifi-bss-color, shared task-233). Evidence:
+ * ../REPORT.md (decode), ../TABLES.md (T1 layout, T3 KAT). No vendor byte is
+ * reproduced; the wire constants are derived values with evidence markers.
+ */
+#include "hi5622_bss_color.h"
+
+#ifdef __KERNEL__
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <net/cfg80211.h>
+#include "hi5622_driver.h"
+#include "hi5622_frame_post.h"
+#else
+#include <string.h>
+#endif
+
+static void hbc_put_le16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+static void hbc_put_le64(u8 *p, u64 v)
+{
+	unsigned int i;
+
+	for (i = 0; i < 8u; i++)
+		p[i] = (u8)((v >> (8u * i)) & 0xffu);
+}
+
+static u16 hbc_get_le16(const u8 *p)
+{
+	return (u16)((u16)p[0] | ((u16)p[1] << 8));
+}
+
+static u64 hbc_get_le64(const u8 *p)
+{
+	u64 v = 0;
+	unsigned int i;
+
+	for (i = 0; i < 8u; i++)
+		v |= (u64)p[i] << (8u * i);
+	return v;
+}
+
+int hi5622_bss_color_policy(unsigned int value)
+{
+	if (value == HI5622_BSS_COLOR_PARAM_OFF)
+		return (int)HI5622_BSS_COLOR_PARAM_OFF;
+	if (value == HI5622_BSS_COLOR_PARAM_ON)
+		return (int)HI5622_BSS_COLOR_PARAM_ON;
+	/* Never guess: an out-of-contract value is refused (no frame). */
+	return -EINVAL;
+}
+
+int hi5622_bss_color_mask_from_color(u8 color, u64 *mask_out)
+{
+	if (!mask_out)
+		return -EINVAL;
+	if (color == 0u || color > HI5622_BSS_COLOR_MAX)
+		return -EINVAL;
+	*mask_out = (u64)1u << color;
+	return 0;
+}
+
+int hi5622_bss_color_build(u8 *wire, size_t cap, u8 fa, u8 fb, u8 bid_hi,
+			   u64 mask, size_t *len_out)
+{
+	if (!wire || !len_out || cap < HI5622_BSS_COLOR_TOTAL_LEN)
+		return -EINVAL;
+	if (bid_hi > 0x0fu)
+		return -EINVAL;
+	memset(wire, 0, HI5622_BSS_COLOR_TOTAL_LEN);
+	/* header: group-nibble 0 (low), direct id 0x24, transport tag. */
+	wire[HI5622_BSS_COLOR_OFF_GROUP] = (u8)HI5622_BSS_COLOR_GROUP;
+	wire[HI5622_BSS_COLOR_OFF_BID] =
+		(u8)(HI5622_BSS_COLOR_ALLOC_NIBBLE | (bid_hi << 4));
+	wire[HI5622_BSS_COLOR_OFF_FA] = fa;
+	wire[HI5622_BSS_COLOR_OFF_FB] = fb;
+	hbc_put_le16(&wire[HI5622_BSS_COLOR_OFF_LEN],
+		     (u16)HI5622_BSS_COLOR_TOTAL_LEN);
+	hbc_put_le16(&wire[HI5622_BSS_COLOR_OFF_ID],
+		     (u16)HI5622_BSS_COLOR_ID);
+	wire[HI5622_BSS_COLOR_OFF_FC] = 0u;
+	wire[HI5622_BSS_COLOR_OFF_DST] = 0u;
+	hbc_put_le16(&wire[HI5622_BSS_COLOR_OFF_TAG],
+		     (u16)HI5622_BSS_COLOR_TAG);
+	hbc_put_le64(&wire[HI5622_BSS_COLOR_OFF_MASK], mask);
+	*len_out = HI5622_BSS_COLOR_TOTAL_LEN;
+	return 0;
+}
+
+int hi5622_bss_color_validate(const u8 *wire, size_t len, u64 *mask_out)
+{
+	if (!wire || len != HI5622_BSS_COLOR_TOTAL_LEN)
+		return -EINVAL;
+	if ((wire[HI5622_BSS_COLOR_OFF_GROUP] & 0x0fu) !=
+	    HI5622_BSS_COLOR_GROUP)
+		return -EINVAL;
+	if ((wire[HI5622_BSS_COLOR_OFF_BID] & 0x0fu) !=
+	    HI5622_BSS_COLOR_ALLOC_NIBBLE)
+		return -EINVAL;
+	if (hbc_get_le16(&wire[HI5622_BSS_COLOR_OFF_LEN]) !=
+	    HI5622_BSS_COLOR_TOTAL_LEN)
+		return -EINVAL;
+	if (hbc_get_le16(&wire[HI5622_BSS_COLOR_OFF_ID]) !=
+	    HI5622_BSS_COLOR_ID)
+		return -EINVAL;
+	if (wire[HI5622_BSS_COLOR_OFF_FC] != 0u ||
+	    wire[HI5622_BSS_COLOR_OFF_DST] != 0u)
+		return -EINVAL;
+	if (hbc_get_le16(&wire[HI5622_BSS_COLOR_OFF_TAG]) !=
+	    HI5622_BSS_COLOR_TAG)
+		return -EINVAL;
+	if (mask_out)
+		*mask_out = hbc_get_le64(&wire[HI5622_BSS_COLOR_OFF_MASK]);
+	return 0;
+}
+
+#ifdef __KERNEL__
+/* Fail-closed module knob: 0 = off (default, no device write at all),
+ * 1 = post the start_ap HE BSS colour as one g0 id36 frame. */
+unsigned int hi5622_bss_color;
+module_param_named(bss_color, hi5622_bss_color, uint, 0644);
+MODULE_PARM_DESC(bss_color,
+		 "AP BSS-color posting: 0=off (default, fail closed, no g0 id36 frame), 1=post the start_ap cfg80211 HE BSS colour (NL80211_ATTR_HE_BSS_COLOR, hostapd he_bss_color=N) as one g0 id36 hmac_scan_config_bss_color bitmap after the AP config; >1 refused (no frame)");
+
+int hi5622_bss_color_post_ap(struct hi5622_pci *ctx, struct device *dev,
+			     const struct cfg80211_ap_settings *settings,
+			     u8 band)
+{
+	u8 wire[HI5622_BSS_COLOR_TOTAL_LEN];
+	const struct cfg80211_he_bss_color *hc;
+	u64 mask = 0;
+	size_t len = 0;
+	int rc;
+
+	if (!ctx || !dev || !settings)
+		return -EINVAL;
+	rc = hi5622_bss_color_policy(hi5622_bss_color);
+	if (rc < 0) {
+		dev_warn_ratelimited(dev,
+				     "cfg80211: bss_color=%u refused (0=off, 1=post AP BSS colour); no g0 id36 frame\n",
+				     hi5622_bss_color);
+		return rc;
+	}
+	if (rc == (int)HI5622_BSS_COLOR_PARAM_OFF)
+		return 0;
+	hc = &settings->beacon.he_bss_color;
+	if (!settings->beacon.he_bss_color_valid || !hc->enabled) {
+		dev_warn_ratelimited(dev,
+				     "cfg80211: bss_color=1 but start_ap carried no enabled HE BSS colour (hostapd he_bss_color unset?); no g0 id36 frame\n");
+		return -EOPNOTSUPP;
+	}
+	rc = hi5622_bss_color_mask_from_color(hc->color, &mask);
+	if (rc) {
+		dev_warn_ratelimited(dev,
+				     "cfg80211: bss_color=1 but start_ap HE BSS colour %u is outside the 1..63 contract; no g0 id36 frame\n",
+				     hc->color);
+		return rc;
+	}
+	rc = hi5622_bss_color_build(wire, sizeof(wire), 0u, band, 0u, mask, &len);
+	if (rc)
+		return rc;
+	rc = hi5622_frame_post(ctx, wire, len, "bss_color", NULL);
+	if (rc) {
+		dev_warn(dev,
+			 "cfg80211: BSS Color %u frame (g0 id36, mask 0x%016llx, chip=%u) NOT posted (%d) - AP start continues\n",
+			 hc->color, (unsigned long long)mask, (unsigned)band, rc);
+		return rc;
+	}
+	dev_info(dev,
+		 "cfg80211: BSS Color %u posted to firmware (g0 id36 hmac_scan_config_bss_color, bitmap 0x%016llx, chip=%u, %zu B)%s\n",
+		 hc->color, (unsigned long long)mask, (unsigned)band, len,
+		 hc->partial ? " [partial flag ignored: not in the wire bitmap]" : "");
+	return 0;
+}
+#endif /* __KERNEL__ */
diff -ruN a/hi5622_bss_color.h b/hi5622_bss_color.h
--- a/hi5622_bss_color.h	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_bss_color.h	2026-11-26 14:26:59.580937935 +0700
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_bss_color.h - the vendor g0 id36 "scan-config BSS color" frame
+ * (hmac_scan_config_bss_color) and the fail-closed AP-colour posting policy.
+ *
+ * ORIGINAL clean-room code (lane wifi-bss-color, shared task-233, 2026-11-26).
+ * No vendor source, object byte, firmware byte, calibration value or secret is
+ * reproduced here; the derivation (vendor host .text 0x99C10, scan-result
+ * producer 0x9D870, firmware g0 table handler file 0x755E1) is in
+ * ../REPORT.md, the frame tables/KAT in ../TABLES.md.
+ *
+ * WHAT THE MESSAGE IS
+ * -------------------
+ * A DIRECT group-0 id-0x24 H2D message (12-byte HCC header + 8-byte payload,
+ * total 20 B; hcc_msg_alloc(8)). The payload is a little-endian u64 bitmap:
+ * bit i set = BSS color i (0..63). The vendor builder ORs 1 << entry[+0x85]
+ * over the scan result list at scan completion; entry[+0x85] is the 6-bit BSS
+ * color parsed from that BSS's HE Operation element (proven in REPORT sec. 1).
+ *
+ * OUR POLICY (fail closed)
+ * ------------------------
+ * Module parameter bss_color: 0 = off (default: no frame, no device write),
+ * 1 = post the start_ap AP's cfg80211 HE BSS colour as a singleton bitmap
+ * (NL80211_ATTR_HE_BSS_COLOR -> settings->beacon.he_bss_color), once per
+ * start_ap, after the AP config. The on-air HE Operation IE is firmware-built,
+ * so this posting is a differential probe, not an assumed colour setter.
+ *
+ * Pure C99: the same header/source compile in the 6.18 kernel module and in
+ * the host selftest.
+ */
+#ifndef HI5622_BSS_COLOR_H
+#define HI5622_BSS_COLOR_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#endif
+#endif
+
+/* ---- wire contract (TABLES.md T1/T2) ---------------------------------- */
+#define HI5622_BSS_COLOR_GROUP		0u	/* group 0 [V] */
+#define HI5622_BSS_COLOR_ID		0x24u	/* id 36 [V] */
+#define HI5622_BSS_COLOR_HDR_LEN	12u	/* HCC header [V] */
+#define HI5622_BSS_COLOR_PAYLOAD_LEN	8u	/* hcc_msg_alloc(8) [V] */
+#define HI5622_BSS_COLOR_TOTAL_LEN 	(HI5622_BSS_COLOR_HDR_LEN + HI5622_BSS_COLOR_PAYLOAD_LEN)
+#define HI5622_BSS_COLOR_TAG		0x5a5au	/* wire bytes 5a 5a at +0x0A [V] */
+#define HI5622_BSS_COLOR_ALLOC_NIBBLE	0x01u	/* hcc_msg_alloc [V] */
+#define HI5622_BSS_COLOR_MAX		63u	/* 6-bit colour domain [V] */
+
+/* header byte offsets (same HCC layout as h2d_frames.h) */
+#define HI5622_BSS_COLOR_OFF_GROUP	0u
+#define HI5622_BSS_COLOR_OFF_BID	1u	/* alloc nibble + dst/band hi nibble */
+#define HI5622_BSS_COLOR_OFF_FA		2u
+#define HI5622_BSS_COLOR_OFF_FB		3u	/* destination chip id [V] */
+#define HI5622_BSS_COLOR_OFF_LEN	4u	/* u16 LE total */
+#define HI5622_BSS_COLOR_OFF_ID		6u	/* u16 LE = 0x0024 */
+#define HI5622_BSS_COLOR_OFF_FC		8u
+#define HI5622_BSS_COLOR_OFF_DST	9u
+#define HI5622_BSS_COLOR_OFF_TAG	10u	/* u16 LE = 0x5A5A */
+#define HI5622_BSS_COLOR_OFF_MASK	12u	/* u64 LE bitmap */
+
+/* ---- module parameter policy (our design) ----------------------------- */
+#define HI5622_BSS_COLOR_PARAM_OFF	0u
+#define HI5622_BSS_COLOR_PARAM_ON	1u
+#define HI5622_BSS_COLOR_PARAM_MAX	HI5622_BSS_COLOR_PARAM_ON
+
+/* Build one complete 20-byte wire frame. fa/fb are the two sequence/address
+ * bytes the vendor copies from its scan object (+0xFA9/+0xFA8); bid_hi is the
+ * high nibble of header byte 1 (vendor scan object +0xFAA, 0 in the capture).
+ * Return 0 and set *len_out = 20, or -EINVAL. */
+int hi5622_bss_color_build(u8 *wire, size_t cap, u8 fa, u8 fb, u8 bid_hi,
+			   u64 mask, size_t *len_out);
+
+/* Structural validation of one complete wire frame; *mask_out (may be NULL)
+ * receives the LE bitmap. Returns 0 or -EINVAL. */
+int hi5622_bss_color_validate(const u8 *wire, size_t len, u64 *mask_out);
+
+/* AP-colour -> singleton bitmap. cfg80211 policy is colour 1..63 (0 is
+ * "disabled" and cannot be expressed); partial colouring is not part of the
+ * 64-bit bitmap and is ignored (documented in REPORT sec. 4). */
+int hi5622_bss_color_mask_from_color(u8 color, u64 *mask_out);
+
+/* Module-parameter policy: OFF/ON pass through; anything else -EINVAL. */
+int hi5622_bss_color_policy(unsigned int value);
+
+#ifdef __KERNEL__
+struct cfg80211_ap_settings;
+struct device;
+struct hi5622_pci;
+
+/* Post the start_ap AP's cfg80211 HE BSS colour as one g0 id36 frame when
+ * bss_color=1. Called from hi5622_scan_op_start_ap after the AP config; a
+ * failure is logged and never aborts/rolls back a started AP. */
+int hi5622_bss_color_post_ap(struct hi5622_pci *ctx, struct device *dev,
+			     const struct cfg80211_ap_settings *settings,
+			     u8 band);
+#endif
+
+#endif /* HI5622_BSS_COLOR_H */
