 /* =====================================================================
  * helpers
@@ -1628,6 +1629,7 @@
 	bool base_was_posted;
 	bool restart_plain = false;
 	int rc;
+	int brc;
 
 	if (!s || !s->initialized || !settings || !dev)
 		return -ENODEV;
@@ -2270,6 +2272,16 @@
 				 "cfg80211: start_ap beacon_static: VAP start owned by the WAL carrier sequence (already posted after ap_cfg)\n");
 		}
 	}
+	/* wifi-bss-color lane (task-233): optional, fail-closed BSS-colour bitmap
+	 * post (g0 id36 hmac_scan_config_bss_color) from the cfg80211 HE BSS colour
+	 * hostapd passed as NL80211_ATTR_HE_BSS_COLOR.  bss_color=0 (default) posts
+	 * nothing; a failure here is logged and never aborts an AP that is already
+	 * configured. */
+	brc = hi5622_bss_color_post_ap(c->ctx, wdev_dev, settings, (u8)p->band);
+	if (brc)
+		dev_warn(wdev_dev,
+			 "cfg80211: BSS Color posting skipped/failed (%d) - AP start continues (optional probe)\n",
+			 brc);
 	dev_info(wdev_dev,
 		 "cfg80211: start_ap sequence posted to provider '%s' - EXPERIMENTAL: beaconing is a firmware effect; verify the VAP context readback\n",
 		 ops->name);
