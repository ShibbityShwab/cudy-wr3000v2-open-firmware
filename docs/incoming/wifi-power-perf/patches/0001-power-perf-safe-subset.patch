 }
 static DEVICE_ATTR_WO(hcc_dr_republish);
 
+/* ---------------------------------------------------------------------
+ * wifi-power-perf lane (task-160): PM safe-subset + PCIe ASPM assertion
+ * -------------------------------------------------------------------*/
+static const char *hcc_pm_gate_reason(hspp_u32 gate)
+{
+	switch (gate) {
+	case HSPP_PM_OK:
+		return "ok";
+	case HSPP_PM_REFUSE_DISABLED:
+		return "pm_enable=0 (default)";
+	case HSPP_PM_REFUSE_NOT_READY:
+		return "boot not latched or phase != ACTIVE";
+	case HSPP_PM_REFUSE_PENDING:
+		return "a previous sleep ack is still pending";
+	default:
+		return "unknown";
+	}
+}
+
+/* One-shot, default-off PM-sleep request (vendor H2D group-0 id1).  This is
+ * NOT a normal operation: our transport has no BAL close and no GPIO wake
+ * handshake, so a device that accepts the request may stop servicing the
+ * host until a physical power-cycle.  The gate mirrors the core's own
+ * preconditions, and pm_enable must be set at load time. */
+static ssize_t hcc_pm_sleep_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct hi5622_pci *ctx = pci_get_drvdata(to_pci_dev(dev));
+	struct hcc_core *core;
+	struct hspp_pm_input in;
+	hspp_u32 gate;
+	int ret;
+
+	if (!ctx || !ctx->hcc)
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	core = &ctx->hcc->hcc.core;
+	memset(&in, 0, sizeof(in));
+	in.enabled = core->cfg.pm_enabled ? 1u : 0u;
+	in.boot_latched = core->boot_latched ? 1u : 0u;
+	in.active_phase = (core->phase == HCC_PHASE_ACTIVE) ? 1u : 0u;
+	in.pending = core->pm_sleep_pending ? 1u : 0u;
+	gate = hspp_pm_gate(&in);
+	if (gate != HSPP_PM_OK) {
+		dev_warn(dev,
+			 "PM: sleep request refused (%s); no device write\n",
+			 hcc_pm_gate_reason(gate));
+		return gate == HSPP_PM_REFUSE_DISABLED ? -EOPNOTSUPP : -EBUSY;
+	}
+	ret = hcc_core_pm_request_sleep(core, hcc_kernel_now_ms());
+	if (ret) {
+		dev_warn(dev, "PM: core refused the sleep request (%d); no retry\n",
+			 ret);
+		return ret;
+	}
+	dev_warn(dev,
+		 "PM: H2D group-0 id1 sleep request posted ONCE (ack window %u ms) - D2H id4 disallow / id5 wake-ok counters are in hcc_pm_status.  This stack has NO BAL close and NO GPIO wake: attended-only evidence, physical power-cycle is the recovery\n",
+		 core->cfg.pm_sleep_ack_ms);
+	return count;
+}
+static DEVICE_ATTR_WO(hcc_pm_sleep);
+
+static ssize_t hcc_pm_status_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct hi5622_pci *ctx = pci_get_drvdata(to_pci_dev(dev));
+	struct hcc_core *core;
+	int pos = 0;
+
+	if (!ctx || !ctx->hcc)
+		return -ENODEV;
+	core = &ctx->hcc->hcc.core;
+	pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+			 "pm: enabled=%u pm_enable_param=%u ack_ms=%u boot_latched=%u phase=%s pending=%u deadline_ms=%llu\n",
+			 core->cfg.pm_enabled ? 1u : 0u, hi5622_pm_enable,
+			 core->cfg.pm_sleep_ack_ms,
+			 core->boot_latched ? 1u : 0u,
+			 hcc_phase_name(core->phase),
+			 core->pm_sleep_pending ? 1u : 0u,
+			 (unsigned long long)core->pm_sleep_deadline_ms);
+	pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+			 "pm counters: requests=%u state_changes=%u disallow=%u wake_ok=%u aborts=%u timeouts=%u (D2H group-0 ids 4/5 are decoded by the core; the vendor's platform BAL/GPIO handshake is not implemented)\n",
+			 core->h2d_pm_requests, core->pm_state_changes,
+			 core->pm_sleep_disallow ? 1u : 0u,
+			 core->pm_wake_ok ? 1u : 0u,
+			 core->pm_sleep_aborts, core->pm_sleep_timeouts);
+	if (ctx->aspm_read) {
+		struct hspp_aspm_state aspm = hspp_aspm_decode(ctx->aspm_lnkctl);
+
+		pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+				 "aspm: lnkctl=0x%04x l0s=%u l1=%u enabled=%u vendor_parity=%s cleared_by_attr=%u (vendor board: stock DTS has no aspm-enable -> ASPM off; enabling it is a link experiment, not the safe subset)\n",
+				 aspm.raw, aspm.l0s, aspm.l1, aspm.enabled,
+				 aspm.enabled ? "VIOLATED" : "ok",
+				 ctx->aspm_cleared ? 1u : 0u);
+	} else {
+		pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+				 "aspm: unreadable at probe (no PCIe capability?)\n");
+	}
+	return pos;
+}
+static DEVICE_ATTR_RO(hcc_pm_status);
+
+/* Disable ASPM if (and only if) a nonzero value is found.  Disabling cannot
+ * break a trained link; enabling it is deliberately not offered. */
+static ssize_t aspm_disable_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct hi5622_pci *ctx = pci_get_drvdata(to_pci_dev(dev));
+	struct hspp_aspm_state aspm;
+	u16 lnkctl = 0, cleared;
+	int cap, ret;
+
+	if (!ctx)
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!ctx->aspm_read)
+		return -EOPNOTSUPP;
+	cap = pci_pcie_cap(ctx->pdev);
+	ret = pci_read_config_word(ctx->pdev, cap + PCI_EXP_LNKCTL, &lnkctl);
+	if (ret)
+		return ret;
+	aspm = hspp_aspm_decode(lnkctl);
+	if (!aspm.enabled) {
+		ctx->aspm_lnkctl = lnkctl;
+		dev_info(dev,
+			 "ASPM: already disabled (LNKCTL=0x%04x) - vendor parity holds, no write\n",
+			 aspm.raw);
+		return count;
+	}
+	cleared = hspp_aspm_disable_bits(lnkctl);
+	ret = pci_write_config_word(ctx->pdev, cap + PCI_EXP_LNKCTL, cleared);
+	if (ret)
+		return ret;
+	(void)pci_read_config_word(ctx->pdev, cap + PCI_EXP_LNKCTL,
+				   &ctx->aspm_lnkctl);
+	ctx->aspm_cleared = true;
+	dev_warn(dev,
+		 "ASPM: disabled (LNKCTL 0x%04x -> 0x%04x, readback 0x%04x) - vendor parity restored; PM/throughput numbers are comparable to the vendor board\n",
+		 lnkctl, cleared, ctx->aspm_lnkctl);
+	return count;
+}
+static DEVICE_ATTR_WO(aspm_disable);
+
 static struct attribute *hi5622_hcc_attrs[] = {
 	&dev_attr_hcc_sr_announce.attr,
 	&dev_attr_hcc_cece_kick.attr,
 	&dev_attr_hcc_dr_republish.attr,
+	&dev_attr_hcc_pm_sleep.attr,
+	&dev_attr_hcc_pm_status.attr,
+	&dev_attr_aspm_disable.attr,
 	NULL,
 };
 ATTRIBUTE_GROUPS(hi5622_hcc);
