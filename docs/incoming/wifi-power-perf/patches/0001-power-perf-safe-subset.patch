-	cfg.pm_enabled = false;		/* vendor PM layer is not on the boot path */
+	/* The vendor PM layer is not on the boot path (RE in REPORT.md sec 2).
+	 * The safe subset arms it only through the explicit pm_enable parameter,
+	 * and the ack window is clamped so a typo cannot make it unbounded. */
+	cfg.pm_enabled = hi5622_pm_enable != 0;
+	cfg.pm_sleep_ack_ms = hspp_pm_ack_ms_clamp(hi5622_pm_sleep_ack_ms);
 	cfg.heartbeat_armed = false;	/* vendor boot path leaves it off */
