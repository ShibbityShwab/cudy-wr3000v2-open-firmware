+/* wifi-power-perf lane (task-160): the vendor PM sleep path, exposed as a
+ * default-off safe subset.  RE (REPORT.md sec 2): the vendor platform sleep
+ * is H2D group-0 id1 -> <=500 ms ack wait -> BAL close + GPIO handshake, and
+ * its arming gate (g_wlan_pm_info+0x124) is only written by plat_pm_vote(),
+ * which no loaded module imports; the only hipriv pm_switch lives in
+ * wifi_debug.ko, loaded only when /etc/hi_version contains "turbo" (stock
+ * 2.4.15/2.5.24 do not).  So the vendor sleep path is dead on this board and
+ * the safe subset is: keep it disabled by default, expose a one-shot gated
+ * request for an attended rung, and prove the refusals on the host. */
+unsigned int hi5622_pm_enable;
+module_param_named(pm_enable, hi5622_pm_enable, uint, 0644);
+MODULE_PARM_DESC(pm_enable,
+		 "enable the H2D group-0 id1 PM-sleep request path (default 0 = disabled; the full vendor handshake also needs a BAL close + GPIO wake which this transport does not implement - attended only)");
+
+unsigned int hi5622_pm_sleep_ack_ms = HSPP_PM_ACK_MS_DEFAULT;
+module_param_named(pm_sleep_ack_ms, hi5622_pm_sleep_ack_ms, uint, 0644);
+MODULE_PARM_DESC(pm_sleep_ack_ms,
+		 "bounded PM-sleep ack window in ms (50..5000, default 500 = the vendor 50-jiffy window)");
+
 
 int hi5622_hcc_init(struct hi5622_pci *ctx)
