+/* lane wifi-band1-start-send-2 (task-207): READ-ONLY outcome snapshot of the
+ * structural key-0x0064 VAP add.  Worker CA 0x449E4 resolves ctx(0, data[4])
+ * (0x961AE), creates/binds it and appends the index to the band object's VAP
+ * list at bandobj+0x12 (entries at bandobj+0): that list is what the 0x0242
+ * worker's band helper CA 0x4C3FC -> CA 0x4AE7C scans, and it needs EXACTLY
+ * one entry - otherwise the 0x0242 post leaves state[4]=0xFF and CA 0x4AF0C
+ * refuses.  The 0x0124 channel worker gates on ctx+0x4B0 (per-link) and the
+ * 0x0242 worker takes the band object from ctx+0x4B8.  This line is the
+ * decisive next-fire evidence: bandobject=ZERO means the VAP-add frame did
+ * not bind; bandlist_count=1 means the state[4]=0xFF is NOT a VAP-add
+ * failure (look at the 0x4C3FC/0x4AE7C path).  Log-only; never a wire
+ * input. */
+static void hi5622_scan_vap_add_readback(struct hi5622_pci *ctx,
+					 struct device *dev, u8 index, u8 band)
+{
+	u32 slot, base, mctx, perlink, vap, bandobj, count, published;
+	const char *verdict;
+
+	if (!ctx || !dev || !ctx->windows_programmed)
+		return;
+	slot = hi5622_fw_ram_read(ctx,
+			HI5622_STAB_MODULE_TABLE_SLOT0_CPU + (u32)index * 4u);
+	base = hi5622_fw_ram_read(ctx, HI5622_STAB_MODULE_TABLE_BASE_CPU);
+	mctx = hi5622_beacon5g_mctx_ca(slot, base);
+	perlink = mctx ? hi5622_fw_ram_read(ctx,
+			mctx + HI5622_BEACON5G_MCTX_LINK_OFF) : 0u;
+	vap = mctx ? hi5622_fw_ram_read(ctx,
+			mctx + HI5622_BEACON5G_MCTX_VAP_OFF) : 0u;
+	bandobj = mctx ? hi5622_fw_ram_read(ctx,
+			mctx + HI5622_BEACON5G_MCTX_BAND_OBJ_OFF) : 0u;
+	count = bandobj ? (hi5622_fw_ram_read(ctx, bandobj + 0x12u) & 0xffu) : 0u;
+	published = bandobj ? hi5622_fw_ram_read(ctx, bandobj + 0x1a00u) : 0u;
+	if (!mctx)
+		verdict = "module ctx unresolved - the key-0x0064 bind cannot have run";
+	else if (!bandobj)
+		verdict = "ctx+0x4B8 is ZERO - the key-0x0064 bind did NOT run (check data[4]/hdr[3]/band/published)";
+	else if (count == 1u)
+		verdict = "bound, band VAP list count=1 - a later state[4]=0xFF is NOT a VAP-add failure";
+	else if (count == 0u)
+		verdict = "band VAP list EMPTY - the key-0x0064 worker stopped before the list add";
+	else
+		verdict = "band VAP list count>1 - CA 0x4AE7C needs exactly one entry";
+	dev_info(dev,
+		 "cfg80211: vap_add post: index=%u band=%u ctx=0x%08x perlink=0x%08x vap=0x%08x bandobject=0x%08x bandlist_count=%u published=0x%08x (%s)\n",
+		 index, band, mctx, perlink, vap, bandobj, count, published,
+		 verdict);
+}
