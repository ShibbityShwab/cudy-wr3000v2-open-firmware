+/* ---------------------------------------------------------------------
+ * Probe / remove
+ * ------------------------------------------------------------------- */
+static void b3_rings_free(struct hi5622_pci *ctx, struct hi5622_b3 *b3)
+{
+	int i;
+
+	for (i = 0; i < HI5622_B3_DR_COUNT; i++)
+		pciet_ete_ring_free(ctx, &b3->dr[i]);
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++)
+		pciet_ete_ring_free(ctx, &b3->sr[i]);
+}
+
+int pciet_b3_probe(struct hi5622_pci *ctx)
+{
+	struct device *dev = &ctx->pdev->dev;
+	struct hi5622_b3 *b3;
+	int i, ret;
+
+	b3_assert_contract();
+
+	b3 = devm_kzalloc(dev, sizeof(*b3), GFP_KERNEL);
+	if (!b3)
+		return -ENOMEM;
+	mutex_init(&b3->lock);
+	ctx->b3 = b3;
+
+	/* Host-DRAM ring allocations only - no device writes here.  Buffer
+	 * sizes: DR 2048 B covers the maximum HCC frame (0x674 payload + 12 B
+	 * header = 0x680, hcc-re REPORT sec 3.1 [V]); the B3 SR rings are armed
+	 * by P0 but not used for messaging (B3 posts no H2D), so 64 B each. */
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++) {
+		ret = pciet_ete_ring_alloc(ctx, &b3->sr[i], b3_sr_off[i], 64);
+		if (ret)
+			goto err_free;
+	}
+	for (i = 0; i < HI5622_B3_DR_COUNT; i++) {
+		ret = pciet_ete_ring_alloc(ctx, &b3->dr[i], b3_dr_off[i],
+					   HI5622_ETE_BUF_LEN);
+		if (ret)
+			goto err_free;
+	}
+
+	ret = device_add_groups(dev, pciet_b3_groups);
+	if (ret) {
+		dev_err(dev, "B3: device_add_groups: %d\n", ret);
+		goto err_free;
+	}
+
+	for (i = 0; i < HI5622_B3_DR_COUNT; i++) {
+		u32 base = (u32)b3->dr[i].node_dma;
+
+		if (!b3_dma_in_window(base))
+			dev_warn(dev, "B3: DR%u node array dma 0x%08x is outside the RC inbound window 0x80000000..0x8fffffff; P0 will refuse to arm\n",
+				 i, base);
+	}
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++) {
+		u32 base = (u32)b3->sr[i].node_dma;
+
+		if (!b3_dma_in_window(base))
+			dev_warn(dev, "B3: SR%u node array dma 0x%08x is outside the RC inbound window 0x80000000..0x8fffffff; P0 will refuse to arm\n",
+				 i, base);
+	}
+
+	if (ctx->poll_thread)
+		dev_warn(dev, "B3: the base module's D2H poll thread is RUNNING (poll_ms != 0). B3's P1/b3_drain need the full ack/drain/re-arm sequence - reload with poll_ms=0 before running the probes\n");
+
+	dev_info(dev, "B3 instrument ready: 3 SR + 4 DR rings allocated in host DRAM (no device writes); probes P0-P5 via b3_* sysfs attrs - see B3-PLAN.md\n");
+	return 0;
+
+err_free:
+	b3_rings_free(ctx, b3);
+	ctx->b3 = NULL;
+	return ret;
+}
+
+void pciet_b3_remove(struct hi5622_pci *ctx)
+{
+	struct hi5622_b3 *b3 = ctx->b3;
+
+	if (!b3)
+		return;
+	device_remove_groups(&ctx->pdev->dev, pciet_b3_groups);
+	b3_rings_free(ctx, b3);
+	ctx->b3 = NULL;
+	dev_info(&ctx->pdev->dev, "B3 instrument removed\n");
+}
