+			     (unsigned long long)b3->d2h_events,
+			     b3->d2h_id_seen,
+			     readl(ctx->bar0 + HI5622_BAR0_D2H_BITMAP));
+	pos += sysfs_emit_at(buf, pos, "counts:");
