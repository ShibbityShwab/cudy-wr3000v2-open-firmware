+static ssize_t b3_p4_state_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct hi5622_pci *ctx = b3_ctx(dev);
+	struct hi5622_b3 *b3;
+	int pos = 0, i;
+
+	if (!ctx || !ctx->b3)
+		return -ENODEV;
+	b3 = ctx->b3;
