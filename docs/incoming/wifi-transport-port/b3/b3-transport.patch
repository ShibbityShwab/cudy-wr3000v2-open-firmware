+			     min_t(u16, b3->g4_id2_plen,
+				   sizeof(b3->g4_id2_payload)));
+		pos += sysfs_emit_at(buf, pos,
+				     "g4_id2 host_ready: payload=%u B (<=0x63: %s) total=%u len=%u payload_first=%s\n",
+				     b3->g4_id2_plen,
+				     b3->g4_id2_plen <= 0x63 ? "OK" : "VIOLATION",
+				     b3->g4_id2_total, b3->g4_id2_len,
+				     hexbuf);
+	}
+	pos += sysfs_emit_at(buf, pos,
+			     "no H2D reply is required or sent by B3\n");
+	return pos;
