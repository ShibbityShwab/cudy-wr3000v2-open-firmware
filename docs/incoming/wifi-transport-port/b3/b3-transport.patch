+			     "boot: fw_loaded=%d cpu_released=%d gate_announced=%d windows=%d base_poll_thread=%d\n",
+			     ctx->fw_loaded, ctx->cpu_released,
+			     ctx->gate_announced, ctx->windows_programmed,
+			     ctx->poll_thread != NULL);
+	pos += sysfs_emit_at(buf, pos, "rings armed=%d prepost=%u\n",
+			     b3->armed, b3->preposted);
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++) {
+		void __iomem *ch = ctx->bar0 + HI5622_BAR0_ETE_BASE +
+				   b3->sr[i].chan_off;
+
+		pos += sysfs_emit_at(buf, pos,
+				     "SR%d enable(+0x00)=0x%08x (firmware-owned, read-only) prod=0x%08x consumer=0x%08x\n",
+				     i, readl(ch + HI5622_ETE_CH_ENABLE),
+				     readl(ch + HI5622_ETE_CH_A_PRD),
+				     readl(ch + HI5622_ETE_CH_A_CNS));
