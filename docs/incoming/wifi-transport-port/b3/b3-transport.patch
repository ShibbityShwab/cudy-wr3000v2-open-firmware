+	pos += sysfs_emit_at(buf, pos,
+			     "watch bits: b3(ETE done)=%u b6(d2h_notify)=%u b2(platform-up 0x4)=%u\n",
+			     b3->d2h_bit_count[3], b3->d2h_bit_count[6],
+			     b3->d2h_bit_count[2]);
+	start = b3->d2h_hist_pos > B3_MAX_HIST ?
+		b3->d2h_hist_pos - B3_MAX_HIST : 0;
+	pos += sysfs_emit_at(buf, pos, "last[%u]:", b3->d2h_hist_pos - start);
+	for (i = 0; i < B3_MAX_HIST && start + i < b3->d2h_hist_pos; i++) {
+		u32 idx = (start + i) % B3_MAX_HIST;
+
+		pos += sysfs_emit_at(buf, pos, " 0x%08x", b3->d2h_hist[idx]);
+	}
