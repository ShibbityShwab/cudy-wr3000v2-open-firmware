+			     b3->hcc_last_rsrc, b3->hcc_last_id,
+			     b3->hcc_last_total, b3->hcc_last_len,
+			     b3->hcc_last_ok);
+	pos += sysfs_emit_at(buf, pos, "group_counts:");
+	for (i = 0; i < 16; i++)
+		if (b3->hcc_group_count[i])
+			pos += sysfs_emit_at(buf, pos, " g%d=%u", i,
+					     b3->hcc_group_count[i]);
+	pos += sysfs_emit_at(buf, pos, "\n");
+	pos += sysfs_emit_at(buf, pos,
+			     "P3 ready gate: g4_id1_seen=%d g4_id2_seen=%d (the vendor's 200/2000-jiffy waits)\n",
+			     b3->g4_id1_seen, b3->g4_id2_seen);
+	if (b3->g4_id1_seen) {
+		b3_hex_bytes(hexbuf, sizeof(hexbuf), b3->g4_id1_first,
+			     min_t(u16, b3->g4_id1_len,
+				   sizeof(b3->g4_id1_first)));
+		pos += sysfs_emit_at(buf, pos,
+				     "g4_id1 device_plat_ready: len=%u total=%u first=%s\n",
+				     b3->g4_id1_len, b3->g4_id1_total,
+				     hexbuf);
+	}
+	if (b3->g4_id2_seen) {
