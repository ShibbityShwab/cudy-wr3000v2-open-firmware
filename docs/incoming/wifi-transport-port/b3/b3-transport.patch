+			     "P4 post-release state (all reads; nothing written)\n");
+	pos += sysfs_emit_at(buf, pos,
+			     "out[0] H2D pending=0x%08x  out[1] D2H bitmap=0x%08x  out[2] H2D doorbell=0x%08x\n",
+			     readl(ctx->bar0 + HI5622_BAR0_H2D_PENDING),
+			     readl(ctx->bar0 + HI5622_BAR0_D2H_BITMAP),
+			     readl(ctx->bar0 + HI5622_BAR0_H2D_DOORBELL));
+	pos += sysfs_emit_at(buf, pos,
+			     "out[5] = 0x%08x (READ-ONLY; never written)  D2H doorbell=0x%08x  ETE intr=0x%08x\n",
+			     readl(ctx->bar0 + HI5622_BAR0_B3_NEVER_WRITE),
+			     readl(ctx->bar0 + HI5622_BAR0_B3_D2H_DOORBELL),
