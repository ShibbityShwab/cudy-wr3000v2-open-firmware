# src-baseline.sha256 - parity baseline of the INHERITED (unmodified)
# files of the wifi-cfg80211 / wifi-vap-scan trees this lane extends.
# Captured at copy time (2026-11-24/25): wifi-cfg80211 HEAD tree (module
# 505,076 B sha256 2c30051e.../d2b3cf79... family) and the task-110
# wifi-vap-scan src/vapscan_frames.c (commit 0e4ad45).  tools/selftest.py
# fails if one of these files changes without an integration note.
#
# Expected integration edits in this lane (NOT in this baseline; each is
# asserted directly by tools/selftest.py):
#   src/Kbuild                        + scan/post/provider objects
#   src/h2d_frames.h                  + shared portable-type guard
#   src/vapscan_frames.h              + shared portable-type guard
#   src/hi5622_scan_d2h.h             + shared portable-type guard
#                                       (portability only; bytes unchanged)
#                                       (portability only; bytes unchanged)
#   src/hcc.c                         + hi5622_scan_deliver() hook
#   src/d2h.c                         full staged payload to delivery
#   src/hi5622_contract.h             D2H_SNAP_MAX = full HCC frame
#   src/hi5622_d2h.h                  + rd->snap staging buffer
#   src/hi5622_cfg80211.c/.h          + scan layer lifecycle/status
#   src/hi5622_cfg80211_ops.c         + scan/abort_scan/start_ap/stop_ap
#                                     + VAP user add/del messages
#   src/cfg80211-provider.symvers     regenerated: 9 symbols
#   tools/gen_cfg80211_symvers.py     Module.symvers grammar + KDIR
#   src/h2d_frames.c                  + WAL group-2 cfg-event family validation
#                                       (wifi-vap-start lane, task-117; the
#                                       post-fire fix for the id-0 handler slot)
#   src/hi5622_scan_d2h.c             + SSID/DS/HT/VAP IE summary fields for the
#                                       cfg80211 BSS evidence line
#                                       (scan-complete lane, task-123)
#   src/hi5622_scan_d2h.h             + shared portable-type guard only
#   src/hi5622_frames_api.h, hi5622_scan.c, hi5622_scan_logic.*,
#   src/hi5622_vapscan_map.**, hi5622_vapscan_provider.c, Kbuild
#                                     + scan-complete: auto scan window,
#                                       channel-coverage completion, dwell
#                                       override, IE summary mapping, VAP caps
#
# New clean-room files of this lane (not inherited, not baseline):
#   src/hi5622_frames_api.h, hi5622_frames_provider.c, hi5622_frame_post.*,
#   hi5622_scan.*, hi5622_scan_logic.*, hi5622_vapscan_map.*,
#   hi5622_vapscan_provider.c
#
