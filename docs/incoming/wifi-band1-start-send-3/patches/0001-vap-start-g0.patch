+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_vap_start_g0.c - H2D g0-id1 key 0x0065 (VAP start) frame, plan and
+ * the fail-closed G1..G14 probe gates (see the header for the decoded
+ * contract).  ORIGINAL clean-room code (lane wifi-band1-start-send-3, shared
+ * task task-209).  This file only synthesizes the host-built protocol bytes,
+ * refuses malformed requests and evaluates read-only probe values.
+ */
+#include "hi5622_vap_start_g0.h"
+
+#ifdef __KERNEL__
+#include <linux/kernel.h>
+#include <linux/string.h>
+#else
+#include <stdio.h>
+#include <string.h>
+#endif
+
+static void vg_put16(u8 *p, u16 v)
+{
+	p[0] = (u8)(v & 0xffu);
+	p[1] = (u8)((v >> 8) & 0xffu);
+}
+
+int hi5622_vap_start_g0_plan(unsigned int vap_start_g0,
+			     unsigned int beacon_static, unsigned int band,
+			     unsigned int module,
+			     struct hi5622_vap_start_g0_plan *out)
+{
+	if (!out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (vap_start_g0 > HI5622_VAP_START_G0_PARM_MAX)
+		return -EINVAL;
+	if (band > 1u || module > HI5622_VAP_START_G0_MODULE_MAX)
+		return -EINVAL;
+	/* The step exists only in the beacon_static vendor order; an explicit
+	 * request without that ladder has no safe slot - refuse, never drop. */
+	if (vap_start_g0 == HI5622_VAP_START_G0_PARM_MAX &&
+	    beacon_static != 1u)
+		return -EINVAL;
+	out->module = (u8)(module & 0xffu);
+	/* Band-1 AP start only: the 0x0065 worker sets the VAP start state that
+	 * the band-1 resolver CA 0x4AE7C reads; band 0 is a clean no-post. */
+	out->post = (vap_start_g0 == HI5622_VAP_START_G0_PARM_MAX && band == 1u);
+	return 0;
+}
+
+/* The 12-byte HCC header of the g0-id1 config-event carrier: group 0,
+ * alloc 1 / dst 0, inherited fa, field B = the module/context index, total,
+ * message id 1, fc/dst 0, transport tag.  Token bytes: the inherited
+ * bench-executed g0-id1 pattern (payload word at +4 = 1); the key workers do
+ * not parse them [V]. */
+static void vg_header(u8 *b, u16 total, u8 module)
+{
+	b[0] = 0x00u;				/* group 0 */
+	b[1] = 0x01u;				/* alloc nibble 1, dst 0 */
+	b[2] = (u8)HI5622_VAP_START_G0_FA;
+	b[3] = module;				/* field B */
+	vg_put16(b + 4, total);
+	vg_put16(b + 6, (u16)HI5622_VAP_START_G0_ID);
+	b[8] = 0x00u;				/* fc */
+	b[9] = 0x00u;				/* dst */
+	vg_put16(b + 10, (u16)HI5622_VAP_START_G0_TAG);
+	b[HI5622_VAP_START_G0_TOKEN_OFF + 4u] = 0x01u;
+}
+
+int hi5622_vap_start_g0_build(u8 *wire, size_t cap, size_t *out_len,
+			      const struct hi5622_vap_start_g0_plan *plan)
+{
+	u8 *b;
+
+	if (!wire || !out_len || !plan)
+		return -EINVAL;
+	if (!plan->post)
+		return -EINVAL;		/* never build an unrequested frame */
+	if (plan->module > HI5622_VAP_START_G0_MODULE_MAX)
+		return -EINVAL;
+	if (cap < HI5622_VAP_START_G0_WIRE_LEN)
+		return -ENOSPC;
+
+	b = wire;
+	memset(b, 0, HI5622_VAP_START_G0_WIRE_LEN);
+	vg_header(b, (u16)HI5622_VAP_START_G0_WIRE_LEN, plan->module);
+	vg_put16(b + HI5622_VAP_START_G0_KEY_OFF,
+		 (u16)HI5622_VAP_START_G0_KEY);
+	vg_put16(b + HI5622_VAP_START_G0_LEN_OFF,
+		 (u16)HI5622_VAP_START_G0_BODY_LEN);
+	/* body {00,01,01,00,00,00,00,00,00,00,00,00}: the stock emitter's
+	 * arg/state/band/field/word map (header comment). */
+	b[HI5622_VAP_START_G0_BODY_OFF + 0u] = (u8)HI5622_VAP_START_G0_ARG;
+	b[HI5622_VAP_START_G0_BODY_OFF + 1u] = (u8)HI5622_VAP_START_G0_STATE;
+	b[HI5622_VAP_START_G0_BODY_OFF + 2u] = (u8)HI5622_VAP_START_G0_BAND;
+	b[HI5622_VAP_START_G0_BODY_OFF + 3u] = (u8)HI5622_VAP_START_G0_FIELD;
+	vg_put16(b + HI5622_VAP_START_G0_BODY_OFF + 4u,
+		 (u16)(HI5622_VAP_START_G0_WORD & 0xffffu));
+	vg_put16(b + HI5622_VAP_START_G0_BODY_OFF + 6u,
+		 (u16)(HI5622_VAP_START_G0_WORD >> 16));
+	/* The inherited 4-byte 0xFF tail every working g0-id1 frame carries. */
+	memset(b + HI5622_VAP_START_G0_BODY_OFF + HI5622_VAP_START_G0_BODY_LEN,
+	       0xff, 4);
+	*out_len = HI5622_VAP_START_G0_WIRE_LEN;
+	return 0;
+}
+
+int hi5622_vap_start_g0_precheck(const struct hi5622_vap_start_g0_probe *p)
+{
+	if (!p)
+		return -EINVAL;
+	/* G1: the module context must resolve - without it every dereference the
+	 * worker makes is unavailable and the 0x0242 resolver cannot return the
+	 * VAP. */
+	if (!p->mctx)
+		return -ENODEV;
+	/* G2: the band VAP list must hold EXACTLY one entry (CA 0x4AE7C's first
+	 * test) and the band object must exist. */
+	if (!p->bandobject || p->count != 1u)
+		return -ENOENT;
+	/* G3: that single entry must be the VAP index the 0x0064 add bound. */
+	if (p->entry0 != p->expected_index)
+		return -EEXIST;
+	/* G4: the bind publish word the 0x0064 worker requires must be set. */
+	if (!p->published)
+		return -EAGAIN;
+	/* G5: THE FAULT GATE.  The key-0x0065 AP branch dereferences
+	 * u32[mctx+0x190] at CA 0x46470; a zero word faults the firmware. */
+	if (!p->b190)
+		return -EFAULT;
+	/* G7: the worker's AP branch is selected by mctx[4] == 2. */
+	if (p->type != 2u)
+		return -EPROTO;
+	/* G8: mctx[0x11] is the band; it must be 5 GHz or the later 5 GHz RF
+	 * branch CA 0x40684 skips the VAP. */
+	if (p->band != HI5622_VAP_START_G0_BAND)
+		return -EINVAL;
+	/* G9: the band-config flag opens the CA 0x944DE/0x101890 RF branch; a
+	 * set flag means this is not the first start of a fresh band. */
+	if (p->b440 != 0u)
+		return -EBUSY;
+	/* G10: CA 0x4C3FC's band-id gate (CA 0x581C8) must pass. */
+	if (p->d6e != 0u)
+		return -EINVAL;
+	/* G11: the band must not already be up. */
+	if (p->ec8 != 0u)
+		return -EALREADY;
+	/* G13: a fresh band run-state: no armed request, no start marker, and
+	 * state[4] still unset (0) or empty (0xFF). */
+	if (p->state0 != 0u || p->state1 != 0u ||
+	    (p->state4 != 0x00u && p->state4 != HI5622_VAP_START_G0_STATE_NO_VAP))
+		return -EBUSY;
+	return 0;
+}
+
+const char *hi5622_vap_start_g0_verdict(
+		const struct hi5622_vap_start_g0_probe *p)
+{
+	if (!p)
+		return "?";
+	if (!p->mctx)
+		return "G1: module ctx unresolved - no frame posted";
+	if (!p->bandobject || p->count != 1u)
+		return "G2: band object absent or band VAP list count != 1 - no frame posted (the key-0x0064 add must bind exactly one entry)";
+	if (p->entry0 != p->expected_index)
+		return "G3: the single band VAP list entry is not vap_add_index - no frame posted (bind ctx drift)";
+	if (!p->published)
+		return "G4: the bind publish word u32[bandobj+0x1A00] is ZERO - the key-0x0064 bind did not run, no frame posted";
+	if (!p->b190)
+		return "G5: u32[mctx+0x190] is ZERO - the key-0x0065 worker would fault at CA 0x46470, no frame posted";
+	if (p->type != 2u)
+		return "G7: mctx[4] is not 2 (AP create type) - no frame posted";
+	if (p->band != HI5622_VAP_START_G0_BAND)
+		return "G8: mctx[0x11] is not 1 (5 GHz) - no frame posted";
+	if (p->b440 != 0u)
+		return "G9: mctx[0x440] band-config flag is set - no frame posted";
+	if (p->d6e != 0u)
+		return "G10: bandobj+0xD6E band-id gate is nonzero - no frame posted";
+	if (p->ec8 != 0u)
+		return "G11: bandobj+0xEC8 says the band is already up - no frame posted";
+	if (p->state0 != 0u || p->state1 != 0u ||
+	    (p->state4 != 0x00u && p->state4 != HI5622_VAP_START_G0_STATE_NO_VAP))
+		return "G13: the band run-state is not fresh (state[0]/state[1] nonzero or state[4] out of {0x00,0xFF}) - no frame posted";
+	return "the G1..G13 gates are open; G6 (helper object) and G14 (per-link branch) are non-gating observations";
+}
+
+bool hi5622_vap_start_g0_helper_ok(
+		const struct hi5622_vap_start_g0_probe *p)
+{
+	return p && p->b4ac != 0u;
+}
+
+int hi5622_vap_start_g0_postcheck(unsigned int mctx_state)
+{
+	/* G12: the only fresh-band writer of this byte is the 0x0065 AP branch
+	 * (CA 0x46418-0x4641A, a 0->1 store).  Anything else means the event did
+	 * not take effect and the 0x0242 pre-start would fail again. */
+	if (mctx_state != HI5622_VAP_START_G0_MCTX_STATE_1)
+		return -EAGAIN;
+	return 0;
+}
+
+int hi5622_vap_start_g0_status_line(unsigned int vap_start_g0,
+				    unsigned int beacon_static, int last_rc,
+				    unsigned int posted, unsigned int refused,
+				    char *buf, size_t len)
+{
+	const char *mode;
+	int n;
+
+	if (!buf || !len)
+		return -EINVAL;
+	if (vap_start_g0 == 0u)
+		mode = "off";
+	else if (vap_start_g0 == HI5622_VAP_START_G0_PARM_MAX)
+		mode = "band1-post";
+	else
+		mode = "invalid";
+	n = snprintf(buf, len,
+		     "vap_start_g0: param=%u (%s) beacon_static=%u last_rc=%d posted=%u refused=%u\n",
+		     vap_start_g0, mode, beacon_static, last_rc, posted, refused);
+	if (n < 0)
+		return n;
+	return (int)((size_t)n < len ? (size_t)n : len - 1);
+}
