+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_vap_start_g0.h - H2D g0-id1 config-event key 0x0065 (VAP start) for
+ * the Hi5622V100 clean-room full-MAC driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-band1-start-send-3, shared task
+ * task-209, 2026-11-25).  The frame and firmware facts are the committed
+ * decodes of the sibling lanes wifi-band-start-prestart (task-208: the
+ * band-start resolver CA 0x4AE7C gate mctx[4]==2 && mctx[0x0E] in 1..3, the
+ * single 0->1 store in the key-0x0065 worker CA 0x46394 at 0x46418-0x4641A,
+ * the stock emitter hmac_config_start_vap_event @ wifi.ko .text+0x15AF88 and
+ * its AP caller 0x4826C), wifi-band1-start-send-2 (task-207: the 0x0242
+ * base) and wifi-vap-start (task-117: the clean-room g0-id1 carrier builder
+ * vsf_build_vap_start and its 40-byte KAT).  No vendor source, object code,
+ * firmware byte, calibration value, MAC or secret is reproduced here.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * The 0x0242 band-start pre-start helper CA 0x4C3FC calls the band VAP
+ * resolver CA 0x4AE7C and writes state[4] only when the resolver returns a
+ * module context.  For the single bound VAP the resolver additionally
+ * requires mctx[4] == 2 (AP create type) and mctx[0x0E] in {1,2,3}.  On a
+ * fresh 5 GHz AP that byte is 0, and it is set 0->1 by EXACTLY ONE code
+ * path: the H2D g0-id1 config-event key-0x0065 worker CA 0x46394, AP branch
+ * (CA 0x46418-0x4641A).  The stock host posts that event
+ * (hmac_config_start_vap_event, 12-byte body, before the green_ap enable);
+ * our ladder never did, so CA 0x4C3FC took its failure branch (state[4] =
+ * 0xFF at CA 0x4C4EE) and CA 0x4AF0C refused at 0x4AF32.  This module
+ * builds the 40-byte g0-id1 key-0x0065 frame and gates it fail-closed on the
+ * live firmware preconditions the worker dereferences:
+ *
+ *     12-B HCC header | 8-B token | key u16 | len u16 | body(12) | 4 x FF
+ *     total = 12 + 8 + 2 + 2 + 12 + 4 = 40 B  (SR node word1 0x00286D2B)
+ *
+ *     body = { channel arg 0, state 1, band 1, field 0, u32 word 0 }
+ *            (the stock hmac_config_start_vap_event body map:
+ *             [0]=arg, [1]=vap+0x0F state, [2]=vap+0x11 band,
+ *             [3]=vap+0x12 field, [4..7]=vap+0x414 word)
+ *
+ * Fail-closed module parameter (owned by hi5622_scan.c):
+ *   vap_start_g0=0 (default)  no 0x0065 frame at all - current behaviour;
+ *   vap_start_g0=1            post the 40-B frame once per band-1 AP start,
+ *                             AFTER the key-0x0064 VAP add and BEFORE the
+ *                             0x00F7 / 0x0242 steps, only with the
+ *                             beacon_static vendor order, and only when the
+ *                             G1..G13 probe pack passes;
+ *   vap_start_g0>1            refused (-EINVAL) before any frame.
+ *
+ * The probe pack (read-only firmware RAM; the caller fills it):
+ *   G1  mctx != 0                          G8  u8[mctx+0x11] == 1 (band 5G)
+ *   G2  bandobj != 0 && count == 1         G9  u8[mctx+0x440] == 0
+ *   G3  bandobj[0] == vap_add_index        G10 u8[bandobj+0xD6E] == 0
+ *   G4  u32[bandobj+0x1A00] != 0           G11 u8[bandobj+0xEC8] == 0
+ *   G5  u32[mctx+0x190] != 0               G13 state[0]==0 && state[1]==0 &&
+ *   G6  u32[mctx+0x4AC] != 0 (warn only)       state[4] in {0x00,0xFF}
+ *   G7  u8[mctx+4] == 2 (AP type)          G14 perlink+0x6C6 observation only
+ * G5 is the fault gate: the key-0x0065 worker dereferences mctx[0x190] at CA
+ * 0x46470 and faults when it is zero.  After the post the caller re-reads
+ * mctx[0x0E] (G12): only 1 allows the 0x0242 band start to be posted, whose
+ * resolver CA 0x4AE7C will otherwise return 0 again.
+ *
+ * Pure C99: the same code compiles in the kernel module and in the host
+ * selftest (src/vap_start_g0_selftest.c); tools/run-host-tests.sh compiles
+ * both against the real sibling builders.
+ */
+#ifndef HI5622_VAP_START_G0_H
+#define HI5622_VAP_START_G0_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef HI5622_HOST_TYPES_DEFINED
+#define HI5622_HOST_TYPES_DEFINED
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+#endif
+
+/* ---- fail-closed module parameter contract ---------------------------- */
+/* The only accepted non-zero value; anything above is refused before any
+ * frame.  0 (default) leaves the wire bytes exactly as in the 0x0242 base. */
+#define HI5622_VAP_START_G0_PARM_MAX		1u
+
+/* ---- frame geometry [V] (the g0-id1 config-event carrier) -------------- */
+#define HI5622_VAP_START_G0_HDR_LEN		12u	/* 12-byte HCC header */
+#define HI5622_VAP_START_G0_TOKEN_OFF		12u	/* 8-byte token/preamble */
+#define HI5622_VAP_START_G0_TOKEN_LEN		8u
+#define HI5622_VAP_START_G0_KEY_OFF		20u	/* key u16 at hdr+20 */
+#define HI5622_VAP_START_G0_LEN_OFF		22u	/* body length u16 at hdr+22 */
+#define HI5622_VAP_START_G0_BODY_OFF		24u	/* body at hdr+24 */
+#define HI5622_VAP_START_G0_TAG			0x5a5au	/* transport tag at hdr+10 */
+#define HI5622_VAP_START_G0_ID			1u	/* HCC message id 1 (g0 config event) */
+#define HI5622_VAP_START_G0_FA			0x00u	/* header byte 2 (inherited family) */
+#define HI5622_VAP_START_G0_KEY			0x0065u	/* VAP-start worker CA 0x46394 */
+#define HI5622_VAP_START_G0_BODY_LEN		12u	/* the stock emitter's 12-byte body */
+#define HI5622_VAP_START_G0_WIRE_LEN		40u	/* 12+8+2+2+12+4 */
+#define HI5622_VAP_START_G0_TOTAL_FIELD		0x0028u	/* total at hdr+4 = wire len */
+/* SR node word1 = (frame_total << 16) | 0x6D2B (h2d_frames convention). */
+#define HI5622_VAP_START_G0_NODE_WORD1		0x00286d2bu
+#define HI5622_VAP_START_G0_MODULE_MAX		0x12u	/* module-table index bound [V] */
+
+/* The body bytes the AP branch of the worker consumes [V]:
+ * [0] = the stock do_start_vap channel argument (0 - the worker's AP branch
+ *       uses it only for a log/arg passthrough, the band is carried by [2]);
+ * [1] = vap+0x0F -> mctx[0x0F] (state byte; 1 = started/up);
+ * [2] = vap+0x11 -> mctx[0x11] = the band (must be 1: the later 5 GHz RF
+ *       branch CA 0x40684 skips a VAP whose band is not 5 GHz);
+ * [3] = vap+0x12 -> mctx[0x12] (field; 0 for the AP);
+ * [4..7] = vap+0x414 u32 word (0). */
+#define HI5622_VAP_START_G0_ARG			0u
+#define HI5622_VAP_START_G0_STATE		1u
+#define HI5622_VAP_START_G0_BAND		1u
+#define HI5622_VAP_START_G0_FIELD		0u
+#define HI5622_VAP_START_G0_WORD		0u
+
+/* ---- firmware offsets the probe pack reads (read-only) [V] ------------ */
+#define HI5622_VAP_START_G0_MCTX_TYPE_OFF	0x04u	/* create type: 2 = AP */
+#define HI5622_VAP_START_G0_MCTX_STATE_OFF	0x0eu	/* VAP start state (G12) */
+#define HI5622_VAP_START_G0_MCTX_CHAN_OFF	0x10u	/* channel (observation) */
+#define HI5622_VAP_START_G0_MCTX_BAND_OFF	0x11u	/* band: 1 = 5 GHz */
+#define HI5622_VAP_START_G0_MCTX_FIELD_OFF	0x12u	/* field (observation) */
+#define HI5622_VAP_START_G0_MCTX_VAP_OFF	0x190u	/* the VAP object (G5) */
+#define HI5622_VAP_START_G0_MCTX_VAP_P10_OFF	0x10u	/* [VAP+0x10] (R4b word) */
+#define HI5622_VAP_START_G0_MCTX_B440_OFF	0x440u	/* band-config flag (G9) */
+#define HI5622_VAP_START_G0_MCTX_B4AC_OFF	0x4acu	/* start-helper object (G6) */
+#define HI5622_VAP_START_G0_MCTX_LINK_OFF	0x4b0u	/* per-link (G14) */
+#define HI5622_VAP_START_G0_MCTX_BAND_OBJ_OFF	0x4b8u	/* band object */
+#define HI5622_VAP_START_G0_BANDOBJ_STATE_OFF	0x14d0u	/* per-band run-state */
+#define HI5622_VAP_START_G0_BANDOBJ_COUNT_OFF	0x12u	/* band VAP list count (G2) */
+#define HI5622_VAP_START_G0_BANDOBJ_PUBLISHED_OFF 0x1a00u /* bind publish word (G4) */
+#define HI5622_VAP_START_G0_BANDOBJ_D6E_OFF	0x0d6eu	/* band-id gate (G10) */
+#define HI5622_VAP_START_G0_BANDOBJ_EC8_OFF	0x0ec8u	/* band-up flag (G11) */
+#define HI5622_VAP_START_G0_PERLINK_6C6_OFF	0x06c6u	/* per-link branch (G14) */
+
+/* State field map of bandobj+0x14D0: [1] = start marker (2 = started),
+ * [4] = bound VAP index (0xFF = none) - the R3b observables. */
+#define HI5622_VAP_START_G0_STATE_STARTED_OFF	1u
+#define HI5622_VAP_START_G0_STATE_VAP_OFF	4u
+#define HI5622_VAP_START_G0_STATE_NO_VAP	0xffu
+
+/* The AP branch of the worker writes mctx[0x0E] = 1 (CA 0x46418-0x4641A);
+ * CA 0x4AE7C also accepts 2 and 3 but on a fresh band only the 0x0065 store
+ * can produce a value at all.  G12 requires exactly 1 (the recipe's value). */
+#define HI5622_VAP_START_G0_MCTX_STATE_1	1u
+
+/* Bounded read-only wait used for the asynchronous mctx[0x190] population
+ * (G5) and for the post-0x0065 G12 read.  Compiled constant: the fire recipe
+ * needs no extra knob. */
+#define HI5622_VAP_START_G0_WAIT_MS		300u
+
+/* ---- fail-closed decision --------------------------------------------- */
+/* What one band-1 AP start must do with the 0x0065 frame. */
+struct hi5622_vap_start_g0_plan {
+	bool	post;	/* true = build + post the frame */
+	u8	module;	/* field B = the AP-start module/context index */
+};
+
+/* Fill *out with the VAP-start decision.
+ *  - 0 on success.  post = true only for vap_start_g0 == 1 on a band-1 AP
+ *    with the beacon_static vendor order enabled;
+ *  - -EINVAL for NULL out, vap_start_g0 > HI5622_VAP_START_G0_PARM_MAX,
+ *    band > 1, module > the module-table bound, or vap_start_g0 == 1
+ *    without beacon_static == 1 (fail closed: never silently ignore an
+ *    explicit request, never guess a band).
+ * band == 0 with a valid parameter is a clean no-post: the 0x0065 VAP start
+ * exists only for the 5 GHz band-1 VAP this lane repairs (the 2.4 GHz path
+ * does not need the 0x4AE7C resolver). */
+int hi5622_vap_start_g0_plan(unsigned int vap_start_g0,
+			     unsigned int beacon_static, unsigned int band,
+			     unsigned int module,
+			     struct hi5622_vap_start_g0_plan *out);
+
+/* Build the complete 40-byte HCC wire frame into wire/cap.
+ * Refuses (-EINVAL) NULL/bad arguments, an unarmed plan and a module outside
+ * the table; -ENOSPC when cap < HI5622_VAP_START_G0_WIRE_LEN.  The caller
+ * posts the result through hi5622_frame_post() (the only wire path); this
+ * module never touches the device. */
+int hi5622_vap_start_g0_build(u8 *wire, size_t cap, size_t *out_len,
+			      const struct hi5622_vap_start_g0_plan *plan);
+
+/* Read-only live-firmware snapshot the G1..G14 gates test.  The kernel layer
+ * fills it from firmware RAM; no field is ever a wire input. */
+struct hi5622_vap_start_g0_probe {
+	/* G1 */	u32	mctx;
+	/* G7 */	u8	type;		/* u8[mctx+0x04] */
+	/* obs */	u8	ch;		/* u8[mctx+0x10] */
+	/* G8 */	u8	band;		/* u8[mctx+0x11] */
+	/* obs */	u8	field;		/* u8[mctx+0x12] */
+	/* G1b */	u32	bandobject;	/* u32[mctx+0x4B8] */
+	/* G13 */	u8	state0;		/* bandobj+0x14D0+0 */
+	/* G13 */	u8	state1;		/* bandobj+0x14D0+1 */
+	/* G13 */	u8	state4;		/* bandobj+0x14D0+4 */
+	/* G2 */	u8	count;		/* u8[bandobj+0x12] */
+	/* G3 */	u8	entry0;		/* u8[bandobj+0] */
+	/* G4 */	u32	published;	/* u32[bandobj+0x1A00] */
+	/* G10 */	u8	d6e;		/* u8[bandobj+0xD6E] */
+	/* G11 */	u8	ec8;		/* u8[bandobj+0xEC8] */
+	/* G5 */	u32	b190;		/* u32[mctx+0x190] = the VAP object */
+	/* G9 */	u8	b440;		/* u8[mctx+0x440] */
+	/* G6 */	u32	b4ac;		/* u32[mctx+0x4AC] */
+	/* G14 */	u8	plink6c6;	/* u8[perlink+0x6C6] */
+	/* G3 expectation */ u8	expected_index;	/* vap_add_index */
+};
+
+/* Check the fail-closed pre-post probe pack.
+ *  - 0 when every mandatory gate G1..G5, G7..G11, G13 passes;
+ *  - -ENODEV  G1: module ctx unresolved;
+ *  - -ENOENT  G2: no band object / band VAP list count != 1;
+ *  - -EEXIST  G3: the single list entry is not vap_add_index;
+ *  - -EAGAIN  G4: the bind publish word is zero (the VAP-add bind did not run);
+ *  - -EFAULT  G5: mctx[0x190] == 0 - the 0x0065 worker would fault at CA
+ *             0x46470, so the frame must not be posted;
+ *  - -EPROTO  G7: create type is not AP (2);
+ *  - -EINVAL  G8: band field is not 5 GHz, or G10: band-id gate nonzero;
+ *  - -EBUSY   G9: band-config flag already set, or G13: band not fresh;
+ *  - -EALREADY G11: band already up.
+ * G6 (mctx[0x4AC] == 0) and G14 (perlink+0x6C6) are not gating; see
+ * hi5622_vap_start_g0_helper_ok(). */
+int hi5622_vap_start_g0_precheck(const struct hi5622_vap_start_g0_probe *p);
+
+/* Human-readable verdict of the FIRST failing gate (or "the G1..G13 gates
+ * are open"), for the dmesg evidence line.  Never a wire input. */
+const char *hi5622_vap_start_g0_verdict(
+		const struct hi5622_vap_start_g0_probe *p);
+
+/* G6: the start-helper object is logged by the worker but not dereferenced
+ * on the AP path; a zero value is a warn-only observation. */
+bool hi5622_vap_start_g0_helper_ok(
+		const struct hi5622_vap_start_g0_probe *p);
+
+/* G12: after the 0x0065 post, mctx[0x0E] must read exactly 1 before the
+ * 0x0242 band start may be posted (the resolver CA 0x4AE7C accepts 1..3, but
+ * only the 0x0065 store makes a fresh value).  Returns 0 when the band start
+ * is allowed, -EAGAIN otherwise.  Read-only. */
+int hi5622_vap_start_g0_postcheck(unsigned int mctx_state);
+
+/* One read-only sysfs status line (the driver appends it to cfg80211_status):
+ *   vap_start_g0: param=N (mode) beacon_static=M last_rc=R posted=P refused=F
+ * mode is "off" (0), "band1-post" (1) or "invalid" (>1).  last_rc is
+ * -ENODATA until the first attempt.  Returns the length, clamped like
+ * hi5622_frame_post_status_line(). */
+int hi5622_vap_start_g0_status_line(unsigned int vap_start_g0,
+				    unsigned int beacon_static, int last_rc,
+				    unsigned int posted, unsigned int refused,
+				    char *buf, size_t len);
+
+#endif /* HI5622_VAP_START_G0_H */
