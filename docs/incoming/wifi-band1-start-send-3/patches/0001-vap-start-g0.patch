+			state + HI5622_VAP_START_G0_STATE_STARTED_OFF);
+	p->state4 = (u8)hi5622_fw_ram_read(ctx,
+			state + HI5622_VAP_START_G0_STATE_VAP_OFF);
+	p->count = (u8)hi5622_fw_ram_read(ctx,
+			bandobj + HI5622_VAP_START_G0_BANDOBJ_COUNT_OFF);
+	p->entry0 = (u8)hi5622_fw_ram_read(ctx, bandobj);
+	p->published = hi5622_fw_ram_read(ctx,
+			bandobj + HI5622_VAP_START_G0_BANDOBJ_PUBLISHED_OFF);
+	p->d6e = (u8)hi5622_fw_ram_read(ctx,
+			bandobj + HI5622_VAP_START_G0_BANDOBJ_D6E_OFF);
+	p->ec8 = (u8)hi5622_fw_ram_read(ctx,
+			bandobj + HI5622_VAP_START_G0_BANDOBJ_EC8_OFF);
+}
