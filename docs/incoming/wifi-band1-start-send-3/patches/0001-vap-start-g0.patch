+/* lane wifi-band1-start-send-3 (task-209, R4): READ-ONLY probe pack for the
+ * key-0x0065 VAP-start preconditions (G1..G14 of the sibling decode
+ * ../wifi-band-start-prestart TABLES T10).  Every field is a live firmware
+ * RAM read through the existing readback chain (slot0/base -> mctx ->
+ * bandobj/perlink); no probe and no write.  The G5 wait is the asynchronous
+ * mctx+0x190 population: the 0x0065 worker dereferences it at CA 0x46470, so
+ * the driver waits the bounded HI5622_VAP_START_G0_WAIT_MS before deciding. */
+static void hi5622_scan_vap_start_g0_probe(struct hi5622_pci *ctx,
+					   struct hi5622_vap_start_g0_probe *p,
+					   u8 expected_index)
+{
+	u32 waited = 0u, slot, base, mctx, bandobj, state, perlink;
+
+	if (!p)
+		return;
+	memset(p, 0, sizeof(*p));
+	p->expected_index = expected_index;
+	if (!ctx || !ctx->windows_programmed)
+		return;
+	slot = hi5622_fw_ram_read(ctx, HI5622_STAB_MODULE_TABLE_SLOT0_CPU);
+	base = hi5622_fw_ram_read(ctx, HI5622_STAB_MODULE_TABLE_BASE_CPU);
+	mctx = hi5622_beacon5g_mctx_ca(slot, base);
+	if (!mctx)
+		return;
+	/* G5 bounded wait: the firmware publishes mctx+0x190 asynchronously. */
+	for (;;) {
+		if (hi5622_fw_ram_read(ctx,
+				mctx + HI5622_VAP_START_G0_MCTX_VAP_OFF) != 0u)
+			break;
+		if (waited >= HI5622_VAP_START_G0_WAIT_MS)
+			break;
+		msleep(5);
+		waited += 5u;
+	}
+	p->mctx = mctx;
+	p->type = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_TYPE_OFF);
+	p->ch = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_CHAN_OFF);
+	p->band = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_BAND_OFF);
+	p->field = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_FIELD_OFF);
+	p->b190 = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_VAP_OFF);
+	p->b440 = (u8)hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_B440_OFF);
+	p->b4ac = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_B4AC_OFF);
+	perlink = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_LINK_OFF);
+	if (perlink)
+		p->plink6c6 = (u8)hi5622_fw_ram_read(ctx,
+				perlink + HI5622_VAP_START_G0_PERLINK_6C6_OFF);
+	bandobj = hi5622_fw_ram_read(ctx,
+			mctx + HI5622_VAP_START_G0_MCTX_BAND_OBJ_OFF);
