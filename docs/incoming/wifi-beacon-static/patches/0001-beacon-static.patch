+/* =====================================================================
+ * AP-start ordering plan (wifi-beacon-static lane, task-140)
+ * ===================================================================
+ * The vendor AP start is an ordered FIVE-message sequence:
+ *   set channel (0x0124) -> set SSID (0x0005) -> auth (0x006D) ->
+ *   AP config (0x0127) -> VAP start (0x0065).
+ * The clean-room bench path posted [VAP add, VAP start] as a mode-1 base
+ * BEFORE the AP config and never set the module channel.  This plan is the
+ * pure ordering contract the kernel layer executes when the fail-closed
+ * beacon_static parameter is enabled; it lives here so the host selftest can
+ * assert the order without a kernel build.  The WAL carrier's own sequence
+ * already ends with its VAP start (after the AP config), so the kernel skips
+ * the extra VAP-start step for it. */
+enum hi5622_beacon_step {
+	HI5622_BEACON_STEP_NONE = 0,
+	HI5622_BEACON_STEP_VAP_ADD = 1,		/* mode-1 base: user_add only */
+	HI5622_BEACON_STEP_CHAN = 2,		/* channel config, vendor first */
+	HI5622_BEACON_STEP_SSID = 3,		/* provider frame 0 */
+	HI5622_BEACON_STEP_AP_CFG = 4,		/* provider frame 1 */
+	HI5622_BEACON_STEP_VAP_START = 5,	/* AFTER the AP config */
+	HI5622_BEACON_STEP_MAX = 6,
+};
+
+/* Fill out[] with the ordered plan; returns the number of steps.  enabled=0
+ * returns 0 (the legacy bench-proven path is executed instead, unchanged).
+ * vap_start=0 drops only the final VAP-start step (ladder isolation rung). */
+unsigned int hi5622_beacon_plan(unsigned int enabled, unsigned int vap_start,
+				u8 *out, unsigned int max);
+
+/* Stable step name ("vap_add"/"ap_chan"/"ap_ssid"/"ap_cfg"/"ap_vap_start";
+ * "none" for unknown). */
+const char *hi5622_beacon_step_name(u8 step);
+
 #endif /* HI5622_SCAN_LOGIC_H */
