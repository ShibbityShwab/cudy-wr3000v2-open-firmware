+static unsigned int hi5622_twt_posts;
+static unsigned int hi5622_twt_refusals;
+
 /* scan-complete lane (task-123): the bench measured the firmware returning 6
  * of the 13 requested per-channel results within the wifi-scan-ap lane's 5 s
  * bound (~830 ms/channel, ledger 2026-11-26 14:00), so a 13-channel request
@@ -1747,6 +1776,30 @@
 		rc = -EINVAL;
 		goto out;
 	}
+	/* lane wifi-ax-twt-impl (task-199): FAIL-CLOSED parameter/precondition
+	 * gate for the TWT-enable config event (g0 id1 key 0x035D).  Runs BEFORE
+	 * any frame, so a bad or unusable request never leaves a partial ladder:
