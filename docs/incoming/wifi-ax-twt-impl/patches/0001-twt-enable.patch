+				 hi5622_twt,
+				 hi5622_ax_twt_mode_name(hi5622_twt), trc);
+			hi5622_twt_refusals++;
+			rc = trc;
+			goto out;
+		}
+	}
 	/* Capture the pre-call VAP-base state BEFORE any post.  The firmware
 	 * populates module_ctx+0x190 ASYNCHRONOUSLY after vap_add/vap_start, so a
 	 * readback immediately after a fresh post is expected to be zero (bench R2
@@ -1778,7 +1831,8 @@
 		 * logged so the bench reads the intended rung from dmesg. */
 		plan_n = hi5622_beacon_plan(1u, hi5622_beacon_vap_start,
 					    hi5622_desc_table, hi5622_dfs_mode,
-					    plan, HI5622_BEACON_STEP_MAX);
+					    hi5622_twt, plan,
+					    HI5622_BEACON_STEP_MAX);
 		dev_info(wdev_dev,
 			 "cfg80211: start_ap beacon_static=1 plan (%u steps):", plan_n);
 		for (i = 0; i < plan_n; i++)
@@ -2269,6 +2323,104 @@
 			dev_info(wdev_dev,
 				 "cfg80211: start_ap beacon_static: VAP start owned by the WAL carrier sequence (already posted after ap_cfg)\n");
 		}
+		/* lane wifi-ax-twt-impl (task-199): the TWT-enable config event
+		 * (g0 id1 key 0x035D) is the LAST AP-start step.  The firmware
+		 * worker CA 0x41E5A writes ctx+0xDA.bit6/bit7 of the per-module
+		 * context, and the message field B is derived from the module
+		 * context the AP start actually bound (the F2 lesson: a
+		 * hard-coded field B silently targets the wrong module).  A
+		 * context that does not resolve to one of the 19 decoded boot
+		 * contexts is refused, never guessed. */
+		if (hi5622_twt) {
+			struct hi5622_ax_twt_plan tp;
+			u32 tw_slot0, tw_base, tw_mctx, tw_ctx, tw_da = 0;
+			u32 tw_out0 = 0;
+			unsigned int tw_wait_ms = 0;
+			int trc;
+
+			trc = hi5622_ax_twt_precheck(hi5622_twt,
+						     hi5622_beacon_static,
+						     hi5622_beacon_vap_start,
+						     hi5622_he_caps, p->band,
+						     &tp);
+			if (trc) {
+				dev_warn(wdev_dev,
+					 "cfg80211: start_ap beacon_static: TWT-enable REFUSED (%d) - no frame sent; AP start latched DIRTY, power-cycle\n",
+					 trc);
+				hi5622_twt_refusals++;
