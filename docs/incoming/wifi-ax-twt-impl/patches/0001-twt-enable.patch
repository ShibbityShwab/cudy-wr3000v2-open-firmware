+static unsigned int hi5622_twt;
+module_param_named(twt, hi5622_twt, uint, 0444);
+MODULE_PARM_DESC(twt,
+		 "TWT (target wake time) enable: 0=off (default, no 0x035D frame), 1=TWT enable, 3=TWT enable+required (the vendor user-path's only values; posted after the VAP start on a 2.4 GHz HE AP with beacon_static=1 and he_caps=1), 2 or >3 refused before any frame (the per-user TWT agreement needs an associated STA = RX gate, not implemented)");
+/* Read-only outcome for the sysfs status line (never a wire input). */
