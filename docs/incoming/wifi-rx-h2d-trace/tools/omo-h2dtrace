#!/bin/sh
# omo-h2dtrace - one-shot read-only vendor H2D capture for the stock pair-A image.
# READ-ONLY: the sampler only pread()s /dev/mem; this script only starts it.
# One-shot: does nothing once a capture log exists.
[ -f /overlay/h2d-trace.stop ] && exit 0
[ -s /overlay/h2d-trace.log ] && exit 0
LOG=/overlay/h2d-trace.log
ERR=/overlay/h2d-trace.err
echo "omo-h2dtrace: aid start $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ERR"
# the S08 can run before the overlay exposes the sampler; wait up to 30 s, then start it
( i=0; while [ $i -lt 300 ]; do [ -x /usr/bin/omo_h2dsampler ] && break; i=$((i+1)); sleep 0.1; done;
  echo "omo-h2dtrace: sampler present after $i x 100ms" >> "$ERR";
  /usr/bin/omo_h2dsampler -o "$LOG" -t 180 -r 20 >>"$ERR" 2>&1 ) &
exit 0