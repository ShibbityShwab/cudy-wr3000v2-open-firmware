Subject: [PATCH] hi5622v100: candidate RX-init config message (g0 id1 key 0x0004)

Lane: rx-init-decode (task-170).  Adds the fail-closed candidate firmware config
event decoded in docs/incoming/wifi-rx-init-msg/REPORT.md: group 0 / id 1 / u16
key 0x0004 / payload len 4 / data u32 1, ONE per module load, gated on the ordered
ctx_create, with the existing bounded announce read-back.  Module param
rx_init_enable defaults to 0 (no auto-send).  Applies with -p1 at the src parent.

--- a/src/h2d_send_logic.h
+++ b/src/h2d_send_logic.h
@@ -54,6 +54,7 @@
 	H2D_MSG_CTX_CREATE_T1,	/* same frame, data[0]=type 1 (defaults+2nd alloc) */
 	H2D_MSG_CTX_CREATE_T2,	/* same frame, data[0]=type 2 (defaults) */
 	H2D_MSG_CFG_CAL,	/* g0 id2 key 0x0101, 270-byte calibration blob */
+	H2D_MSG_RX_INIT,	/* candidate: g0 id1 key 0x0004, one ctx byte (task-170) */
 	H2D_MSG_COUNT,
 };
 
@@ -77,6 +78,16 @@
 #define H2D_CTX_TYPE		3u
 #define H2D_CTX_VAP		4u
 #define H2D_CTX_USER		4u
+
+/* The candidate RX-init config event (task-170): group 0 id 1, u16 key
+ * 0x0004, payload len 4, data u32 = 1.  The firmware key-table worker
+ * (CA 0x811CD) writes data[0] to ctx[+0x190][+0x52] and needs the module
+ * context the ordered ctx_create (key 0x0064) created (hdr[3] = fb = module).
+ * Total = 28 + len = 0x20.  Fail-closed: OFF by default, one per load. */
+#define H2D_RX_INIT_KEY		0x0004u
+#define H2D_RX_INIT_LEN		0x4u
+#define H2D_RX_INIT_VAL		1u
+#define H2D_RX_INIT_TOTAL	0x20u
 #define H2D_CTX_MAX_MODULE	0x12u	/* module table index bound */
 
 /* The six vendor calibration alg set_* config events (wifi-proto-seq lane,
@@ -119,6 +130,8 @@
 	H2D_GATE_DUP_CTX,	/* ctx_create already committed this load */
 	H2D_GATE_CTX_PHASE,	/* ctx_create is legal only in READY_TXQ_SYNC */
 	H2D_GATE_FRAME_INVALID,	/* the frame builder/validator refused */
+	H2D_GATE_DUP_RX_INIT,	/* rx_init is one per load */
+	H2D_GATE_RX_INIT_NO_CTX,	/* rx_init requires the ordered ctx_create */
 };
 
 /* Live driver-state snapshot the gate needs (filled by h2d_send.c or a test
@@ -130,6 +143,7 @@
 	bool		lane_closed;
 	bool		txq_submitted;	/* a REAL txq_sync/txq_sync72 frame was sent */
 	bool		ctx_created;	/* a ctx_create frame was sent this load */
+	bool		rx_init_sent;	/* a rx_init frame was sent this load */
 	enum hcc_phase	phase;
 	hcc_u32		frames_sent;	/* real H2D frames posted this load */
 	hcc_u32		budget;		/* per-load real-frame budget */

--- a/src/h2d_send_logic.c
+++ b/src/h2d_send_logic.c
@@ -115,6 +115,7 @@
 	case H2D_MSG_CTX_CREATE_T1:	return "ctx_create_t1";
 	case H2D_MSG_CTX_CREATE_T2:	return "ctx_create_t2";
 	case H2D_MSG_CFG_CAL:		return "cfg_cal";
+	case H2D_MSG_RX_INIT:		return "rx_init";
 	default:		return "?";
 	}
 }
@@ -138,6 +139,8 @@
 	case H2D_GATE_DUP_CTX:		return "ctx_already_created";
 	case H2D_GATE_CTX_PHASE:	return "ctx_phase_not_ready";
 	case H2D_GATE_FRAME_INVALID:	return "frame_invalid";
+	case H2D_GATE_DUP_RX_INIT:	return "rx_init_already_sent";
+	case H2D_GATE_RX_INIT_NO_CTX:	return "no_ctx_create";
 	default:			return "?";
 	}
 }
@@ -160,6 +163,7 @@
 		{ "ctx_create_t1",	H2D_MSG_CTX_CREATE_T1 },
 		{ "ctx_create_t2",	H2D_MSG_CTX_CREATE_T2 },
 		{ "cfg_cal",	H2D_MSG_CFG_CAL },
+		{ "rx_init",	H2D_MSG_RX_INIT },
 		{ "stub",	H2D_MSG_STUB },
 		{ "edca",	H2D_MSG_EDCA_OPT },
 		{ "del_user",	H2D_MSG_DEL_USER },
@@ -219,6 +223,15 @@
 		if (live->phase != HCC_PHASE_READY_TXQ_SYNC)
 			return H2D_GATE_CTX_PHASE;
 	}
+	if (msg == H2D_MSG_RX_INIT) {
+		/* Candidate firmware config message: ONE per load and only after the
+		 * ordered context-create was accepted (the firmware worker dereferences
+		 * ctx+0x190, which only the key-0x0064 create helper allocates). */
+		if (live->rx_init_sent)
+			return H2D_GATE_DUP_RX_INIT;
+		if (!live->ctx_created)
+			return H2D_GATE_RX_INIT_NO_CTX;
+	}
 	if (msg == H2D_MSG_TXQ_SYNC || msg == H2D_MSG_TXQ_SYNC72) {
 		/* The vendor's first post-ready message is sent exactly once.  The
 		 * ordinary path sends it from READY_TXQ_SYNC (the core flips to
@@ -419,6 +432,24 @@
 		rc = h2d_build_cfg_cal(f, 0u, cal_id, cal_fb, &e);
 		break;
 	}
+	case H2D_MSG_RX_INIT: {
+		/* g0 id1 key 0x0004, payload len 4, data u32 = 1 (the byte the
+		 * firmware worker writes at ctx+0x190+0x52).  Header fields are the
+		 * ctx_create frame's (fa/fc 0, fb = the created module). */
+		u8 data[H2D_RX_INIT_LEN] = { H2D_RX_INIT_VAL, 0, 0, 0 };
+
+		if (dst != 0u) {
+			if (err)
+				*err = H2D_EPOLICY;
+			return -1;
+		}
+		rc = h2d_build_g0_cfg_event(f, 1u, 0u, H2D_CTX_FA,
+					    H2D_CTX_USER, H2D_CTX_FC,
+					    h2d_ctx_token, H2D_RX_INIT_KEY,
+					    data, (u16)sizeof(data),
+					    h2d_ctx_tail, &e);
+		break;
+	}
 	case H2D_MSG_EDCA_OPT:
 		rc = h2d_build_g0_id1d_edca_opt(f, dst, H2D_EDCA_FA,
 						H2D_EDCA_FB, H2D_EDCA_FC, &e);

--- a/src/h2d_send.c
+++ b/src/h2d_send.c
@@ -93,6 +93,14 @@
 	return pci_get_drvdata(to_pci_dev(dev));
 }
 
+/* Candidate RX-init message (task-170): fail-closed default OFF.  When 1,
+ * the h2d_rx_init WO attribute accepts ONE write per module load.  The frame
+ * is the firmware-live g0 id1 key 0x0004 config event (REPORT.md sec 5). */
+unsigned int hi5622_rx_init_enable;
+module_param_named(rx_init_enable, hi5622_rx_init_enable, uint, 0644);
+MODULE_PARM_DESC(rx_init_enable,
+		 "candidate RX-init config event (g0 id1 key 0x0004): 0=off (default), 1=allow one h2d_rx_init write per load");
+
 static u32 h2d_budget(void)
 {
 	return hi5622_h2d_send_budget > HI5622_H2D_SEND_BUDGET_MAX ?
@@ -118,6 +126,7 @@
 	 * actually committed: only a real TXQ frame sets live->txq_submitted. */
 	live->txq_submitted = h->h2d_txq_sync_sent > 0u;
 	live->ctx_created = h->h2d_ctx_create_sent > 0u;
+	live->rx_init_sent = h->h2d_rx_init_sent > 0u;
 	live->phase = core->phase;
 	live->frames_sent = h->h2d_frames_sent;
 	live->budget = h2d_budget();
@@ -320,6 +329,8 @@
 		h->h2d_ctx_create_sent++;
 	else if (msg == H2D_MSG_CFG_CAL)
 		h->h2d_cfg_cal_sent++;
+	else if (msg == H2D_MSG_RX_INIT)
+		h->h2d_rx_init_sent++;
 	h->h2d_last_msg = (u32)msg;
 	h->h2d_last_gate = (u32)H2D_GATE_OK;
 	h->h2d_last_total = total;
@@ -718,6 +729,29 @@
 }
 static DEVICE_ATTR_RO(h2d_plan);
 
+/* Candidate RX-init config event: ONE write per load, only with
+ * rx_init_enable=1 and only after the ordered ctx_create was accepted.  The
+ * existing gate stack (armed/released/latched/phase/lane/budget/out0) plus the
+ * new one-shot rules apply; the announce read-back is the existing bounded
+ * out[0] poll in h2d_post.  FAIL-CLOSED: default OFF, no auto-send, no retry. */
+static ssize_t h2d_rx_init_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct hi5622_pci *ctx = h2d_ctx(dev);
+	int ret;
+
+	if (!ctx || !ctx->hcc)
+		return -ENODEV;
+	if (!hi5622_rx_init_enable)
+		return -EPERM;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	ret = h2d_post(ctx, H2D_MSG_RX_INIT, 0u, 0u, NULL, 0u,
+		       H2D_CAL_FB_DEFAULT_UNSET);
+	return ret ? ret : (ssize_t)count;
+}
+static DEVICE_ATTR_WO(h2d_rx_init);
+
 static struct attribute *hi5622_h2d_attrs[] = {
 	&dev_attr_h2d_txq_sync.attr,
 	&dev_attr_h2d_txq_sync72.attr,
@@ -726,6 +760,7 @@
 	&dev_attr_h2d_send.attr,
 	&dev_attr_h2d_status.attr,
 	&dev_attr_h2d_plan.attr,
+	&dev_attr_h2d_rx_init.attr,
 	NULL,
 };
 ATTRIBUTE_GROUPS(hi5622_h2d);

--- a/src/hi5622_hcc.h
+++ b/src/hi5622_hcc.h
@@ -62,6 +62,7 @@
 	u32			h2d_txq_sync_sent;
 	u32			h2d_ctx_create_sent;	/* ordered txq precondition */
 	u32			h2d_cfg_cal_sent;	/* calibration alg set_* frames */
+	u32			h2d_rx_init_sent;	/* candidate RX-init config event (task-170) */
 	u64			h2d_send_ok;		/* announce consumed */
 	u64			h2d_send_timeout;	/* announce not consumed */
 	u64			h2d_send_refused;
