+	ctx190 = hi5622_fw_ram_read(ctx, H2D_CTX4_CPU + H2D_CTX190_OFF);
+	ctx434 = hi5622_fw_ram_read(ctx, H2D_CTX4_CPU + H2D_CTX434_OFF);
+	out->ctx4 = H2D_CTX4_CPU;
+	out->ctx0_lo = (u8)(ctx0 & 0xffu);
+	out->ctx190 = ctx190;
+	out->ctx434 = ctx434;
+	/* The proven TYPE-1 signature: the +0x190 buffer exists, the object is
+	 * the created module 4, and the type-1 second allocation exists. */
+	out->ok = ctx190 != 0u && out->ctx0_lo == (u8)H2D_CTX_MODULE_ID &&
+		  ctx434 != 0u;
+	h->h2d_ctx4 = out->ctx4;
+	h->h2d_ctx190 = ctx190;
+	h->h2d_ctx434 = ctx434;
+	h->h2d_ctx_attest_ok = out->ok ? 1u : 0u;
+	h->h2d_ctx_attest_reads++;
+	return out->ok ? 0 : -EAGAIN;
+}
