+static struct hi5622_pci *rc_ctx(struct device *dev)
+{
+	return pci_get_drvdata(to_pci_dev(dev));
+}
+
+static void rc_policy_fill(struct rc_policy *pol, struct hi5622_pci *ctx)
+{
+	u32 budget;
+
+	memset(pol, 0, sizeof(*pol));
+	pol->enabled = hi5622_rate_ctl != 0u;
+	pol->arbitrary = hi5622_rate_ctl_arbitrary != 0u;
+	/* rate-control frames are provider frames posted through the single
+	 * fail-closed wire path; its per-load budget is the one that bounds
+	 * them (a separate knob from the curated h2d_send ladder budget). */
+	budget = hi5622_allow_frames > RC_RC_BUDGET_MAX ? RC_RC_BUDGET_MAX :
+		 hi5622_allow_frames;
+	pol->budget = budget;
+	pol->sent = rc_state.sent;
