diff -ruN a/hi5622_rate_ctl_wire.c b/hi5622_rate_ctl_wire.c
--- a/hi5622_rate_ctl_wire.c
+++ b/hi5622_rate_ctl_wire.c
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_rate_ctl_wire.c - the rate-control alg_cfg config-event wire builder
+ * (Hi5622V100 clean-room driver, wifi-rc-impl-2 lane, RC-2).
+ *
+ * ORIGINAL clean-room code: the carrier shape is the committed calibration
+ * contract (../wifi-rate-ctl/REPORT.md sec 4; ../wifi-proto-seq/recipes/
+ * cal-alg-ladder.json P3) and h2d_frames' exact-frame library re-validates
+ * every byte (transport + firmware table + handler) before the wire is
+ * returned.  No vendor source/object/firmware byte is reproduced.
+ */
+#include "hi5622_rate_ctl_wire.h"
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/slab.h>
+#else
+#include <errno.h>
+#include <stdlib.h>
+#endif
+
+static const uint8_t rc_wire_token[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
+static const uint8_t rc_wire_tail[4] = { 0, 0, 0, 0 };
+
+/* struct h2d_frame embeds the maximum payload (0x674 B), so it must not live
+ * on the kernel stack (the module builds with -Werror=frame-larger-than=1024).
+ * Heap-allocate it in both worlds; the builder is otherwise pure. */
+static struct h2d_frame *rc_wire_frame_alloc(void)
+{
+#ifdef __KERNEL__
+	return kmalloc(sizeof(struct h2d_frame), GFP_KERNEL);
+#else
+	return malloc(sizeof(struct h2d_frame));
+#endif
+}
+
+static void rc_wire_frame_free(struct h2d_frame *f)
+{
+#ifdef __KERNEL__
+	kfree(f);
+#else
+	free(f);
+#endif
+}
+
+int rc_wire_build(const uint8_t *blob, uint16_t blob_len, uint8_t fb,
+		  uint8_t *wire, size_t cap, size_t *out_len)
+{
+	struct h2d_frame *f;
+	enum h2d_err err = H2D_OK;
+	size_t wire_len = 0;
+	int rc;
+
+	if (!blob || !wire || !out_len)
+		return -EINVAL;
+	/* The blob must be a complete alg_cfg header + value, and the carrier
+	 * bound must hold (fail closed, never guess a length). */
+	if (blob_len < RC_ALG_HDR_LEN || blob_len > RC_ALG_MAX_BLOB)
+		return -EINVAL;
+	if (fb > RC_CFG_FB_MAX)
+		return -EINVAL;
+	if (cap < (size_t)RC_WIRE_CARRIER_OVERHEAD + blob_len)
+		return -ENOSPC;
+	f = rc_wire_frame_alloc();
+	if (!f)
+		return -ENOMEM;
+	/* Chunk 0: the shared config-event builder (group 0 / id 2 / key
+	 * 0x0101 / 8-byte zero token / u16 len / blob / 4-byte zero tail), the
+	 * exact shape the bench proved on the calibration ladder. */
+	rc = h2d_build_g0_cfg_event(f, 2u, 0u, 0u, fb, 0u, rc_wire_token,
+				    (u16)RC_CFG_KEY, blob, blob_len,
+				    rc_wire_tail, &err);
+	if (rc != 0) {
+		rc_wire_frame_free(f);
+		return -EPERM;
+	}
+	/* Chunk 1: wire encode re-runs the transport/firmware/handler/policy
+	 * validation on the frame struct before a byte can reach the ring. */
+	rc = h2d_frame_encode(f, wire, cap, &wire_len, &err);
+	rc_wire_frame_free(f);
+	if (rc != 0)
+		return -EPERM;
+	if (wire_len != (size_t)RC_WIRE_CARRIER_OVERHEAD + blob_len)
+		return -EPERM;
+	*out_len = wire_len;
+	return 0;
+}
+
+int rc_wire_build_req(const struct rc_req *req, uint8_t fb,
+		      uint8_t *wire, size_t cap, size_t *out_len)
+{
+	uint8_t blob[RC_ALG_MAX_BLOB];
+	size_t blob_len = 0;
+
+	if (!req)
+		return -EINVAL;
+	if (rc_blob_build(req, blob, sizeof(blob), &blob_len) != 0)
+		return -EINVAL;
+	return rc_wire_build(blob, (uint16_t)blob_len, fb, wire, cap, out_len);
+}
diff -ruN a/hi5622_rate_ctl_wire.h b/hi5622_rate_ctl_wire.h
--- a/hi5622_rate_ctl_wire.h
+++ b/hi5622_rate_ctl_wire.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_rate_ctl_wire.h - the wire builder for the rate-control alg_cfg
+ * config events (Hi5622V100 clean-room driver, wifi-rc-impl-2 lane, RC-2).
+ *
+ * The rate-control command carrier is the calibration ladder's bench-proven
+ * HCC group 0 / id 2 / key 0x0101 config event: the 12-byte HCC header, the
+ * 8-byte token, the u16 key, the u16 blob length, the alg_cfg blob and the
+ * inherited 4-byte zero tail (28 bytes of carrier + the blob).  The 39-byte
+ * SET rate_mode auto wire is derived in ../REPORT.md sec 3 and pinned byte
+ * for byte by ../tools/rc2_frame_selftest.c.
+ *
+ * This unit is pure C (h2d_frames.h is the project's portable exact-frame
+ * library) so the host selftest compiles it unchanged.  It constructs bytes
+ * only: no device access, no register write, no libc beyond string.h.
+ */
+#ifndef HI5622_RATE_CTL_WIRE_H
+#define HI5622_RATE_CTL_WIRE_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stddef.h>
+#endif
+#include "h2d_frames.h"
+#include "hi5622_rate_ctl_logic.h"
+
+/* 12-byte HCC header + 8 token + 2 key + 2 len + 4 tail. */
+#define RC_WIRE_CARRIER_OVERHEAD	28u
+/* The maximum wire this surface can build (10-byte alg header + 260 value). */
+#define RC_WIRE_MAX_LEN	(RC_WIRE_CARRIER_OVERHEAD + RC_ALG_MAX_BLOB)
+
+/* Build one complete alg_cfg config-event wire frame from an already-built
+ * alg_cfg blob.  dst is the vendor's 0; fb is the module-context selector
+ * (header field B; the proven calibration frames and the C2 type-1 create use
+ * module 4).  Returns 0 on success, -EINVAL/-ENOSPC/-EPERM (fail closed) on a
+ * malformed request; *out_len is the wire length (28 + blob_len). */
+int rc_wire_build(const uint8_t *blob, uint16_t blob_len, uint8_t fb,
+		  uint8_t *wire, size_t cap, size_t *out_len);
+
+/* Convenience: build the blob from a protocol-level request (rc_blob_build's
+ * strict validation included) and then the wire. */
+int rc_wire_build_req(const struct rc_req *req, uint8_t fb,
+		      uint8_t *wire, size_t cap, size_t *out_len);
+
+#endif /* HI5622_RATE_CTL_WIRE_H */
