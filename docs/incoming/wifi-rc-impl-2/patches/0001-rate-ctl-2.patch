+	if (!ctx || !out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	h = ctx->hcc;
+	if (!h)
+		return -ENODEV;
+	/* The firmware-RAM window exists only after prepare programmed the iATU
+	 * windows; before that a read would be meaningless.  Fail closed. */
+	if (!ctx->windows_programmed)
