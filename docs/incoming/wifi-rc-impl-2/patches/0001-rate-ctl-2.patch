+		/* the corrected C2 precondition, recorded by the H2D layer */
+		pol->ctx_type1 = ctx->hcc->h2d_ctx_create_type == 1u;
+		pol->ctx_attested = ctx->hcc->h2d_ctx_attest_ok != 0u;
+		pol->txq_sent = ctx->hcc->h2d_txq_sync_sent > 0u;
+	}
+}
