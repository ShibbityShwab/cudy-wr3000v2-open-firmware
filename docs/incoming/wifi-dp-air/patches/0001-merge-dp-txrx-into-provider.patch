+#define DP_TXRX_TABLE_ENTRY_DWORDS 3u
+#define DP_TXRX_TABLE_ACP_DELTA 0x01000000u /* [V] memmap_get_dev_acp_addr */
+#define DP_TXRX_TABLE_USERS 0x92u
