+/* ------------------------------------------------------------------ */
+/* probe / remove                                                     */
+/* ------------------------------------------------------------------ */
+int hi5622_dp_probe(struct hi5622_pci *ctx)
+{
+    struct hi5622_dp *dp;
+
+    dp = devm_kzalloc(&ctx->pdev->dev, sizeof(*dp), GFP_KERNEL);
+    if (!dp)
+        return -ENOMEM;
+    dp->dev = &ctx->pdev->dev;
+    mutex_init(&dp->lock);
+    ctx->dp = dp;
+    return 0;
+}
+
+void hi5622_dp_remove(struct hi5622_pci *ctx)
+{
+    if (!ctx || !ctx->dp)
+        return;
+    hi5622_dp_txrx_release(ctx);
+    dp_free_rings(ctx);
+    ctx->dp = NULL;
+}
