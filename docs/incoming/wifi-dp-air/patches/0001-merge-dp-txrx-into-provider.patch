+/* ====================================================================== */
+/* 1. TX: device-RAM MSDU-info ring-pointer table entry (12 bytes)       */
+/* ====================================================================== */
+/* [V] shuangta_tx_msdu_ring_buf_alloc (wifi.ko 2.4.15 0x38f5c):
+ *   entry = { ring_device_va, published_wptr, device_consumed_rptr }
