+    dp_u32 norm_rptr;
+    dp_u32 small_rptr;
+    dp_u32 cmp_rptr;
+    dp_u32 captured;  /* raw completion words captured this load */
+    dp_u32 consumed;  /* completion entries consumed (pointers moved) */
+    dp_u32 unknown;   /* refused completion entries */
+    dp_u32 last_cmp_raw;
+};
