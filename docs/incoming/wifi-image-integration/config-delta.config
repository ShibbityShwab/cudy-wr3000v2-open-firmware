# SPDX-License-Identifier: GPL-2.0-only
#
# wifi-image-integration (task-112) bench-image package delta.
#
# APPENDED to the release-line OpenWrt .config, then resolved with
# "make defconfig". Do not add these to target/linux/hisilicon/luofu/target.mk
# or the image stanza: they are bench-only, not part of the release image.
#
# Basis: release-line tree /home/shibbityshwab/openwrt-lab-selectorfix-img,
# commit 27663a0, image 22b72852 (kernel slice 13e81214); the tree's target
# kernel config already sets CONFIG_CFG80211=m (docs/incoming/
# wifi-upstream-target/CFG80211-BENCH-IMAGE.md), which is what makes the two
# kmod packages below buildable/installable.

# --- userspace tools for the cfg80211 bench -------------------------------
# iw: nl80211 configuration + "iw phy / iw dev" enumeration (needs libnl-tiny,
# already in the release image as package libnl-tiny1).
CONFIG_PACKAGE_iw=y
# iwinfo CLI + library, C implementation (the bench tooling parity choice:
# OpenWrt's default ucode wifi-scripts iwinfo is not selected, see below).
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
# Regulatory database. The kernel delta keeps CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
# and OpenWrt's wireless-regdb package ships only the unsigned regulatory.db,
# so cfg80211 falls back to the built-in world regulatory domain (permissive;
# the driver's own wiphy bands/channels are unaffected). Kept in the image so
# the bench has the db and the behaviour is documented, not silently absent.
CONFIG_PACKAGE_wireless-regdb=y

# Use the C iwinfo binary instead of the ucode-based wifi-scripts CLI
# (package/network/config/wifi-scripts/files-ucode/usr/bin/iwinfo). With
# WIFI_SCRIPTS_UCODE=y package "iwinfo" installs nothing and depends on
# libiwinfo only conditionally, so the bench image would carry no iwinfo CLI.
# wifi-scripts itself is NOT selected by this delta (no netifd wifi hooks on
# the bench image become active); this only picks the C CLI implementation.
# CONFIG_WIFI_SCRIPTS_UCODE is not set

# --- clean-room driver modules + cfg80211 --------------------------------
# cfg80211.ko from the target kernel tree (the driver was compiled against it).
CONFIG_PACKAGE_kmod-hi5622-cfg80211=y
# The clean-room Wi-Fi host driver (built from wifi-cfg80211/src snapshot).
CONFIG_PACKAGE_kmod-hi5622-wifi=y
