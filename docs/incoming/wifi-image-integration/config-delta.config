# SPDX-License-Identifier: GPL-2.0-only
#
# wifi-image-integration (task-112 -> final-image task-132) bench-image
# package delta.
#
# APPENDED to the release-line OpenWrt .config, then resolved with
# "make defconfig". Do not add these to target/linux/hisilicon/luofu/target.mk
# or the image stanza: they are bench-only, not part of the release image.
#
# Basis: release-line tree /home/shibbityshwab/openwrt-lab-selectorfix-img,
# commit 27663a0, ABI-validated image df6a78c3 (kernel slice 13e81214, slot
# 1794a531). The target kernel config already sets CONFIG_CFG80211=m, so the
# two kmod packages below install/compile cleanly and the kernel slice is not
# touched by this delta (the image stays a ROOTFS-ONLY rebuild).
#
# Round 3 (SELF-CONTAINED FINAL IMAGE, 2026-11-27): adds the hostapd package
# set + the wifi-scripts ucode files so a fresh flash has iw/iwinfo/regdb/
# kmods/hostapd/ucode out of the box with no /tmp deployment. The previous
# round's C-iwinfo selection is dropped: with the ucode wifi scripts selected,
# /usr/bin/iwinfo is the (OpenWrt default) ucode implementation provided by
# wifi-scripts, and hostapd-mini needs the wifi-scripts ucode modules
# (/usr/share/hostap/{common,wdev,wifi-detect}.uc) - bench finding of the
# wifi-ap-start lane (image/wifi-scripts-ucode.md).

# --- cfg80211 bench userspace --------------------------------------------
# iw: nl80211 configuration + "iw phy / iw dev" (needs libnl-tiny, already in
# the release image as package libnl-tiny1).
CONFIG_PACKAGE_iw=y
# Regulatory database (see REPORT.md: unsigned db + REQUIRE_SIGNED_REGDB=y =>
# world regulatory domain; kept so the bench behaviour is explicit).
CONFIG_PACKAGE_wireless-regdb=y

# --- AP bring-up stack (hostapd + ucode) ---------------------------------
# OpenWrt wifi scripts (ucode implementation): ships /usr/bin/iwinfo (ucode
# CLI), /usr/share/ucode/iwinfo.uc + /usr/share/ucode/wifi/*.uc, the hostapd
# ucode modules /usr/share/hostap/{common,wdev,wifi-detect}.uc and the netifd
# wireless integration. Pulls ucode + ucode-mod-{nl80211,rtnl,ubus,uci,digest}
# and netifd (already in the release image).
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_WIFI_SCRIPTS_UCODE=y
# The AP fixture used for the 2026-11-27 hostapd AP-ENABLED milestone; v2.12,
# internal TLS, no libmbedtls. Depends on hostapd-common (init/config/acl).
CONFIG_PACKAGE_hostapd-mini=y
CONFIG_PACKAGE_hostapd-common=y
# ucode netlink modules used by hostapd/wifi-scripts (explicit for the
# manifest, they are also pulled as wifi-scripts dependencies).
CONFIG_PACKAGE_ucode-mod-nl80211=y
CONFIG_PACKAGE_ucode-mod-rtnl=y

# --- clean-room driver modules + cfg80211 --------------------------------
# cfg80211.ko from the target kernel tree (the driver was compiled against it).
CONFIG_PACKAGE_kmod-hi5622-cfg80211=y
# The clean-room Wi-Fi host driver (prebuilt ABI-validated module staged by
# tools/install-into-tree.sh --driver-ko, or compiled from a source snapshot).
CONFIG_PACKAGE_kmod-hi5622-wifi=y
