+/* ------------------------------------------------------------------ */
+/* wifi-rx-woc-class (task-167): vendor-class RX buffer allocation    */
+/*                                                                    */
+/* Everything here is derived from the decoded vendor path; no vendor */
+/* code/bytes are reproduced (REPORT.md section 3):                    */
+/*   hi_net_woc_alloc_skb(kpie 0x73a8): __netdev_alloc_skb(NULL,      */
+/*     buflen+3, GFP_ATOMIC = 0xa20); align skb->data to 4;           */
+/*     is_vmalloc_addr(data) -> dma_map_page_attrs(dev,               */
+/*     page(data), offset, buflen, DMA_FROM_DEVICE, attrs=0); return  */
+/*     skb (the dma_addr is the direct-map CPU physical address).     */
+/*   shuangta_host_rx_add_buff(wifi 0x374d0): pre-write *data = skb,  */
+/*     zero the 36-byte header, cache-maintain the header span        */
+/*     (map TO_DEVICE then FROM_DEVICE) and publish data+4 through    */
+/*     pcie_if_hostca_to_devva -> identity window -> CPU physical.    */
+/*   hi_net_woc_skb_free(kpie 0x6aec) does not unmap (the buffer is   */
+/*     recycled through the WOC per-cpu lists); we unmap at teardown. */
+/* ------------------------------------------------------------------ */
+bool hi5622_dp_rx_woc_class(struct hi5622_pci *ctx)
+{
+    return ctx && ctx->dp &&
+           ctx->dp->rx_buf_class_used == DP_RX_CLASS_WOC;
+}
+
+static int dp_woc_rx_alloc_one(struct hi5622_pci *ctx, size_t size,
+                               void **cpu, dma_addr_t *dma,
+                               struct sk_buff **skb)
+{
+    struct device *dev = &ctx->pdev->dev;
+    struct sk_buff *s;
+    dma_addr_t d;
+    unsigned long va;
+    unsigned int misalign;
+
+    if (!cpu || !dma || !skb || size < HIL_RX_PAYLOAD_OFF)
+        return -EINVAL;
+    /* vendor: __netdev_alloc_skb(NULL, buflen + 3, GFP_ATOMIC); the extra
+     * margin below only covers the up-to-3-byte alignment shift, it does not
+     * change the device-writable span. */
+    s = __netdev_alloc_skb(NULL, (unsigned int)size + DP_RX_WOC_ALLOC_MARGIN,
+                           GFP_KERNEL);
+    if (!s)
+        return -ENOMEM;
+    misalign = (unsigned int)((unsigned long)s->data &
+                              (DP_RX_WOC_ALIGN - 1u));
+    if (misalign)
+        skb_reserve(s, DP_RX_WOC_ALIGN - misalign);
+    if (skb_tailroom(s) < (int)size) {
+        kfree_skb(s);
+        return -ENOMEM;
+    }
+    va = (unsigned long)s->data;
+    /* one held streaming mapping, exactly the vendor class: cacheable slab
+     * memory mapped DMA_FROM_DEVICE (the map invalidates the buffer lines). */
+    d = dma_map_page_attrs(dev, virt_to_page((void *)va),
+                           (size_t)offset_in_page(va), size,
+                           DMA_FROM_DEVICE, 0);
+    if (dma_mapping_error(dev, d)) {
+        kfree_skb(s);
+        return -ENOMEM;
+    }
+    if ((u64)d < (u64)DP_HOST_DMA_LO || (u64)d > (u64)DP_HOST_DMA_HI) {
+        dev_err(dev,
+                "DP: WOC RX buffer DMA address 0x%llx outside the device-visible host window 0x%08x..0x%08x - refused\n",
+                (unsigned long long)d, DP_HOST_DMA_LO, DP_HOST_DMA_HI);
+        dma_unmap_page_attrs(dev, d, size, DMA_FROM_DEVICE, 0);
+        kfree_skb(s);
+        return -ERANGE;
+    }
+    /* host word + zeroed 36-byte device header (vendor add_buff pre-write). */
+    *(u32 *)(void *)va = DP_RX_WOC_HOST_WORD;
+    memset((void *)(va + HIL_RX_SKB_WORD), 0, HIL_RX_HDR_BYTES);
+    *cpu = (void *)va;
+    *dma = d;
+    *skb = s;
+    return 0;
+}
+
+static void dp_woc_rx_free_one(struct hi5622_pci *ctx, void *cpu,
+                               dma_addr_t dma, size_t size,
+                               struct sk_buff *skb)
+{
+    struct device *dev = &ctx->pdev->dev;
+
+    dma_unmap_page_attrs(dev, dma, size, DMA_FROM_DEVICE, 0);
+    kfree_skb(skb);
+    (void)cpu;
+}
