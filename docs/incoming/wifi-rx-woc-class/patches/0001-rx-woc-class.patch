+/* Vendor per-publish preparation: scrub the host word + 36-byte device header
+ * and cache-maintain the write before the ring entry becomes visible.  The
+ * coherent class keeps the old behaviour exactly (no-op, returns 0). */
+int hi5622_dp_rx_buf_prepare(struct hi5622_pci *ctx, u32 buf_dma,
+                             unsigned int size)
+{
+    struct hi5622_dp *dp;
+    void *va = NULL;
+    unsigned int i;
+
+    if (!ctx || !ctx->dp)
+        return -ENODEV;
+    dp = ctx->dp;
+    if (dp->rx_buf_class_used != DP_RX_CLASS_WOC)
+        return 0;
+    for (i = 0; i < DP_RX_NORM_DEPTH && !va; i++)
+        if ((u32)dp->rx_norm_dma[i] == buf_dma)
+            va = dp->rx_norm_cpu[i];
+    for (i = 0; i < DP_RX_SMALL_DEPTH && !va; i++)
+        if ((u32)dp->rx_small_dma[i] == buf_dma)
+            va = dp->rx_small_cpu[i];
+    if (!va)
+        return -ENOENT;
+    *(u32 *)va = DP_RX_WOC_HOST_WORD;
+    memset((u8 *)va + HIL_RX_SKB_WORD, 0, HIL_RX_HDR_BYTES);
+    /* flush the heading pre-write (TO_DEVICE) and invalidate the lines before
+     * the device owns them (FROM_DEVICE): the vendor does both around
+     * add_buff; BIDIRECTIONAL is the single-call equivalent. */
+    dma_sync_single_for_device(&ctx->pdev->dev, (dma_addr_t)buf_dma, size,
+                               DMA_BIDIRECTIONAL);
+    dp->rx_woc_prepares++;
+    return 0;
+}
+
+/* Before the CPU parses a completed buffer, invalidate the lines the device
+ * wrote (no-op for the coherent class). */
+void hi5622_dp_rx_buf_sync_cpu(struct hi5622_pci *ctx, unsigned int ring_kind,
+                               unsigned int slot)
+{
+    struct hi5622_dp *dp;
+    dma_addr_t d;
+    size_t size;
+
+    if (!ctx || !ctx->dp)
+        return;
+    dp = ctx->dp;
+    if (dp->rx_buf_class_used != DP_RX_CLASS_WOC)
+        return;
+    if (ring_kind == 0u) {
+        if (slot >= DP_RX_NORM_DEPTH || !dp->rx_norm_skb)
+            return;
+        d = dp->rx_norm_dma[slot];
+        size = DP_RX_NORM_ALLOC;
+    } else {
+        if (slot >= DP_RX_SMALL_DEPTH || !dp->rx_small_skb)
+            return;
+        d = dp->rx_small_dma[slot];
+        size = DP_RX_SMALL_ALLOC;
+    }
+    dma_sync_single_for_cpu(&ctx->pdev->dev, d, size, DMA_FROM_DEVICE);
+    dp->rx_woc_sync_cpu++;
+}
