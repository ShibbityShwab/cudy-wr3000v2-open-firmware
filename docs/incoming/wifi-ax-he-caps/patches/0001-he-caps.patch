+ * no iftype_data at all, byte-identical behaviour to the bench-validated
+ * module; 1 = advertise the vendor-decoded HE caps on the installed bands;
+ * anything else is refused at init (-EINVAL) - never guessed. */
+unsigned int hi5622_he_caps;
+module_param_named(he_caps, hi5622_he_caps, uint, 0644);
+MODULE_PARM_DESC(he_caps,
+		 "HE (802.11ax) wiphy advertisement: 0=off (default, fail closed, no HE iftype_data), 1=vendor-decoded HE caps for the AP iftype on the installed bands (2.4GHz 40MHz / 5GHz 40+80+160MHz, 2SS MCS0-9, no PPE, no 6GHz); >1 refused at init");
+
 /* Documentation-purpose locally-administered address (02:...) - never a
