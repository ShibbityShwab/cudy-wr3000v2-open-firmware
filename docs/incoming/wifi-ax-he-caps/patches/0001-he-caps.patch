@@ -102,6 +103,19 @@
 MODULE_PARM_DESC(band5g,
 		 "5GHz band enable: 0=off (default, bench-validated 2.4 GHz per-endpoint behaviour; 5 GHz AP start fail-closed), 1=one-radio/two-band profile: the primary endpoint's wiphy carries the vendor 29-ch/HT 0x62/VHT 0x400064 5 GHz band IN ADDITION to 2.4 GHz and the secondary host view gets no wiphy; 5 GHz AP start and the H1 5 GHz band config are then allowed");
 
+/* wifi-ax-he-caps lane (task-177), FAIL-CLOSED default 0.  The shipped
