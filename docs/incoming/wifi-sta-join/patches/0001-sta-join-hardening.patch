+	resp_len = sta_get32(payload + HI5622_STA_ASSOC_OFF_RESP_IE_LEN);
+	req_va = sta_get32(payload + HI5622_STA_ASSOC_OFF_REQ_IE_VA);
+	resp_va = sta_get32(payload + HI5622_STA_ASSOC_OFF_RESP_IE_VA);
