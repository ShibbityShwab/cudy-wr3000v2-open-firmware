+	    p->ie_va & 0x3u || p->key_va & 0x3u)
+		return -EINVAL;
+	if (p->bssid_va < dma_lo || p->bssid_va > dma_hi)
+		return -ERANGE;
+	if (p->ssid_va < dma_lo || p->ssid_va > dma_hi)
+		return -ERANGE;
+	if (p->ie_va < dma_lo || p->ie_va > dma_hi)
+		return -ERANGE;
