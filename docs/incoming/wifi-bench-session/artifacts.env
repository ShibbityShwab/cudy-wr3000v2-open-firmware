# artifacts.env - artifact pins for the attended wifi-bench-session (task-127)
#
# Lane: wifi-bench-session (host-only package; the Lead fires).  This file is
# the single place artifact paths/hashes live.  Format: shell KEY=VALUE.
#
# status values:
#   <path>     host path, verified by host/check-artifacts.sh
#   pending    dependency lane has not delivered the final pin yet -> a real
#              run of that phase refuses (dry-run records DEPENDENCY-PENDING)
#
# The values below were re-verified on 2026-11-26 from the lane build trees;
# module sizes/shas are build-path dependent (debug info records the build
# dir), so the ACCEPT lists are used where a lane documented an alternate.

# ---- bench link / transport ------------------------------------------------
SSH_HOST=192.168.1.1
ENDPOINT=0000:00:00.0
SESSION_TIMEOUT=300
REBOOT_DEADLINE_S=300
REBOOT_POLL_S=4

# ---- PD4-patched vendor firmware (never committed; local evidence) ---------
FW_PD4=/tmp/hi5622-patched/FIRMWARE.PD4.bin
FW_PD4_SHA=cfe24bfb194899f362bfcb0301d7e28a3b4dce0ef4e70b705d54a1f78d3037b1
FW_PD4_SIZE=928920
FW_MANIFEST=/tmp/hi5622-patched/manifest.json
FW_MANIFEST_SHA=d89f01a7b6f1a7eeafccb1036911ac2e32bd03a0422b84d92ac60b46142c288c

# ---- PHY custom block (local evidence) -------------------------------------
WIFI_BLOCK=/tmp/blocks/wifi_block.bin
WIFI_BLOCK_SHA=0b4ef9188fc1c9160b4b30cc20be0e704dd62412cbdb25dd51ea5ffb16145b32
WIFI_BLOCK_SIZE=2472

# ---- cfg80211 userspace support (deployed to /tmp; kmods stay /tmp) --------
CFG80211_KO=/home/shibbityshwab/openwrt-lab-selectorfix-img/staging_dir/target-arm_cortex-a9_musl_eabi/root-hisilicon/lib/modules/6.18.60/cfg80211.ko
CFG80211_KO_SHA=949393f9676cc7bab18def92f1f96a07c45bd0ff599ee418c16ba7d54715170c
CFG80211_KO_SIZE=2328548
IW_BIN=/home/shibbityshwab/openwrt-lab-selectorfix-img/staging_dir/target-arm_cortex-a9_musl_eabi/root-hisilicon/usr/sbin/iw
IW_BIN_SHA=6345e1cacfd40262d9cab8f0fbb225512ad5e0401326112b717c91024dbc424d
LIBNL_TINY=/home/shibbityshwab/openwrt-lab-selectorfix-img/staging_dir/target-arm_cortex-a9_musl_eabi/root-hisilicon/usr/lib/libnl-tiny.so.1
LIBNL_TINY_SHA=5978991097c6149528f995037c98f37cfd97b2f155f97c20fda104a0892a1cb6

# ---- PHASE S: 13-channel scan (wifi-scan-complete provider) ---------------
# Preferred canonical build: 748,888 B sha256 b42ff4ec...
# The local alternate build (documented in wifi-scan-complete/BUILD-NOTES.md)
# is 748,564 B sha256 02162d4a...; both are accepted by
# SCAN_MODULE_ACCEPT (sha256:size pairs).
SCAN_MODULE=/tmp/final-check/src/hi5622_wifi.ko
SCAN_MODULE_SIZE=748564
SCAN_MODULE_SHA=02162d4a6296b8df5b3ea16824cadff45a534d4e5d6cfa77a0fed1aa8dea9744
SCAN_MODULE_ACCEPT="b42ff4ec775e7b223baefeb4a655bb925e3c88eca3560634ed87ac53029e1884:748888 02162d4a6296b8df5b3ea16824cadff45a534d4e5d6cfa77a0fed1aa8dea9744:748564"
# NOTE: scan_timeout_ms=60000 is the requested bound; the module clamps it to
# HI5622_SCAN_TIMEOUT_MAX_MS=45000 (hi5622_scan_logic.h).  At the measured
# firmware pace (~3.5 s/channel) 13 channels need ~45.5 s, so the last channel
# can be cut by the clamp.  See SESSION-PLAN.md "scan window" and GATES.md.
SCAN_PARAMS=allow_frames=16 vap_start_first=1 vap_start_mode=1 vap_start_module=0 frame_gap_ms=100 h2d_send_budget=8 scan_timeout_ms=60000
SCAN_TIMEOUT_REQUEST_MS=60000
SCAN_TIMEOUT_EFFECTIVE_MAX_MS=45000

# ---- PHASE A: AP start (wifi-ap-start provider, task-121) ------------------
AP_MODULE=/tmp/wifi-ap-start-bench-artifact/hi5622_wifi.ko
AP_MODULE_SIZE=206708
AP_MODULE_SHA=fd8e1439c7c323eae57b291fd034a647815ba5ab1ca27bedd48f83b3f9a45020
AP_PARAMS=allow_frames=16 vap_start_first=1 vap_start_mode=1 vap_start_module=0 frame_gap_ms=100 h2d_send_budget=8 ap_start_mode=0
# ap_start_mode 0 = g0 id1 static keys: the provider posts 2 frames (ap_ssid
# 0x0005 64 B -> ap_cfg 0x0127 184 B); 1 = WAL g2 order: 4 frames (ssid, auth
# 0x006D, ap_cfg, vap_start 0x0065).  The device stage gates the carrier set.
AP_START_MODE=0
# hostapd deployment (wifi-hostapd-deploy lane, task-125) ----------------
# Canonical bench path: the lane's T0 zero-flash apk-add of the four packages
# (hostapd-mini + hostapd-common + ucode-mod-nl80211 + ucode-mod-rtnl; every
# other shared lib is already in the bench image).  The install writes only
# the persistent rootfs overlay - no flash, no reboot - and MUST be run (it is
# itself attended) BEFORE this session; the phase-A reboot keeps it.
#   cd opensource/docs/incoming/wifi-hostapd-deploy
#   ./deploy-hostapd.sh --apply --attended --yes-really
# HOSTAPD_MODE=static is the fallback (push one binary; libs already on box).
HOSTAPD_MODE=apk
HOSTAPD_DEPLOY_CMD="opensource/docs/incoming/wifi-hostapd-deploy/deploy-hostapd.sh --apply --attended --yes-really"
HOSTAPD_REMOTE_BIN=/usr/sbin/hostapd
HOSTAPD_ONBOX_SHA=13cb3a4306f752f4e1638585e734cd29368ee393096b75931f89e71e01b21919
HOSTAPD_REMOTE_CONF=/root/hostapd-deploy/hostapd-open.conf
HOSTAPD_CONF_SHA=e4f6edc694adca340e08607ae00616878e91399e265543b591bd90122804e5be
HOSTAPD_PIDFILE=/root/hostapd-deploy/hostapd.pid
HOSTAPD_APK_DIR=/home/shibbityshwab/hostapd-lane-artifacts
# static-mode fallback pins (unused while HOSTAPD_MODE=apk):
HOSTAPD_BIN=pending
HOSTAPD_BIN_SHA=pending
# device-side AP start script/readback (this lane, committed)
AP_FIRE_SCRIPT=device/ap-fire.sh
AP_READBACK_SCRIPT=device/ap-readback.sh

# ---- PHASE X: first MAC data-plane TX/RX (wifi-dp-air, task-126) -----------
# Merged provider+dp module (provider base 748,888 b42ff4ec + E1 datapath +
# dp-txrx actions), canonical build path /tmp/wifi-dp-air-build; the module sha
# is build-path dependent (BUILD-NOTES.md records the canonical line).
X_MODE=cfg80211
X_MODULE=/tmp/wifi-dp-air-build/src/hi5622_wifi.ko
X_MODULE_SHA=ca32aec46dae46de536281ee4dee8d8255d6981570b61bd86b186c50c6d5b4a0
X_MODULE_SIZE=884576
# The dp-air lane's canonical one-command F-AIR ladder (committed in the bench
# tooling): boot -> ctx_create -> txq_sync72 -> iface add+link up -> one scan
# (mode-1 VAP base) -> dp_probe -> dp_setup -> 0x0320 sync -> TX posts ->
# dp_tx_status -> read-only RX capture -> packs.
X_SEQUENCE=opensource/docs/incoming/wifi-bench-tooling/tools/sequences/bringup-f-air-txrx.json
X_SEQUENCE_SHA=96354365867beaedeb77c001fed31a2afdb0d4d2edb949cd898fab2fcc8342f6
X_PARAMS=
X_BUDGET_MIN=3