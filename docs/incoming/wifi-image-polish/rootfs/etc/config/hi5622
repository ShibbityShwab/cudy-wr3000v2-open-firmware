# /etc/config/hi5622 - clean-room Hi5622V100 Wi-Fi image policy.
#
# TWO SWITCHES, ON PURPOSE:
#   hi5622.main.autoload=0  BENCH DEFAULT: nothing loads at boot.  The driver
#                           boot ladder writes the Wi-Fi chip on load, so a
#                           bench session stays attended (the operator runs
#                           /etc/init.d/hi5622-wifi start or hi5622-load).
#   hi5622.main.autoload=1  PRODUCTION-STYLE: /etc/init.d/hi5622-wifi loads
#                           cfg80211 + the driver at boot (~40 s, the ladder's
#                           fixed sleeps), then optionally starts the AP.
#   hi5622.ap.enabled=1     start hostapd on the AP VAP after the C2 ladder.
#
# Details, failure modes and the exact working incantation: INIT.md and
# PACKAGING.md in docs/incoming/wifi-image-polish/.

config driver 'main'
	# 0 = bench policy (load by hand); 1 = load at boot via rc.d S96.
	option autoload '0'
	# Vendor-derived PD4 research firmware: pushed by hand to /lib/firmware/,
	# never packaged in the image (firmware policy).
	option fw_path 'hi_wifi/FIRMWARE.PD4.bin'
	# Locally captured Wi-Fi PHY/radio custom block (0x9a8 B): never packaged.
	option wifi_block_path 'hi_wifi/wifi_block.bin'
	# H2D frame budget: 2 VAP add/notify + 4 AP-start + scan/VAP-base + spares.
	option allow_frames '16'
	option frame_gap_ms '100'
	# ctx-create + txq-sync72 + TXQ address hand-off + one spare.
	option h2d_send_budget '4'
	# Mode-1 VAP base: g0 id1 keys, posted before scan/AP (the AP start path
	# posts it itself; the once-guard prevents a duplicate).
	option vap_start_first '1'
	option vap_start_mode '1'
	option vap_start_module '0'
	# Explicit vendor 60 ms scan dwell instead of "0 = vendor default".
	option scan_dwell_ms '60'
	option hcc_poll_ms '5'
	# Run the C2 ladder (h2d_ctx_create=3 -> h2d_txq_sync72=1) after load.
	option c2_ladder '1'
	# 1 = fail the service when a gate does not come up; 0 = log and continue.
	option strict '1'
	# Seconds to wait for /sys/class/ieee80211/phy* after the module load.
	option wiphy_timeout '30'

config ap 'ap'
	# 0 = do not start an AP (bench default); 1 = after the C2 ladder.
	option enabled '0'
	option ifname 'wlan0'
	# auto = first wiphy registered by this load.
	option phy 'auto'
	# Proven interface type for this driver (iw ... type __ap).
	option type '__ap'
	# Regulatory country (e.g. US). Empty = leave the image regdomain as-is;
	# the world regdomain is NO_IR, so an AP on a real channel needs a country.
	option country ''
	option config '/etc/hi5622/hostapd-open.conf'
