+ * per-context latch cleared on user_del; this READ-ONLY readback is the
+ * fail-closed belt-and-braces gate: never post an AP frame against a zero VAP
+ * pointer.  Addresses are the bench-proven AP-start ladder readback recipe
+ * (BAR0 module-table slot 0, module-table base offset, ctx+0x190); no write. */
+#define HI5622_STAB_MODULE_TABLE_SLOT0_CPU	0x175458u /* BAR0 0x829458 */
+#define HI5622_STAB_MODULE_TABLE_BASE_CPU	0x17a504u /* BAR0 0x82a504 */
+#define HI5622_STAB_VAP_PTR_OFF			0x190u
+
+static bool hi5622_scan_vap_object_valid(struct hi5622_pci *ctx)
+{
+	u32 table, base, ctx_ca, vap;
+
+	if (!ctx || !ctx->windows_programmed)
+		return false;
+	table = hi5622_fw_ram_read(ctx, HI5622_STAB_MODULE_TABLE_SLOT0_CPU);
+	if (!table)
+		return false;
+	base = hi5622_fw_ram_read(ctx, HI5622_STAB_MODULE_TABLE_BASE_CPU);
+	ctx_ca = table + base;
+	vap = hi5622_fw_ram_read(ctx, ctx_ca + HI5622_STAB_VAP_PTR_OFF);
+	return vap != 0;
