+/* Hot-path events: per-frame H2D/D2H bookkeeping plus the periodic heartbeat.
+ * These are the lines that flooded the bench console; keep everything else
+ * (boot latch, ready, timeouts, refusals, invalid/unknown frames, exception
+ * captures) always on - those are one-shot or failure evidence. */
+static bool hcc_kernel_event_hot(enum hcc_event ev)
+{
+	switch (ev) {
+	case HCC_EVENT_TXQ_SYNC:
+	case HCC_EVENT_HEARTBEAT:
+	case HCC_EVENT_H2D_SENT:
+	case HCC_EVENT_H2D_COMPLETE:
+	case HCC_EVENT_D2H_WORD:
+	case HCC_EVENT_D2H_DISPATCH:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static void hcc_kernel_event(void *priv, enum hcc_event ev, hcc_u32 data)
 {
 	struct hcc_kernel *k = priv;
 
+	if (!k->trace && hcc_kernel_event_hot(ev))
+		return;
 	if (k->log_limit && k->logged >= k->log_limit)
 		return;
 	k->logged++;
