+/* Stability hardening (wifi-stability lane): locate the VAP slot for a netdev
+ * (the AP restart path needs the model entry for a user_add re-create). */
+static int hi5622_scan_vap_slot_of(struct hi5622_cfg80211 *c,
+				   struct net_device *dev)
+{
+	unsigned int i;
+
+	if (!c || !dev)
+		return -EINVAL;
+	for (i = 0; i < HI5622_CFG_MAX_VAPS; i++)
