+ * live firmware RAM or re-release a running CPU, and the firmware would DMA
+ * into freed host rings.  Fail closed; the only reset is a power-cycle (the
+ * project rule is "never rmmod after release"). */
+static int hi5622_transport_reload_refused(struct hi5622_pci *ctx, const char *op)
+{
+	if (!ctx->chip_booted_at_probe)
