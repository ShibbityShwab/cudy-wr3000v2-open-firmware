 #include "hi5622_vapscan_map.h"
 
 static DEFINE_MUTEX(hi5622_vapscan_lock);
@@ -124,7 +125,52 @@
 static int vapscan_parse_scan_result(const u8 *payload, u32 len,
 				     struct hi5622_scan_result *out)
 {
-	return hi5622_vapscan_parse_scan_result(payload, len, out);
+	struct hi5622_scan_d2h_bss b;
+	int rc;
+
+	if (!out)
+		return -EINVAL;
+	/* Vendor-verified g1 id15 decoder: 802.11 frame + 20-byte trailer with
+	 * a tolerant IE-chain layout probe (wifi-scan-d2h lane, task-118).
+	 * The previous guess (trim 20 from the end unconditionally) is kept as
+	 * one of the probe candidates inside the decoder. */
+	rc = hi5622_scan_d2h_parse_bss(payload, len, NULL, &b);
+	if (rc)
+		return rc;
+	memset(out, 0, sizeof(*out));
+	memcpy(out->bssid, b.bssid, sizeof(out->bssid));
+	memcpy(out->ssid, b.ssid, b.ssid_len);
+	out->ssid_len = b.ssid_len;
+	out->frame_type = (b.frame_type == HI5622_SCAN_D2H_FTYPE_PRESP) ?
+			  HI5622_SCAN_FTYPE_PRESP : HI5622_SCAN_FTYPE_BEACON;
+	out->signal_mbm = b.signal_mbm;
+	out->freq = b.freq;
+	out->capability = b.capability;
+	out->beacon_interval = b.beacon_interval;
+	out->tsf = b.tsf;
+	out->ie_len = b.ie_len;
+	memcpy(out->ie, b.ie, b.ie_len);
+	return 0;
+}
+
+static int vapscan_parse_scan_complete(const u8 *payload, u32 len,
+				       struct hi5622_scan_complete *out)
+{
+	struct hi5622_scan_d2h_complete cc;
+	int rc;
+
+	if (!out)
+		return -EINVAL;
+	/* g1 id16 hmac_scan_proc_scan_comp_event: payload[0] is the vendor
+	 * handler's status/result byte (wifi.ko .text+0x9a0ec reads it and
+	 * compares against 1).  The completion reason space is not decoded
+	 * further, so expose the raw byte and the "not success" bit. [I] */
+	rc = hi5622_scan_d2h_parse_complete(payload, len, &cc);
+	if (rc)
+		return rc;
+	out->reason = cc.status;
+	out->aborted = (cc.status != 1u) ? 1u : 0u;
+	return 0;
 }
 
