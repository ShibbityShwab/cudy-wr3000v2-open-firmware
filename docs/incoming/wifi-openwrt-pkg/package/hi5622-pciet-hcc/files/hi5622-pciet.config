# /etc/config/hi5622-pciet - Hi5622V100 clean-room bench driver policy.
#
# The init script is enabled by the package, but it does NOTHING while
# enabled='0' (the default): on a bench image the module is loaded explicitly
# as part of the attended session, never silently at boot.
#
# Enable only on an attended bench image:
#   uci set hi5622-pciet.main.enabled='1'
#   uci commit hi5622-pciet
#   /etc/init.d/hi5622-pciet start
#
# Loading the module performs probe only: host ring allocation + sysfs
# attributes; NO device write, NO firmware request, NO CPU release.

config 'hi5622-pciet' 'main'
	# 0 = never modprobe the driver at boot (default, safest).
	option 'enabled' '0'
	# Firmware-loader name RELATIVE to /lib/firmware (kernel API).
	# The vendor blob is LOCAL EVIDENCE ONLY and is not shipped by this
	# package: place the 928,920-byte image at /lib/firmware/hi_wifi/
	# FIRMWARE.bin on the bench image (or point this at another local name).
	option 'fw_path' 'hi_wifi/FIRMWARE.bin'
