+	dptx_live_read(ctx, &st, &nr, &sr, &cw);
+	pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+		"dp_rx_probe: READ-ONLY RX format survey (no register write, no ring pointer moved; rx_enable not required)\n"
+		"format: entry=4B devVA(buffer+4); device-header=36B@buffer+4; payload@buffer+0x28; host-word@buffer+0\n"
+		"  norm{alloc=0x%x dev=0x%x slots=%u} small{alloc=0x%x dev=0x%x slots=%u} cmp{slots=%u}\n",
+		DPTX_RX_NORM_ALLOC, HIL_RX_NORM_BUFLEN, HIL_RX_NORM_DEPTH,
+		DPTX_RX_SMALL_ALLOC, HIL_RX_SMALL_BUFLEN, HIL_RX_SMALL_DEPTH,
+		HIL_RX_CMP_DEPTH);
