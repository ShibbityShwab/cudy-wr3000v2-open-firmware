+/* wifi-rx-format (task-163): READ-ONLY device-write witness survey.
+
+ * This is the decisive host-side check for "the MAC RX captures nothing":
+ *  - the config format words must mirror the vendor stock dump;
+ *  - every free-ring slot must hold the devVA of one of our buffers;
+ *  - a nonzero completion-ring entry that the live cmp wptr never reported
+ *    proves the completion pointer path (not the buffer format) is broken;
+ *  - a published buffer whose 36-byte header is nonzero while its host-word
+ *    cookie is intact proves the MAC DMA'd a received frame into host memory
+ *    even if no completion / wptr / D2H event ever surfaced it.
+ * No register write, no ring pointer moved; safe before dp_rx_arm and with
+ * rx_enable=0. */
+ssize_t hi5622_dp_rx_probe_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	static const u32 cfg_offs[HIF_RX_CFG_WORDS] = {
+		0x1cu, 0x2cu, 0x30u, 0x34u, 0x38u, 0x3cu, 0x40u, 0x48u,
+	};
+	static const char *cfg_names[HIF_RX_CFG_WORDS] = {
+		"buflen", "norm_depth", "small_depth", "cmp_depth",
+		"norm_prod", "small_prod", "cmp_cons", "int_mask",
+	};
+	struct hi5622_dp_txrx *t = dptx_from_dev(dev);
+	struct hi5622_pci *ctx;
+	struct hif_rx_hdr hdr;
+	const u8 *first = NULL;
+	const char *verdict;
+	u32 st = 0xffffffffu, nr = 0xffffffffu, sr = 0xffffffffu;
+	u32 cw = 0xffffffffu, v = 0, expect = 0, posted = 0;
+	u32 cfg_bad = 0, ring_bad = 0, cmp_nonzero = 0, cmp_first = 0;
+	u32 wit = 0, untouched = 0, stale = 0, first_kind = 0, first_slot = 0;
+	unsigned int i, j;
+	int pos = 0, rc;
+
+	(void)attr;
+	if (t == NULL || t->ctx == NULL)
+		return -ENODEV;
+	ctx = t->ctx;
+	mutex_lock(&t->lock);
