+/* Re-publish one completed buffer into a free ring exactly as the vendor's
+ * shuangta_host_rx_add_buff 0x374d0 does on every add: prepare the buffer
+ * (zero the 36-byte device header, refresh the host word) BEFORE writing the
+ * entry, then write the 4-byte devVA(buffer+4) at *prod and advance the
+ * packed producer by one.  Publishing a recycled buffer without the scrub
+ * would let a stale header+0x1a length / header+0x20 sub-MSDU chain pointer
+ * survive a recycle, which the drain would then refuse (or misread). */
+static int dptx_rx_publish_one(struct hi5622_dp_txrx *t, u8 ring_kind,
+			       void *ring, u32 prod, u32 buf_dma, u32 *next)
+{
+	u8 kind = ring_kind;
+	void *cpu = NULL;
+	u32 slot = 0, entry = 0, idx, depth, alloc;
+	int rc;
+
+	if (ring == NULL || next == NULL)
+		return -EINVAL;
+	depth = (ring_kind == 0u) ? HIL_RX_NORM_DEPTH : HIL_RX_SMALL_DEPTH;
+	alloc = (ring_kind == 0u) ? DPTX_RX_NORM_ALLOC : DPTX_RX_SMALL_ALLOC;
+	idx = prod & HIL_RX_IDX_MASK;
+	if (idx >= depth)
+		return -ERANGE;
+	rc = dptx_rx_lookup_buf(t, buf_dma, &kind, &cpu, &slot);
+	if (rc)
+		return rc;
+	if (kind != ring_kind)
+		return -EINVAL;
+	rc = hif_rx_buffer_prepare((u8 *)cpu, alloc, ring_kind, slot);
+	if (rc)
+		return -EIO;
+	rc = hif_rx_entry_encode(buf_dma, &entry);
+	if (rc)
+		return -EIO;
+	((u32 *)ring)[idx] = entry;
+	*next = hi5622_rx_idx_advance(prod, depth);
+	t->rx_scrubbed++;
+	return 0;
+}
