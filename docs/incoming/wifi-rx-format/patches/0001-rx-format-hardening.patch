+/* One-time (bind) format self-check: prepare both pools, verify every
+ * just-filled free-ring slot carries the canonical entry of its buffer, and
+ * verify the MAC host-interface config words mirror the vendor stock dump
+ * (0x4004001c=0x00b0063c, +0x2c=0x100, +0x30=0x200, +0x34=0xfff,
+ * +0x38/+0x3c=0x8000, +0x40=0, +0x48=0xfffffcc1).  A mismatch fails dp_setup
+ * closed before any RX action can publish a pointer. */
+static int dptx_rx_format_selfcheck(struct hi5622_dp_txrx *t)
+{
+	static const u32 cfg_offs[HIF_RX_CFG_WORDS] = {
+		0x1cu, 0x2cu, 0x30u, 0x34u, 0x38u, 0x3cu, 0x40u, 0x48u,
+	};
+	unsigned int i, k;
+	u32 expect = 0, v;
+	int rc;
+
+	if (t->rx_norm_cpu == NULL || t->rx_small_cpu == NULL ||
+	    t->rx_norm_dma == NULL || t->rx_small_dma == NULL ||
+	    t->rx_norm_ring == NULL || t->rx_small_ring == NULL)
+		return -ENODEV;
+	for (i = 0; i < HIL_RX_NORM_DEPTH; i++) {
+		if (t->rx_norm_cpu[i] == NULL)
+			return -ENODEV;
+		rc = hif_rx_buffer_prepare((u8 *)t->rx_norm_cpu[i],
+					   DPTX_RX_NORM_ALLOC, 0u, i);
+		if (rc)
+			return -EIO;
+		t->rx_fmt_prepared++;
+	}
+	for (i = 0; i < HIL_RX_SMALL_DEPTH; i++) {
+		if (t->rx_small_cpu[i] == NULL)
+			return -ENODEV;
+		rc = hif_rx_buffer_prepare((u8 *)t->rx_small_cpu[i],
+					   DPTX_RX_SMALL_ALLOC, 1u, i);
+		if (rc)
+			return -EIO;
+		t->rx_fmt_prepared++;
+	}
+	for (i = 0; i < HIL_RX_NORM_DEPTH; i++) {
+		rc = hif_rx_entry_encode((u32)t->rx_norm_dma[i], &expect);
+		if (rc != HIF_RX_OK ||
+		    expect != ((const u32 *)t->rx_norm_ring)[i]) {
+			t->rx_fmt_bad++;
+			return -EIO;
+		}
+	}
+	for (i = 0; i < HIL_RX_SMALL_DEPTH; i++) {
+		rc = hif_rx_entry_encode((u32)t->rx_small_dma[i], &expect);
+		if (rc != HIF_RX_OK ||
+		    expect != ((const u32 *)t->rx_small_ring)[i]) {
+			t->rx_fmt_bad++;
+			return -EIO;
+		}
+	}
+	for (k = 0; k < HIF_RX_CFG_WORDS; k++) {
+		rc = hif_rx_cfg_expect(cfg_offs[k], &expect);
+		if (rc != 1)
+			return -EIO;
+		v = dptx_mac_read(t->ctx, cfg_offs[k]);
+		if (v != expect) {
+			t->rx_fmt_bad++;
+			return -ERANGE;
+		}
+	}
+	return 0;
+}
