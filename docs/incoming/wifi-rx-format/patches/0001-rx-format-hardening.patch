+					   HIL_RX_SMALL_BUFLEN, &hdr);
+		if (rc == HIF_RX_OK) {
+			pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+				" len=%u next=0x%08x status=0x%02x submsdu=%u fctrl=0x%04x ppdu=0x%08x",
+				hdr.payload_len, hdr.next_devva, hdr.status,
+				hdr.submsdu_num, hdr.fctrl, hdr.ppdu_devva);
+			pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+				" payload[0..15]=");
+			for (j = 0; j < 16u; j++)
+				pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+						 "%02x", first[HIL_RX_PAYLOAD_OFF + j]);
+		} else {
+			pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+				" header-parse=0x%x", rc);
+		}
+		pos += scnprintf(buf + pos, PAGE_SIZE - pos, "\n");
+	}
+	if (cfg_bad != 0u || ring_bad != 0u)
+		verdict = "FORMAT-SETUP-MISMATCH (fix the config/ring before reading any capture result)";
+	else if (wit != 0u)
+		verdict = "DEVICE-WROTE-FRAMES (a received frame WAS DMA'd into host memory: the capture gap is the completion/report pointer path, not the entry/header format)";
+	else if (cmp_nonzero != 0u)
+		verdict = "COMPLETION-ENTRIES-NONZERO-BUT-NO-FRAME-HEADER (completion path wrote entries; no received frame reached a buffer)";
+	else
+		verdict = "MAC-WROTE-NOTHING (rings armed, config mirrored, no received frame has been DMA'd into host buffers in this load)";
+	pos += scnprintf(buf + pos, PAGE_SIZE - pos, "verdict: %s\n", verdict);
+	mutex_unlock(&t->lock);
+	return pos;
+}
