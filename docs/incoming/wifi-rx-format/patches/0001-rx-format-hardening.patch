+/* wifi-rx-format (task-163): find the pool buffer a DMA address belongs to.
+ * The completion entry is devVA(buffer+4), so lookups are on the decoded
+ * buffer DMA address.  Bounded (256 + 512 compares); sysfs-triggered path
+ * only. */
+static int dptx_rx_lookup_buf(struct hi5622_dp_txrx *t, u32 buf_dma,
+			      u8 *ring_kind, void **cpu, u32 *slot)
+{
+	unsigned int i;
+
+	if (ring_kind == NULL || cpu == NULL || slot == NULL)
+		return -EINVAL;
+	if (t->rx_norm_dma != NULL && t->rx_norm_cpu != NULL) {
+		for (i = 0; i < HIL_RX_NORM_DEPTH; i++) {
+			if (t->rx_norm_cpu[i] == NULL)
+				continue;
+			if ((u32)t->rx_norm_dma[i] != buf_dma)
+				continue;
+			*ring_kind = 0u;
+			*cpu = t->rx_norm_cpu[i];
+			*slot = i;
+			return 0;
+		}
+	}
+	if (t->rx_small_dma != NULL && t->rx_small_cpu != NULL) {
+		for (i = 0; i < HIL_RX_SMALL_DEPTH; i++) {
+			if (t->rx_small_cpu[i] == NULL)
+				continue;
+			if ((u32)t->rx_small_dma[i] != buf_dma)
+				continue;
+			*ring_kind = 1u;
+			*cpu = t->rx_small_cpu[i];
+			*slot = i;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
