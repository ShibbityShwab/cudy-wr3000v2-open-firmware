 /* ------------------------------------------------------------------ */
+/* wifi-ap-mgmt lane (task-143): WAL cfg-event mgmt-tx carrier         */
+/* ------------------------------------------------------------------ */
+/* Vendor cfg80211 .mgmt_tx (wal_cfg80211_mgmt_tx -> wal_mgmt_do_tx) emits
+ * ONE WAL cfg-event TLV: HCC group2 id0, WAL id 1, cmd 0x01F2, 12-byte body
+ * {channel, cookie idx, pad, len, device-visible frame address}.  The frame
+ * bytes are NOT in the message; the kernel half copies them into its coherent
+ * DMA buffer and passes that device-visible address.  The command is added to
+ * the h2d_frames WAL cfg-event allowlist so hi5622_frame_post() keeps its
+ * fail-closed envelope/size validation. */
+static int vapscan_mgmt_tx(u8 *wire, size_t cap, size_t *out_len,
+			   const struct hi5622_mgmt_tx_params *p)
+{
+	struct himg_tx_params hp;
+	int rc;
+
+	if (!wire || !out_len || !p)
+		return -EINVAL;
+	memset(&hp, 0, sizeof(hp));
+	hp.channel = p->channel;
+	hp.cookie_idx = p->cookie_idx;
+	hp.len = p->len;
+	hp.frame_addr = p->frame_devaddr;
+	hp.seq = p->seq;
+	hp.dst = p->dst & 0x0fu;
+	rc = himg_build_wal_mgmt_tx(wire, cap, out_len, &hp);
+	if (rc)
+		return rc;
+	return 0;
+}
+
