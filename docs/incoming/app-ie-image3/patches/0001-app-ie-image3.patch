+/* lane wifi-app-ie (task-234), rebased onto the IMAGE #3 merged tree by lane
+ * app-ie-rebase (task-235), FAIL-CLOSED default 0.  The H2D g0 id 0x20
+ * app/vendor IE set (the vendor builder CA 0x600cc): the firmware handler
+ * (CA 0x85631) stores a per-VAP IE blob in the slot table
+ * vap+0x24c+20*type the firmware frame builders read (sibling lane TABLES
+ * T3/T4).  The driver collects the cfg80211 vendor IEs (element id 0xDD)
+ * that hostapd delivered through start_ap()'s cfg80211_beacon_data (beacon
+ * tail / beacon_ies / proberesp_ies / assocresp_ies) and posts ONE 0x20
+ * frame at the end of the beacon_static AP-start ladder, after the image #3
+ * lineage's single VAP-start step.
+ *   app_ie=0 (default) = no frame at all - current behaviour, byte-identical;
+ *   app_ie=1 = post the frame after the 'ap_vap_start' step (the VAP start
+ *              must exist: beacon_vap_start=1 or a carrier-owned start), on a
+ *              beacon_static AP start only; needs a non-empty vendor-IE list;
+ *   app_ie>1 = refused at use time BEFORE any frame (fail closed).
+ * app_ie_type = the firmware per-VAP IE class (0..19; 4 = the class the stock
+ * capture cleared, T6 - an explicit parameter, never a guess in code).
+ * One meaning per module load; read-only. */
+static unsigned int hi5622_app_ie;
+module_param_named(app_ie, hi5622_app_ie, uint, 0444);
+MODULE_PARM_DESC(app_ie,
+		 "app/vendor IE injection (H2D g0 id 0x20): 0=off default, 1=post the cfg80211 vendor-IE list at the end of the beacon_static AP start (needs a posted VAP start and a non-empty 0xDD list), >1 refused");
+/* The bounded wait before the read-only slot read-back.  The task-234
+ * integration used the R5 tree's HI5622_VAP_START_G0_WAIT_MS (300 ms); this
+ * tree has no such constant, so the same value is kept local here.  The wait
+ * is diagnostic only (the frame is already posted): it gives the firmware
+ * time to consume the 0x20 message before the slot is read. */
+#define HI5622_APP_IE_WAIT_MS		300u
+#define HI5622_APP_IE_TYPE_DEFAULT	4u	/* stock-observed class [I] */
+static unsigned int hi5622_app_ie_type = HI5622_APP_IE_TYPE_DEFAULT;
+module_param_named(app_ie_type, hi5622_app_ie_type, uint, 0444);
+MODULE_PARM_DESC(app_ie_type,
+		 "firmware per-VAP IE class for app_ie (0..19; default 4 = the stock-observed class; >19 refused)");
+static int hi5622_app_ie_last_rc = -ENODATA;	/* never attempted */
+static unsigned int hi5622_app_ie_posts;
+static unsigned int hi5622_app_ie_refusals;
+static unsigned int hi5622_app_ie_ie_len;
+static unsigned int hi5622_app_ie_vendor_ies;
+/* The IMAGE #3 lineage has ONE VAP-start step (the plan's 'ap_vap_start'):
+ * it is posted either explicitly (beacon_vap_start=1, ap_start_mode=0) or by
+ * the WAL carrier sequence (ap_start_mode!=0).  This is the "a VAP has been
+ * started" condition the app-IE gate needs - the rebased equivalent of the
+ * R5 tree's vap_start_g0=1 requirement (see ../REPORT.md). */
+static unsigned int hi5622_app_ie_vap_start_ok(void)
+{
+	return (hi5622_beacon_vap_start || hi5622_ap_start_mode != 0u) ? 1u : 0u;
+}
