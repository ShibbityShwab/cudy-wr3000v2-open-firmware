+/* ------------------------------------------------------------------ */
+/* wifi-data-tx (task-150): peer-aware data TX through the proven ring */
+/* ------------------------------------------------------------------ */
+int hi5622_dp_tx_data_post(struct hi5622_pci *ctx, u32 buf_devva,
+			   u16 frame_len, u8 vap_type, u8 tid, u8 hdr_flag,
+			   u32 *published_wptr, u32 *dev_rptr)
+{
+	struct hi5622_dp_txrx *t;
+	dp_u8 entry[DP_TXRX_TXE_BYTES];
+	u32 d[3] = { 0u, 0u, 0u };
+	u32 index, prev, next = 0, ring_devva = 0, entry_addr;
+	unsigned long txflags;
+	int rc;
+
+	if (!ctx || !published_wptr || tid >= DP_TXRX_TABLE_TIDS)
+		return -EINVAL;
+	t = ctx->dptx;
+	if (!t)
+		return -ENODEV;
+	rc = dp_txrx_txe_encode(entry, buf_devva, frame_len, 0u, hdr_flag,
+				tid, vap_type);
+	if (rc != DP_TXRX_OK)
+		return -EINVAL;
+
+	spin_lock_irqsave(&t->tx_post_lock, txflags);
+	if (!t->bound || t->failed || !t->tx_msdu_rings) {
+		rc = -ENODEV;
+		goto out;
+	}
+	rc = dptx_write_gate(ctx);
+	if (rc)
+		goto out;
+	index = t->tx_tid_wptr[tid] & 0x7fffu;
+	if (index >= DP_TXRX_TX_RING_DEPTH) {
+		t->failed = true;
+		rc = -EIO;
+		goto out;
+	}
+	entry_addr = (u32)(unsigned long)t->tx_msdu_rings +
+		     tid * DP_TXRX_TX_RING_BYTES +
+		     index * DP_TXRX_TXE_BYTES;
+	memcpy((void *)(unsigned long)entry_addr, entry, DP_TXRX_TXE_BYTES);
+	dma_wmb();
+	ring_devva = dp_tx_ring_devva(t->tx_msdu_rings_dma, tid);
+	prev = t->tx_tid_wptr[tid];
+	next = dp_txrx_idx_next(prev, DP_TXRX_TX_RING_DEPTH);
+	rc = dptx_table_publish(t, tid, next, ring_devva, d);
+	if (rc) {
+		dev_err(&ctx->pdev->dev,
+			"data_tx: MSDU table write read-back FAILED (rc %d) - TX lane closed for this load, no retry\n",
+			rc);
+		t->failed = true;
+		rc = -EIO;
+		goto out;
+	}
+	t->tx_tid_wptr[tid] = next;
+	t->tx_wptr = next;
+	t->tx_completion_rptr = d[2];
+	t->tx_tid_count[tid]++;
+	t->tx_tid_bytes[tid] += (u32)frame_len;
+	t->tx_tid_sn[tid] = (u16)(t->tx_tid_count[tid] & 0x0fffu);
+	/* vendor enqueue-tail order: ring push, then the per-TID TXQ-table
+	 * queue state (hmac_update_user_tid_txq_table) [V*] */
+	if (dptx_txq_publish_en && t->txq_table) {
+		dma_wmb();
+		dp_txrx_txq_publish(t->txq_table, DP_TXRX_TX_USER_DEFAULT, tid,
+				    t->tx_tid_count[tid],
+				    (dp_u32)t->tx_tid_sn[tid], true,
+				    t->tx_tid_bytes[tid],
+				    (dp_u16)jiffies_to_msecs(jiffies));
+		dma_wmb();
+		t->txq_published = true;
+		t->txq_publish_count++;
+	}
+	*published_wptr = next;
+	if (dev_rptr)
+		*dev_rptr = d[2];
+	rc = 0;
+out:
+	spin_unlock_irqrestore(&t->tx_post_lock, txflags);
+	return rc;
+}
