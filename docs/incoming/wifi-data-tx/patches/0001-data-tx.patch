+int hi5622_dp_tx_data_poll(struct hi5622_pci *ctx, u8 tid,
+			   u32 *published_wptr, u32 *dev_rptr)
+{
+	struct hi5622_dp_txrx *t;
+	u32 d[3] = { 0u, 0u, 0u };
+	unsigned long txflags;
+	int rc;
+
+	if (!ctx || !dev_rptr || tid >= DP_TXRX_TABLE_TIDS)
+		return -EINVAL;
+	t = ctx->dptx;
+	if (!t)
+		return -ENODEV;
+	spin_lock_irqsave(&t->tx_post_lock, txflags);
+	if (!t->bound) {
+		rc = -ENODEV;
+		goto out;
+	}
+	rc = dptx_table_snapshot_tid(t, tid, d);
+	if (rc) {
+		rc = -EIO;
+		goto out;
+	}
+	if (published_wptr)
+		*published_wptr = d[1];
+	*dev_rptr = d[2];
+	rc = 0;
+out:
+	spin_unlock_irqrestore(&t->tx_post_lock, txflags);
+	return rc;
+}
