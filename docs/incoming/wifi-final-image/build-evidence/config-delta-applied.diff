+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Kernel-config carry-over for the bench image build (wifi-image-integration).
+#
+# APPENDED to $OWRT/.config AFTER "make defconfig", on purpose. The
+# release-line bench .config carries this override, but it has no
+# config/Config-kernel.in menu entry, so OpenWrt's defconfig drops it as an
+# unknown symbol. include/kernel-defaults.mk then maps every CONFIG_KERNEL_*
+# line in .config to the kernel's CONFIG_* symbol, so dropping it silently
+# changes the kernel build:
+#
+#   release-line .config (pre-build, current state of the shared tree):
+#       CONFIG_KERNEL_HOTPLUG_CPU=y     (appended after the generated config)
+#       -> kernel CONFIG_HOTPLUG_CPU=y  (as in the hardware-validated slice)
+#   defconfig-normalized .config:
+#       (line dropped) -> kernel CONFIG_HOTPLUG_CPU remains unset
+#       (generic/config-6.18 line 2719)
+#
+# Consequence measured on the first build attempt of this lane: the kernel was
+# rebuilt with CONFIG_HOTPLUG_CPU unset and produced a NEW kernel slice
+# (3,369,166 B sha256 853ac764..., replacing the hardware-validated
+# 3,372,638 B sha256 13e81214...). Carrying the override over reproduces the
+# validated slice, so the bench image needs no kernel write at deploy time.
+#
+# Do not "fix" this by editing target/linux/generic/config-6.18 here: that file
+# belongs to the release line / other lanes. This lane only appends to the
+# build .config and documents why.
 CONFIG_KERNEL_HOTPLUG_CPU=y
