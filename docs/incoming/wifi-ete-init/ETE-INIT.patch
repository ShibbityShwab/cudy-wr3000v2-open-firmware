 /* ---------------------------------------------------------------------
+ * 3a. ETE init-time register set recovered from the vendor platform module
+ *     hi5622v100_plat.ko (pcie_ete_*; byte-identical in 2.5.24 and 2.4.15) [V]
+ *
+ * The vendor host driver's complete ETE init writes are (in order):
+ *   1. CA 0x40039508: read-modify-write AND 0xffe0f8f8 in pcie_ete_intr_init
+ *      (the host-facing ETE interrupt word; one shot, before any ring arm);
+ *   2. SR0-2 group A: +0x10 base store, +0x14 depth-1 (bfi 0..9), +0x18
+ *      producer store, +0x08 ctrl bits 0..2 (bfi) — upper bits preserved;
+ *      the SR send word hi16 is READ first and only logged when non-zero;
+ *   3. DR0-3 group B: +0x30 base store, +0x34 depth-1 (bfi 0..9), +0x38
+ *      published index store.
+ *
+ * The per-channel send/flag words live at ETE + 0xC00 + 4i (DR0..DR3) and
+ * ETE + 0xC18 + 4i (SR0..SR2).  The host driver ONLY READS them: high16 =
+ * target send index, low16 = device progress index, both packed ring indices
+ * (low 10 bits idx, bit 10 wrap phase).  They are device/hardware-authored
+ * state — the golden 0x04050405 / 0x040E040E capture is boot traffic
+ * (1029 / 1038 nodes), NOT an init value, and the host must not write them.
+ * ------------------------------------------------------------------- */
+#define HI5622_CA_ETE_STATUS	0x4003a874u	/* ETE status word [V] */
+#define HI5622_ETE_INTR_KEEP	0xffe0f8f8u	/* vendor pcie_ete_intr_init mask [V] */
+#define HI5622_ETE_SEND_DR0	0xc00u		/* DR send/flag word, +4i [V] */
+#define HI5622_ETE_SEND_SR0	0xc18u		/* SR send/flag word, +4i [V] */
+#define HI5622_ETE_SEND_STRIDE	4u
