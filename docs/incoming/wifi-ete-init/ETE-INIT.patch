+
+	if (!ctx || !ctx->b3)
+		return -ENODEV;
+	b3 = ctx->b3;
+	b3_build_ete_send(ctx, b3->ete_send_result,
+			  sizeof(b3->ete_send_result));
+	return sysfs_emit(buf, "%s", b3->ete_send_result);
