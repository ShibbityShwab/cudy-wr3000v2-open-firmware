+/* ---------------------------------------------------------------------
+ * Vendor ETE init-time host writes and the device-authored send words [V]
+ *
+ * Recovered from hi5622v100_plat.ko (2.5.24; the pcie_ete_* init functions are
+ * byte-identical in 2.4.15).  The vendor ETE init order is:
+ *   pcie_ete_init -> pcie_ete_intr_init    CA 0x40039508 &= 0xffe0f8f8
+ *                 -> pcie_ete_rings_init   SR0-2 group A, DR0-3 group B
+ *                 -> pcie_ete_chn_res      vendor pcie-channel LRES, not ETE
+ * The +0xC00+4i (DR) / +0xC18+4i (SR) send/flag words are NEVER written by
+ * the host: the init paths only store their KVA in the ring context and every
+ * access is a read (debug logs, the SR "already sending" check, the TX-done
+ * progress read).  They are device/hardware-authored state: hi16 = target
+ * send index, low16 = device progress index, both packed ring indices (low 10
+ * bits idx, bit 10 wrap phase).  The golden 0x04050405/0x040E040E capture is
+ * boot traffic (1029/1038 nodes), not an init value; nothing may be seeded
+ * there from the host.
+ * ------------------------------------------------------------------- */
+static u32 b3_ete_read(struct hi5622_pci *ctx, u32 chan_off, u32 reg_off)
+{
+	return readl(ctx->bar0 + HI5622_BAR0_ETE_BASE + chan_off + reg_off);
+}
+
+/* Vendor pcie_ete_init_dst_ring/src_ring: +0xC00 / +0xC18 send word, +4i. */
+static u32 b3_ete_send_word(struct hi5622_pci *ctx, bool dr, u32 i)
+{
+	u32 ca = HI5622_CA_ETE_BASE +
+		 (dr ? HI5622_ETE_SEND_DR0 : HI5622_ETE_SEND_SR0) +
+		 i * HI5622_ETE_SEND_STRIDE;
+
+	return readl(ctx->bar0 + HI5622_BAR0_IO(ca));
+}
+
+/* Vendor pcie_ete_intr_init: a single read-modify-write of the ETE
+ * interrupt word.  It is the host-facing receive mask (the firmware never
+ * reads it), applied before any ring is armed in the vendor boot. */
+static void b3_ete_intr_init(struct hi5622_pci *ctx)
+{
+	struct hi5622_b3 *b3 = ctx->b3;
+	struct device *dev = &ctx->pdev->dev;
+	u32 off = HI5622_BAR0_IO(HI5622_CA_ETE_INTR);
+	u32 before, after, rb;
+
+	before = readl(ctx->bar0 + off);
+	after = before & HI5622_ETE_INTR_KEEP;
+	b3_writel(ctx, off, after);
+	wmb();
+	rb = readl(ctx->bar0 + off);
+	b3->ete_intr_masked = (rb == after);
+	dev_info(dev, "B3 P0: ETE intr CA 0x%08x 0x%08x -> 0x%08x (vendor pcie_ete_intr_init AND 0x%08x) readback=0x%08x %s\n",
+		 HI5622_CA_ETE_INTR, before, after, HI5622_ETE_INTR_KEEP, rb,
+		 b3->ete_intr_masked ? "OK" : "MISMATCH");
+}
+
+/* Vendor writes depth-1 as a bfi(0,10) bitfield: preserve the upper bits. */
+static void b3_ete_depth_init(struct hi5622_pci *ctx, u32 chan_off, u32 reg_off,
+			      u32 depth)
+{
+	void __iomem *reg = ctx->bar0 + HI5622_BAR0_ETE_BASE + chan_off + reg_off;
+	u32 v = readl(reg);
+
+	v = (v & ~B3_IDX_LOW_MASK) | ((depth - 1) & B3_IDX_LOW_MASK);
+	writel(v, reg);
+}
+
+/* Vendor writes SR ctrl as a bfi(0,3) bitfield: preserve the upper bits. */
+static void b3_ete_ctrl_init(struct hi5622_pci *ctx, u32 chan_off, u32 val)
+{
+	void __iomem *reg = ctx->bar0 + HI5622_BAR0_ETE_BASE + chan_off +
+			    HI5622_ETE_CH_CTRL;
+	u32 v = readl(reg);
+
+	v = (v & ~0x7u) | (val & 0x7u);
+	writel(v, reg);
+}
+
+/* P0 baseline for the read-only b3_ete_send watch. */
+static void b3_ete_send_baseline(struct hi5622_pci *ctx)
+{
+	struct hi5622_b3 *b3 = ctx->b3;
+	u32 i;
+
+	for (i = 0; i < HI5622_B3_DR_COUNT; i++) {
+		b3->send_at_arm[i] = b3_ete_send_word(ctx, true, i);
+		b3->fill_at_arm[i] = b3_ete_read(ctx, b3->dr[i].chan_off,
+						HI5622_ETE_CH_B_CNS);
+	}
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++)
+		b3->send_at_arm[HI5622_B3_DR_COUNT + i] =
+			b3_ete_send_word(ctx, false, i);
+}
+
+/* Format the ETE send/flag words plus the firmware-owned DR source-ring state
+ * (read-only bench observable).  This function performs no device writes. */
+static void b3_build_ete_send(struct hi5622_pci *ctx, char *buf, size_t size)
+{
+	struct hi5622_b3 *b3 = ctx->b3;
+	struct b3_out o;
+	bool any_nonzero = false;
+	bool fw_dr_ready = false;
+	u32 i;
+
+	b3_out_init(&o, buf, size);
+	b3_out_printf(&o, "ETE send/flag watch (host-write-free block: DR CA 0x4003AC00+4i, SR CA 0x4003AC18+4i)\n");
+	b3_out_printf(&o, "intr CA 0x%08x=0x%08x vendor-mask 0x%08x %s | status CA 0x%08x=0x%08x\n",
+		      HI5622_CA_ETE_INTR,
+		      readl(ctx->bar0 + HI5622_BAR0_IO(HI5622_CA_ETE_INTR)),
+		      HI5622_ETE_INTR_KEEP,
+		      b3->ete_intr_masked ? "applied" : "NOT-applied",
+		      HI5622_CA_ETE_STATUS,
+		      readl(ctx->bar0 + HI5622_BAR0_IO(HI5622_CA_ETE_STATUS)));
+
+	for (i = 0; i < HI5622_B3_DR_COUNT; i++) {
+		struct hi5622_ete_ring *r = &b3->dr[i];
+		u32 send = b3_ete_send_word(ctx, true, i);
+		u32 fill = b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_B_CNS);
+		u32 en = b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_ENABLE);
+		u32 ga = b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_BASE);
+		u32 adv = b3_idx_count(b3->fill_at_arm[i], fill, r->depth);
+
+		if (send)
+			any_nonzero = true;
+		if (ga && (en & 0x1u))
+			fw_dr_ready = true;
+		b3_out_printf(&o,
+			      "DR%u ch=0x%03x send=0x%08x hi16(target)=0x%04x lo16(progress)=0x%04x sync=%d | fw groupA base=0x%08x depth-1=0x%02x prod=0x%08x cons=0x%08x enable=0x%08x | host groupB base=0x%08x depth-1=0x%02x pub=0x%08x fill=0x%04x advance=%u\n",
+			      i, r->chan_off, send, send >> 16, send & 0xffffu,
+			      (send >> 16) == (send & 0xffffu) ? 1 : 0,
+			      ga,
+			      b3_ete_read(ctx, r->chan_off,
+					  HI5622_ETE_CH_A_DEPTH) & B3_IDX_LOW_MASK,
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_PRD),
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_CNS),
+			      en,
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_B_BASE),
+			      b3_ete_read(ctx, r->chan_off,
+					  HI5622_ETE_CH_B_DEPTH) & B3_IDX_LOW_MASK,
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_B_PRD),
+			      fill & 0xffffu, adv);
+	}
+	for (i = 0; i < HI5622_B3_SR_COUNT; i++) {
+		struct hi5622_ete_ring *r = &b3->sr[i];
+		u32 send = b3_ete_send_word(ctx, false, i);
+
+		if (send)
+			any_nonzero = true;
+		b3_out_printf(&o,
+			      "SR%u ch=0x%03x send=0x%08x hi16=0x%04x lo16=0x%04x sync=%d | groupA base=0x%08x depth-1=0x%02x prod=0x%08x cons=0x%08x enable=0x%08x\n",
+			      i, r->chan_off, send, send >> 16, send & 0xffffu,
+			      (send >> 16) == (send & 0xffffu) ? 1 : 0,
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_BASE),
+			      b3_ete_read(ctx, r->chan_off,
+					  HI5622_ETE_CH_A_DEPTH) & B3_IDX_LOW_MASK,
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_PRD),
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_A_CNS),
+			      b3_ete_read(ctx, r->chan_off, HI5622_ETE_CH_ENABLE));
+	}
+	b3_out_printf(&o, "host send-index writes performed: 0 (device-authored block; the vendor host never writes it)\n");
+	if (any_nonzero)
+		b3_out_printf(&o, "verdict: at least one send word is NON-ZERO -> the device firmware/engine has pumped nodes on an ETE ring\n");
+	else
+		b3_out_printf(&o, "verdict: all send words ZERO -> the device engine has not transferred anything (upstream of any host ETE register write)\n");
+	if (!fw_dr_ready)
+		b3_out_printf(&o, "fallback: firmware DR source rings unconfigured (groupA base==0 or enable bit0==0 on every DR channel) -> firmware pcie_msg_init / DR bring-up has not run; no host-side ETE init write can substitute (see REPORT.md sec 6)\n");
+	b3_out_finish(&o);
+}
