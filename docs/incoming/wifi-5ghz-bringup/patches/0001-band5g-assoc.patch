 /* ---------------------------------------------------------------------
  * Module parameters (host-only bench experiments; defaults are the safe
@@ -82,6 +83,18 @@
 MODULE_PARM_DESC(band_vendor,
 		 "use the vendor band tables instead of the shipped lists (2.4 GHz ch1-14, 5 GHz 29 channels incl. ch144 and the 4.9 GHz block; 0=off default)");
 
+/* wifi-5ghz lane (task-145, host-only static RE): one switch for the complete
+ * 5 GHz profile on the 5 GHz endpoint wiphy - vendor 29-channel table (ch144 +
+ * 4.9 GHz block), HT cap 0x0062 (20/40+SGI), VHT cap 0x00400064 (160 MHz) with
+ * the 2-SS MCS map - and the fail-closed gate for the 5 GHz AP-start path
+ * (channel config 0x0124 + H1 band config g0 id10 validate against the vendor
+ * tables; 5 GHz AP start is refused while this is 0).  The explicit ht_mode /
+ * vht_cap / band_vendor parameters still take precedence when set. */
+unsigned int hi5622_band5g;
+module_param_named(band5g, hi5622_band5g, uint, 0644);
+MODULE_PARM_DESC(band5g,
+		 "5GHz band enable: 0=off (default, bench-validated 2.4 GHz behaviour; 5 GHz AP start fail-closed), 1=register the 5 GHz endpoint with the vendor 29-ch/HT 0x62/VHT 0x400064 profile and allow 5 GHz AP start");
+
 /* Documentation-purpose locally-administered address (02:...) - never a
  * per-unit MAC; each VAP derives its own last byte from the slot. */
 static const u8 hi5622_cfg11_perm_addr[ETH_ALEN] = {
@@ -311,6 +324,43 @@
 	return 0;
 }
 
+/* wifi-5ghz lane (task-145): 5 GHz wiphy channel array from the lane's
+ * decoded vendor table (29 channels: 36..64, 100..144, 149..165 and the
+ * 4.9 GHz block 184..196).  The kernel regdb still owns availability. */
+static int hi5622_cfg11_band5g_channels(u8 band,
+					struct ieee80211_channel **out,
+					unsigned int *out_n)
+{
+	const struct hi5622_band5g_chan *tbl;
+	struct ieee80211_channel *ch;
+	u16 cnt = 0, i;
+
+	if (!out || !out_n)
+		return -EINVAL;
+	tbl = hi5622_band5g_channels(band, &cnt);
+	if (!tbl || !cnt)
+		return -EINVAL;
+	ch = kcalloc(cnt, sizeof(*ch), GFP_KERNEL);
+	if (!ch)
+		return -ENOMEM;
+	for (i = 0; i < cnt; i++) {
+		ch[i].band = band == HI5622_BAND_2GHZ ? NL80211_BAND_2GHZ :
+							NL80211_BAND_5GHZ;
+		ch[i].center_freq = tbl[i].freq;
+		ch[i].hw_value = tbl[i].num;
+		ch[i].max_power = hi5622_band5g_max_power(band);
+		if (tbl[i].flags & HI5622_BAND5G_CHAN_NO_IR)
+			ch[i].flags |= IEEE80211_CHAN_NO_IR;
+		if (tbl[i].flags & HI5622_BAND5G_CHAN_RADAR) {
+			ch[i].flags |= IEEE80211_CHAN_RADAR;
+			ch[i].flags |= IEEE80211_CHAN_NO_IR;
+		}
+	}
+	*out = ch;
+	*out_n = cnt;
+	return 0;
+}
+
 /* Copy the static capability templates into the wiphy (cfg80211's
  * regulatory core modifies the channel arrays, so two wiphys must never
  * share them). */
@@ -350,20 +400,34 @@
 		sband->ht_cap.cap = hi5622_sta_ht_cap_word(hi5622_ht_mode);
