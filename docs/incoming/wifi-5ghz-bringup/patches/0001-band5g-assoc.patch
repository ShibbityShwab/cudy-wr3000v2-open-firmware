 		sband->vht_cap.vht_mcs.rx_highest = 0;
 		sband->vht_cap.vht_mcs.tx_highest = 0;
 		sband->vht_cap.vht_mcs.rx_mcs_map = HI5622_STA_VHT_MCS_MAP;
