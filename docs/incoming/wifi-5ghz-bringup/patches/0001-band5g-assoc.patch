 	}
-	if (hi5622_band_vendor) {
+	if (hi5622_band_vendor ||
+	    (hi5622_band5g && band_idx == NL80211_BAND_5GHZ)) {
 		struct ieee80211_channel *vchans = NULL;
 		unsigned int vn = 0;
 
