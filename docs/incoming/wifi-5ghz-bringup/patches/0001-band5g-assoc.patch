diff -ruN a/hi5622_band5g.c b/hi5622_band5g.c
--- a/hi5622_band5g.c	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_band5g.c	2026-11-25 12:39:05.509522537 +0700
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hi5622_band5g.c - 5 GHz band-enable / band-config helpers (clean-room).
+ *
+ * See hi5622_band5g.h for the design and ../REPORT.md for the evidence.
+ * The tables are the vendor's static band tables, decoded from:
+ *   host module  g_ast_channel_list_2G / g_ast_channel_list_5G
+ *                (.data+0x3b8 / .data+0x3f0, 4-byte entries {u8 chan; u8 0xff})
+ *                g_ast_freq_map_2g / g_ast_freq_map_5g
+ *                (.rodata+0x918 / .rodata+0x8a4, 4-byte {u16 freq; u8 chan})
+ *   firmware     CA 0x117B48 / CA 0x117AD4 (same 14/29 channel numbers),
+ *                validator CA 0x10172C, H1 handler CA 0x5FF64.
+ */
+#include "hi5622_band5g.h"
+
+#ifdef __KERNEL__
+#include <linux/string.h>
+#else
+#include <string.h>
+#endif
+
+/* 2.4 GHz: 14 channels, 2412..2472 + 2484 (ch14).  Flags 0: the kernel
+ * regulatory core owns the restrictions on this band (same policy as the
+ * bench-validated driver). */
+static const struct hi5622_band5g_chan hi5622_band5g_2g[] = {
+	{ 2412,  1,  0 }, { 2417,  2,  0 }, { 2422,  3,  0 },
+	{ 2427,  4,  0 }, { 2432,  5,  0 }, { 2437,  6,  0 },
+	{ 2442,  7,  0 }, { 2447,  8,  0 }, { 2452,  9,  0 },
+	{ 2457, 10,  0 }, { 2462, 11,  0 }, { 2467, 12,  0 },
+	{ 2472, 13,  0 }, { 2484, 14,  0 },
+};
+
+/* 5 GHz: 29 channels in the vendor table order (index 0..28):
+ * 36 40 44 48 | 52 56 60 64 | 100..140 | 144 | 149 153 157 161 165 |
+ * 184 188 192 196.  DFS channels carry RADAR|NO_IR (the kernel regdb still
+ * decides); the 4.9 GHz block is passive-only. */
+static const struct hi5622_band5g_chan hi5622_band5g_5g[] = {
+	{ 5180,  36, 0 },
+	{ 5200,  40, 0 },
+	{ 5220,  44, 0 },
+	{ 5240,  48, 0 },
+	{ 5260,  52, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5280,  56, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5300,  60, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5320,  64, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5500, 100, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5520, 104, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5540, 108, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5560, 112, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5580, 116, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5600, 120, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5620, 124, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5640, 128, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5660, 132, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5680, 136, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5700, 140, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5720, 144, HI5622_BAND5G_CHAN_RADAR | HI5622_BAND5G_CHAN_NO_IR },
+	{ 5745, 149, 0 },
+	{ 5765, 153, 0 },
+	{ 5785, 157, 0 },
+	{ 5805, 161, 0 },
+	{ 5825, 165, 0 },
+	{ 4920, 184, HI5622_BAND5G_CHAN_NO_IR },
+	{ 4940, 188, HI5622_BAND5G_CHAN_NO_IR },
+	{ 4960, 192, HI5622_BAND5G_CHAN_NO_IR },
+	{ 4980, 196, HI5622_BAND5G_CHAN_NO_IR },
+};
+
+const struct hi5622_band5g_chan *hi5622_band5g_channels(u8 band, u16 *count)
+{
+	if (band == HI5622_BAND5G_2GHZ) {
+		if (count)
+			*count = (u16)(sizeof(hi5622_band5g_2g) /
+				       sizeof(hi5622_band5g_2g[0]));
+		return hi5622_band5g_2g;
+	}
+	if (band == HI5622_BAND5G_5GHZ) {
+		if (count)
+			*count = (u16)(sizeof(hi5622_band5g_5g) /
+				       sizeof(hi5622_band5g_5g[0]));
+		return hi5622_band5g_5g;
+	}
+	if (count)
+		*count = 0;
+	return NULL;
+}
+
+int hi5622_band5g_chan_count(u8 band)
+{
+	u16 n = 0;
+
+	hi5622_band5g_channels(band, &n);
+	return (int)n;
+}
+
+int hi5622_band5g_freq_to_chan(u8 band, u16 freq, u8 *out_chan)
+{
+	const struct hi5622_band5g_chan *tbl;
+	u16 n = 0, i;
+
+	if (!out_chan)
+		return -EINVAL;
+	tbl = hi5622_band5g_channels(band, &n);
+	if (!tbl || !n)
+		return -EINVAL;
+	if (!freq)
+		return -ENOENT;
+	for (i = 0; i < n; i++) {
+		if (tbl[i].freq == freq) {
+			*out_chan = tbl[i].num;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+int hi5622_band5g_chan_to_freq(u8 band, u8 chan, u16 *out_freq)
+{
+	const struct hi5622_band5g_chan *tbl;
+	u16 n = 0, i;
+
+	if (!out_freq)
+		return -EINVAL;
+	tbl = hi5622_band5g_channels(band, &n);
+	if (!tbl || !n)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		if (tbl[i].num == chan) {
+			*out_freq = tbl[i].freq;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+int hi5622_band5g_chan_index(u8 band, u8 chan, u8 *out_idx)
+{
+	const struct hi5622_band5g_chan *tbl;
+	u16 n = 0, i;
+
+	if (!out_idx)
+		return -EINVAL;
+	tbl = hi5622_band5g_channels(band, &n);
+	if (!tbl || !n)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		if (tbl[i].num == chan) {
+			if (i > 0xffu)
+				return -EINVAL;
+			*out_idx = (u8)i;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+int hi5622_band5g_chan_valid(u8 band, u8 chan)
+{
+	const struct hi5622_band5g_chan *tbl;
+	u16 n = 0, i;
+
+	tbl = hi5622_band5g_channels(band, &n);
+	if (!tbl || !n)
+		return 0;
+	for (i = 0; i < n; i++) {
+		if (tbl[i].num == chan)
+			return 1;
+	}
+	return 0;
+}
+
+int hi5622_band5g_ap_chan_prepare(u32 band5g_enable, u8 band, u16 center_freq,
+				  u8 channel,
+				  struct hi5622_band5g_ap_chan *out)
+{
+	u8 chan = channel;
+	int rc;
+
+	if (!out)
+		return -EINVAL;
+	if (band > HI5622_BAND5G_5GHZ)
+		return -EINVAL;
+
+	/* Fail closed: the 5 GHz AP path is only reachable with band5g=1. */
+	if (band == HI5622_BAND5G_5GHZ && !band5g_enable)
+		return -EOPNOTSUPP;
+
+	if (!chan) {
+		if (!center_freq)
+			return -EINVAL;
+		rc = hi5622_band5g_freq_to_chan(band, center_freq, &chan);
+		if (rc)
+			return rc;
+	} else if (center_freq) {
+		u8 derived = 0;
+
+		rc = hi5622_band5g_freq_to_chan(band, center_freq, &derived);
+		if (rc)
+			return rc;
+		if (derived != chan)
+			return -EINVAL;
+	}
+
+	if (!hi5622_band5g_chan_valid(band, chan))
+		return -EINVAL;
+	out->band = band;
+	out->channel = chan;
+	return 0;
+}
+
+int hi5622_band5g_band_cfg_chan(u32 band5g_enable, u8 band, u16 freq,
+				u16 *out_chan)
+{
+	u8 chan = 0;
+	int rc;
+
+	if (!out_chan)
+		return -EINVAL;
+	if (band > HI5622_BAND5G_5GHZ)
+		return -EINVAL;
+	if (band == HI5622_BAND5G_5GHZ && !band5g_enable)
+		return -EOPNOTSUPP;
+	rc = hi5622_band5g_freq_to_chan(band, freq, &chan);
+	if (rc)
+		return rc;
+	*out_chan = chan;
+	return 0;
+}
+
+u16 hi5622_band5g_ht_cap_word(u8 band)
+{
+	/* 2.4 GHz: the bench-validated baseline word (SGI20 | MAX_AMSDU);
+	 * 5 GHz: vendor 0x0062 = SUP_WIDTH_20_40 | SGI_20 | SGI_40. */
+	return band == HI5622_BAND5G_5GHZ ? 0x0062u : 0x0820u;
+}
+
+u32 hi5622_band5g_vht_cap_word(u8 band)
+{
+	if (band == HI5622_BAND5G_2GHZ)
+		return 0x00400000u;	/* HTC_VHT only */
+	if (band == HI5622_BAND5G_5GHZ)
+		return 0x00400064u;	/* HTC_VHT|160 MHz|SGI80|SGI160 */
+	return 0xffffffffu;
+}
+
+u16 hi5622_band5g_vht_mcs_map(u8 band)
+{
+	if (band > HI5622_BAND5G_5GHZ)
+		return 0xffffu;
+	return 0xfffau;		/* 2 SS, MCS 0..9, rx and tx */
+}
+
+u8 hi5622_band5g_max_power(u8 band)
+{
+	return band == HI5622_BAND5G_5GHZ ? 23u : 30u;
+}
+
+const char *hi5622_band5g_name(u8 band)
+{
+	return band == HI5622_BAND5G_5GHZ ? "5GHz" : "2.4GHz";
+}
diff -ruN a/hi5622_band5g.h b/hi5622_band5g.h
--- a/hi5622_band5g.h	1970-01-01 07:00:00.000000000 +0700
+++ b/hi5622_band5g.h	2026-11-25 12:39:05.509466021 +0700
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * hi5622_band5g.h - 5 GHz band-enable / band-config helpers for the
+ * Hi5622V100 clean-room Wi-Fi driver (Cudy WR3000 v2.0, Linux 6.18).
+ *
+ * ORIGINAL clean-room code (lane wifi-5ghz, shared task task-145,
+ * 2026-11-24).  No vendor source text, object code, firmware byte or
+ * calibration value is reproduced; every constant is a decoded fact with the
+ * vendor-module / firmware address recorded in ../REPORT.md and ../TABLES.md.
+ *
+ * Purpose
+ * -------
+ * The vendor driver builds ONE wiphy per logical band (band type 0 = 2.4 GHz,
+ * 1 = 5 GHz) and keeps two static band/channel tables:
+ *   - 14 channels: ch1..14   (2412..2484 MHz)
+ *   - 29 channels: ch36..64, 100..144, 149..165, 184..196
+ *                 (5180..5320, 5500..5720, 5745..5825, 4920..4980 MHz)
+ * The firmware carries the SAME two tables (2.4 GHz at CA 0x117B48, 5 GHz at
+ * CA 0x117AD4, 4-byte stride) and resolves a channel NUMBER to a band-local
+ * INDEX 0..13 / 0..28 (CA 0x10172C).  The H1 band-config message (g0 id10,
+ * firmware handler CA 0x5FF64) carries the channel NUMBER in a u16 and asks
+ * the firmware chip channel table (CA 0xD6A1E) for the per-channel context,
+ * so no separate 5 GHz "channel id" table exists.
+ *
+ * Everything here is pure C99 (host-testable with tools/selftest.sh); the
+ * driver only acts on it when the band5g module parameter is 1 (default 0 =
+ * bench-validated 2.4 GHz behaviour, 5 GHz AP start fail-closed).
+ */
+#ifndef HI5622_BAND5G_H
+#define HI5622_BAND5G_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t  u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#endif
+
+#define HI5622_BAND5G_2GHZ		0u
+#define HI5622_BAND5G_5GHZ		1u
+
+#define HI5622_BAND5G_2G_COUNT		14u
+#define HI5622_BAND5G_5G_COUNT		29u
+
+/* Channel flags (derived from the vendor wiphy tables + the regulatory
+ * rules the bench-validated driver already applies; the kernel regdb still
+ * has the final say at wiphy registration). */
+#define HI5622_BAND5G_CHAN_NO_IR	0x01u	/* passive / no initiator */
+#define HI5622_BAND5G_CHAN_RADAR	0x02u	/* DFS radar channel */
+
+struct hi5622_band5g_chan {
+	u16	freq;	/* centre frequency, MHz */
+	u8	num;	/* IEEE channel number */
+	u8	flags;	/* HI5622_BAND5G_CHAN_* */
+};
+
+/* Vendor static band table (2.4 GHz: 14 entries; 5 GHz: 29 entries incl
+ * ch144 and the 4.9 GHz public-safety block).  NULL for an invalid band. */
+const struct hi5622_band5g_chan *hi5622_band5g_channels(u8 band, u16 *count);
+
+/* Channel count of a band, 0 for an invalid band. */
+int hi5622_band5g_chan_count(u8 band);
+
+/* Centre frequency <-> IEEE channel number using the vendor tables.
+ * Returns 0 on success, -EINVAL for an invalid band, -ENOENT when the
+ * frequency/channel is not in the vendor table. */
+int hi5622_band5g_freq_to_chan(u8 band, u16 freq, u8 *out_chan);
+int hi5622_band5g_chan_to_freq(u8 band, u8 chan, u16 *out_freq);
+
+/* Band-local channel index 0..13 (2.4 GHz) / 0..28 (5 GHz) - the index the
+ * firmware CA 0x10172C validator produces and the scan request's entry+0x03
+ * field carries. */
+int hi5622_band5g_chan_index(u8 band, u8 chan, u8 *out_idx);
+
+/* 1 = channel number is in the band table, 0 = not (or invalid band). */
+int hi5622_band5g_chan_valid(u8 band, u8 chan);
+
+/* AP-start module channel config (vendor WAL cmd 0x0124 / g0 id1 key 0x0124,
+ * 4-byte body {band, vap, channel, 0}): resolve+validate the band/channel
+ * pair the cfg80211 chandef asks for.
+ *
+ * FAIL CLOSED: on the 5 GHz band the vendor table validation and the band5g
+ * gate both apply - band5g_enable == 0 returns -EOPNOTSUPP before any frame
+ * can be built.  0 = 2.4 GHz keeps the bench-validated behaviour. */
+struct hi5622_band5g_ap_chan {
+	u8	band;		/* 0 = 2.4 GHz, 1 = 5 GHz */
+	u8	channel;	/* IEEE channel number */
+};
+
+int hi5622_band5g_ap_chan_prepare(u32 band5g_enable, u8 band, u16 center_freq,
+				  u8 channel,
+				  struct hi5622_band5g_ap_chan *out);
+
+/* H1 band-config (g0 id10, handler CA 0x5FF64) channel field: the firmware
+ * looks the channel up in its chip channel table, so this must be the IEEE
+ * channel NUMBER derived from the scan frequency - never the raw MHz value
+ * (the old auto path sent 5180 for a 5 GHz scan, which the firmware lookup
+ * cannot resolve).  Same fail-closed band5g gate for the 5 GHz band. */
+int hi5622_band5g_band_cfg_chan(u32 band5g_enable, u8 band, u16 freq,
+				u16 *out_chan);
+
+/* 5 GHz wiphy profile words (vendor static .data+0xe54 supported-band
+ * template): HT cap 0x0062 (20/40 + SGI20/40), VHT cap 0x00400064
+ * (HTC_VHT | 160 MHz | SGI80 | SGI160), VHT MCS map 0xfffa (2 SS MCS0-9).
+ * The 2.4 GHz values are reported for symmetry only. */
+u16 hi5622_band5g_ht_cap_word(u8 band);
+u32 hi5622_band5g_vht_cap_word(u8 band);
+u16 hi5622_band5g_vht_mcs_map(u8 band);
+u8  hi5622_band5g_max_power(u8 band);
+const char *hi5622_band5g_name(u8 band);
+
+#endif /* HI5622_BAND5G_H */
