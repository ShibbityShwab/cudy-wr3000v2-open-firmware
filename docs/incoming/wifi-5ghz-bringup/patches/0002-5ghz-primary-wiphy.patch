+/* wifi-5ghz-bringup lane (task-154): band of a scan request batch, derived
+ * from the requested centre frequencies (the firmware scan request carries ONE
+ * chip_id, so a cfg80211 request must be single-band; the 2.4 GHz and 5 GHz
+ * vendor tables are both present on the band5g=1 primary wiphy).  Falls back
+ * to the legacy wiphy band byte when no frequency resolves; *mixed is set when
+ * the batch spans both bands (the first channel's band is then used and the
+ * caller logs the limitation). */
+static u8 hi5622_scan_batch_band(struct hi5622_scan *s, u32 first, u32 n,
+				 bool *mixed)
+{
+	struct hi5622_cfg80211 *c = s->cfg;
+	u8 band = c->band;
+	int b0;
+	u32 i;
+
+	*mixed = false;
+	if (first >= s->n_freqs)
+		return band;
+	b0 = hi5622_band5g_freq_band(s->freqs[first]);
+	if (b0 < 0)
+		return band;
+	band = (u8)b0;
+	for (i = first + 1u; i < first + n && i < s->n_freqs; i++) {
+		if (hi5622_band5g_freq_band(s->freqs[i]) != b0)
+			*mixed = true;
+	}
+	return band;
+}
