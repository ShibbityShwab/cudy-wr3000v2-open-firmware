+/* One-radio/two-band wiphy plan (lane wifi-5ghz-bringup, shared task task-154).
+ *
+ * The two PCI endpoints on this board are two HOST VIEWS of ONE chip: the
+ * vendor boot log prints "chip 0" for both buses, both functions' BAR0 windows
+ * alias the same on-chip register space, and only register instance 0 is
+ * initialised/serviced (opensource/docs/phase21/sibling-ep.md A.3/A.4).  A
+ * wiphy is therefore not a per-endpoint radio: with the 5 GHz profile enabled
+ * the PRIMARY endpoint (PCI domain 0 - the only endpoint the boot ladder and
+ * the single HCC service may run on) carries BOTH bands, and the second host
+ * view carries no wiphy at all.  enable=0 keeps the bench-validated
+ * per-endpoint single-band model unchanged (domain 0 = 2.4 GHz, domain 1 =
+ * 5 GHz, the hi5622_cfg11_pick_band() auto rule).
+ */
+#define HI5622_BAND5G_MAX_WIPHY_BANDS	2u
+
+/* Fill out_bands[]/out_n with the bands this endpoint's wiphy must carry.
+ * Returns 0 on success (out_n == 0 means "no wiphy on this endpoint"),
+ * -EINVAL for bad arguments, -ENOSPC when max is too small. */
+int hi5622_band5g_wiphy_bands(u32 band5g_enable, int pci_domain,
+			      u8 *out_bands, unsigned int max,
+			      unsigned int *out_n);
+
+/* Band (0 = 2.4 GHz, 1 = 5 GHz) of a centre frequency using the two vendor
+ * band tables; -ENOENT when the frequency is in neither table. */
+int hi5622_band5g_freq_band(u16 freq);
