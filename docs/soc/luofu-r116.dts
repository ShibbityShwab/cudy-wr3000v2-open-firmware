// SPDX-License-Identifier: GPL-2.0
/*
 * luofu-r116.dts -- stage-1 mach SKELETON for the Cudy WR3000 v2.0
 * (HiSilicon Hi5671Y "luofu", board R116).
 *
 * This is the upstream-port skeleton, NOT the vendor DT. It keeps every
 * register value, interrupt number and reset/clock cell verbatim from the
 * pinned vendor tree (opensource/docs/soc/luofu-r116-pinned.dts) and only
 * re-expresses the bindings:
 *
 *   - free bindings (GIC/SCU/PL310/TWD/SP804/UART/GPIO/I2C + fixed-clocks)
 *     are written in mainline form (driver URLs in build/tmp/dt-spec/dt.md);
 *   - vendor "hsan,*" blocks become "hisilicon,luofu-*" placeholders with
 *     status = "disabled", each marked TODO + the binding question.
 *
 * "pinned:NNNN" references point into luofu-r116-pinned.dts. Not yet
 * buildable: no dt-bindings/ headers exist and the luofu clock/reset/pinctrl/
 * SMP drivers are unwritten (see build/tmp/inta-spec/stage1.md).
 */

/dts-v1/;

/* Placeholder CRG clock IDs -- no <dt-bindings/clock/luofu.h> yet. Names
 * mirror the pinned tree's clock-output-names; (reg-offset, bit) is the
 * vendor gate geometry (pinned clk@14880000, :201) that seeds the driver
 * clock table:
 *   SFC    0  sfc_clk    clk_gate@001400  reg-offset 0x14  bit 0x0   :236
 *   GPIO0  1  gpio0_clk  clk_gate1@001420 reg-offset 0x14  bit 0x14  :206
 *   GPIO1  2  gpio1_clk  clk_gate2@001421 reg-offset 0x14  bit 0x15  :216
 *   I2C0   3  i2c0_clk   clk_gate2@001424 reg-offset 0x14  bit 0x18  :226
 *   PCIE0  4  pcie0_clk  clk_gate@002012 reg-offset 0x20  bit 0xc   :286
 *   PCIE1  5  pcie1_clk  clk_gate@002013 reg-offset 0x20  bit 0xd   :296
 *   GMAC0  6  gemac_clk0 clk_gate@002019 reg-offset 0x20  bit 0x13  :306
 */
#define LUOFU_CLK_SFC   0
#define LUOFU_CLK_GPIO0 1
#define LUOFU_CLK_GPIO1 2
#define LUOFU_CLK_I2C0  3
#define LUOFU_CLK_PCIE0 4
#define LUOFU_CLK_PCIE1 5
#define LUOFU_CLK_GMAC0 6

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "hsan luofu/R116";
	compatible = "hisilicon,luofu-r116", "hisilicon,luofu";
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart1;	/* physical console (ttyS0), pinned:181 */
		serial1 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* vendor bootargs (pinned:195): "noinitrd cma=0 console=ttyS0,115200
		 * earlycon maxcpus=2 nr_cpus=2 additional_cpus=1" -- keep this in the
		 * bootloader for mainline, not in the DTS. */
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		/* pinned:435 uses enable-method = "hisilicon,hsan_smp" -- no mainline
		 * method matches; TODO stage-1 SMP port (Hisilicon pen/smc path). */
		enable-method = "hisilicon,hsan_smp";

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
			/* TODO: pinned cpu@0 (:440) also carries clocks/cpu-supply/
			 * operating-points-v2/nvmem-cells -- reintroduce with the luofu
			 * clock + efuse + pwm-regulator drivers. */
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
		};
	};

	memory@80500000 {
		device_type = "memory";
		reg = <0x80500000 0x7b00000>;	/* 128 MB, pinned:1169 */
	};

	/* ---- fixed input clocks (free bindings; pinned values) ---- */

	osc_clk: fixed-clock@20000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <20000000>;	/* 0x1312d00, pinned:756 */
		clock-output-names = "osc";
	};

	ahb_clk: ahb_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;	/* 0xbebc200, pinned:173 */
		clock-output-names = "ahb_clk";
	};

	apb_clk: apb_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;	/* 0x5f5e100, pinned:187 */
		clock-output-names = "apb_clk";
	};

	corrector_clk: fixed-clock@1000000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1000000000>;	/* 0x3b9aca00, pinned:427 */
		clock-output-names = "corrector_clk";
	};

	twd_clk: twd_clk {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&corrector_clk>;
		clock-div = <4>;	/* pinned:774 */
		clock-mult = <1>;	/* 1 GHz / 4 = 250 MHz, pinned:772 */
	};

	/* ---- SoC CRG: clock + reset controllers (new binding) ----
	 * pinned clk@14880000 ("hsan,clk" + "syscon" + "simple-mfd", :201) and
	 * crg@14880000 ("hsan,crg", softrst values, :467) share the 0x14880000
	 * page with reset0 ("hsan,hsan-reset", :1394). Folded into ONE controller
	 * (build/tmp/inta-spec/clocks2.md sec 2). */

	crg: clock-reset-controller@14880000 {
		compatible = "hisilicon,luofu-crg", "syscon", "simple-mfd";
		reg = <0x14880000 0x1000>;	/* pinned:201 */
		#clock-cells = <1>;		/* clk id table in luofu.h */
		#reset-cells = <2>;		/* (reg-offset, bit), pinned:1395 */
	};

	/* ---- standard ARM peripherals (free bindings) ---- */

	gic: interrupt-controller@10181000 {
		compatible = "arm,cortex-a9-gic";
		#interrupt-cells = <3>;
		interrupt-controller;
		reg = <0x10181000 0x1000>,	/* dist,   pinned:1023 */
		      <0x10180100 0x100>;	/* cpu i/f */
	};

	scu@10180000 {
		compatible = "arm,cortex-a9-scu";
		reg = <0x10180000 0x1000>;	/* pinned:1412 */
	};

	L2: l2-cache {
		compatible = "arm,pl310-cache";
		reg = <0x7f000000 0x1000>;	/* pinned:1043 */
		cache-level = <2>;
		cache-unified;
		/* pinned:1043 also has l2c_aux_val = <0x430001>,
		 * l2c_aux_mask = <0xffb0fffe>, cache-way-size-sel = <1>.
		 * TODO: mainline cache-l2x0 derives the AUX register from
		 * arm,tag-latency / arm,data-latency -- translate. */
	};

	local_timer: local-timer@10180600 {
		compatible = "arm,cortex-a9-twd-timer";
		reg = <0x10180600 0x20>;	/* pinned:1066 */
		interrupts = <1 13 0x301>;	/* PPI 13, pinned:1066 */
		clocks = <&twd_clk>;
		/* pinned also sets contrl/count/load/status-reg-offset; mainline
		 * smp_twd uses the fixed A9 TWD offsets, so those are dropped. */
	};

	/* Cortex-A9 has no ARM architected timer; the TWD local timer above is
	 * the per-CPU timer source (no arm,armv7-timer node on this SoC). */

	timer@10104000 {
		compatible = "arm,sp804";
		reg = <0x10104000 0x1000>;	/* pinned:1469 */
		interrupts = <1 0x2f 4>;	/* PPI 47, pinned:1469 */
		clocks = <&apb_clk>;
	};

	/* ---- DesignWare peripherals (free bindings) ---- */

	uart0: serial@1010e000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x1010e000 0x1000>;	/* pinned:1490 */
		reg-shift = <2>;		/* pinned:1499 */
		interrupts = <0 0x2d 4>;	/* SPI 45, pinned:1490 */
		clocks = <&apb_clk>;
		clock-names = "apb_pclk";
		status = "disabled";
	};

	uart1: serial@1010f000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x1010f000 0x1000>;	/* pinned:1501 */
		reg-shift = <2>;		/* pinned:1510 */
		interrupts = <0 0x2e 4>;	/* SPI 46, pinned:1501 */
		clocks = <&apb_clk>;
		clock-names = "apb_pclk";
		status = "okay";		/* console */
	};

	gpio0: gpio@10106000 {
		compatible = "snps,dw-apb-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10106000 0x1000>;	/* pinned:963 */
		clocks = <&crg LUOFU_CLK_GPIO0>;
		resets = <&crg 0x2c 0x14>;	/* pinned:963 */

		porta: gpio-port@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&gic>;
			interrupts = <0 0x31 4>;	/* SPI 49, pinned:968 */
			reg = <0>;
			snps,nr-gpios = <32>;	/* " " == 0x20, pinned:985 */
		};
	};

	gpio1: gpio@10107000 {
		compatible = "snps,dw-apb-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x10107000 0x1000>;	/* pinned:988 */
		clocks = <&crg LUOFU_CLK_GPIO1>;
		resets = <&crg 0x2c 0x15>;	/* pinned:988 */

		portb: gpio-port@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&gic>;
			interrupts = <0 0x32 4>;	/* SPI 50, pinned:993 */
			reg = <0>;
			snps,nr-gpios = <5>;	/* pinned:1010 */
		};
	};

	i2c0: i2c@10111000 {
		compatible = "snps,designware-i2c";
		reg = <0x10111000 0x1000>;	/* pinned:1013 */
		interrupts = <0 0x2c 4>;	/* SPI 44, pinned:1013 */
		clocks = <&crg LUOFU_CLK_I2C0>;
		resets = <&crg 0x2c 0x18>;	/* pinned:1013 */
		clock-frequency = <100000>;	/* 0x186a0, pinned:1014 */
		status = "disabled";
	};

	/* ---- vendor-specific blocks: placeholders (new bindings, TODO) ---- */

	/* SPI-NAND controller. pinned fmc@10a20000 "hsan,fmc" (:781): quad-mode
	 * SPI-NAND with the A/B partition table (vendor-dt-notes.md sec 6). */
	fmc: spi-nand@10a20000 {
		compatible = "hisilicon,luofu-fmc";
		reg = <0x10a20000 0x1000>,	/* ctrl,    pinned:781 */
		      <0x1c000000 0x100000>;	/* window */
		clocks = <&crg LUOFU_CLK_SFC>;
		clock-names = "sfc_clk";
		resets = <&crg 0x2c 0x0>;	/* pinned:781 */
		reset-names = "sfc_rst";
		#address-cells = <1>;
		#size-cells = <1>;
		status = "disabled";
		/* TODO binding question: reuse the spi-nand core but a new
		 * hisilicon,luofu-fmc controller driver is needed; the
		 * fixed-partitions A/B table goes here once it lands. */
	};

	/* gigabit MAC #0 + MDIO bus. pinned gemac@0x14300000 "hsan,mac" (:885)
	 * and mdio0 "hsan,mdio" (:1124). Five MACs (ports 8..12): gemac0 is
	 * RGMII, 1..4 are GMII into the internal LSW switch. */
	gmac0: ethernet@14300000 {
		compatible = "hisilicon,luofu-gmac";
		reg = <0x14300000 0x10000>;	/* pinned:885 */
		phy-mode = "rgmii";		/* pinned:892 */
		clocks = <&crg LUOFU_CLK_GMAC0>;
		resets = <&crg 0x30 0xd>,	/* mac_logic, pinned:895 */
			 <&crg 0x30 0xe>;	/* mac */
		reset-names = "mac_logic_reset", "mac_reset";
		status = "disabled";
		/* TODO binding question: no mainline hsan,mac; reference
		 * hix5hd2_gmac.c (different family). */
	};

	mdio0: mdio@14000000 {
		compatible = "hisilicon,luofu-mdio";
		reg = <0x14000000 0x1000>;	/* pinned:1124 */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
		/* TODO binding question: 5x ethernet-phy-ieee802.3-c22 @ reg 1..5
		 * (first at pinned:1133) once the mdio driver lands. */
	};

	/* DWC PCIe root complex #0. pinned pcie@0x10160000 "hsan,pcie" +
	 * "hsan,acp-pcie0" (:1205). NOTE: the "misc" window 0x10161000 is kept
	 * for reference only -- it MUST NEVER be read at runtime (panics the
	 * box); measure through the endpoint BAR0/BAR2 instead. */
	pcie0: pcie@10160000 {
		compatible = "hisilicon,luofu-pcie";
		reg = <0x10160000 0x1000>,	/* dbi,  pinned:1205 */
		      <0x10161000 0x3000>,	/* misc (NEVER read) */
		      <0x50000000 0x1000>,	/* cfg */
		      <0x40000000 0x2000000>,	/* mem */
		      <0x48000000 0x800000>;	/* io */
		reg-names = "dbi", "misc", "cfg", "mem", "io";
		bus-range = <0 0xa>;
		interrupts = <0 0x3b 4>,	/* radm,     pinned:1205 */
			     <0 0x45 4>;	/* linkdown */
		interrupt-names = "radm", "linkdown";
		clocks = <&crg LUOFU_CLK_PCIE0>;
		resets = <&crg 0x34 0xc>,	/* apb,  pinned:1226 */
			 <&crg 0x34 0xd>,	/* pcs */
			 <&crg 0x34 0xe>,	/* phy */
			 <&crg 0x34 0xf>;	/* ctrl */
		reset-names = "apb_rst", "pcs_rst", "phy_rst", "ctrl_rst";
		status = "disabled";
		/* TODO binding question: DWC glue -- reference pcie-histb.c /
		 * pcie-hisi.c; keep the vendor iatu_rc/iatu_ep window tables. */
	};
};
