 /*
+ * W22: PFE NAPT/flow engine initialization (patch 059).
+ *
+ * The E0-a/E0-b experiments showed where the native CPU-delivery path breaks in
+ * our bring-up: the W10 IFC defaults punt broadcast/ARP to the CPU and route
+ * unicast into the PFE NAPT/flow engine.  The vendor initializes that engine in
+ * hi_pfe_napt_init@0x4314 (called from hi_pfe_probe after the PFE base init and
+ * before hi_pfe_ifc_init); this driver never did, so the unicast class died
+ * inside an unconfigured engine and never produced a PIE completion.
+ *
+ * Replaying the decoded sequence got M1a proven on hardware on 2026-11-21
+ * (release tree + only the command-line change, no mirror): host ping 200/200,
+ * SSH working, UART RXDIAG showing native port=11 deliveries.
+ *
+ * Safety contract:
+ *  - register-only; the CPU never writes into the flow DDR window.  The flow
+ *    table bases are derived from the validated variant flow window (checked
+ *    against the devicetree resource in luofu_switch_check_windows), and the
+ *    function refuses unless the whole base range stays inside that window,
+ *    does not overlap the queue window, and ends below the measured Linux RAM
+ *    start (LUOFU_SWITCH_RAM_BASE).  The engine's DMA can therefore not reach
+ *    a Linux page;
+ *  - the vendor order is preserved and the two table-clear commands are polled
+ *    with the vendor bound; a timeout or any readback mismatch restores the
+ *    complete pre-write snapshot (which also re-clears the enable word);
+ *  - the idempotent guard re-runs nothing when the stage already applied (the
+ *    probe can be retried / the driver re-bound);
+ *  - stage ordering mirrors the vendor: after W8 (hi_pfe_init) and before W10
+ *    (hi_pfe_ifc_init).
+ */
+
+static void luofu_switch_napt_restore(struct luofu_switch *lsw)
+{
+	void __iomem *napt = lsw->window[LUOFU_SWITCH_WIN_NAPT];
+	void __iomem *glb = lsw->window[LUOFU_SWITCH_WIN_PFE_GLB];
+
+	if (!napt || !glb)
+		return;
+
+	writel(lsw->napt_pre[9], napt + LUOFU_SWITCH_NAPT_HASH_PARAM);
+	writel(lsw->napt_pre[8], napt + LUOFU_SWITCH_NAPT_HASH_CFG);
+	writel(lsw->napt_pre[7], napt + LUOFU_SWITCH_NAPT_BASE_D);
+	writel(lsw->napt_pre[6], napt + LUOFU_SWITCH_NAPT_BASE_C);
+	writel(lsw->napt_pre[5], napt + LUOFU_SWITCH_NAPT_BASE_B);
+	writel(lsw->napt_pre[4], napt + LUOFU_SWITCH_NAPT_BASE_A);
+	writel(lsw->napt_pre[3], napt + LUOFU_SWITCH_NAPT_AGE_EN);
+	writel(lsw->napt_pre[2], napt + LUOFU_SWITCH_NAPT_ENABLE);
+	writel(lsw->napt_pre[1], napt + LUOFU_SWITCH_NAPT_CTRL_A);
+	writel(lsw->napt_pre[0], glb + LUOFU_SWITCH_PFE_GLB_TAB_CFG);
+}
+
+static int luofu_switch_napt_write_verify(struct luofu_switch *lsw,
+					  void __iomem *base, u32 offset,
+					  u32 want, const char *name)
+{
+	u32 got;
+
+	writel(want, base + offset);
+	got = readl(base + offset);
+	if (got != want) {
+		dev_err(lsw->dev,
+			"W22: %s readback mismatch at %s+%#x: wrote %#x, read %#x\n",
+			name, base == lsw->window[LUOFU_SWITCH_WIN_NAPT] ? "napt" : "pfe_glb",
+			offset, want, got);
+		return -EIO;
+	}
+	return 0;
+}
+
+static int luofu_switch_napt_clear(struct luofu_switch *lsw, u32 command)
+{
+	void __iomem *napt = lsw->window[LUOFU_SWITCH_WIN_NAPT];
+	unsigned int i;
+	u32 value;
+
+	writel(command, napt + LUOFU_SWITCH_NAPT_CLEAR);
+	for (i = 0; i < LUOFU_SWITCH_NAPT_CLEAR_POLL; i++) {
+		value = readl(napt + LUOFU_SWITCH_NAPT_CLEAR);
+		if (!(value & LUOFU_SWITCH_NAPT_CLEAR_BUSY))
+			return 0;
+		cpu_relax();
+	}
+
+	dev_err(lsw->dev,
+		"W22: NAPT table clear command %#x did not complete (%#x still has bit0 set after %u polls)\n",
+		command, value, LUOFU_SWITCH_NAPT_CLEAR_POLL);
+	return -ETIMEDOUT;
+}
+
+static int luofu_switch_napt_program(struct luofu_switch *lsw)
+{
+	void __iomem *napt = lsw->window[LUOFU_SWITCH_WIN_NAPT];
+	void __iomem *glb = lsw->window[LUOFU_SWITCH_WIN_PFE_GLB];
+	const struct luofu_switch_variant *variant = lsw->variant;
+	phys_addr_t base_a, base_b, base_c, base_d, flow_end;
+	u32 want_glb, want_ctrl;
+	int ret;
+
+	if (!napt || !glb)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "missing napt/pfe_glb window for the W22 stage\n");
+
+	base_a = variant->flow_base;
+	base_b = base_a + LUOFU_SWITCH_NAPT_BASE_B_OFF;
+	base_c = base_a + LUOFU_SWITCH_NAPT_BASE_C_OFF;
+	base_d = base_a + LUOFU_SWITCH_NAPT_BASE_D_OFF;
+	flow_end = base_a + variant->flow_size;
+
+	if (base_a != LUOFU_SWITCH_FLOW_BASE)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "W22: flow window base is %#llx, expected %#llx from the loader-handoff contract; refusing to point the flow engine at it\n",
+				     (unsigned long long)base_a,
+				     (unsigned long long)LUOFU_SWITCH_FLOW_BASE);
+	if (base_d + LUOFU_SWITCH_NAPT_BASE_TAIL > flow_end)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "W22: flow window %#llx+%#llx is too small for the decoded NAPT table layout (needs %#x bytes)\n",
+				     (unsigned long long)base_a,
+				     (unsigned long long)variant->flow_size,
+				     LUOFU_SWITCH_NAPT_BASE_D_OFF +
+				     LUOFU_SWITCH_NAPT_BASE_TAIL);
+	if (base_a < variant->queue_base + variant->queue_size)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "W22: flow window overlaps the queue window; refusing\n");
+	if (flow_end > LUOFU_SWITCH_RAM_BASE)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "W22: flow window ends at %#llx, above the measured Linux RAM start %#llx; refusing to let the flow engine DMA there\n",
+				     (unsigned long long)flow_end,
+				     (unsigned long long)LUOFU_SWITCH_RAM_BASE);
+
+	/* Idempotent guard: a previous run (or an initrd replay) already did it. */
+	if (readl(napt + LUOFU_SWITCH_NAPT_CTRL_A) ==
+		    LUOFU_SWITCH_NAPT_CTRL_A_VALUE &&
+	    readl(napt + LUOFU_SWITCH_NAPT_ENABLE) ==
+		    LUOFU_SWITCH_NAPT_ENABLE_VALUE &&
+	    readl(napt + LUOFU_SWITCH_NAPT_BASE_A) == (u32)base_a &&
+	    readl(napt + LUOFU_SWITCH_NAPT_BASE_B) == (u32)base_b &&
+	    readl(napt + LUOFU_SWITCH_NAPT_BASE_C) == (u32)base_c &&
+	    readl(napt + LUOFU_SWITCH_NAPT_BASE_D) == (u32)base_d) {
+		dev_info(lsw->dev,
+			 "W22: NAPT/flow engine already initialized (bases %#llx/%#llx); skipping the replay\n",
+			 (unsigned long long)base_a,
+			 (unsigned long long)base_b);
+		return 0;
+	}
+
+	dev_info(lsw->dev,
+		 "W22: NAPT/flow engine init: flow carveout %#llx+%#llx, bases %#llx/%#llx/%#llx/%#llx, up_port %#x\n",
+		 (unsigned long long)base_a, (unsigned long long)variant->flow_size,
+		 (unsigned long long)base_a, (unsigned long long)base_b,
+		 (unsigned long long)base_c, (unsigned long long)base_d,
+		 variant->napt_up_port);
+
+	/* Snapshot the complete pre-write state; every word must be stable. */
+	lsw->napt_pre[0] = readl(glb + LUOFU_SWITCH_PFE_GLB_TAB_CFG);
+	lsw->napt_pre[1] = readl(napt + LUOFU_SWITCH_NAPT_CTRL_A);
+	lsw->napt_pre[2] = readl(napt + LUOFU_SWITCH_NAPT_ENABLE);
+	lsw->napt_pre[3] = readl(napt + LUOFU_SWITCH_NAPT_AGE_EN);
+	lsw->napt_pre[4] = readl(napt + LUOFU_SWITCH_NAPT_BASE_A);
+	lsw->napt_pre[5] = readl(napt + LUOFU_SWITCH_NAPT_BASE_B);
+	lsw->napt_pre[6] = readl(napt + LUOFU_SWITCH_NAPT_BASE_C);
+	lsw->napt_pre[7] = readl(napt + LUOFU_SWITCH_NAPT_BASE_D);
+	lsw->napt_pre[8] = readl(napt + LUOFU_SWITCH_NAPT_HASH_CFG);
+	lsw->napt_pre[9] = readl(napt + LUOFU_SWITCH_NAPT_HASH_PARAM);
+
+	if (readl(glb + LUOFU_SWITCH_PFE_GLB_TAB_CFG) != lsw->napt_pre[0] ||
+	    readl(napt + LUOFU_SWITCH_NAPT_CTRL_A) != lsw->napt_pre[1] ||
+	    readl(napt + LUOFU_SWITCH_NAPT_ENABLE) != lsw->napt_pre[2] ||
+	    readl(napt + LUOFU_SWITCH_NAPT_AGE_EN) != lsw->napt_pre[3] ||
+	    readl(napt + LUOFU_SWITCH_NAPT_BASE_A) != lsw->napt_pre[4] ||
+	    readl(napt + LUOFU_SWITCH_NAPT_HASH_PARAM) != lsw->napt_pre[9])
+		return dev_err_probe(lsw->dev, -EIO,
+				     "W22: NAPT/flow register changed between two reads; refusing to write the sequence\n");
+
+	want_glb = (lsw->napt_pre[0] & LUOFU_SWITCH_PFE_GLB_TAB_MASK) |
+		   ((u32)variant->napt_up_port << LUOFU_SWITCH_PFE_GLB_UP_PORT_SHIFT);
+	want_ctrl = (lsw->napt_pre[1] & LUOFU_SWITCH_NAPT_CTRL_A_KEEP) |
+		    LUOFU_SWITCH_NAPT_CTRL_A_VALUE;
+
+	/*
+	 * Vendor order: hi_pfe_init attr, napt ctrl/enable/age, table bases,
+	 * hash config, v6 clear, v4 clear, hash params.
+	 */
+	ret = luofu_switch_napt_write_verify(lsw, glb,
+					     LUOFU_SWITCH_PFE_GLB_TAB_CFG,
+					     want_glb, "up_port");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_CTRL_A, want_ctrl,
+					     "ctrl A");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_ENABLE,
+					     LUOFU_SWITCH_NAPT_ENABLE_VALUE,
+					     "engine enable");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_AGE_EN,
+					     LUOFU_SWITCH_NAPT_AGE_EN_VALUE,
+					     "flow age enable");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_BASE_A,
+					     (u32)base_a, "flow base A");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_BASE_B,
+					     (u32)base_b, "flow base B");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_BASE_C,
+					     (u32)base_c, "flow base C");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_BASE_D,
+					     (u32)base_d, "flow base D");
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_HASH_CFG,
+					     LUOFU_SWITCH_NAPT_HASH_CFG_VALUE,
+					     "hash config");
+	if (ret)
+		goto restore;
+
+	ret = luofu_switch_napt_clear(lsw, LUOFU_SWITCH_NAPT_CLEAR_V6);
+	if (ret)
+		goto restore;
+	ret = luofu_switch_napt_clear(lsw, LUOFU_SWITCH_NAPT_CLEAR_V4);
+	if (ret)
+		goto restore;
+
+	ret = luofu_switch_napt_write_verify(lsw, napt,
+					     LUOFU_SWITCH_NAPT_HASH_PARAM,
+					     LUOFU_SWITCH_NAPT_HASH_PARAM_VALUE,
+					     "hash params");
+	if (ret)
+		goto restore;
+
+	dev_info(lsw->dev,
+		 "W22: NAPT/flow engine initialized and verified: up_port %#x, bases %#llx/%#llx/%#llx/%#llx, v4+v6 tables cleared (vendor hi_pfe_napt_init sequence)\n",
+		 variant->napt_up_port, (unsigned long long)base_a,
+		 (unsigned long long)base_b, (unsigned long long)base_c,
+		 (unsigned long long)base_d);
+	return 0;
+
+restore:
+	luofu_switch_napt_restore(lsw);
+	dev_err(lsw->dev,
+		"W22: NAPT/flow init failed; pre-write snapshot restored (engine disabled again)\n");
+	return ret;
+}
