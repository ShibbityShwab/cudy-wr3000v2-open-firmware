+		if (ndev && netif_running(ndev)) {
+			static atomic_t copy_trace = ATOMIC_INIT(0);
+			u32 n = atomic_inc_return(&copy_trace);
+
+			if (n <= 16)
+				pr_info("pie-trace RXCPUCOPY port=0 -> port %u len=%u status=%u (cpucopy_deliver=1, mirror source port)\n",
