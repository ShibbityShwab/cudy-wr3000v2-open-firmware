+/*
+ * W20_CPUCOPY (patch 057): the switch CPU-copy mirror delivers normal-path
+ * completions with port/vport 0 (W19 dwell: 13 normal completions len=98
+ * status=0 port=0 inside the dst=4 window, zero outside it).  The vendor stack
+ * has no net_device for port 0, so those copies are dropped there too, but for
+ * the bench they are the host frames arriving through the mirror.  This gate
+ * delivers them to the net_device registered for the mirror source port
+ * (luofu_pie.cpucopy_port, default 11 = eth2) instead of dropping them, and
+ * logs the first deliveries.  Vendor behaviour is kept for every other port
+ * and for all exception completions (those still follow luofu_pie.accepterr).
+ */
+static bool luofu_pie_cpucopy_deliver_gate;
+module_param_named(cpucopy_deliver, luofu_pie_cpucopy_deliver_gate, bool, 0444);
+MODULE_PARM_DESC(cpucopy_deliver, "Attended W20 delivery: hand port-0 normal-path completions (CPU/mirror copies) to the netdev of luofu_pie.cpucopy_port instead of dropping them (default off)");
+
+static uint luofu_pie_cpucopy_port = 11;
+module_param_named(cpucopy_port, luofu_pie_cpucopy_port, uint, 0444);
+MODULE_PARM_DESC(cpucopy_port, "W20: mirror source switch port whose netdev receives CPU-copy completions (default 11 = eth2)");
+
