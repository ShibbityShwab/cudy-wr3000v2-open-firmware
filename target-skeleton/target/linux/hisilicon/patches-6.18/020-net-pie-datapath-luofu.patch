+/* Reclaim TX descriptors the engine has completed (poll-only, no TX IRQ). */
+static void luofu_pie_tx_reclaim(struct luofu_pie *pie, unsigned int ch)
+{
+	struct luofu_pie_ring *ring = &pie->tx_ring[ch];
+	u32 hw_rptr, delta;
+
+	hw_rptr = readl(pie->base + LUOFU_PIE_TX_RPTR_OFF(ch)) & 0xffff;
+	delta = (hw_rptr - (ring->rptr & 0xffff)) & 0xffff;
+	if (delta > ring->entries)
+		delta = ring->entries;
+
+	while (delta--) {
+		u32 index = ring->rptr & (ring->entries - 1);
+		struct luofu_pie_tx_buf *b = &pie->tx_buf[ch][index];
+
+		if (b->skb) {
+			dma_unmap_single(pie->dev, b->dma, b->len,
+					 DMA_TO_DEVICE);
+			dev_kfree_skb_any(b->skb);
+			b->skb = NULL;
+			pie->tx_completed++;
+		}
+		ring->rptr++;
+	}
+}
