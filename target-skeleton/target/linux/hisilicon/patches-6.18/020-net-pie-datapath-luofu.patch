+/*
+ * Global and per-channel register initialization, following the recovered
+ * vendor v250 reg_init sequence.  Every write below is either [V] recovered
+ * code or a [V] measured post-init value; where the vendor value is [U] it is
+ * identified in the comment and the write is only the documented default.
+ */
+static void luofu_pie_reg_init(struct luofu_pie *pie)
+{
+	u32 val;
+	unsigned int ch;
+
+	/* 0x1000: clear bit 0, set bits 6-8, preserve the rest. [V] */
+	val = readl(pie->base + LUOFU_PIE_GLOBAL_CTRL_OFF);
+	val &= ~LUOFU_PIE_GLOBAL_CTRL_BIT0;
+	val |= LUOFU_PIE_GLOBAL_CTRL_BITS;
+	writel(val, pie->base + LUOFU_PIE_GLOBAL_CTRL_OFF);
+
+	/*
+	 * All channels start masked.  This loops over all eight slots, which
+	 * is also a safety property: the uninitialized Wi-Fi offload half of
+	 * each vector can never raise an interrupt we do not service.
+	 */
+	for (ch = 0; ch < LUOFU_PIE_CHAN_SLOTS; ch++)
+		writel(LUOFU_PIE_RX_IRQ_BIT,
+		       pie->base + LUOFU_PIE_RX_IRQ_MASK_OFF(ch));
+
+	/*
+	 * Per-channel defaults for the active wired channels.  The measured
+	 * vendor boot has these values on all eight slots; the semantics are
+	 * [U], but the documented reg_init values are 1/1/1 and 3/2/8.  The
+	 * inactive slots (including the WoC half) are deliberately left in
+	 * their loader state because those paths are not ours to program.
+	 */
+	for (ch = 0; ch < max(pie->rx_chans, pie->tx_chans); ch++) {
+		writel(LUOFU_PIE_REG_180_VAL,
+		       pie->base + LUOFU_PIE_REG_180_OFF(ch));
+		writel(LUOFU_PIE_REG_200_VAL,
+		       pie->base + LUOFU_PIE_REG_200_OFF(ch));
+		writel(LUOFU_PIE_REG_380_VAL,
+		       pie->base + LUOFU_PIE_REG_380_OFF(ch));
+		writel(LUOFU_PIE_REG_3210_VAL,
+		       pie->base + LUOFU_PIE_REG_3210_OFF(ch));
+		writel(LUOFU_PIE_REG_3290_VAL,
+		       pie->base + LUOFU_PIE_REG_3290_OFF(ch));
+		writel(LUOFU_PIE_REG_3310_VAL,
+		       pie->base + LUOFU_PIE_REG_3310_OFF(ch));
+	}
+
+	/* Remaining documented reg_init defaults. [V] writes, [U] meaning. */
+	writel(LUOFU_PIE_REG_3204_VAL, pie->base + LUOFU_PIE_REG_3204_OFF);
+	writel(LUOFU_PIE_REG_3208_VAL, pie->base + LUOFU_PIE_REG_3208_OFF);
+	writel(0, pie->base + LUOFU_PIE_REG_3404_OFF);
+	writel(0, pie->base + LUOFU_PIE_REG_3408_OFF);
+
+	/*
+	 * 0x3200: the documented reg_init model clears bits 0-1 and sets bit 1
+	 * only in single-channel mode [I]; the measured two-channel word has
+	 * bit 1 clear.  Bits 2-7 are preserved from the current value; the
+	 * global RX enable bit (0) stays clear until the rings are armed.
+	 */
+	val = readl(pie->base + LUOFU_PIE_RX_EN_OFF);
+	val = (val & ~GENMASK(7, 0)) | (val & GENMASK(7, 2));
+	if (pie->rx_chans == 1)
+		val |= LUOFU_PIE_RX_EN_SINGLE_BIT;
+	writel(val, pie->base + LUOFU_PIE_RX_EN_OFF);
