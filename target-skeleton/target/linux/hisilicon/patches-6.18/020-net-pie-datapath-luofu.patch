+/**
+ * luofu_pie_xmit - queue one skb into the PIE TX ring
+ * @skb: the frame to transmit (consumed on NETDEV_TX_OK)
+ * @ndev: the MAC net_device, for the software statistics
+ *
+ * Returns NETDEV_TX_OK when the frame was queued or dropped, NETDEV_TX_BUSY
+ * when the ring is temporarily full.  The engine counts descriptors from the
+ * current CPU modulo the configured channel count ([I] mirror of the vendor
+ * per-CPU TX channel selection).
+ */
+netdev_tx_t luofu_pie_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	struct luofu_pie *pie = READ_ONCE(luofu_pie_ctrl);
+	struct luofu_pie_ring *ring;
+	struct luofu_pie_tx_buf *b;
+	struct luofu_pie_desc *desc;
+	unsigned int ch;
+	dma_addr_t dma;
+	u32 used;
+	u16 len;
+
+	if (!pie || !READ_ONCE(pie->armed)) {
+		dev_kfree_skb_any(skb);
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	if (skb->len > U16_MAX || skb->len == 0)
+		goto drop;
+
+	/* One descriptor per frame: the recovered TX field is a single u16. */
+	if (skb_is_nonlinear(skb) && skb_linearize(skb))
+		goto drop;
+
+	ch = raw_smp_processor_id() % pie->tx_chans;
+	ring = &pie->tx_ring[ch];
+	luofu_pie_tx_reclaim(pie, ch);
+
+	used = ring->wptr - ring->rptr;
+	if (used >= ring->entries)
+		goto drop;
+
+	dma = dma_map_single(pie->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(pie->dev, dma))
+		goto drop;
+
+	b = &pie->tx_buf[ch][ring->wptr & (ring->entries - 1)];
+	if (WARN_ON(b->skb)) {
+		dma_unmap_single(pie->dev, dma, skb->len, DMA_TO_DEVICE);
+		goto drop;
+	}
+
+	len = skb->len;
+	desc = luofu_pie_desc_at(ring->desc, ring->wptr & (ring->entries - 1));
+	luofu_pie_tx_desc_set_buf(desc, dma, len);
+	b->skb = skb;
+	b->dma = dma;
+	b->len = len;
+	ring->wptr++;
+
+	/* Doorbell: a full 32-bit write starts transmission of the ring. */
+	dma_wmb();
+	writel(ring->wptr, pie->base + LUOFU_PIE_TX_WPTR_OFF(ch));
+
+	ndev->stats.tx_packets++;
+	ndev->stats.tx_bytes += skb->len;
+
+	return NETDEV_TX_OK;
+
+drop:
+	dev_kfree_skb_any(skb);
+	ndev->stats.tx_dropped++;
+	return NETDEV_TX_OK;
+}
+EXPORT_SYMBOL_GPL(luofu_pie_xmit);
