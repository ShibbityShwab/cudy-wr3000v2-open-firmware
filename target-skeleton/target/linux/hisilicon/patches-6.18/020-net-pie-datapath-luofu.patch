+/* Read back every register the arm sequence programs and verify the values. */
+static int luofu_pie_verify(struct luofu_pie *pie)
+{
+	struct luofu_pie_ring *ring;
+	u32 val;
+	unsigned int ch;
+
+	val = readl(pie->base + LUOFU_PIE_GLOBAL_CTRL_OFF);
+	if (val & LUOFU_PIE_GLOBAL_CTRL_BIT0) {
+		dev_err(pie->dev, "global control bit 0 still set (%#x)\n", val);
+		return -EIO;
+	}
+	if ((val & LUOFU_PIE_GLOBAL_CTRL_BITS) != LUOFU_PIE_GLOBAL_CTRL_BITS) {
+		dev_err(pie->dev, "global control bits 6-8 not set (%#x)\n",
+			val);
+		return -EIO;
+	}
+
+	val = readl(pie->base + LUOFU_PIE_RX_EN_OFF);
+	if (!(val & LUOFU_PIE_RX_EN_BIT)) {
+		dev_err(pie->dev, "global RX enable bit not set (%#x)\n", val);
+		return -EIO;
+	}
+
+	for (ch = 0; ch < pie->rx_chans; ch++) {
+		ring = &pie->rx_ring[ch];
+		if (readl(pie->base + LUOFU_PIE_RX_BASE_OFF(ch)) !=
+		    lower_32_bits(ring->desc_dma)) {
+			dev_err(pie->dev, "RX%u ring base readback mismatch\n",
+				ch);
+			return -EIO;
+		}
+		if (readl(pie->base + LUOFU_PIE_RX_CFG_OFF(ch)) !=
+		    ring->shift) {
+			dev_err(pie->dev, "RX%u config readback mismatch\n", ch);
+			return -EIO;
+		}
+		if (readl(pie->base + LUOFU_PIE_RX_SIZE_OFF(ch)) !=
+		    pie->rx_buf_size[ch] / LUOFU_PIE_RX_SIZE_UNIT) {
+			dev_err(pie->dev, "RX%u size readback mismatch\n", ch);
+			return -EIO;
+		}
+		if (readl(pie->base + LUOFU_PIE_RX_IRQ_MASK_OFF(ch)) &
+		    LUOFU_PIE_RX_IRQ_BIT) {
+			dev_err(pie->dev, "RX%u interrupt still masked\n", ch);
+			return -EIO;
+		}
+	}
+
+	for (ch = 0; ch < pie->tx_chans; ch++) {
+		ring = &pie->tx_ring[ch];
+		if (readl(pie->base + LUOFU_PIE_TX_BASE_OFF(ch)) !=
+		    lower_32_bits(ring->desc_dma)) {
+			dev_err(pie->dev, "TX%u ring base readback mismatch\n",
+				ch);
+			return -EIO;
+		}
+		if (readl(pie->base + LUOFU_PIE_TX_CFG_OFF(ch)) !=
+		    ring->shift) {
+			dev_err(pie->dev, "TX%u config readback mismatch\n", ch);
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
