+	    vals[0] > LUOFU_PIE_DESC_SHIFT_MAX)
+		return dev_err_probe(pie->dev, -EINVAL,
+				     "TX descriptor shift %u out of range\n",
+				     vals[0]);
+	if (vals[1] < 1 || vals[1] > LUOFU_PIE_MAX_TX_CHANS)
+		return dev_err_probe(pie->dev, -EINVAL,
+				     "TX channel count %u out of range\n",
