+/*
+ * Park the engine: mask and disable RX, stop NAPI, free the rings and
+ * buffers, then park the block in reset and gate its clock.  Called on probe
+ * error paths and from the devres action; safe for a partially armed state.
+ */
+static void luofu_pie_halt(struct luofu_pie *pie)
+{
+	unsigned int ch;
+
+	pie->armed = false;
+
+	if (pie->clk_enabled)
+		luofu_pie_rx_disable(pie);
+
+	while (pie->napi_enabled) {
+		ch = --pie->napi_enabled;
+		napi_disable(&pie->napi[ch].napi);
+	}
+	while (pie->napi_added) {
+		ch = --pie->napi_added;
+		netif_napi_del(&pie->napi[ch].napi);
+	}
+
+	luofu_pie_rings_free(pie);
+
+	if (pie->napi_netdev) {
+		free_netdev(pie->napi_netdev);
+		pie->napi_netdev = NULL;
+	}
+
+	if (pie->clk_enabled) {
+		reset_control_assert(pie->resets);
+		clk_disable_unprepare(pie->clk);
+		pie->clk_enabled = false;
+	}
+}
