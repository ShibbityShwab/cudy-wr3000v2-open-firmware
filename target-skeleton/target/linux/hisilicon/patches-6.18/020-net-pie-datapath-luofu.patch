+/* Fill one RX ring with freshly allocated buffers and arm all descriptors. */
+static int luofu_pie_rx_ring_fill(struct luofu_pie *pie, unsigned int ch)
+{
+	struct luofu_pie_ring *ring = &pie->rx_ring[ch];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ring->entries; i++) {
+		struct luofu_pie_rx_buf *b = &pie->rx_buf[ch][i];
+		struct sk_buff *skb;
+		dma_addr_t dma;
+
+		/*
+		 * The vendor allocates the per-frame buffer plus 128 bytes of
+		 * headroom; coherent mapping only, no cache maintenance. [V]
+		 */
+		skb = netdev_alloc_skb_ip_align(pie->napi_netdev,
+						pie->rx_buf_size[ch] + 128);
+		if (!skb) {
+			ret = -ENOMEM;
+			goto err_unmap;
+		}
+		dma = dma_map_single(pie->dev, skb->data, pie->rx_buf_size[ch],
+				     DMA_FROM_DEVICE);
+		if (dma_mapping_error(pie->dev, dma)) {
+			dev_kfree_skb(skb);
+			ret = -ENOMEM;
+			goto err_unmap;
+		}
+		b->skb = skb;
+		b->dma = dma;
+		luofu_pie_rx_desc_set_buf(luofu_pie_desc_at(ring->desc, i),
+					  dma);
+	}
+
+	/*
+	 * The producer counter is free-running; pushing "entries" makes every
+	 * populated descriptor visible to the engine ([I] doorbell model, the
+	 * 16-bit field has room for the measured 256-descriptor ring).
+	 */
+	ring->rptr = 0;
+	ring->wptr = ring->entries;
+	dma_wmb();
+	luofu_pie_rx_kick(pie, ch, ring->wptr & 0xffff);
+
+	return 0;
+
+err_unmap:
+	/* The caller's halt path frees the partially filled ring. */
+	return ret;
+}
