+/* Mask every RX channel interrupt and clear the global RX enable. */
+static void luofu_pie_rx_disable(struct luofu_pie *pie)
+{
+	u32 val;
+	unsigned int ch;
+
+	for (ch = 0; ch < LUOFU_PIE_CHAN_SLOTS; ch++)
+		writel(LUOFU_PIE_RX_IRQ_BIT,
+		       pie->base + LUOFU_PIE_RX_IRQ_MASK_OFF(ch));
+
+	val = readl(pie->base + LUOFU_PIE_RX_EN_OFF);
+	writel(val & ~LUOFU_PIE_RX_EN_BIT,
+	       pie->base + LUOFU_PIE_RX_EN_OFF);
+}
