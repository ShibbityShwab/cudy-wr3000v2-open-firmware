+static irqreturn_t luofu_pie_rx_interrupt(int irq, void *data)
+{
+	struct luofu_pie_irq *priv = data;
+	struct luofu_pie *pie = priv->pie;
+	irqreturn_t ret = IRQ_NONE;
+	unsigned int i;
+
+	if (!READ_ONCE(pie->armed))
+		return IRQ_NONE;
+
+	for (i = 0; i < ARRAY_SIZE(luofu_pie_vector_chans[0]); i++) {
+		unsigned int ch = luofu_pie_vector_chans[priv->vector][i];
+
+		/*
+		 * The upper channel of each pair is the Wi-Fi offload half of
+		 * the engine.  It is not initialized here and its interrupt is
+		 * left masked; never service it.
+		 */
+		if (ch >= pie->rx_chans)
+			continue;
+		if (readl(pie->base + LUOFU_PIE_RX_IRQ_MASK_OFF(ch)) &
+		    LUOFU_PIE_RX_IRQ_BIT)
+			continue;
+		if (!(readl(pie->base + LUOFU_PIE_RX_IRQ_STS_OFF(ch)) &
+		      LUOFU_PIE_RX_IRQ_BIT))
+			continue;
+		if (!napi_schedule_prep(&pie->napi[ch].napi))
+			continue;
+
+		/* Recorded order: schedule, mask, acknowledge, then poll. */
+		writel(LUOFU_PIE_RX_IRQ_BIT,
+		       pie->base + LUOFU_PIE_RX_IRQ_MASK_OFF(ch));
+		writel(LUOFU_PIE_RX_IRQ_BIT,
+		       pie->base + LUOFU_PIE_RX_IRQ_STS_OFF(ch));
+		__napi_schedule(&pie->napi[ch].napi);
+		ret = IRQ_HANDLED;
+	}
+
+	return ret;
+}
+
+static int luofu_pie_rx_poll(struct napi_struct *napi, int budget)
+{
+	struct luofu_pie_napi *np = container_of(napi, struct luofu_pie_napi,
+						 napi);
+	struct luofu_pie *pie = np->pie;
+	unsigned int ch = np->ch;
+	struct luofu_pie_ring *ring = &pie->rx_ring[ch];
+	u32 hw_rptr, delta;
+	unsigned int done = 0;
+
+	hw_rptr = readl(pie->base + LUOFU_PIE_RX_RPTR_OFF(ch)) & 0xffff;
+	delta = (hw_rptr - (ring->rptr & 0xffff)) & 0xffff;
+	if (delta > ring->entries)
+		delta = ring->entries;
+
+	while (done < budget && done < delta) {
+		u32 index = (ring->rptr + done) & (ring->entries - 1);
+		struct luofu_pie_desc *desc =
+			luofu_pie_desc_at(ring->desc, index);
+
+		/*
+		 * The engine clears the owner bit when it has written a
+		 * completion ([I] direction).  Stop at the first descriptor
+		 * that is still owned by the engine.
+		 */
+		if (desc->bytes[LUOFU_PIE_DESC_OWNER_BYTE] &
+		    LUOFU_PIE_DESC_OWNER_BIT)
+			break;
+
+		/*
+		 * The completion status/length decode is [U], so the buffer
+		 * is NOT handed to the stack: the descriptor is re-armed for
+		 * the next frame and the completion is accounted as a drop.
+		 * The DMA mapping stays valid (coherent, never unmapped until
+		 * the channel is halted), so no cache work is needed.
