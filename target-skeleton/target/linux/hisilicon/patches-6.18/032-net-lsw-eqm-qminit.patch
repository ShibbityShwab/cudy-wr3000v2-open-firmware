+/*
+ * W7: the EQM queue-manager init write set.
+ *
+ * The vendor switch initialises the queue manager in hi_queue_init@0x507c and
+ * its per-group/per-qid helpers: the EQM indirect tables 19 (cell-count
+ * record), 32 (per-queue-port deque record), 35 (per-qid buffer record), 17
+ * (scheduler profile), 16 (per-qid tag row) and 34 (per-qid deque map), plus
+ * table 38 (per-qid scheduler state) and the virtual-port class, which stay
+ * out of this write set (see luofu-switch-regs.h, W7 section, and SUMMARY.md).
+ *
+ * The write set is built from the same contiguous qid allocation model patch
+ * 022 validates against the measured qid maps: the nine wired queue groups are
+ * ports 4..12, they own qids 1..72, eight per port in variant->qid_ports order.
+ * Every entry is snapshotted before the first write, the expected post-write
+ * content is computed from the snapshot plus the vendor formulas (never from an
+ * invented value), every entry is written through the decoded indirect engine
+ * and then read back; the first mismatch restores the whole snapshot and fails
+ * the probe closed.  The snapshot lives in driver state so remove() restores it
+ * as well.
+ */
+
+/* [V] table id per item kind; order matches enum luofu_switch_qm_kind. */
+static const u8 luofu_switch_qm_tables[] = {
+	LUOFU_SWITCH_EQM_TAB_QUEUE_INFO,
+	LUOFU_SWITCH_EQM_TAB_QPORT,
+	LUOFU_SWITCH_EQM_TAB_QBUF,
+	LUOFU_SWITCH_EQM_TAB_QSCH,
+	LUOFU_SWITCH_EQM_TAB_QTAG,
+	LUOFU_SWITCH_EQM_TAB_QDEQUE,
+};
+
+/* [V] EQM indirect data registers: write words 0..4, read words 0..4. */
+static const u16 luofu_switch_eqm_wdata[LUOFU_SWITCH_EQM_IND_WORDS] = {
+	LUOFU_SWITCH_EQM_WDATA0,
+	LUOFU_SWITCH_EQM_WDATA0 + LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_WDATA0 + 2 * LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_WDATA0 + 3 * LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_WDATA0 + 4 * LUOFU_SWITCH_EQM_WDATA_STRIDE,
+};
+
+static const u16 luofu_switch_eqm_rdata[LUOFU_SWITCH_EQM_IND_WORDS] = {
+	LUOFU_SWITCH_EQM_RDATA0,
+	LUOFU_SWITCH_EQM_RDATA0 + LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_RDATA0 + 2 * LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_RDATA0 + 3 * LUOFU_SWITCH_EQM_WDATA_STRIDE,
+	LUOFU_SWITCH_EQM_RDATA4,
+};
+
+static int luofu_switch_eqm_access(struct luofu_switch *lsw, bool write,
+				   u8 table, u16 index, u32 *words)
+{
+	void __iomem *eqm = lsw->window[LUOFU_SWITCH_WIN_EQM];
+	unsigned int i;
+	u32 status;
+	u32 cmd;
+
+	if (!eqm)
+		return -EINVAL;
+
+	cmd = (index & LUOFU_SWITCH_EQM_IND_INDEX_MASK) |
+	      ((u32)(table & (LUOFU_SWITCH_EQM_IND_TABLES - 1)) <<
+	       LUOFU_SWITCH_EQM_IND_TABLE_SHIFT) |
+	      LUOFU_SWITCH_EQM_IND_START |
+	      (write ? LUOFU_SWITCH_EQM_IND_WRITE : 0);
+
+	for (i = 0; write && i < LUOFU_SWITCH_EQM_IND_WORDS; i++)
+		writel(words[i], eqm + luofu_switch_eqm_wdata[i]);
+
+	writel(cmd, eqm + LUOFU_SWITCH_EQM_IND_CMD);
+
+	for (i = 0; i < LUOFU_SWITCH_EQM_IND_POLL; i++) {
+		status = readl(eqm + LUOFU_SWITCH_EQM_IND_CMD);
+		if (!(status & LUOFU_SWITCH_EQM_IND_BUSY))
+			break;
+		cpu_relax();
+	}
+	if (i == LUOFU_SWITCH_EQM_IND_POLL)
+		return -ETIMEDOUT;
+	if (status & LUOFU_SWITCH_EQM_IND_ERROR)
+		return -EIO;
+
+	if (!write)
+		for (i = 0; i < LUOFU_SWITCH_EQM_IND_WORDS; i++)
+			words[i] = readl(eqm + luofu_switch_eqm_rdata[i]);
+
+	return 0;
+}
+
+/* The qid of one slot of a queue group in the measured allocation model. */
+static int luofu_switch_qm_qid(const struct luofu_switch_variant *variant,
+			       const struct luofu_switch_qm_port *port,
+			       unsigned int slot)
+{
+	unsigned int i;
+
+	for (i = 0; i < variant->num_qid_ports; i++)
+		if (variant->qid_ports[i] == port->port)
+			return variant->qid_first + i * LUOFU_SWITCH_QID_SLOTS +
+			       slot;
+
+	return -EINVAL;
+}
+
+/* The table 17 scheduler profile of one slot of a queue group. [V] formula. */
+static unsigned int
+luofu_switch_qm_profile(const struct luofu_switch_qm_port *port,
+			unsigned int slot)
+{
+	if (port->profile_sel <= 7)
+		return port->profile_base + port->profile_sel;
+
+	return port->profile_base + slot;
+}
+
+static int luofu_switch_qm_add(struct luofu_switch_qm *qm,
+			       enum luofu_switch_qm_kind kind, u16 index)
+{
+	if (qm->count >= LUOFU_SWITCH_QM_ITEM_MAX)
+		return -E2BIG;
+	qm->item[qm->count].kind = kind;
+	qm->item[qm->count].index = index;
+	qm->count++;
+	return 0;
+}
+
+static bool luofu_switch_qm_has(const struct luofu_switch_qm *qm,
+				enum luofu_switch_qm_kind kind, u16 index)
+{
+	unsigned int i;
+
+	for (i = 0; i < qm->count; i++)
+		if (qm->item[i].kind == kind && qm->item[i].index == index)
+			return true;
+
+	return false;
+}
+
+/* Build the W7 item list in the vendor init order (shared entries once). */
+static int luofu_switch_qm_build(struct luofu_switch *lsw)
+{
+	const struct luofu_switch_variant *variant = lsw->variant;
+	struct luofu_switch_qm *qm;
+	unsigned int i, slot, row;
+	int qid, ret;
+
+	qm = devm_kzalloc(lsw->dev, sizeof(*qm), GFP_KERNEL);
+	if (!qm)
+		return -ENOMEM;
+	lsw->qm = qm;
+
+	ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QUEUE_INFO, 0);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < variant->num_qm_ports; i++) {
+		ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QPORT,
+					  variant->qm_ports[i].port);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < variant->num_qm_ports; i++) {
+		for (slot = 0; slot < LUOFU_SWITCH_EQM_QPORT_SLOTS; slot++) {
+			qid = luofu_switch_qm_qid(variant, &variant->qm_ports[i],
+						  slot);
+			if (qid < 0)
+				return qid;
+			ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QBUF,
+						  qid);
+			if (ret)
+				return ret;
+		}
+	}
+
+	for (i = 0; i < variant->num_qm_ports; i++) {
+		for (slot = 0; slot < LUOFU_SWITCH_EQM_QPORT_SLOTS; slot++) {
+			u16 profile;
+
+			profile = luofu_switch_qm_profile(&variant->qm_ports[i], slot);
+			if (luofu_switch_qm_has(qm, LUOFU_SWITCH_QM_QSCH,
+						profile))
+				continue;
+			ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QSCH,
+						  profile);
+			if (ret)
+				return ret;
+		}
+	}
+
+	for (i = 0; i < variant->num_qm_ports; i++) {
+		for (slot = 0; slot < LUOFU_SWITCH_EQM_QPORT_SLOTS; slot++) {
+			qid = luofu_switch_qm_qid(variant, &variant->qm_ports[i],
+						  slot);
+			if (qid < 0)
+				return qid;
+			row = (unsigned int)qid / 16;
+			if (luofu_switch_qm_has(qm, LUOFU_SWITCH_QM_QTAG, row))
+				continue;
+			ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QTAG,
+						  row);
+			if (ret)
+				return ret;
+		}
+	}
+
+	for (i = 0; i < variant->num_qm_ports; i++) {
+		for (slot = 0; slot < LUOFU_SWITCH_EQM_QPORT_SLOTS; slot++) {
+			qid = luofu_switch_qm_qid(variant, &variant->qm_ports[i],
+						  slot);
+			if (qid < 0)
+				return qid;
+			ret = luofu_switch_qm_add(qm, LUOFU_SWITCH_QM_QDEQUE,
+						  qid);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Pre-write snapshot and conformance: every target entry is read twice and must
+ * be stable, and the indirect interface must be idle.  A live, changing entry
+ * means the queue manager is not quiescent: refuse instead of overwriting a
+ * moving target.
+ */
+static int luofu_switch_qm_snapshot(struct luofu_switch *lsw)
+{
+	struct luofu_switch_qm *qm = lsw->qm;
+	void __iomem *eqm = lsw->window[LUOFU_SWITCH_WIN_EQM];
+	u32 again[LUOFU_SWITCH_EQM_IND_WORDS];
+	unsigned int i, w;
+	u32 status;
+	int ret;
+
+	status = readl(eqm + LUOFU_SWITCH_EQM_IND_CMD);
+	if (status & (LUOFU_SWITCH_EQM_IND_BUSY | LUOFU_SWITCH_EQM_IND_ERROR))
+		return dev_err_probe(lsw->dev, -EIO,
+				     "eqm+0x48 reads %#x: the indirect interface is busy or in error; refusing to write the queue-manager tables\n",
+				     status);
+
+	for (i = 0; i < qm->count; i++) {
+		u8 table = luofu_switch_qm_tables[qm->item[i].kind];
+		u16 index = qm->item[i].index;
+
+		ret = luofu_switch_eqm_access(lsw, false, table, index,
+					      qm->pre[i]);
+		if (ret)
+			return dev_err_probe(lsw->dev, ret,
+					     "EQM table %u entry %u read failed during the pre-write snapshot\n",
+					     table, index);
+		ret = luofu_switch_eqm_access(lsw, false, table, index, again);
+		if (ret)
+			return dev_err_probe(lsw->dev, ret,
+					     "EQM table %u entry %u re-read failed during the pre-write snapshot\n",
+					     table, index);
+		for (w = 0; w < LUOFU_SWITCH_EQM_IND_WORDS; w++)
+			if (qm->pre[i][w] != again[w])
+				return dev_err_probe(lsw->dev, -EIO,
+						     "EQM table %u entry %u word %u changed between two reads (%#x -> %#x); the queue manager is not quiescent, refusing to write\n",
+						     table, index, w,
+						     qm->pre[i][w], again[w]);
+	}
+
+	dev_info(lsw->dev,
+		 "W7 snapshot: %u EQM table entries (%u words) read and stable, indirect interface idle (eqm+0x48 %#x)\n",
+		 qm->count, qm->count * LUOFU_SWITCH_EQM_IND_WORDS, status);
+	return 0;
+}
+
+/*
+ * Compute the expected post-write content of every entry.  Read-modify-write
+ * entries start from the snapshot and set only the fields the vendor sets; the
+ * three full-write entries are the vendor's constants.
+ */
+static void luofu_switch_qm_compute(struct luofu_switch *lsw, u32 cell_cfg)
+{
+	const struct luofu_switch_variant *variant = lsw->variant;
+	struct luofu_switch_qm *qm = lsw->qm;
+	unsigned int i, j, slot;
+	u32 cells = cell_cfg & LUOFU_SWITCH_EQM_QSCH_CELLS_MASK;
+
+	for (i = 0; i < qm->count; i++) {
+		struct luofu_switch_qm_item *item = &qm->item[i];
+		u32 *pre = qm->pre[i];
+		u32 *want = qm->want[i];
+
+		memcpy(want, pre, sizeof(qm->pre[i]));
+
+		switch (item->kind) {
+		case LUOFU_SWITCH_QM_QUEUE_INFO:
+			want[0] = LUOFU_SWITCH_EQM_CELL_REC0;
+			want[1] = LUOFU_SWITCH_EQM_CELL_REC1;
+			for (j = 2; j < LUOFU_SWITCH_EQM_IND_WORDS; j++)
+				want[j] = 0xffffffff;
+			break;
+		case LUOFU_SWITCH_QM_QPORT: {
+			u32 pri = 0;
+
+			for (slot = 0; slot < LUOFU_SWITCH_EQM_QPORT_SLOTS;
+			     slot++)
+				pri |= (LUOFU_SWITCH_EQM_QPORT_SLOTS - 1 - slot) <<
+				       (slot * LUOFU_SWITCH_EQM_QPORT_PRI_BITS);
+			want[0] = (pre[0] & ~GENMASK(7, 0)) |
+				  ((item->index *
+				    LUOFU_SWITCH_EQM_QPORT_SLOT_BASE) &
+				   GENMASK(7, 0));
+			want[1] = (pre[1] & ~LUOFU_SWITCH_EQM_QPORT_PRI_MASK) |
+				  pri;
+			break;
+		}
+		case LUOFU_SWITCH_QM_QBUF:
+			want[0] = LUOFU_SWITCH_EQM_QBUF_WORD0;
+			for (j = 1; j < LUOFU_SWITCH_EQM_IND_WORDS; j++)
+				want[j] = 0;
+			break;
+		case LUOFU_SWITCH_QM_QSCH: {
+			const struct luofu_switch_qm_port *port;
+			u32 rate = 0;
+			u32 sch = 0;
+			u32 value;
+
+			for (j = 0; j < variant->num_qm_ports; j++) {
+				port = &variant->qm_ports[j];
+				for (slot = 0;
+				     slot < LUOFU_SWITCH_EQM_QPORT_SLOTS;
+				     slot++) {
+					if (luofu_switch_qm_profile(port, slot) !=
+					    item->index)
+						continue;
+					rate = port->rate;
+					sch = port->sch_id;
+					break;
+				}
+				if (rate)
+					break;
+			}
+			if (!rate)
+				continue;
+			value = cells < rate ? rate :
+				rate / LUOFU_SWITCH_EQM_QSCH_DIV_MIN;
+			want[0] = rate & LUOFU_SWITCH_EQM_QSCH_RATE_MASK;
+			want[1] = LUOFU_SWITCH_EQM_QSCH_WORD1;
+			want[2] = LUOFU_SWITCH_EQM_QSCH_RATE_HI |
+				  (rate & GENMASK(15, 0));
+			want[3] = ((sch & LUOFU_SWITCH_EQM_QSCH_SCH_MASK) <<
+				   LUOFU_SWITCH_EQM_QSCH_SCH_SHIFT) |
+				  (value & LUOFU_SWITCH_EQM_QSCH_CELLS_MASK);
+			want[4] = LUOFU_SWITCH_EQM_QSCH_WORD4;
+			break;
+		}
+		case LUOFU_SWITCH_QM_QTAG:
+			for (j = 0; j < variant->num_qm_ports; j++) {
+				const struct luofu_switch_qm_port *port =
+					&variant->qm_ports[j];
+				int qid;
+
+				for (slot = 0;
+				     slot < LUOFU_SWITCH_EQM_QPORT_SLOTS;
+				     slot++) {
+					unsigned int byte, shift, word;
+					u32 cur, val;
+
+					qid = luofu_switch_qm_qid(variant, port,
+								  slot);
+					if (qid < 0 || qid / 16 != item->index)
+						continue;
+					byte = qid & 15;
+					word = byte >> 2;
+					shift = (byte & 3) * 8;
+					cur = (want[word] >> shift) & 0xff;
+					val = LUOFU_SWITCH_EQM_QTAG_VALID |
+					      (luofu_switch_qm_profile(port,
+								       slot) &
+					       LUOFU_SWITCH_EQM_QTAG_VALUE_MASK) |
+					      (cur & LUOFU_SWITCH_EQM_QTAG_KEEP);
+					want[word] = (want[word] &
+						      ~(0xffu << shift)) |
+						     (val << shift);
+				}
+			}
+			break;
+		case LUOFU_SWITCH_QM_QDEQUE:
+			for (j = 0; j < variant->num_qm_ports; j++) {
+				const struct luofu_switch_qm_port *port =
+					&variant->qm_ports[j];
+				int qid;
+
+				for (slot = 0;
+				     slot < LUOFU_SWITCH_EQM_QPORT_SLOTS;
+				     slot++) {
+					qid = luofu_switch_qm_qid(variant, port,
+								  slot);
+					if (qid != item->index)
+						continue;
+					want[0] = (pre[0] &
+						   ~(LUOFU_SWITCH_EQM_QDEQUE_QP_MASK |
+						     LUOFU_SWITCH_EQM_QDEQUE_INPUT |
+						     LUOFU_SWITCH_EQM_QDEQUE_SLOT_MASK |
+						     LUOFU_SWITCH_EQM_QDEQUE_VALID)) |
+						  (port->port &
+						   LUOFU_SWITCH_EQM_QDEQUE_QP_MASK) |
+						  LUOFU_SWITCH_EQM_QDEQUE_INPUT |
+						  ((slot <<
+						    LUOFU_SWITCH_EQM_QDEQUE_SLOT_SHIFT) &
+						   LUOFU_SWITCH_EQM_QDEQUE_SLOT_MASK) |
+						  LUOFU_SWITCH_EQM_QDEQUE_VALID;
+				}
+			}
+			break;
+		}
+	}
+}
+
+static int luofu_switch_qm_write(struct luofu_switch *lsw)
+{
+	struct luofu_switch_qm *qm = lsw->qm;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < qm->count; i++) {
+		u8 table = luofu_switch_qm_tables[qm->item[i].kind];
+
+		ret = luofu_switch_eqm_access(lsw, true, table,
+					      qm->item[i].index, qm->want[i]);
+		if (ret)
+			return dev_err_probe(lsw->dev, ret,
+					     "EQM write failed at table %u entry %u\n",
+					     table, qm->item[i].index);
+	}
+
+	return 0;
+}
+
+/* Restore every entry of the W7 write set from the pre-write snapshot. */
+static void luofu_switch_qm_restore(struct luofu_switch *lsw)
+{
+	struct luofu_switch_qm *qm = lsw->qm;
+	unsigned int i;
+	int ret;
+
+	if (!qm)
+		return;
+
+	for (i = 0; i < qm->count; i++) {
+		u8 table = luofu_switch_qm_tables[qm->item[i].kind];
+
+		ret = luofu_switch_eqm_access(lsw, true, table,
+					      qm->item[i].index, qm->pre[i]);
+		if (ret)
+			dev_err(lsw->dev,
+				"EQM restore failed at table %u entry %u: %d\n",
+				table, qm->item[i].index, ret);
+	}
+}
+
+static int luofu_switch_qm_verify(struct luofu_switch *lsw)
+{
+	struct luofu_switch_qm *qm = lsw->qm;
+	u32 got[LUOFU_SWITCH_EQM_IND_WORDS] = { 0 };
+	unsigned int i, w = 0;
+	int ret;
+
+	for (i = 0; i < qm->count; i++) {
+		u8 table = luofu_switch_qm_tables[qm->item[i].kind];
+		u16 index = qm->item[i].index;
+
+		ret = luofu_switch_eqm_access(lsw, false, table, index, got);
+		if (ret)
+			goto mismatch;
+		for (w = 0; w < LUOFU_SWITCH_EQM_IND_WORDS; w++)
+			if (got[w] != qm->want[i][w])
+				goto mismatch;
+	}
+
+	{
+		unsigned int qids = lsw->variant->num_qm_ports *
+				    LUOFU_SWITCH_EQM_QPORT_SLOTS;
+		unsigned int profiles = 0;
+
+		for (i = 0; i < qm->count; i++)
+			if (qm->item[i].kind == LUOFU_SWITCH_QM_QSCH)
+				profiles++;
+		dev_info(lsw->dev,
+			 "W7: %u EQM table entries (%u words) programmed and verified: table 19 cell record, table 32 x %u queue ports, table 35/16/34 x %u qids, table 17 x %u scheduler profiles\n",
+			 qm->count, qm->count * LUOFU_SWITCH_EQM_IND_WORDS,
+			 lsw->variant->num_qm_ports, qids, profiles);
+	}
+	return 0;
+
+mismatch:
+	if (ret)
+		dev_err(lsw->dev,
+			"EQM readback failed at table %u entry %u: %d\n",
+			luofu_switch_qm_tables[qm->item[i].kind],
+			qm->item[i].index, ret);
+	else
+		dev_err(lsw->dev,
+			"EQM readback mismatch at table %u entry %u word %u: read %#x, expected %#x; restoring the pre-write snapshot\n",
+			luofu_switch_qm_tables[qm->item[i].kind],
+			qm->item[i].index, w, got[w], qm->want[i][w]);
+	luofu_switch_qm_restore(lsw);
+	return -EIO;
+}
+
+static int luofu_switch_qm_program(struct luofu_switch *lsw)
+{
+	void __iomem *eqm = lsw->window[LUOFU_SWITCH_WIN_EQM];
+	u32 cell_cfg;
+	int ret;
+
+	if (!eqm)
+		return -EINVAL;
+
+	ret = luofu_switch_qm_build(lsw);
+	if (ret)
+		return dev_err_probe(lsw->dev, ret,
+				     "cannot build the W7 EQM init write set\n");
+
+	ret = luofu_switch_qm_snapshot(lsw);
+	if (ret)
+		return ret;
+
+	cell_cfg = readl(eqm + LUOFU_SWITCH_EQM_CELL_CFG1);
+	luofu_switch_qm_compute(lsw, cell_cfg);
+
+	ret = luofu_switch_qm_write(lsw);
+	if (ret) {
+		luofu_switch_qm_restore(lsw);
+		return ret;
+	}
+
+	return luofu_switch_qm_verify(lsw);
+}
