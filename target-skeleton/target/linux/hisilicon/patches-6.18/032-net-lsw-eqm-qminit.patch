+ *
+ * Measured evidence that this engine ran on the stock boot [V]: eqm+0x48 =
+ * 0x41100012 == a completed write of table 17, index 18, and eqm+0x5c =
+ * 0xbb8 = 3000 == that write's first data word, which is exactly the rate
+ * the vendor's last profile write for ports 5..7 carries.
+ *
+ * The write set (all tables are EQM indirect tables; the field/record shapes
+ * below are the vendor write shape [V], the semantics are [I]/[U]):
+ *
+ *   table 19, index 0   8-word cell-count record, 5 words actually written:
+ *                       { 0xffffffff, 0xffffc3e8, 0xffffffff, 0xffffffff,
+ *                         0xffffffff }  (0xff-filled buffer, word 1 low 14
+ *                       bits = 1000).  hi_queue_init@0x5164..0x5198.
+ *   table 32, index P   8-word per-queue-port record, 5 words written; the
+ *                       vendor writes byte 0 = P * 8 and then 3-bit slot
+ *                       priorities 7..0 for slots 0..7 (bits 0..23 of word 1).
+ *                       Helper at 0x20f8 (header) and 0x2184 (priorities).
+ *   table 35, index qid per-qid buffer record, 5 words written: word 0 =
+ *                       0x00070000 (byte 2 = 7), rest zero.  Helper 0x2b40.
+ *   table 17, profile   5-word scheduler profile (helper 0x24d0): word 0 =
+ *                       rate & 0x1fff; word 1 = 0x10000000; word 2 =
+ *                       0xffff0000 | rate; word 3 = ((sch & 0x1ff) << 20) |
+ *                       cells; word 4 = 0x07f03fff, where cells = rate if
+ *                       (eqm+0x38 & 0x3fff) < rate, else rate / 2 (the
+ *                       vendor's min divider comes from .data..read_mostly+4
+ *                       = 2).
+ *   table 16, index row per-qid 5-bit tag row (16 qids/row, helper 0x223c):
+ *                       byte (qid & 15) = 0x80 | (profile & 0x1f), preserving
+ *                       bits 6:5.
+ *   table 34, index qid  per-qid deque map (helper 0x22ec): word 0 =
+ *                       queue-port in bits 5:0 (the LSW hardware port P),
+ *                       slot in bits 17:14, bit 13 = 1 ("input"/root), bit 18
+ *                       = 1 (valid); bits 6..12 and 19..31 preserved.
+ *
+ * The per-port queue-group constants (profile base/selector, scheduler id and
+ * rate) are the vendor's build-time .data+0xd0 table entries for ports 4..12,
+ * i.e. the nine populated rows of the measured qid-map allocation model:
+ *
+ *   port  base  sel  sch   rate
+ *     4   0x10    1  0x20  3000
+ *     5   0x10    2  0x20  3000
+ *     6   0x10    2  0x20  3000
+ *     7   0x10    2  0x20  3000
+ *   8-12  0x00    8  0x20  2500
+ *
+ * profile(port, slot) = base + (sel <= 7 ? sel : slot); qid(port, slot) =
+ * qid_first + port_index * 8 + slot with port_index the position of the port
+ * in variant->qid_ports (the same allocation model patch 022 programs and
+ * validates).
+ *
+ * Deliberately not in the W7 write set (documented in SUMMARY.md):
+ *   - table 38 (per-qid scheduler/buffer state): the vendor writes a
+ *     table-manager id into it (hi_tab_mgr_alloc_hash) that only exists
+ *     inside the vendor software table manager and cannot be reproduced
+ *     from this evidence base; its validity semantics are [U].
+ *   - the ports 40..43 virtual-port class (table 32 indices 35..38 and table
+ *     34 indices 227..230 in the vendor code): the GEMAC wired egress path
+ *     does not use the Wi-Fi/VP class on this board and its index space is
+ *     [U]; excluded by design, not forgotten.
+ *   - the queue/flow DDR region contents: not mapped, not written.
+ */
+#define LUOFU_SWITCH_EQM_IND_WORDS	5	/* [V] one op moves <= 5 words */
+#define LUOFU_SWITCH_EQM_IND_POLL	1001	/* [V] vendor poll count */
+#define LUOFU_SWITCH_EQM_IND_START	BIT(31)	/* [V] start/busy */
+#define LUOFU_SWITCH_EQM_IND_WRITE	BIT(30)	/* [V] 1 = write, 0 = read */
+#define LUOFU_SWITCH_EQM_IND_TABLE_SHIFT 20	/* [V] table id field */
+#define LUOFU_SWITCH_EQM_IND_TABLE_MASK	GENMASK(26, 20)
+#define LUOFU_SWITCH_EQM_IND_INDEX_MASK	GENMASK(15, 0)
+#define LUOFU_SWITCH_EQM_IND_TABLES	128	/* [V] 7-bit table id space */
+
+/* [V] The indirect tables the W7 write set uses (id space is the vendor's). */
+#define LUOFU_SWITCH_EQM_TAB_QTAG	16	/* per-qid 5-bit tag row */
+#define LUOFU_SWITCH_EQM_TAB_QSCH	17	/* scheduler profile */
+#define LUOFU_SWITCH_EQM_TAB_QUEUE_INFO	19	/* cell-count record */
+#define LUOFU_SWITCH_EQM_TAB_QPORT	32	/* per-queue-port deque record */
+#define LUOFU_SWITCH_EQM_TAB_QDEQUE	34	/* per-qid deque map */
+#define LUOFU_SWITCH_EQM_TAB_QBUF	35	/* per-qid buffer record */
+
+/*
+ * [V] data register offsets, words 0..4.  Write data goes to +0x5c/+0x60/
+ * +0x64/+0x68/+0x70, read data comes from +0x4c/+0x50/+0x54/+0x58/+0x6c
+ * (the vendor's g_eqm_tab_ba pairs decoded from the fixture's .rodata).
+ */
+#define LUOFU_SWITCH_EQM_WDATA0		0x5c
+#define LUOFU_SWITCH_EQM_WDATA_STRIDE	4
+#define LUOFU_SWITCH_EQM_RDATA0		0x4c
+#define LUOFU_SWITCH_EQM_RDATA4		0x6c
+
+/* [V] table 19 cell-count record (5 words actually written). */
+#define LUOFU_SWITCH_EQM_CELL_WORDS	1000
+#define LUOFU_SWITCH_EQM_CELL_REC0	0xffffffff
+#define LUOFU_SWITCH_EQM_CELL_REC1	\
+	(0xffff0000 | (LUOFU_SWITCH_EQM_CELL_WORDS & GENMASK(13, 0)))
+
+/* [V] table 35 per-qid buffer record: byte 2 = 7, 5-word buffer. */
+#define LUOFU_SWITCH_EQM_QBUF_WORD0	0x00070000
+
+/* [V] table 32 per-queue-port record. */
+#define LUOFU_SWITCH_EQM_QPORT_SLOT_BASE	8	/* byte 0 = port * 8 */
+#define LUOFU_SWITCH_EQM_QPORT_PRI_MASK		GENMASK(23, 0)
+#define LUOFU_SWITCH_EQM_QPORT_PRI_BITS		3
+#define LUOFU_SWITCH_EQM_QPORT_SLOTS		8
+
+/* [V] table 34 per-qid deque map word 0 fields. */
+#define LUOFU_SWITCH_EQM_QDEQUE_QP_MASK		GENMASK(5, 0)
+#define LUOFU_SWITCH_EQM_QDEQUE_INPUT		BIT(13)
+#define LUOFU_SWITCH_EQM_QDEQUE_SLOT_MASK	GENMASK(17, 14)
+#define LUOFU_SWITCH_EQM_QDEQUE_SLOT_SHIFT	14
+#define LUOFU_SWITCH_EQM_QDEQUE_VALID		BIT(18)
+
+/* [V] table 16 per-qid tag byte fields. */
+#define LUOFU_SWITCH_EQM_QTAG_VALID		BIT(7)
+#define LUOFU_SWITCH_EQM_QTAG_KEEP		GENMASK(6, 5)
+#define LUOFU_SWITCH_EQM_QTAG_VALUE_MASK	GENMASK(4, 0)
+
+/* [V] table 17 scheduler profile fields and the vendor's build-time constants. */
+#define LUOFU_SWITCH_EQM_QSCH_RATE_MASK		GENMASK(12, 0)
+#define LUOFU_SWITCH_EQM_QSCH_RATE_HI		0xffff0000
+#define LUOFU_SWITCH_EQM_QSCH_WORD1		0x10000000
+#define LUOFU_SWITCH_EQM_QSCH_WORD4		0x07f03fff
+#define LUOFU_SWITCH_EQM_QSCH_SCH_MASK		GENMASK(8, 0)
+#define LUOFU_SWITCH_EQM_QSCH_SCH_SHIFT		20
+#define LUOFU_SWITCH_EQM_QSCH_CELLS_MASK	GENMASK(13, 0)
+#define LUOFU_SWITCH_EQM_QSCH_DIV_MIN		2	/* [V] read_mostly+4 */
+
 #endif /* __LUOFU_SWITCH_REGS_H */
