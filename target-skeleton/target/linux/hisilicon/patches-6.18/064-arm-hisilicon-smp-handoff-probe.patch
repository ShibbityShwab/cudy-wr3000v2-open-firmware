 early_param("luofu_smp_early_probe", luofu_smp_setup_early_probe);
 
 /*
+ * SMP handoff probes (patch 060).
+ *
+ * The decompressor (arch/arm/boot/compressed/head.S) writes a marker-only
+ * stub at PA 0x80600040 and points the SYSCTRL pen at it from its very
+ * first instruction; the decompressed kernel's stext does the same with a
+ * second stub at PA 0x80600080.  Each stub writes its MPIDR into its marker
+ * word and spins, so a secondary core that takes the pen parks safely.
+ *
+ * Reading the markers at early_param time is the point: it happens before
+ * arm_memblock_init()/paging_init(), so no kernel allocation can have
+ * overwritten them, and the early_ioremap() window gives an uncached view
+ * of the RAM bytes the secondary core wrote with its caches off.
+ *
+ *   A != 0  the loader's consumer was alive at the decompressor's entry
+ *   B != 0  it was still alive at stext (after decompression)
+ *   A = B = 0  it was gone before our kernel ran at all
+ */
+#define LUOFU_HANDOFF_WINDOW_PA	0x80600000UL
+#define LUOFU_HANDOFF_MARK_A	0x10
+#define LUOFU_HANDOFF_MARK_B	0x20
+
+static u32 luofu_smp_handoff_marker_early(unsigned long pa)
+{
+	void __iomem *win;
+	u32 val = 0;
+
+	win = early_ioremap(LUOFU_HANDOFF_WINDOW_PA, SZ_4K);
+	if (win) {
+		val = readl_relaxed(win + (pa - LUOFU_HANDOFF_WINDOW_PA));
+		early_iounmap(win, SZ_4K);
+	}
+	return val;
+}
+
+/* At prepare the linear map is fine; the line may already be stale, so this
+ * print is informational only (the early_param read above is authoritative). */
+static u32 luofu_smp_handoff_marker_va(unsigned long pa)
+{
+	void *v = __va(pa);
+
+	__sync_cache_range_r(v, sizeof(u32));
+	return READ_ONCE(*(u32 *)v);
+}
+
+static int __init luofu_smp_setup_handoff_probe(char *val)
+{
+	void __iomem *sysctrl, *scu;
+	u32 a, b, pen = 0, scu_cfg = 0;
+
+	if (!val) {
+		pr_warn("luofu-smp: ignoring luofu_smp_handoff_probe without value\n");
+		return 0;
+	}
+
+	a = luofu_smp_handoff_marker_early(0x80600010);
+	b = luofu_smp_handoff_marker_early(0x80600020);
+	sysctrl = early_ioremap(LUOFU_SYSCTRL_PA, SZ_4K);
+	scu = early_ioremap(0x10180000, SZ_4K);
+	if (sysctrl)
+		pen = readl_relaxed(sysctrl + LUOFU_SMP_PEN_OFFSET);
+	if (scu)
+		scu_cfg = readl_relaxed(scu + 0x04);
+	if (sysctrl)
+		early_iounmap(sysctrl, SZ_4K);
+	if (scu)
+		early_iounmap(scu, SZ_4K);
+
+	pr_info("luofu-smp: handoff A=%08x B=%08x pen=%08x scu_cfg=%08x\n",
+		a, b, pen, scu_cfg);
+	pr_info("luofu-smp: handoff verdict decompressor-entry=%s kernel-stext=%s\n",
+		a ? "CONSUMED" : "no", b ? "CONSUMED" : "no");
+	pr_info("luofu-smp: handoff cpu1-ran monitor scu_cfg bit5=%s\n",
+		(scu_cfg & 0x20) ? "set" : "clear");
+	return 0;
+}
+early_param("luofu_smp_handoff_probe", luofu_smp_setup_handoff_probe);
