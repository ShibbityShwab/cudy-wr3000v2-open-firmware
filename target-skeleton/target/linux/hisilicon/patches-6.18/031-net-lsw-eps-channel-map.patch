+/*
+ * W6: program the EPS channel-map and companion words with the values measured
+ * on the stock boot.  Without them the switch has no channel mapping between
+ * the MAC/PIE channels and the switch ports: the PIE engine consumes TX
+ * descriptors but nothing appears on the wire, and ingress frames never reach
+ * the PIE RX rings.  Every word is written, read back and restored on mismatch.
+ */
+static int luofu_switch_eps_program(struct luofu_switch *lsw)
+{
+	const struct luofu_switch_variant *variant = lsw->variant;
+	u32 pre[32];
+	void __iomem *base;
+	unsigned int i, n = 0;
+
+	base = lsw->window[LUOFU_SWITCH_WIN_EPS];
+	if (!base)
+		return -EINVAL;
+
+	for (i = 0; i < variant->num_baseline; i++) {
+		const struct luofu_switch_baseline_entry *entry =
+			&variant->baseline[i];
+
+		if (entry->window != LUOFU_SWITCH_WIN_EPS ||
+		    strncmp(entry->name, "eps channel", 11))
+			continue;
+		if (n >= ARRAY_SIZE(pre))
+			return -E2BIG;
+		pre[n++] = readl(base + entry->offset);
+	}
+
+	for (i = 0; i < variant->num_baseline; i++) {
+		const struct luofu_switch_baseline_entry *entry =
+			&variant->baseline[i];
+
+		if (entry->window != LUOFU_SWITCH_WIN_EPS ||
+		    strncmp(entry->name, "eps channel", 11))
+			continue;
+
+		writel(entry->value, base + entry->offset);
+		if (readl(base + entry->offset) != entry->value) {
+			unsigned int m = 0, r = 0;
+
+			for (m = 0; m < variant->num_baseline; m++) {
+				const struct luofu_switch_baseline_entry *e2 =
+					&variant->baseline[m];
+
+				if (e2->window != LUOFU_SWITCH_WIN_EPS ||
+				    strncmp(e2->name, "eps channel", 11))
+					continue;
+				if (r < n)
+					writel(pre[r], base + e2->offset);
+				r++;
+			}
+			return dev_err_probe(lsw->dev, -EIO,
+					     "EPS channel map readback mismatch at %s\n",
+					     entry->name);
+		}
+	}
+
+	dev_info(lsw->dev,
+		 "W6: %u EPS channel-map/companion words programmed and verified (stock baselines)\n",
+		 n);
+	return 0;
+}
