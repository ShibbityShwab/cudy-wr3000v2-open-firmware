+/*
+ * Trampoline handoff mode (patch 061).
+ *
+ * Reserves the stub/marker page before arm_memblock_init() so the kernel can
+ * never allocate or reuse it, and switches the release path from the 035 probe
+ * stub to __pa_symbol(secondary_startup): the stext trampoline then sees the
+ * pen change and branches to the real secondary entry with secondary_data
+ * already prepared by __cpu_up().
+ */
+static int __init luofu_smp_setup_trampoline(char *val)
+{
+	if (!val)
+		return 0;
+	luofu_smp_trampoline = true;
+	if (memblock_reserve(LUOFU_HANDOFF_WINDOW_PA, SZ_4K))
+		pr_warn("luofu-smp: cannot reserve the trampoline page 0x80600000\n");
+	else
+		pr_info("luofu-smp: trampoline page 0x80600000-0x80600fff reserved; release pen = secondary_startup\n");
+	return 0;
+}
+early_param("luofu_smp_trampoline", luofu_smp_setup_trampoline);
+
+/* Marker report used at prepare, after the release and in late_initcall. */
