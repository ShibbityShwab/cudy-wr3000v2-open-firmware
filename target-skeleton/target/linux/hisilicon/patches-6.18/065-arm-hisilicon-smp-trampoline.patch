+	u32 b1 = luofu_smp_handoff_marker_va(0x80600024);
+	u32 b2 = luofu_smp_handoff_marker_va(0x80600028);
+
+	pr_info("luofu-smp: handoff %s A=%08x B0=%08x B1=%08x B2=%08x A=%s B=%s jump=%s target=%08x\n",
+		tag, a, b0, b1, b2, luofu_smp_handoff_state(a),
+		luofu_smp_handoff_state(b0),
+		(b1 == LUOFU_HANDOFF_JUMP_MAGIC) ? "YES" : "no", b2);
+	pr_info("luofu-smp: handoff %s cpu1-ran monitor scu_cfg=%08x bit5=%s\n",
+		tag, luofu_scu_read(LUOFU_SCU_CONFIG),
+		(luofu_scu_read(LUOFU_SCU_CONFIG) & 0x20) ? "set" : "clear");
+}
