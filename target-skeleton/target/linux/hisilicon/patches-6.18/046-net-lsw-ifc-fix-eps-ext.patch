+/*
+ * W12: the remaining persistent stock-vs-ours differences (patch 046).
+ *
+ * The 2026-11-20 read-only W11 dump diff (evidence
+ * build/evidence-bench-gates/2026-11-20-lsw-diff.txt) left exactly two classes
+ * of persistent configuration that the vendor stack sets and our W3-W10 write
+ * set does not:
+ *
+ *  1. sixteen extended EPS channel/companion words at eps+0xb20..0xb3c and
+ *     eps+0xba0..0xbbc (values below) - the second bank that W6's 16 baseline
+ *     words do not cover;
+ *  2. the DP runtime word dp+0x1c: the vendor probe writes
+ *     BIT(16) | a field it obtains from hi_system_mem_info_get (that field read
+ *     0 on our boot, hence W4's 0x10000), while the stock runtime word is
+ *     0x18000, i.e. the same plus BIT(15) [V measured].  Bit 15's meaning is
+ *     [U]; it is a vendor-supplied memory/runtime field, not a forwarding
+ *     enable - the observed value is replayed as the stock state.
+ *
+ * The EQM words in the same diff are the indirect command/data registers
+ * (eqm+0x48 command, +0x4c/+0x50..0x70 data), each side holding the residue of
+ * its own last queue-init command (stock: 0x41100012 = table 17 index 18 write;
+ * ours: our last W7 write).  They are not persistent configuration and are
+ * deliberately not replayed.
+ *
+ * All W12 words are snapshotted, required stable across two reads, written,
+ * read back exactly, and restored on any mismatch; the stage fails closed.
+ */
+struct luofu_switch_ext_word {
+	u16 offset;
+	u32 value;
+};
+
+static const struct luofu_switch_ext_word luofu_switch_v250_eps_ext[] = {
+	{ 0x0b20, 0x000000a0 }, { 0x0b24, 0x000810a0 },
+	{ 0x0b28, 0x000820a0 }, { 0x0b2c, 0x000830a0 },
+	{ 0x0b30, 0x000000b0 }, { 0x0b34, 0x000810b0 },
+	{ 0x0b38, 0x000820b0 }, { 0x0b3c, 0x000830b0 },
+	{ 0x0ba0, 0x8004ffff }, { 0x0ba4, 0x8105ffff },
+	{ 0x0ba8, 0x8106ffff }, { 0x0bac, 0x8107ffff },
+	{ 0x0bb0, 0x8004ffff }, { 0x0bb4, 0x8105ffff },
+	{ 0x0bb8, 0x8106ffff }, { 0x0bbc, 0x8107ffff },
+};
+
+static void luofu_switch_ext_restore(struct luofu_switch *lsw)
+{
+	unsigned int i;
+
+	for (i = 0; i < LUOFU_SWITCH_EPS_EXT_WORDS; i++)
+		writel(lsw->eps_ext_pre[i],
+		       lsw->window[LUOFU_SWITCH_WIN_EPS] +
+		       luofu_switch_v250_eps_ext[i].offset);
+	writel(lsw->dp_runtime_pre,
+	       lsw->window[LUOFU_SWITCH_WIN_DP] +
+	       LUOFU_SWITCH_DP_RUNTIME_OFF);
+}
+
+static int luofu_switch_ext_program(struct luofu_switch *lsw)
+{
+	void __iomem *eps = lsw->window[LUOFU_SWITCH_WIN_EPS];
+	void __iomem *dp = lsw->window[LUOFU_SWITCH_WIN_DP];
+	unsigned int i;
+	int ret = 0;
+
+	if (!eps || !dp)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "missing eps/dp window for the W12 stage\n");
+
+	dev_info(lsw->dev,
+		 "W12: extended EPS/DP runtime words: %u EPS words + dp+%#x, snapshotting the current state first\n",
+		 LUOFU_SWITCH_EPS_EXT_WORDS, LUOFU_SWITCH_DP_RUNTIME_OFF);
+
+	for (i = 0; i < LUOFU_SWITCH_EPS_EXT_WORDS; i++) {
+		u32 off = luofu_switch_v250_eps_ext[i].offset;
+		u32 a = readl(eps + off);
+
+		if (readl(eps + off) != a)
+			return dev_err_probe(lsw->dev, -EIO,
+					     "W12: eps+%#x is not stable across two reads; refusing to write it\n",
+					     off);
+		lsw->eps_ext_pre[i] = a;
+	}
+	lsw->dp_runtime_pre = readl(dp + LUOFU_SWITCH_DP_RUNTIME_OFF);
+	if (readl(dp + LUOFU_SWITCH_DP_RUNTIME_OFF) != lsw->dp_runtime_pre)
+		return dev_err_probe(lsw->dev, -EIO,
+				     "W12: dp+%#x is not stable across two reads; refusing to write it\n",
+				     LUOFU_SWITCH_DP_RUNTIME_OFF);
+
+	for (i = 0; i < LUOFU_SWITCH_EPS_EXT_WORDS; i++)
+		writel(luofu_switch_v250_eps_ext[i].value,
+		       eps + luofu_switch_v250_eps_ext[i].offset);
+	writel(LUOFU_SWITCH_DP_RUNTIME_VAL, dp + LUOFU_SWITCH_DP_RUNTIME_OFF);
+
+	for (i = 0; i < LUOFU_SWITCH_EPS_EXT_WORDS; i++) {
+		u32 off = luofu_switch_v250_eps_ext[i].offset;
+		u32 got = readl(eps + off);
+
+		if (got == luofu_switch_v250_eps_ext[i].value)
+			continue;
+		dev_err(lsw->dev,
+			"W12: eps+%#x readback mismatch: read %#x, expected %#x (snapshot %#x); restoring the snapshot\n",
+			off, got, luofu_switch_v250_eps_ext[i].value,
+			lsw->eps_ext_pre[i]);
+		ret = -EIO;
+		goto restore;
+	}
+	{
+		u32 got = readl(dp + LUOFU_SWITCH_DP_RUNTIME_OFF);
+
+		if (got != LUOFU_SWITCH_DP_RUNTIME_VAL) {
+			dev_err(lsw->dev,
+				"W12: dp+%#x readback mismatch: read %#x, expected %#x (snapshot %#x); restoring the snapshot\n",
+				LUOFU_SWITCH_DP_RUNTIME_OFF, got,
+				LUOFU_SWITCH_DP_RUNTIME_VAL,
+				lsw->dp_runtime_pre);
+			ret = -EIO;
+			goto restore;
+		}
+	}
+
+	dev_info(lsw->dev,
+		 "W12: extended EPS/DP runtime words programmed and verified: %u EPS words + dp+%#x=%#x\n",
+		 LUOFU_SWITCH_EPS_EXT_WORDS, LUOFU_SWITCH_DP_RUNTIME_OFF,
+		 LUOFU_SWITCH_DP_RUNTIME_VAL);
+	return 0;
+
+restore:
+	luofu_switch_ext_restore(lsw);
+	return ret;
+}
