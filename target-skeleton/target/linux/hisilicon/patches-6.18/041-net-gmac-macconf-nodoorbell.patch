+		netdev_warn(ndev,
+			    "txhalt: TX queue stopped after the first xmit (port %u, len %u) to contain the hang\n",
+			    g->port, skb->len);
+	}
+
 	if (luofu_gmac_trace_gate && n <= 32)
 		pr_info("gmac-trace %s port=%u len=%u post: ctrl=%#x maxframe=%#x port_mode=%#x\n",
 			ndev->name, g->port, skb->len,
--- a/drivers/net/ethernet/hisilicon/luofu-pie.c
+++ b/drivers/net/ethernet/hisilicon/luofu-pie.c
@@ -416,6 +416,18 @@
 module_param_named(arm, luofu_pie_arm_gate, bool, 0444);
 MODULE_PARM_DESC(arm, "Arm the PIE packet engine data path (default off; attended bench bring-up only)");
 
+/*
+ * Patch 041: hang-bisection gate.  With nodoorbell=1 the TX descriptor is built
+ * and published to the ring but the channel doorbell write pointer is NOT
+ * updated, so the engine never processes the descriptor.  If the box survives
+ * that run, the descriptor build/DMA mapping is proven safe and the hang is
+ * in the engine's processing of the descriptor after the doorbell; if it still
+ * hangs, look before the doorbell.
+ */
+static bool luofu_pie_nodoorbell_gate;
+module_param_named(nodoorbell, luofu_pie_nodoorbell_gate, bool, 0444);
+MODULE_PARM_DESC(nodoorbell, "Attended hang bisection: build and publish TX descriptors but never ring the channel doorbell (default off)");
+
 static const struct luofu_pie_variant luofu_pie_v250 = {
 	.hwver = LUOFU_PIE_HWVER_V250,
 	.name = "v250",
@@ -563,6 +575,7 @@
  * [U], so they are not acted on (no checksum/VLAN offload reporting).
  */
 static atomic_t luofu_pie_trace_tx = ATOMIC_INIT(0);
+static atomic_t luofu_pie_trace_node = ATOMIC_INIT(0);
 static atomic_t luofu_pie_trace_rx = ATOMIC_INIT(0);
 
 struct luofu_pie_rx_compl {
@@ -1280,7 +1293,14 @@
 		pr_info("pie-trace TX doorbell=%u\n", ring->wptr & ring_mask);
 	}
 	dma_wmb();
-	writel(ring->wptr & ring_mask, pie->base + LUOFU_PIE_TX_WPTR_OFF(ch));
+	if (luofu_pie_nodoorbell_gate) {
+		if (atomic_inc_return(&luofu_pie_trace_node) <= 4)
+			pr_info("pie-trace TX doorbell SUPPRESSED (nodoorbell=1): wptr=%u rptr=%u ch=%u port=%u len=%u\n",
+				ring->wptr, ring->rptr, ch, port, len);
+	} else {
+		writel(ring->wptr & ring_mask,
+		       pie->base + LUOFU_PIE_TX_WPTR_OFF(ch));
+	}
 
 	ndev->stats.tx_packets++;
 	ndev->stats.tx_bytes += len;
