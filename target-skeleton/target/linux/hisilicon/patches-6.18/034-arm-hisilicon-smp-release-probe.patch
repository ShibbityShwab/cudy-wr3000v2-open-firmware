+/*
+ * Unconditional register snapshot: SYSCTRL 0xc00..0xc1c, CRG 0x04..0x3c and
+ * the SCU control/config/CPU-status words.  The CRG window deliberately stops
+ * before the watchdog words (0x50/0x64/0x70/0x100) and skips the reboot
+ * command word at 0x00.
+ */
+static void luofu_smp_dump(const char *tag)
+{
+	unsigned int i;
+
+	if (!luofu_sysctrl_base || !luofu_crg_base)
+		return;
+
+	pr_info("luofu-smp: %s sysctrl:", tag);
+	for (i = 0; i < LUOFU_SYSCTRL_DUMP_WORDS; i++)
+		pr_cont(" %08x",
+			readl_relaxed(luofu_sysctrl_base +
+				      LUOFU_SYSCTRL_DUMP_OFF + 4 * i));
+	pr_cont("\n");
+
+	pr_info("luofu-smp: %s crg:", tag);
+	for (i = 0; i < LUOFU_CRG_DUMP_WORDS; i++)
+		pr_cont(" %08x",
+			readl_relaxed(luofu_crg_base + LUOFU_CRG_DUMP_OFF +
+				      4 * i));
+	pr_cont("\n");
+
+	if (luofu_scu_base)
+		pr_info("luofu-smp: %s scu ctrl=%08x config=%08x status=%08x cpu0=%u cpu1=%u\n",
+			tag, luofu_scu_read(LUOFU_SCU_CTRL),
+			luofu_scu_read(LUOFU_SCU_CONFIG),
+			luofu_scu_read(LUOFU_SCU_CPU_STATUS),
+			luofu_scu_cpu_status(0), luofu_scu_cpu_status(1));
