+/*
+ * Read-only second look at the marker page once initcalls have run: if CPU1
+ * consumed the pen only later (or the boot CPU's first look raced the store),
+ * the marker shows up here.  With ".probe=0" the marker page is unused.
+ */
+static int __init luofu_smp_late_marker_check(void)
+{
+	if (!luofu_smp_probe)
+		return 0;
+
+	pr_info("luofu-smp: late marker0=%08x marker1=%08x consumed=%s\n",
+		luofu_smp_marker_read(0), luofu_smp_marker_read(1),
+		luofu_smp_pen_consumed() ? "yes" : "no");
+	return 0;
+}
+late_initcall(luofu_smp_late_marker_check);
