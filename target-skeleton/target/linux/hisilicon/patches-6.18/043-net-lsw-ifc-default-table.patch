+/*
+ * W10: the IFC default-classification table (patch 043).
+ *
+ * The round-4d/4e runs armed W3-W9 and enabled the MAC, but no frame was ever
+ * classified or forwarded: the vendor's data path is only complete once the
+ * classifier has its default entries.  hi_lsw_pfe's hi_pfe_ifc_init@0x794
+ * writes eight defaults through two interfaces (see luofu-switch-regs.h):
+ * the ifc+0x120 command/data engine (5 words per entry) and the 4-word entry at
+ * ifc+0x50000 + index*16.  Both writes are replayed here for entries 1..8.
+ *
+ * Verification contract, same tiered discipline as W7:
+ *  - the tab128 words are directly readable and are STRICT: snapshot, write,
+ *    read back, restore on any mismatch and fail the stage;
+ *  - the command/data engine has no read path in the recovered code (like
+ *    write-only table 19): completion is acknowledged by the poll loop and the
+ *    command word is logged; those engine entries cannot be restored, which is
+ *    stated in the lane record.
+ *
+ * Payloads are the vendor's own init values, extracted by emulating the pinned
+ * hi_lsw_pfe.ko and cross-checked by hand; the only runtime-dependent field is
+ * tab128 word0 of entries 3..7, built from the vendor table-manager allocation
+ * id (0 on a fresh manager, giving 0x1d00; the constant is in the regs header).
+ */
+struct luofu_switch_ifc_entry {
+	u16 index;
+	u32 engine[LUOFU_SWITCH_IFC_ENTRY_WORDS];
+	u32 tab[LUOFU_SWITCH_IFC_TAB_WORDS];
+};
+
+static const struct luofu_switch_ifc_entry luofu_switch_v250_ifc_entries[] = {
+	{ 1, { 0x00000000, 0x00000000, 0x00000000, 0x00100000, 0x000f3001 },
+	     { 0x00000000, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 2, { 0x00000002, 0x00000000, 0x00000022, 0xffff0000, 0x000f2002 },
+	     { 0x00100800, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 3, { 0x00000001, 0x00000000, 0x00000028, 0xffff0000, 0x000f1003 },
+	     { LUOFU_SWITCH_IFC_ID_TAB_WORD, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 4, { 0x00000002, 0x00000000, 0x00000028, 0xffff0000, 0x000f1004 },
+	     { LUOFU_SWITCH_IFC_ID_TAB_WORD, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 5, { 0xe0000000, 0x00000000, 0x1c00000c, 0xffff0000, 0x000f1005 },
+	     { LUOFU_SWITCH_IFC_ID_TAB_WORD, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 6, { 0x00000000, 0xff000000, 0x00001100, 0xffff0018, 0x000f1006 },
+	     { LUOFU_SWITCH_IFC_ID_TAB_WORD, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 7, { 0x00000001, 0x00000000, 0x00000025, 0xffff0c00, 0x000f1007 },
+	     { LUOFU_SWITCH_IFC_ID_TAB_WORD, 0x00000000, 0x00000000, 0x00000000 } },
+	{ 8, { 0x00000000, 0x00000000, 0x00000000, 0xffff0000, 0x000f0008 },
+	     { 0x00100800, 0x00000000, 0x00000000, 0x00000000 } },
+};
+
+/* Restore the W10 tab128 snapshot. */
+static void luofu_switch_ifc_restore(struct luofu_switch *lsw)
+{
+	unsigned int i, w;
+	void __iomem *base = lsw->window[LUOFU_SWITCH_WIN_IFC];
+
+	if (!base)
+		return;
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_ifc_entries); i++)
+		for (w = 0; w < LUOFU_SWITCH_IFC_TAB_WORDS; w++)
+			writel(lsw->ifc_tab_pre[i][w],
+			       base + LUOFU_SWITCH_IFC_TAB128 +
+			       i * LUOFU_SWITCH_IFC_TAB128_STRIDE + w * 4);
+}
+
+static int luofu_switch_ifc_engine_write(struct luofu_switch *lsw,
+					 const struct luofu_switch_ifc_entry *e)
+{
+	void __iomem *base = lsw->window[LUOFU_SWITCH_WIN_IFC];
+	unsigned int i;
+	u32 cmd;
+
+	for (i = 0; i < LUOFU_SWITCH_IFC_ENTRY_WORDS; i++)
+		writel(e->engine[i], base + LUOFU_SWITCH_IFC_DATA0 + i * 4);
+
+	cmd = readl(base + LUOFU_SWITCH_IFC_CMD);
+	cmd &= ~(LUOFU_SWITCH_IFC_CMD_WRITE | LUOFU_SWITCH_IFC_CMD_INDEX);
+	cmd |= LUOFU_SWITCH_IFC_CMD_WRITE |
+	       (e->index & LUOFU_SWITCH_IFC_CMD_INDEX);
+	writel(cmd, base + LUOFU_SWITCH_IFC_CMD);
+
+	for (i = 0; i < LUOFU_SWITCH_IFC_POLL; i++) {
+		u32 st = readl(base + LUOFU_SWITCH_IFC_CMD);
+
+		if (!(st & LUOFU_SWITCH_IFC_CMD_BUSY)) {
+			if (st & LUOFU_SWITCH_IFC_CMD_ERROR) {
+				dev_err(lsw->dev,
+					"W10: IFC entry %u command failed (cmd=%#x, bit29 set)\n",
+					e->index, st);
+				return -EIO;
+			}
+			return 0;
+		}
+		cpu_relax();
+	}
+	dev_err(lsw->dev,
+		"W10: IFC entry %u command never completed (cmd=%#x after %u polls)\n",
+		e->index, readl(base + LUOFU_SWITCH_IFC_CMD),
+		LUOFU_SWITCH_IFC_POLL);
+	return -ETIMEDOUT;
+}
+
+static int luofu_switch_ifc_program(struct luofu_switch *lsw)
+{
+	void __iomem *base = lsw->window[LUOFU_SWITCH_WIN_IFC];
+	unsigned int i, w;
+	u32 pre120;
+	int ret;
+
+	if (!base)
+		return dev_err_probe(lsw->dev, -EINVAL,
+				     "missing ifc window for the W10 stage\n");
+
+	pre120 = readl(base + LUOFU_SWITCH_IFC_CMD);
+	dev_info(lsw->dev,
+		 "W10: IFC default-classification table: %zu entries, command-engine pre-state %#x (busy %u, error %u), tab128 base %#x\n",
+		 ARRAY_SIZE(luofu_switch_v250_ifc_entries), pre120,
+		 !!(pre120 & LUOFU_SWITCH_IFC_CMD_BUSY),
+		 !!(pre120 & LUOFU_SWITCH_IFC_CMD_ERROR),
+		 LUOFU_SWITCH_IFC_TAB128);
+
+	if (pre120 & (LUOFU_SWITCH_IFC_CMD_BUSY | LUOFU_SWITCH_IFC_CMD_ERROR))
+		return dev_err_probe(lsw->dev, -EBUSY,
+				     "W10: IFC command engine is not idle (%#x); refusing to program the default table\n",
+				     pre120);
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_ifc_entries); i++) {
+		for (w = 0; w < LUOFU_SWITCH_IFC_TAB_WORDS; w++) {
+			u32 off = LUOFU_SWITCH_IFC_TAB128 +
+				  i * LUOFU_SWITCH_IFC_TAB128_STRIDE + w * 4;
+
+			lsw->ifc_tab_pre[i][w] = readl(base + off);
+			if (readl(base + off) != lsw->ifc_tab_pre[i][w])
+				return dev_err_probe(lsw->dev, -EIO,
+						     "W10: ifc+%#x is not stable across two reads; refusing to write the entry\n",
+						     off);
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_ifc_entries); i++) {
+		const struct luofu_switch_ifc_entry *e =
+			&luofu_switch_v250_ifc_entries[i];
+
+		ret = luofu_switch_ifc_engine_write(lsw, e);
+		if (ret) {
+			luofu_switch_ifc_restore(lsw);
+			return ret;
+		}
+
+		for (w = 0; w < LUOFU_SWITCH_IFC_TAB_WORDS; w++)
+			writel(e->tab[w],
+			       base + LUOFU_SWITCH_IFC_TAB128 +
+			       i * LUOFU_SWITCH_IFC_TAB128_STRIDE + w * 4);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(luofu_switch_v250_ifc_entries); i++) {
+		const struct luofu_switch_ifc_entry *e =
+			&luofu_switch_v250_ifc_entries[i];
+
+		for (w = 0; w < LUOFU_SWITCH_IFC_TAB_WORDS; w++) {
+			u32 off = LUOFU_SWITCH_IFC_TAB128 +
+				  i * LUOFU_SWITCH_IFC_TAB128_STRIDE + w * 4;
+			u32 got = readl(base + off);
+
+			if (got == e->tab[w])
+				continue;
+			dev_err(lsw->dev,
+				"W10: tab128 readback mismatch at index %u word %u (ifc+%#x): read %#x, expected %#x (snapshot %#x); restoring the snapshot\n",
+				e->index, w, off, got, e->tab[w],
+				lsw->ifc_tab_pre[i][w]);
+			luofu_switch_ifc_restore(lsw);
+			return -EIO;
+		}
+	}
+
+	dev_info(lsw->dev,
+		 "W10: IFC default-classification table programmed and verified: %zu entries (5-word command-engine descriptors acknowledged, 4-word tab128 entries read back exactly)\n",
+		 ARRAY_SIZE(luofu_switch_v250_ifc_entries));
+	return 0;
+}
