--- a/drivers/net/ethernet/hisilicon/luofu-switch-regs.h
+++ b/drivers/net/ethernet/hisilicon/luofu-switch-regs.h
@@ -513,4 +513,47 @@
 #define LUOFU_SWITCH_OPP_PFE_INIT	0x110	/* [V] value 0 */
 #define LUOFU_SWITCH_PFE_WRITES		4	/* [V] four direct words */
 
+/*
+ * W10: IFC default-classification table (patch 043).
+ *
+ * The vendor hi_lsw_pfe module initialises the classifier in hi_pfe_ifc_init:
+ * after creating its table manager it writes eight default entries, and each
+ * entry is written through TWO interfaces:
+ *
+ *  1. an indirect command/data engine in the IFC window:
+ *       0x138/0x13c/0x140/0x144/0x148 = the five descriptor words
+ *       0x120 command = 0xc0000000 | (index & 0x7f)   (bits 31:30 = write)
+ *     poll 0x120 until bit31 clears (<=1001 tries), bit29 = error - the same
+ *     access protocol as the EQM indirect engine (patch 025/032).
+ *  2. the 4-word shadow/table entry at ifc+0x50000 + index*16, written through
+ *     the shared hi_lsw_write_tab128 primitive (four 32-bit stores per entry).
+ *
+ * The payloads below were extracted by emulating hi_pfe_ifc_init@0x794 from the
+ * pinned hi_lsw_pfe.ko (52,412 B, sha256
+ * 12ea9fcb90bef0b77f8ba54b4781f72de4af91b2a24c31d68813878212c49d1a) and were
+ * cross-checked by hand for entries 1-5.  Write shape [V]; field semantics are
+ * [U].  The one runtime-dependent field is tab128 word0 of entries 3..7, which
+ * the vendor builds from the id returned by hi_tab_mgr_alloc_hash: on a fresh
+ * manager the first allocation is expected to be 0, so the default is
+ * 0x1d00; luofu_lsw.ifc_id overrides the low six bits for the attended run.
+ */
+#define LUOFU_SWITCH_IFC_CMD		0x0120
+#define LUOFU_SWITCH_IFC_DATA0		0x0138
+#define LUOFU_SWITCH_IFC_DATA1		0x013c
+#define LUOFU_SWITCH_IFC_DATA2		0x0140
+#define LUOFU_SWITCH_IFC_DATA3		0x0144
+#define LUOFU_SWITCH_IFC_DATA4		0x0148
+#define LUOFU_SWITCH_IFC_CMD_WRITE	0xc0000000
+#define LUOFU_SWITCH_IFC_CMD_INDEX	GENMASK(6, 0)
+#define LUOFU_SWITCH_IFC_CMD_BUSY	BIT(31)
+#define LUOFU_SWITCH_IFC_CMD_ERROR	BIT(29)
+#define LUOFU_SWITCH_IFC_POLL		1001	/* [V] 0x3e9 iterations */
+#define LUOFU_SWITCH_IFC_TAB128		0x50000
+#define LUOFU_SWITCH_IFC_TAB128_STRIDE	16
+#define LUOFU_SWITCH_IFC_ENTRIES	8
+#define LUOFU_SWITCH_IFC_ENTRY_WORDS	5
+#define LUOFU_SWITCH_IFC_TAB_WORDS	4
+/* tab128 word0 of entries 3..7: (alloc-id & 0x3f) | 0x1d00; fresh manager id 0 */
+#define LUOFU_SWITCH_IFC_ID_TAB_WORD	0x00001d00
+
 #endif /* __LUOFU_SWITCH_REGS_H */
