-
-	luofu_gmac_hw_diag(ndev);
-	if (luofu_gmac_hwinit_write_allowed() &&
-	    g->port == luofu_gmac_hwinit_port) {
-		ret = luofu_gmac_hw_init_write(ndev);
-		if (ret)
-			goto err_phylink;
+	if (luofu_gmac_w9_gate) {
+		if (!luofu_gmac_hwinit_gate)
