+					pr_info("pie-trace RXERR ACCEPTED (accepterr=1, vendor would drop) status=%u port=%u vport=%u len=%u ch=%u\n",
+						compl.status, compl.port,
+						compl.vport, compl.len, ch);
+			}
+		}
+
 		luofu_pie_rx_deliver(pie, np, skb, &compl);
 	}
 
