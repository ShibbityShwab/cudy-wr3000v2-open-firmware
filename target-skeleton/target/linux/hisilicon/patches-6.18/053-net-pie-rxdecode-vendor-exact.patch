 };
 
+/*
+ * Patch 053 (RXDECODE_VENDOR_EXACT): the completion decode now matches the
+ * vendor hi_pie_rx_get_desc@0xf14 exactly for all three paths:
+ *
+ *  - error path (status != 0): port = byte[+9] bits 7:4, vport = byte[+24]
+ *    bits 4:0, and the "no error" summary bit is clear -> hi_net_rx_proc drops
+ *    the frame.  The observed 0x25/37 completions decode to port 11 (eth2),
+ *    i.e. they are the host's ingress frames punted as exceptions.
+ *  - normal path (+16 != 0): port = byte[+16], vport = byte[+17].
+ *  - no-status path (+16 == 0): port = byte[+23] bits 7:4, vport = byte[+24]
+ *    bits 4:0.
+ *  - tag class = byte[+10] bits 5:4; second flag class = byte[+13] bits 6:5
+ *    (the two [U] classes; they do not decide error/normal).
+ */
+
 static int luofu_pie_rx_decode(const struct luofu_pie_desc *desc, u32 buf_size,
 			       struct luofu_pie_rx_compl *compl)
 {
-	u32 port_vport;
+	u32 tag, port_vport;
 
 	compl->len = get_unaligned_le16(&desc->bytes[LUOFU_PIE_RX_DESC_LEN]);
 	compl->status = desc->bytes[LUOFU_PIE_RX_DESC_STATUS] &
 			LUOFU_PIE_RX_DESC_STATUS_MASK;
 	compl->vlan = !!(desc->bytes[LUOFU_PIE_RX_DESC_VLAN] & GENMASK(5, 4));
+	compl->err = compl->status != 0;
 
-	if (compl->status || compl->len < ETH_HLEN || compl->len > buf_size)
+	if (compl->len < ETH_HLEN || compl->len > buf_size)
 		return -EIO;
 
-	port_vport = get_unaligned_le32(&desc->bytes[LUOFU_PIE_RX_DESC_PORT]);
-	if (port_vport)
-		compl->port = port_vport & 0xff;
-	else
-		compl->port = (desc->bytes[LUOFU_PIE_RX_DESC_PS_PORT] >> 4) &
-			      0xf;
+	if (compl->err) {
+		/* vendor error path: hi_pie_rx_get_desc@0xfc4 */
+		compl->port = (desc->bytes[9] >> 4) & 0xf;
+		compl->vport = desc->bytes[24] & 0x1f;
+	} else {
+		port_vport = get_unaligned_le32(&desc->bytes[LUOFU_PIE_RX_DESC_PORT]);
+		if (port_vport) {
+			compl->port = port_vport & 0xff;
+			compl->vport = (port_vport >> 8) & 0xff;
+		} else {
+			compl->port = (desc->bytes[LUOFU_PIE_RX_DESC_PS_PORT] >> 4) & 0xf;
+			compl->vport = desc->bytes[LUOFU_PIE_RX_DESC_PS_VPORT] & 0x1f;
+		}
+	}
+
+	tag = desc->bytes[LUOFU_PIE_RX_DESC_VLAN];
+	tag = (tag >> 4) & 3;
 
 	if (compl->port > LUOFU_PIE_RX_PORT_MAX)
 		return -EIO;
@@ -1283,6 +1329,32 @@
 			continue;
 		}
 
+		{
+			static atomic_t trace_comp = ATOMIC_INIT(0);
+			u32 n = atomic_inc_return(&trace_comp);
+
+			if (luofu_pie_rxdiag_gate && n <= 24) {
+				const u32 *w = (const u32 *)desc;
+
+				pr_info("pie-trace RXDIAG ch=%u idx=%u len=%u status=%u err=%u port=%u vport=%u vlan=%u desc=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+					ch, index, compl.len, compl.status,
+					compl.err, compl.port, compl.vport,
+					compl.vlan, w[0], w[1], w[2], w[3],
+					w[4], w[5], w[6], w[7]);
+			}
+			if (compl.err) {
