 MODULE_PARM_DESC(nodoorbell, "Attended hang bisection: build and publish TX descriptors but never ring the channel doorbell (default off)");
 
 /*
+ * Patch 053 diagnostics: rxdiag prints the whole completion descriptor for the
+ * first completions of both classes; accepterr is the experimental step that
+ * delivers vendor-exception completions (status != 0) to the net_device
+ * registered for the decoded error-path port (observed: port 11 = eth2) - the
+ * vendor stack drops them, but on this bench they are the host's ingress
+ * frames, so accepting them tests whether the software path can complete the
+ * wire->CPU->wire loop without the missing CFE flow tables.
+ */
+static bool luofu_pie_rxdiag_gate;
+module_param_named(rxdiag, luofu_pie_rxdiag_gate, bool, 0444);
+MODULE_PARM_DESC(rxdiag, "Attended W17_RXDIAG diagnostic: print the full 32-byte RX completion descriptor and the vendor-exact decode for the first completions (default off)");
+
+static bool luofu_pie_accepterr_gate;
+module_param_named(accepterr, luofu_pie_accepterr_gate, bool, 0444);
+MODULE_PARM_DESC(accepterr, "Attended W17 experiment: deliver vendor-exception completions (status != 0) to the netdev registered for the decoded error-path port instead of dropping them (default off)");
+
+/*
  * Patch 047 (diagnostic): read-only PIE RX/TX state dump for the stock-vs-ours
  * RX comparison.  The stock boot inventory (PIE-DATAPATH 4.5) measured the
  * vendor state of the same registers; two stand out as candidates for the
@@ -709,28 +726,57 @@
 	u16 len;
