+/* Register the net_device that receives frames completed on @port. */
+int luofu_pie_rx_register(unsigned int port, struct net_device *ndev)
+{
+	struct luofu_pie *pie = READ_ONCE(luofu_pie_ctrl);
+	unsigned long flags;
+
+	if (!pie || !READ_ONCE(pie->armed))
+		return -EOPNOTSUPP;
+	if (port > LUOFU_PIE_RX_PORT_MAX || !ndev)
+		return -EINVAL;
+
+	spin_lock_irqsave(&pie->rx_port_lock, flags);
+	if (pie->rx_ports[port]) {
+		spin_unlock_irqrestore(&pie->rx_port_lock, flags);
+		return -EBUSY;
+	}
+	pie->rx_ports[port] = ndev;
+	spin_unlock_irqrestore(&pie->rx_port_lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(luofu_pie_rx_register);
+
+/* Remove the port registration if it is still the caller's net_device. */
+void luofu_pie_rx_unregister(unsigned int port, struct net_device *ndev)
+{
+	struct luofu_pie *pie = READ_ONCE(luofu_pie_ctrl);
+	unsigned long flags;
+
+	if (!pie || port > LUOFU_PIE_RX_PORT_MAX)
+		return;
+
+	spin_lock_irqsave(&pie->rx_port_lock, flags);
+	if (pie->rx_ports[port] == ndev)
+		pie->rx_ports[port] = NULL;
+	spin_unlock_irqrestore(&pie->rx_port_lock, flags);
+}
+EXPORT_SYMBOL_GPL(luofu_pie_rx_unregister);
