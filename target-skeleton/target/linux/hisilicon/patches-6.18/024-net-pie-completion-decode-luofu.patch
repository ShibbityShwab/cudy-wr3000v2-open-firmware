+/* Look up the receiving net_device for a completion port (holds a reference). */
+static struct net_device *luofu_pie_rx_port_netdev(struct luofu_pie *pie,
+						   unsigned int port)
+{
+	struct net_device *ndev;
+	unsigned long flags;
+
+	if (port > LUOFU_PIE_RX_PORT_MAX)
+		return NULL;
+
+	spin_lock_irqsave(&pie->rx_port_lock, flags);
+	ndev = pie->rx_ports[port];
+	if (ndev)
+		dev_hold(ndev);
+	spin_unlock_irqrestore(&pie->rx_port_lock, flags);
+
+	return ndev;
