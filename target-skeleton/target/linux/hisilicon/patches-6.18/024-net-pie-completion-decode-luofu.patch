+/*
+ * Decode one v250 RX completion descriptor into the fields this driver uses.
+ * The vendor decoder (hi_pie_rx_get_desc) fills a 12-byte summary that
+ * hi_pie_drv_rx_recv/hi_net_rx_proc consume:
+ *   +0 port, +1 vport, +2 u16, +4 u16 frame length, +6 status code,
+ *   +7 bit 0 no-error, bits 2:1 and 4:3 the two flag classes.
+ * The length is the u16 at descriptor +0; status code is descriptor +8 bits
+ * 6:0 (zero = no error); the port/vport pair is the u32 at +16 when it is
+ * non-zero, otherwise the packed fields at +23/+24.  The two 2-bit flag
+ * classes at +13 bits 6:5 and +10 bits 5:4 are recorded but their meaning is
+ * [U], so they are not acted on (no checksum/VLAN offload reporting).
+ */
+struct luofu_pie_rx_compl {
+	u16 len;
+	u8 status;
+	unsigned int port;
+	bool vlan;
+};
+
+static int luofu_pie_rx_decode(const struct luofu_pie_desc *desc, u32 buf_size,
+			       struct luofu_pie_rx_compl *compl)
+{
+	u32 port_vport;
+
+	compl->len = get_unaligned_le16(&desc->bytes[LUOFU_PIE_RX_DESC_LEN]);
+	compl->status = desc->bytes[LUOFU_PIE_RX_DESC_STATUS] &
+			LUOFU_PIE_RX_DESC_STATUS_MASK;
+	compl->vlan = !!(desc->bytes[LUOFU_PIE_RX_DESC_VLAN] & GENMASK(5, 4));
+
+	if (compl->status || compl->len < ETH_HLEN || compl->len > buf_size)
+		return -EIO;
+
+	port_vport = get_unaligned_le32(&desc->bytes[LUOFU_PIE_RX_DESC_PORT]);
+	if (port_vport)
+		compl->port = port_vport & 0xff;
+	else
+		compl->port = (desc->bytes[LUOFU_PIE_RX_DESC_PS_PORT] >> 4) &
+			      0xf;
+
+	if (compl->port > LUOFU_PIE_RX_PORT_MAX)
+		return -EIO;
+
+	return 0;
 }
 
