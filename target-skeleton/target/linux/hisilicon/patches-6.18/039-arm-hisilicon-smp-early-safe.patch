+/*
+ * GIC state is the other half of a WFI/dormant release: the wakeup IPI is only
+ * deliverable if the distributor and the target CPU interface are enabled.
+ * The GIC driver has run by the time the release happens, so these words say
+ * whether the normal release could reach CPU1 at all.
+ */
+static void luofu_smp_dump_gic(const char *tag)
+{
+	void __iomem *dist, *cpu0, *cpu1;
+
+	dist = ioremap(LUOFU_GIC_DIST_PA, SZ_4K);
+	cpu0 = ioremap(LUOFU_GIC_CPU0_PA, 0x100);
+	cpu1 = ioremap(LUOFU_GIC_CPU1_PA, 0x100);
+	if (!dist || !cpu0 || !cpu1) {
+		pr_info("luofu-smp: %s gic: ioremap failed\n", tag);
+	} else {
+		pr_info("luofu-smp: %s gic: dist_ctlr=%08x sgir=%08x cpu0_ctlr=%08x cpu1_ctlr=%08x\n",
+			tag, readl_relaxed(dist),
+			readl_relaxed(dist + LUOFU_GIC_SGIR),
+			readl_relaxed(cpu0), readl_relaxed(cpu1));
+	}
+	if (dist)
+		iounmap(dist);
+	if (cpu0)
+		iounmap(cpu0);
+	if (cpu1)
+		iounmap(cpu1);
+}
