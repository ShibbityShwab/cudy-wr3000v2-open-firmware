@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config ARCH_LUOFU
+	bool "HiSilicon luofu (Hi5671Y) family"
+	depends on ARCH_HISI
+	select CACHE_L2X0
+	select HAVE_ARM_SCU if SMP
+	select HAVE_ARM_TWD if SMP
+	help
+	  Support for the HiSilicon Hi5671Y "luofu" SoC family and the
+	  Cudy WR3000 v2.0 board (board R116).
+
+	  The machine code only matches the board devicetree and programs no
+	  hardware itself; the drivers and DT nodes bound to it do the work.
+	  A UP-only boot is the first supported posture: there is no mainline
+	  smp_ops for this SoC yet.
