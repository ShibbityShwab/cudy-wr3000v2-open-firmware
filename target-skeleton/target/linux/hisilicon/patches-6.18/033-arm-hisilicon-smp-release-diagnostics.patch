+/*
+ * Optional pen probe stub.
+ *
+ * CPU1 starts at the pen address with the MMU and the caches off (the stock
+ * loader's secondary stub polls SYSCTRL+0xc00 and branches there), so a flat
+ * position independent instruction sequence is enough.  It polls the console
+ * UART's LSR.THRE, prints the low MPIDR nibble as an ASCII digit and a 'P',
+ * then branches to __pa_symbol(secondary_startup):
+ *
+ *	movw	r0, #0xf000		@ UART0 low half
+ *	movt	r0, #0x1010		@ r0 = 0x1010f000
+ *	ldrb	r1, [r0, #0x14]		@ LSR
+ *	tst	r1, #0x20		@ THR empty?
+ *	beq	-4 * 4
+ *	mrc	p15, 0, r3, c0, c0, 5	@ MPIDR
+ *	and	r3, r3, #0xf
+ *	add	r3, r3, #'0'
+ *	strb	r3, [r0]		@ CPU id digit
+ *	mov	r1, #'P'
+ *	strb	r1, [r0]		@ 'P' = pen consumed
+ *	ldr	r2, [pc]
+ *	bx	r2
+ *	.word	__pa_symbol(secondary_startup)
+ *
+ * The sequence is built at boot and its cache lines are cleaned to the point
+ * of coherency; CPU1 fetches it with the caches off.  The stub clobbers only
+ * r0-r3, which the real entry does not consume.  It writes the console
+ * UART, hence the parameter gate.
+ */
+static u32 luofu_smp_probe_stub[16] __aligned(64);
+
+static void __init luofu_smp_build_probe_stub(void)
+{
+	u32 *s = luofu_smp_probe_stub;
+
+	s[0] = 0xe30f0000;	/* movw	r0, #0xf000 */
+	s[1] = 0xe3410010;	/* movt	r0, #0x1010 */
+	s[2] = 0xe5d01014;	/* ldrb	r1, [r0, #0x14] */
+	s[3] = 0xe3110020;	/* tst	r1, #0x20 */
+	s[4] = 0x0afffffc;	/* beq	2b */
+	s[5] = 0xee103fb0;	/* mrc	p15, 0, r3, c0, c0, 5 */
+	s[6] = 0xe203300f;	/* and	r3, r3, #0xf */
+	s[7] = 0xe2833030;	/* add	r3, r3, #'0' */
+	s[8] = 0xe5c03000;	/* strb	r3, [r0] */
+	s[9] = 0xe3a01050;	/* mov	r1, #'P' */
+	s[10] = 0xe5c01000;	/* strb	r1, [r0] */
+	s[11] = 0xe59f2000;	/* ldr	r2, [pc] */
+	s[12] = 0xe12fff12;	/* bx	r2 */
+	s[13] = (u32)__pa_symbol(secondary_startup);
+
+	/*
+	 * Make the instructions visible to a core that starts with the caches
+	 * off.  The array is 64-byte aligned and 64 bytes long, so no other
+	 * variable shares its cache lines.
+	 */
+	sync_cache_w(luofu_smp_probe_stub);
+}
+
+static u32 luofu_scu_read(unsigned int off)
+{
+	if (!luofu_scu_base)
+		return 0;
+	return readl_relaxed(luofu_scu_base + off);
+}
+
+/*
+ * The A9 SCU exposes the two power-status bits of each core in one byte per
+ * core at 0x08 (same access width as mainline scu_set_power_mode_internal():
+ * readb(scu_base + 0x08 + cpu) & 3).
+ */
+static unsigned int luofu_scu_cpu_status(unsigned int cpu)
+{
+	if (!luofu_scu_base)
+		return 0xff;
+	return readb_relaxed(luofu_scu_base + LUOFU_SCU_CPU_STATUS + cpu) & 0x3;
+}
 
