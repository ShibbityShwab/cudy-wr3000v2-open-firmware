+static void luofu_smp_release(unsigned int cpu, u32 resume_mask,
+			      u32 pen_value)
+{
+	/* 1. pen word: publish the secondary entry address before the IPI. */
+	if (cpu_logical_map(cpu) != 0)
+		writel(pen_value, luofu_smp_pen);
+	dsb(sy);
+
+	/* 2. CRG resume bits of the target core (read-modify-write). */
+	writel(readl_relaxed(luofu_smp_resume) & ~resume_mask,
+	       luofu_smp_resume);
+	dsb(sy);
+
+	/* 3. ARM wakeup IPI, then an event in case the core is in WFE. */
+	arch_send_wakeup_ipi_mask(cpumask_of(cpu));
+	sev();
 }
 
