CONFIG_LUOFU_REBOOT=y
# [N] new driver in patches-6.18/005 (luofu watchdog)
CONFIG_LUOFU_WDT=y
# [N] new driver in patches-6.18/006 (luofu FMC SPI-NAND controller, a
