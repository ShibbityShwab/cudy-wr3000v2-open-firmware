CONFIG_LUOFU_GMAC=y
# [N] new driver in patches-6.18/007 (luofu MDIO bus controller)
CONFIG_LUOFU_MDIO=y
# [N] new driver in patches-6.18/008 (luofu Genius PHY)
CONFIG_LUOFU_PHY=y
# [N] new driver in patches-6.18/010 (luofu machine restart: SYSCTRL
