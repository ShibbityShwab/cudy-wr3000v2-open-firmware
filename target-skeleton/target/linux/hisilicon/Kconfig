# target/linux/hisilicon/Kconfig
#
# STATUS (2026-11-24): REVIEW STUB, NOT USED BY THE BUILD.
#
# This file is deliberately NOT part of the working target: the release-line
# build in OpenWrt main does not read it, and the two config symbols below are
# not referenced by any Makefile in the tree.  It is kept only as a written
# note for the upstream review form; the submission recommendation is to
# DELETE it and carry the platform symbols in the kernel patch (see below).
#
# READ THIS BEFORE COPYING IT INTO A TREE.
#
# A target directory in OpenWrt does not normally carry a Kconfig, and this
# file must not be confused with the two Kconfigs that actually matter here:
#
#  1. KERNEL platform symbols. ARCH_HISI / ARCH_LUOFU are kernel symbols; they
#     belong in the target's kernel patch, not in target/linux. The lab tree
#     proves the shape (tools/lab-src/arch/arm/mach-hisi/Kconfig; TARGET-DESIGN.md
#     4.1):
#
#       config ARCH_HISI
#           bool "HiSilicon SoC support"
#           depends on ARCH_MULTI_V7 || ARCH_MULTI_V5
#           select ARM_AMBA
#           select ARM_GIC if ARCH_MULTI_V7
#           select ARM_TIMER_SP804
#           select POWER_RESET
#           select POWER_RESET_HISI
#           select POWER_SUPPLY
#
#       config ARCH_LUOFU
#           bool "HiSilicon luofu (Hi5671Y) family"
#           depends on ARCH_MULTI_V7
#           select CACHE_L2X0
#           select HAVE_ARM_SCU if SMP
#           select HAVE_ARM_TWD if SMP
#           help
#             Support for the Hisilicon Hi5671Y "luofu" SoC (board R116, the
#             Cudy WR3000 v2.0).
#
#     plus arch/arm/mach-hisilicon/Makefile:
#       machine-$(CONFIG_ARCH_LUOFU) += luofu
#     and arch/arm/boot/dts/Makefile:
#       dtb-$(CONFIG_ARCH_LUOFU) += luofu-r116.dtb
#     The DT enable-method and the mach-OF table are TODOs, not Kconfig
#     (TARGET-DESIGN.md 7.1: "machine", "SMP").
#
#  2. OpenWrt build options. Kept here only so a reviewer can see what the
#     image recipe needs. TODO(upstream review): either delete this file or
#     move the symbols to the tree's own Kconfig location if the target is
#     accepted; do not invent a new target-level Kconfig convention.
#
# Not decided here: whether the port adds a second luofu-family board as a
# subtarget (TARGET-DESIGN.md 4.1 says one board first).

config TARGET_HISILICON_LUOFU
	bool "HiSilicon luofu (Hi5671Y / Cudy WR3000 v2.0, board R116)"
	help
	  REVIEW STUB ONLY - NOT USED BY THE BUILD.  The working target is
	  selected through the standard Device/ stanzas in image/Makefile and
	  image/luofu.mk (CONFIG_TARGET_hisilicon_luofu_DEVICE_cudy_wr3000-v2
	  in the tree's .config), not through this symbol.

config LUOFU_FIP_TRAILER
	string "FIP trailer input (fixed 40,732-byte uImage trailer)"
	default ""
	help
	  Path to the FIP trailer that the image recipe appends to the uImage to
	  make a kernel slot (TARGET-DESIGN.md 3.2, 5.2). The verified bench lane
	  uses a fixed 40,732-byte trailer; the upstream recipe must regenerate it
	  from source and prove it with one attended boot (TARGET-DESIGN.md 5.2).
	  An empty value means "no trailer configured" and the image recipe must
	  fail closed rather than build a bare uImage.

config LUOFU_FIP_REQUIRE_GATE_CHECK
	bool "Fail the build unless the FIP gate magic verifies"
	default y
	help
	  The stock loader takes the kernel entry only if the 32-bit big-endian
	  value at 0x40 + ih_size + base-DTB totalsize is 0xd7b7ab1e
	  (TARGET-DESIGN.md 3.2; phase42-decode/report.md section 2). Keep this
	  enabled: a slice without the gate magic must never be produced.
