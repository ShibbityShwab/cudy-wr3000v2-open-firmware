#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# luofu_record_pair - record the running A/B firmware pair after a successful
# boot, so that the bootloader's next boot is stable.
#
# STATUS: host-tested only (tools/test-platform-abinstall.sh); never run on
# hardware. It writes one sysfs attribute and nothing else: no env block, no
# mtd partition, no raw devmem.
#
# WHY THIS SERVICE EXISTS
# The stock loader selects the firmware pair from its environment
# ("bootcmd=mtd read kernel${bootflag} ${loadaddr}; bootfip ${loadaddr}") and
# keeps a record of the pair in the SYSCTRL cell at 0x10100c08.  bootfip stores
# the *opposite* pair's low byte before Linux starts (0x11 for an A boot, 0x10
# for a B boot) and the loader treats a recorded value that contradicts the
# environment as "the last boot of that pair failed": it re-stamps the
# environment to the other pair and boots it.  A boot is therefore only stable
# if userspace records the running pair before the next reset; the vendor
# firmware does that at boot-done time (/etc/init.d/hsan_appm), and this is the
# target's equivalent.  Without it every reboot after a normal boot would take
# the failover path and silently switch back to the previous pair, and the
# two-witness check in base-files/lib/upgrade/platform.sh would refuse on our
# own system.
#
# WHAT IT DOES
#   1. determines the booted rootfs slot from /sys/class/ubi/ubi0/mtd_num and
#      that mtd's /proc/mtd label (rootfsa -> pair a, rootfsb -> pair b), with
#      a /proc/cmdline cross-check when the command line names the slot;
#   2. waits (bounded) for the luofu-selector sysfs interface to exist;
#   3. reads the recorded pair; if it already equals the running pair it does
#      nothing (idempotent);
#   4. otherwise it writes the running pair to next_pair, which performs the
#      driver's low-byte read-modify-write and read-back verification, then
#      re-reads current_pair and treats a mismatch as a failure.
# It never writes "manual-b", "uninitialised" or "unknown": if any witness is
# missing, disagrees or is not one of the two established values, it logs and
# leaves the cell untouched.
#
# TIMING AND RACE
# The service is enabled automatically in the image (START=96, so after
# /etc/init.d/done marks the boot complete).  A boot that dies, hangs or is
# reset before this point leaves the loader's opposite-pair marker in the
# cell, so the loader's next attempt treats the boot as failed and boots the
# other pair - the intended failover.  Conversely, if this service has run,
# the machine-restart driver (patch 010) writes the same recorded value back
# before a software reset, so the pair survives a reboot.  Do not move this
# before the system is considered up.

START=96

# Host-side test hook: empty on the device (the same convention as
# base-files/lib/upgrade/platform.sh).  The mocked harness sets it to a
# fixture tree so every lookup resolves inside the fixture.
LUOFU_TEST_ROOT="${LUOFU_TEST_ROOT:-}"
LUOFU_SELECTOR_DIR="$LUOFU_TEST_ROOT/sys/devices/platform/luofu-selector"
LUOFU_UBI_SYS="$LUOFU_TEST_ROOT/sys/class/ubi"
LUOFU_MTD_TABLE="$LUOFU_TEST_ROOT/proc/mtd"
LUOFU_CMDLINE="$LUOFU_TEST_ROOT/proc/cmdline"

# Bounded wait for the selector interface, in seconds (one poll per second).
# The driver is built in and its device exists before init, so the wait only
# covers a deferred probe; the boot path must never block indefinitely.
LUOFU_RECORD_WAIT="${LUOFU_RECORD_WAIT:-10}"

_log() {
	if command -v logger >/dev/null 2>&1; then
		logger -t luofu-record-pair "$*" 2>/dev/null && return 0
	fi
	echo "luofu-record-pair: $*"
}

# first word of a file -> stdout; failure (missing/unreadable/empty) -> RC 1
_read_word() {
	local word rest

	[ -r "$1" ] || return 1
	read -r word rest < "$1" 2>/dev/null || return 1
	[ -n "$word" ] || return 1
	echo "$word"
}

# <mtdN> -> unquoted /proc/mtd label; exactly one match required
_mtd_label() {
	local label

	[ -r "$LUOFU_MTD_TABLE" ] || return 1
	label="$(awk -v want="$1:" '
		$1 == want {
			name = $4
			for (i = 5; i <= NF; i++)
				name = name " " $i
			print name
			found++
		}
		END { exit(found == 1 ? 0 : 1) }
	' "$LUOFU_MTD_TABLE")" || return 1
	label="${label#\"}"
	label="${label%\"}"
	[ -n "$label" ] || return 1
	echo "$label"
}

# The pair this system booted from: the UBI rootfs device's mtd_num
# cross-checked with that mtd's /proc/mtd label.  /proc/cmdline is not
# trusted alone - the measured stock boot carries no slot token - it is only
# an additional witness (below).
_booted_rootfs_pair() {
	local mtdnum label

	mtdnum="$(_read_word "$LUOFU_UBI_SYS/ubi0/mtd_num")" || return 1
	case "$mtdnum" in
	''|*[!0-9]*) return 1 ;;
	esac
	label="$(_mtd_label "mtd$mtdnum")" || return 1
	case "$label" in
	rootfsa) echo a ;;
	rootfsb) echo b ;;
	*) return 1 ;;
	esac
}

# Slot named on the kernel command line, if any: ubi.mtd=rootfsa/rootfsb or
# ubi.mtd=<mtd number>.  Prints nothing (RC 1) when the command line names no
# slot, which is the measured stock case.
_cmdline_pair() {
	local tok val label

	[ -r "$LUOFU_CMDLINE" ] || return 1
	for tok in $(cat "$LUOFU_CMDLINE" 2>/dev/null); do
		case "$tok" in
		ubi.mtd=*) ;;
		*) continue ;;
		esac
		val="${tok#ubi.mtd=}"
		case "$val" in
		rootfsa) echo a; return 0 ;;
		rootfsb) echo b; return 0 ;;
		''|*[!0-9]*) return 1 ;;
		esac
		label="$(_mtd_label "mtd$val")" || return 1
		case "$label" in
		rootfsa) echo a; return 0 ;;
		rootfsb) echo b; return 0 ;;
		esac
		return 1
	done
	return 1
}

_selector_read() {
	_read_word "$LUOFU_SELECTOR_DIR/current_pair"
}

_wait_selector() {
	local i=0

	while [ "$i" -lt "$LUOFU_RECORD_WAIT" ]; do
		[ -r "$LUOFU_SELECTOR_DIR/current_pair" ] && return 0
		i=$((i + 1))
		sleep 1
	done
	[ -r "$LUOFU_SELECTOR_DIR/current_pair" ]
}

start() {
	local running cmdline_pair current

	running="$(_booted_rootfs_pair)" || {
		_log "cannot identify the booted rootfs pair (ubi0/mtd_num missing or its /proc/mtd label is not rootfsa/rootfsb); not writing the boot selector"
		return 0
	}

	cmdline_pair="$(_cmdline_pair)" || cmdline_pair=""
	if [ -n "$cmdline_pair" ] && [ "$cmdline_pair" != "$running" ]; then
		_log "kernel command line names pair $cmdline_pair but ubi0 is rootfs$running; not writing the boot selector"
		return 0
	fi

	_wait_selector || {
		_log "no luofu-selector interface at $LUOFU_SELECTOR_DIR/current_pair after ${LUOFU_RECORD_WAIT}s; not writing the boot selector"
		return 0
	}

	current="$(_selector_read)" || current=""
	case "$current" in
	a|b) ;;
	*)
		_log "boot selector state '$current' is not one of the two established recorded pairs (a, b); leaving it untouched"
		return 0
		;;
	esac

	if [ "$current" = "$running" ]; then
		_log "running pair $running is already recorded (cell records pair $current); nothing to do"
		return 0
	fi

	_log "recording the running pair $running (the cell records pair $current from the bootloader's bootfip pass)"
	if ! printf '%s\n' "$running" > "$LUOFU_SELECTOR_DIR/next_pair" 2>/dev/null; then
		_log "FAILED to store pair $running; the cell still records pair $current, so the next boot will take the bootloader's failover path"
		return 1
	fi

	current="$(_selector_read)" || current=""
	if [ "$current" != "$running" ]; then
		_log "FAILED: the selector reads '$current' after writing pair $running; the next boot will take the bootloader's failover path"
		return 1
	fi

	_log "running pair $running recorded"
	return 0
}
