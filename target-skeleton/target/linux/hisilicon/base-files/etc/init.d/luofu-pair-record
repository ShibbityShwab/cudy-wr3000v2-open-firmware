#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Bench: record the running A/B pair in the SYSCTRL boot cell so the next
# reset returns to this image (the loader stores the opposite pair before Linux).
START=01
STOP=99
record() {
	slot=b
	grep -q "ubi.mtd=rootfsa" /proc/cmdline && slot=a
	echo "$slot" > /sys/devices/platform/boot-selector/next_pair
	logger -t luofu-pair "recorded running pair: $slot"
}
boot() { record; }
stop() { record; }
